#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""buildq-shim: send heavy commands through buildq without anyone having to remember to.

Install it as links named after the tools (cargo, pnpm, npm, npx, yarn, make, gmake, ninja, dotnet,
cmake, ctest, zig, gradle) in a directory that comes first on PATH (`./install.sh --shims`). Each
link runs this program, which finds the real tool further down PATH and then:

  - runs a heavy invocation as `buildq run -- <the real tool> ARGS...`: it waits its turn, its
    output streams as usual, and it exits with the tool's exit code;
  - runs anything else (cargo fmt, cargo metadata, pnpm dev, vitest in watch mode, ...) directly;
  - runs everything directly inside a build, which already holds a turn.

Heavy means it compiles or runs a whole suite: any cargo subcommand but the few that never
compile (fmt, metadata, tree, clean, ...), npm/pnpm/yarn scripts named build*, test*, lint*,
check*, e2e* and the like, `vitest run`, `jest`, `vite build`, `tsc`, `playwright test`, make and
ninja (except dry runs and long-running targets such as dev, serve or up), `dotnet build/test/
publish/pack`, `cmake --build/--workflow`, `ctest` (except `--show-only`/`--list-presets`),
`zig build/test/build-exe/build-lib/build-obj`, and `gradle` tasks (except `--stop`, `--status`,
dry runs, continuous mode, and query/run tasks). A watch mode is never heavy: it would hold a turn
for as long as it runs. `cargo run` and `dotnet run` queue the build, then run the program
directly, with stdin.

BUILDQ_SHIM=off in the environment turns the shim off for one command. In CI jobs (CI or
GITHUB_ACTIONS set) and under rust-analyzer, tools always run directly.
"""

from __future__ import annotations

import os
import subprocess
import sys

# Cargo subcommands that never compile; anything else, external subcommands included (insta,
# sqlx, xtask, hack, ...), is treated as a build. `watch` runs here and sends what it starts back
# through the shim, so each of its runs is queued instead of the watcher holding a turn.
# They are kept in two sets, for never_builds() below. Cargo's own commands: an alias can't
# redefine these ("Aliases are not allowed to redefine existing built-in commands", cargo's
# configuration reference; seen with cargo 1.99: CARGO_ALIAS_TREE is ignored).
CARGO_OWN_LIGHT = {"metadata", "tree", "version", "help", "search", "login", "logout", "owner", "yank",
                   "locate-project", "pkgid", "read-manifest", "verify-project", "clean", "new", "init", "add",
                   "remove", "update", "fetch", "generate-lockfile", "vendor", "config", "report", "uninstall"}
# Names an alias may take: other programs' (cargo-fmt, cargo-watch, cargo-deny, ...); `rm`, itself
# cargo's alias for `remove`, which a user's alias replaces (CARGO_ALIAS_RM=version cargo rm prints
# the version); and `info`, a command of cargo's own only since 1.82.
CARGO_TOOLS_LIGHT = {"fmt", "watch", "deny", "audit", "outdated", "udeps-list", "machete", "sort", "rm", "info"}
CARGO_LIGHT = CARGO_OWN_LIGHT | CARGO_TOOLS_LIGHT
JS_SCRIPT_PREFIXES = ("build", "test", "typecheck", "type-check", "check", "lint", "e2e", "verify", "storybook:build",
                      "build-storybook", "test-storybook", "ci")
import re

# make targets that start something long-running (a dev server, containers) or just tidy up.
MAKE_LIGHT_TARGET = re.compile(r"(^|[-_:.])(dev|watch|up|down|serve|server|start|run|stop|help|clean|shell|logs|"
                               r"format|fmt|open)($|[-_:.])")
GRADLE_LIGHT_TASK = re.compile(
    r"(^|:)(help|tasks|projects|properties|dependencies|dependencyInsight|components|model|"
    r"outgoingVariants|resolvableConfigurations|clean|wrapper|init|bootRun|run)$", re.I
)
GRADLE_VALUE_OPTIONS = {
    "-p", "--project-dir", "-b", "--build-file", "-c", "--settings-file", "-g", "--gradle-user-home",
    "-I", "--init-script", "-x", "--exclude-task", "--max-workers", "--console", "--console-unicode",
    "--warning-mode", "--priority", "--include-build", "--project-cache-dir",
    "--configuration-cache-problems", "-F", "--dependency-verification", "-M",
    "--write-verification-metadata", "--export-keys", "--update-locks", "--develocity-url",
    "--develocity-plugin-version", "--tests", "-D", "--system-prop", "-P", "--project-prop",
}
ZIG_BUILD_VALUE_OPTIONS = {
    "-j", "-p", "--prefix", "--prefix-lib-dir", "--prefix-exe-dir", "--prefix-include-dir",
    "--sysroot", "--search-prefix", "--libc", "--cache-dir", "--global-cache-dir", "--zig-lib-dir",
    "--build-file", "--build-runner", "--seed", "--maxrss", "--color", "-freference-trace",
}
JS_TOOLS = {"vitest", "vite", "tsc", "vue-tsc", "playwright", "storybook", "build-storybook", "jest", "eslint",
            "next", "nuxt", "astro"}
INFO = {"--help", "-h", "--version", "-V", "version", "help", "--list"}  # asks, builds nothing


def positional_items(args, value_options=()):
    out, skip = [], False
    for i, arg in enumerate(args):
        if skip:
            skip = False
        elif arg.startswith("-"):
            skip = arg in value_options
        else:
            out.append((i, arg))
    return out


def positionals(args, value_options=()):
    return [arg for _, arg in positional_items(args, value_options)]


def watching(args: list[str]) -> bool:
    return any(a in ("--watch", "--watchAll", "watch") or a.startswith("--watch=") for a in args)


def js_script_heavy(name: str) -> bool:
    lowered = name.lower()
    if "watch" in lowered or lowered.startswith(("dev", "start", "serve", "preview")):
        return False
    return lowered.startswith(JS_SCRIPT_PREFIXES)


def js_tool_heavy(tool: str, args: list[str]) -> bool:
    if watching(args):
        return False
    if tool == "vitest":
        # Without "run" it watches at a terminal, and runs the whole suite once without one.
        return "run" in args or "--run" in args or not sys.stdout.isatty()
    if tool == "vite":
        return positionals(args)[:1] == ["build"]
    if tool in ("tsc", "vue-tsc"):
        return not {"--version", "-v", "--help", "-h", "-w"} & set(args)
    if tool == "playwright":
        return positionals(args)[:1] == ["test"]
    if tool in ("storybook", "build-storybook"):
        return tool == "build-storybook" or positionals(args)[:1] == ["build"]
    if tool in ("jest", "eslint"):
        return True
    if tool in ("next", "nuxt", "astro"):
        return positionals(args)[:1] == ["build"]
    return False


def cargo_subcommand(args: list[str]) -> list[str]:
    """The subcommand and the word after it, past a +toolchain and cargo's own options."""
    rest = args[1:] if args and args[0].startswith("+") else args
    return positionals(rest, {"-Z", "--config", "--color", "-C", "--manifest-path"})[:2]


CARGO_ASKS = {"--help", "-h", "--version", "-V", "--list"}  # to cargo itself: they build nothing


def never_builds(tool: str, args: list[str]) -> bool:
    """Whether a command sent to the queue on purpose (`buildq run`, a wrapper around it) is a
    cargo command that never compiles, which `buildq run` then runs at once instead of queueing it
    behind builds (#72): cargo asked for its version or help, one of cargo's own light commands
    (`cargo metadata`, `cargo tree`, `cargo update`, ...), or `cargo fmt`.

    Deliberately narrower than "not heavy()", though it reads the same lists, and whatever it
    calls light heavy() calls light too, so nothing the shim queues is ever let through here:
    - cargo only: other tools' commands stay queued (`make help` is a target like any other), and
      so do words after a subcommand (`cargo test version` names a test);
    - `clean` stays queued: it deletes a target folder without locking it, so it waits for a build
      that uses the folder;
    - of the names an alias may take (CARGO_TOOLS_LIGHT) only `fmt`, which is what agents send.
      For `fmt`, an alias given in the environment (CARGO_ALIAS_FMT) or on the command line
      (--config) is seen; one in a config file isn't (heavy() doesn't see it either), and the
      rustc guard is what refuses that compile outside the queue."""
    if os.path.basename(tool) != "cargo":
        return False
    rest = args[1:] if args and args[0].startswith("+") else args
    if rest and all(a in CARGO_ASKS for a in rest):
        return True
    sub = cargo_subcommand(args)
    own = args[:args.index("--")] if "--" in args else args  # (after `--` they are the tool's, not cargo's)
    if not sub or watching(args) or any(a == "--config" or a.startswith("--config=") for a in own):
        return False  # (cargo's --config can define an alias, or anything else)
    if sub[0] == "fmt":
        return "CARGO_ALIAS_FMT" not in os.environ
    return sub[0] in CARGO_OWN_LIGHT and sub[0] != "clean"


def heavy(tool: str, args: list[str]) -> bool:
    if args and all(a in INFO for a in args):
        return False
    if tool == "cargo":
        sub = cargo_subcommand(args)
        if not sub:
            return False  # cargo -V, cargo --list, ...
        if watching(args) or (sub[0] not in ("build", "b", "check", "c", "test", "t", "run", "r", "clippy")
                              and sub[1:] and sub[1] in ("watch", "dev", "serve")):
            return False  # cargo leptos watch, cargo tauri dev, ...: runs until stopped
        return sub[0] not in CARGO_LIGHT
    if tool == "dotnet":
        before = args[: args.index("--")] if "--" in args else args
        if watching(before):
            return False
        pos = positionals(before)
        if pos[:1] == ["run"] and "--no-build" in before:
            return False  # caller explicitly asked to run without building
        return pos[:1] in (["build"], ["test"], ["publish"], ["pack"], ["msbuild"], ["run"])
    if watching(args):
        return False
    if tool in ("npm", "pnpm", "yarn", "bun"):
        items = positional_items(args, {"-C", "--dir", "--prefix", "--filter", "-F", "--workspace", "--cwd"})
        if items and items[0][1] in ("run", "run-script"):
            items = items[1:]
        if items and items[0][1] in ("exec", "dlx", "x") and len(items) > 1:
            idx, cmd = items[1]
            return js_tool_heavy(os.path.basename(cmd), args[idx + 1:])
        if items and items[0][1] in JS_TOOLS:  # pnpm vitest, yarn tsc: the tool itself
            idx, cmd = items[0]
            return js_tool_heavy(cmd, args[idx + 1:])
        return bool(items) and js_script_heavy(items[0][1])
    if tool in ("npx", "pnpx", "bunx"):
        items = positional_items(args, {"-p", "--package"})
        if not items:
            return False
        idx, cmd = items[0]
        return js_tool_heavy(os.path.basename(cmd), args[idx + 1:])
    if tool in ("make", "gmake", "ninja"):
        if {"-n", "--dry-run", "--just-print", "--recon", "-q", "--question", "-t", "--touch"} & set(args):
            return False
        targets = [a for a in positionals(args, {"-C", "-f", "-j", "-l", "-o", "-W", "--directory", "--file"})
                   if "=" not in a]
        return not targets or not all(MAKE_LIGHT_TARGET.search(t) for t in targets)
    if tool == "cmake":
        before = args[: args.index("--")] if "--" in args else args
        if any(a in ("--help", "-h", "--version", "--list-presets")
               or a.startswith(("--help-", "--list-presets=")) for a in before):
            return False
        return before[:1] in (["--build"], ["--workflow"])
    if tool == "ctest":
        if any(a in ("-N", "--show-only", "--list-presets", "--help", "-h", "--version")
               or a.startswith(("--show-only=", "--list-presets=", "--help-")) for a in args):
            return False
        return True
    if tool == "zig":
        sub = args[0] if args and not args[0].startswith("-") else ""
        rest = args[1:]
        before = rest[: rest.index("--")] if "--" in rest else rest
        if any(a in ("-h", "--help", "-l", "--list-steps") for a in before) or watching(before):
            return False
        if sub == "build":
            steps = positionals(before, ZIG_BUILD_VALUE_OPTIONS)
            return not steps or not all(MAKE_LIGHT_TARGET.search(s) for s in steps)
        return sub in ("test", "test-obj", "build-exe", "build-lib", "build-obj")
    if tool in ("gradle", "gradlew"):
        before = args[: args.index("--")] if "--" in args else args
        if {"--stop", "--status", "--foreground", "-t", "--continuous", "-m", "--dry-run",
            "--task-graph", "-v", "--version", "-h", "--help", "-?"} & set(before):
            return False
        tasks = positionals(before, GRADLE_VALUE_OPTIONS)
        return not tasks or not all(GRADLE_LIGHT_TASK.search(t) for t in tasks)
    if tool in ("docker", "podman"):
        pos = positionals(args)
        return pos[:1] == ["build"] or pos[:2] in (["buildx", "build"], ["compose", "build"], ["image", "build"])
    return False


def passed_through() -> bool:
    """CI jobs and editors run their tools directly: CI has its own runners' limits, and an editor
    kills and restarts its checks far too often to queue them."""
    if os.environ.get("BUILDQ_SHIM") == "off":
        return True
    # A GitHub Actions job, not merely CI=true (which people set to turn watch modes off).
    if os.environ.get("GITHUB_ACTIONS") and os.environ.get("RUNNER_NAME"):
        return True
    pid = os.getppid()
    for _ in range(40):
        try:
            with open(f"/proc/{pid}/comm") as f:
                if f.read().strip() in ("rust-analyzer", "rust-analyzer-proc-macro-srv"):
                    return True
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return False
        if pid <= 1:
            return False
    return False


def build_then_run(tool: str, args: list[str]) -> list[str] | None:
    """For `cargo run` and `dotnet run`: the arguments of the matching build, else None."""
    if tool == "cargo":
        lead = [args[0]] if args and args[0].startswith("+") else []
        rest = args[len(lead):]
        before = rest[: rest.index("--")] if "--" in rest else rest
        items = positional_items(before, {"-Z", "--config", "--color", "-C", "--manifest-path"})
        if not items or items[0][1] not in ("run", "r"):
            return None
        i = items[0][0]
        return lead + before[:i] + ["build"] + before[i + 1:]
    if tool == "dotnet":
        before = args[: args.index("--")] if "--" in args else args
        items = positional_items(before)
        if not items or items[0][1] != "run" or "--no-build" in before:
            return None
        i = items[0][0]
        raw = before[:i] + ["build"] + before[i + 1:]
        build, skip = [], False
        for idx, a in enumerate(raw):
            if skip:
                skip = False
                continue
            # `dotnet run` takes `--project <path>` or `-p <path>` (while `-p <Name>=<Value>` and
            # `-p:<Name>=<Value>` are MSBuild properties); `dotnet build` takes `<path>` positionally
            # and accepts `-p:<Name>=<Value>` and `--no-restore`.
            if a == "--project" and idx + 1 < len(raw):
                build.append(raw[idx + 1])
                skip = True
            elif a == "-p" and idx + 1 < len(raw):
                val = raw[idx + 1]
                build.append(f"-p:{val}" if "=" in val else val)
                skip = True
            elif a.startswith("--project="):
                val = a.split("=", 1)[1]
                if val:
                    build.append(val)
            elif a.startswith("-p="):
                val = a.split("=", 1)[1]
                if val:
                    build.append(f"-p:{val}" if "=" in val else val)
            else:
                build.append(a)
        return build
    return None


def real_tool(name: str) -> str | None:
    """The tool the shim stands in for: the first one of that name on PATH that isn't a shim."""
    me = os.path.realpath(__file__)
    here = os.path.realpath(os.path.dirname(os.path.abspath(sys.argv[0])))
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory or os.path.realpath(directory) == here:
            continue
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and os.path.realpath(candidate) != me:
            return candidate
    return None


def main() -> int:
    name = os.path.basename(sys.argv[0])
    args = sys.argv[1:]
    if name == "buildq-shim":
        print(__doc__.strip(), file=sys.stderr)
        return 2
    tool = real_tool(name)
    if tool is None:
        print(f"buildq-shim: no {name} on PATH besides this shim", file=sys.stderr)
        return 127
    if not passed_through() and heavy(name, args):
        buildq = os.environ.get("BUILDQ_BIN") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "buildq")
        queued = [sys.executable, buildq, "run", "--"]
        build_first = build_then_run(name, args)
        if build_first is not None:
            # Build in the queue, then run the program here: it may read stdin, and it may run for
            # hours (a server), which mustn't hold a turn.
            code = subprocess.call(queued + [tool, *build_first])
            if code != 0:
                return code
            run_args = list(args)
            if name == "dotnet":
                sep = run_args.index("--") if "--" in run_args else len(run_args)
                if "--no-build" not in run_args[:sep]:
                    run_args.insert(sep, "--no-build")
            os.execv(tool, [tool, *run_args])
        # `buildq run` runs it directly when this is already inside a build.
        os.execv(sys.executable, queued + [tool, *args])
    os.execv(tool, [tool, *args])
    return 127


if __name__ == "__main__":
    sys.exit(main())
