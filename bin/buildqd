#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Executable entrypoint for `buildqd` (delegates to the `buildq.daemon` package)."""

from __future__ import annotations

import os
import sys

LIBDIR = None  # stamped by install.sh; None uses ../src from a repository checkout


def _bootstrap() -> None:
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = ([LIBDIR] if LIBDIR else []) + [os.path.normpath(os.path.join(here, "..", "src"))]
    for path in candidates:
        if path and os.path.isdir(os.path.join(path, "buildq")) and path not in sys.path:
            sys.path.insert(0, path)
            break


_bootstrap()

from buildq import common, daemon  # noqa: E402

common.set_daemon_entrypoint(__file__)

if __name__ == "__main__":
    daemon.main()
