try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11
    sys.exit("buildqd needs Python 3.11 or newer (for tomllib).")

VERSION = "0.2.0"
KIB, MIB, GIB = 1 << 10, 1 << 20, 1 << 30
UID = os.getuid()
SELF = os.path.realpath(__file__)
FINISHED = ("succeeded", "failed", "cancelled", "lost")
DEVNULL = subprocess.DEVNULL


# --------------------------------------------------------------------------------------------
# Paths and small helpers


def runtime_dir() -> str:
    return os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{UID}"


def default_socket() -> str:
    return os.path.expanduser(os.environ.get("BUILDQ_SOCKET") or os.path.join(runtime_dir(), "buildq.sock"))


def default_state_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.expanduser(os.environ.get("BUILDQ_STATE_DIR") or os.path.join(base, "buildq"))


def default_config() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.expanduser(os.environ.get("BUILDQ_CONFIG") or os.path.join(base, "buildq", "config.toml"))


_log_lock = threading.Lock()


def to_journal() -> bool:
    """Whether stdout is the journal: JOURNAL_STREAM holds its device and inode (sd_journal's way of
    telling; a shell in a terminal that systemd started inherits the variable, not the stream)."""
    try:
        device, inode = (int(x) for x in os.environ.get("JOURNAL_STREAM", "").split(":"))
        st = os.fstat(sys.stdout.fileno())
        return (st.st_dev, st.st_ino) == (device, inode)
    except (ValueError, OSError, AttributeError):
        return False


def log(message: str, level: int | None = None) -> None:
    """A line for the journal, written whole even with threads logging; `level` (syslog: 4 is
    warning) is marked only when stdout really is the journal."""
    if level is not None and to_journal():  # journald reads the level of each line by itself
        message = "\n".join(f"<{level}>{line}" for line in message.split("\n"))
    with _log_lock:
        sys.stdout.write(message + "\n")
        sys.stdout.flush()


def write_json(path: str, data) -> None:
    """Write a JSON file atomically: readers see the old contents or the new, never a part."""
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f, separators=(",", ":"))
    os.replace(tmp, path)


def read_json(path: str):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def peer_uid(sock: socket.socket) -> int | None:
    try:
        _pid, uid, _gid = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                              struct.calcsize("3i")))
        return uid
    except (OSError, AttributeError):
        return None


# --------------------------------------------------------------------------------------------
# Sizes, durations, numbers


def parse_size(value, total: int | None = None) -> int:
    """'16G', '512M', '1.5T', '2048K', a plain number of bytes, or '10%' of `total` -> bytes."""
    if isinstance(value, bool):
        raise ValueError(f"not a size: {value!r}")
    if isinstance(value, (int, float)):
        if not math.isfinite(value) or value < 0:
            raise ValueError(f"not a size: {value!r}")
        return int(value)
    text = str(value).strip()
    if text.endswith("%"):
        if total is None:
            raise ValueError(f"a percentage needs a total: {value!r}")
        share = float(text[:-1])
        if not 0 <= share <= 100:
            raise ValueError(f"not a percentage: {value!r}")
        return int(share / 100 * total)
    match = re.fullmatch(r"([0-9]*\.?[0-9]+)\s*([kKmMgGtT]?)(?:i?[bB])?", text)
    if not match:
        raise ValueError(f"not a size: {value!r}")
    unit = {"": 1, "k": KIB, "m": MIB, "g": GIB, "t": 1 << 40}[match.group(2).lower()]
    return int(float(match.group(1)) * unit)


def parse_duration(value) -> float:
    """'90', '90s', '10m', '2h', '7d' -> seconds."""
    if isinstance(value, bool):
        raise ValueError(f"not a duration: {value!r}")
    if isinstance(value, (int, float)):
        seconds = float(value)
    else:
        match = re.fullmatch(r"\s*([0-9]*\.?[0-9]+)\s*([smhd]?)\s*", str(value))
        if not match:
            raise ValueError(f"not a duration: {value!r}")
        seconds = float(match.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
    if not math.isfinite(seconds) or seconds < 0:
        raise ValueError(f"not a duration: {value!r}")
    return seconds


def boolean(value, what: str) -> bool:
    if not isinstance(value, bool):
        raise ValueError(f"{what} must be true or false")
    return value


def number(value, what: str, low: float, high: float, integer: bool = False):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError(f"{what} must be a number")
    if not math.isfinite(value) or not low <= value <= high:
        raise ValueError(f"{what} must be between {low:g} and {high:g}")
    if integer and int(value) != value:
        raise ValueError(f"{what} must be a whole number")
    return int(value) if integer else float(value)


def fmt_duration(seconds: float) -> str:
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def fmt_size(n: float) -> str:
    if abs(n) >= 10 * GIB:
        return f"{n / GIB:.0f}G"
    if abs(n) >= GIB:
        return f"{n / GIB:.1f}G"
    return f"{n / MIB:.0f}M"


# --------------------------------------------------------------------------------------------
# Configuration

DEFAULTS = {
    "max_jobs": 4,
    "cpu_target": 0.9,
    "mem_floor": "10%",
    "disk_floor": "2G",
    # Where image builds write: Docker's root, containerd's image store, rootless Docker's, and
    # Podman's rootful and rootless stores (those that exist).
    "container_storage": ["/var/lib/docker", "/var/lib/containerd", "~/.local/share/docker",
                          "/var/lib/containers/storage", "~/.local/share/containers/storage"],
    "cpu_psi_block": 50.0,
    "mem_psi_block": 10.0,
    "ramp_seconds": 90,
    "starve_seconds": 600,
    "ci_first": False,
    "make_room_for_ci": "0",
    "make_room_behind_agents": True,
    "make_room_spare_after": "0",
    "script_labels": [],
    "restartable_scripts": [],
    "unwatched_seconds": 30,
    "history_runs": 30,
    "history_days": 30,
    "history_keys": 2000,
    "mem_margin": 1.15,
    "max_log": "64M",
    "slice": "buildq.slice",
    "slice_guard": True,
    "runner": "auto",
    "default_lane": "default",
    "keep_finished": "7d",
    "max_finished": 1000,
    "on_finish": "",
    "shed_memory": True,
    "reuse_window": "2h",
    "github_status": False,
    "gh": "",
    "metrics": True,
    "release_after_peak": "shadow",
    "env": {},
    "lanes": {"default": {"cores": 4, "mem": "4G", "properties": {"MemoryHigh": "40%", "MemoryMax": "50%"}}},
    "lane_rules": [],
    "flock_slots": [],
}
PROPERTY_NAME = re.compile(r"^[A-Z][A-Za-z0-9]*$")
ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


class Lane:
    KEYS = {"cores", "min_cores", "max_cores", "mem", "min_mem", "properties", "may_pass_held", "jobserver",
            "exclusive", "timeout", "priority", "extra_jobs", "test_threads", "waits_for_cpu",
            "release_after_peak", "workspace_group"}

    def __init__(self, name: str, raw, mem_total: int, ncpu: int):
        if not isinstance(raw, dict):
            raise ValueError(f"lanes.{name} must be a table")
        unknown = set(raw) - self.KEYS
        if unknown:
            raise ValueError(f"lanes.{name}: unknown keys {sorted(unknown)}")
        self.name = name
        self.cores = number(raw.get("cores", 4), f"lanes.{name}.cores", 1, 4096, integer=True)
        self.min_cores = number(raw.get("min_cores", 1), f"lanes.{name}.min_cores", 1, 4096, integer=True)
        self.max_cores = number(raw.get("max_cores", max(self.cores, 1)), f"lanes.{name}.max_cores", 1, 4096,
                                integer=True)
        self.max_cores = min(self.max_cores, ncpu)
        self.cores = min(max(self.cores, self.min_cores), self.max_cores)
        if self.min_cores > self.max_cores:
            raise ValueError(f"lanes.{name}: min_cores is more than max_cores")
        self.mem = parse_size(raw.get("mem", "4G"), mem_total)
        self.min_mem = parse_size(raw.get("min_mem", 0), mem_total)
        if not 0 < self.mem <= mem_total:
            raise ValueError(f"lanes.{name}.mem must be more than 0 and at most the machine's memory")
        if self.min_mem > mem_total:
            raise ValueError(f"lanes.{name}.min_mem is more than the machine's memory")
        properties = raw.get("properties") or {}
        if not isinstance(properties, dict):
            raise ValueError(f"lanes.{name}.properties must be a table")
        self.properties = {}
        for key, value in properties.items():
            if not PROPERTY_NAME.match(str(key)) or isinstance(value, (dict, list)) or "\n" in str(value):
                raise ValueError(f"lanes.{name}.properties: bad property {key!r}")
            self.properties[str(key)] = str(value).lower() if isinstance(value, bool) else str(value)
        self.may_pass_held = boolean(raw.get("may_pass_held", False), f"lanes.{name}.may_pass_held")
        # false: its builds start even when the CPU is at cpu_target, on the cores they need, and
        # the rebalancer takes the difference back from resizable builds. Memory still decides.
        self.waits_for_cpu = boolean(raw.get("waits_for_cpu", True), f"lanes.{name}.waits_for_cpu")
        # Off for builds whose memory is used outside their cgroup (docker build: dockerd does the work).
        self.release_after_peak = boolean(raw.get("release_after_peak", True), f"lanes.{name}.release_after_peak")
        mode = raw.get("jobserver", "tools")
        modes = {True: "all", "all": "all", "tools": "tools", False: "off", "off": "off"}
        if mode not in modes:
            raise ValueError(f"lanes.{name}.jobserver must be true, false or \"tools\"")
        self.jobserver = modes[mode]  # "tools": only for cargo, make and ninja, which are known to speak it
        self.exclusive = boolean(raw.get("exclusive", True), f"lanes.{name}.exclusive")
        # Exclusive lanes with the same group run one build per workspace between them (a cargo
        # check and a cargo test sharing a target folder would only wait on cargo's lock).
        group = raw.get("workspace_group", name)
        if not isinstance(group, str) or not group:
            raise ValueError(f"lanes.{name}.workspace_group must be a name")
        self.workspace_group = group
        self.group_given = "workspace_group" in raw and group != name  # (naming itself is the default)
        # RUST_TEST_THREADS and NEXTEST_TEST_THREADS win over a project's own settings (a suite
        # pinned to one thread for a shared database, say), so they are set only where asked.
        self.test_threads = boolean(raw.get("test_threads", False), f"lanes.{name}.test_threads")
        self.timeout = parse_duration(raw["timeout"]) if raw.get("timeout") else None
        self.priority = number(raw.get("priority", 0), f"lanes.{name}.priority", -1000, 1000, integer=True)
        self.extra_jobs = number(raw.get("extra_jobs", 0), f"lanes.{name}.extra_jobs", 0, 1000, integer=True)
        cap = self.properties.get("MemoryMax")
        try:
            self.mem_cap = parse_size(cap, mem_total) if cap and cap != "infinity" else None
        except ValueError:
            self.mem_cap = None

    def summary(self) -> dict:
        return {"cores": self.cores, "min_cores": self.min_cores, "max_cores": self.max_cores, "mem": self.mem,
                "min_mem": self.min_mem, "properties": self.properties, "may_pass_held": self.may_pass_held,
                "jobserver": self.jobserver, "exclusive": self.exclusive, "timeout": self.timeout,
                "priority": self.priority, "extra_jobs": self.extra_jobs, "waits_for_cpu": self.waits_for_cpu,
                "release_after_peak": self.release_after_peak, "workspace_group": self.workspace_group}


class Config:
    def __init__(self, raw: dict, mem_total: int, ncpu: int):
        if not isinstance(raw, dict):
            raise ValueError("the configuration must be a table")
        unknown = set(raw) - set(DEFAULTS)
        if unknown:
            raise ValueError(f"unknown keys {sorted(unknown)}")
        d = {**DEFAULTS, **raw}
        self.max_jobs = number(d["max_jobs"], "max_jobs", 1, 10000, integer=True)
        self.cpu_target = number(d["cpu_target"], "cpu_target", 0.05, 4)
        self.mem_floor = parse_size(d["mem_floor"], mem_total)
        if not 0 <= self.mem_floor < mem_total:
            raise ValueError("mem_floor must be less than the machine's memory")
        # A size, or a percentage of each build's own filesystem ("20%"), worked out where it runs.
        storage = d["container_storage"]
        if not isinstance(storage, list) or not all(isinstance(p, str) and p for p in storage):
            raise ValueError("container_storage must be a list of directories")
        self.container_storage = [os.path.expanduser(p) for p in storage]
        floor = d["disk_floor"]
        if isinstance(floor, str) and floor.strip().endswith("%"):
            try:
                share = float(floor.strip()[:-1])
            except ValueError:
                raise ValueError(f"disk_floor: not a percentage: {floor!r}") from None
            share = number(share, "disk_floor", 0, 99)
            self.disk_floor, self.disk_floor_share = 0, share / 100
        else:
            self.disk_floor, self.disk_floor_share = parse_size(floor), 0.0
        self.cpu_psi_block = number(d["cpu_psi_block"], "cpu_psi_block", 0, 1000)
        self.mem_psi_block = number(d["mem_psi_block"], "mem_psi_block", 0, 1000)
        self.ramp_seconds = number(d["ramp_seconds"], "ramp_seconds", 0, 3600)
        self.starve_seconds = number(d["starve_seconds"], "starve_seconds", 1, 7 * 86400)
        self.ci_first = boolean(d["ci_first"], "ci_first")
        room = d["make_room_for_ci"]
        self.make_room_for_ci = 0.0 if room in (0, "0", "", None, False) else parse_duration(room)
        if self.make_room_for_ci and not self.ci_first:
            raise ValueError("make_room_for_ci needs ci_first = true: without it a CI job's build holds no room, "
                             "so the memory freed for it could go to another build")
        # (#38) Whether a CI build waiting partly behind room held for agents' builds that have waited
        # longer may stop builds; and how long a build may have run before it is never stopped for one.
        self.make_room_behind_agents = boolean(d["make_room_behind_agents"], "make_room_behind_agents")
        spare = d["make_room_spare_after"]
        self.make_room_spare_after = 0.0 if spare in (0, "0", "", None, False) else parse_duration(spare)
        labels = d["script_labels"]
        if not isinstance(labels, list) or not all(isinstance(x, str) and re.fullmatch(r"[A-Za-z0-9_.+-]+", x)
                                                    for x in labels):
            raise ValueError("script_labels must be a list of script file names, such as [\"build.sh\"]")
        self.script_labels = frozenset(labels)
        scripts = d["restartable_scripts"]
        if not isinstance(scripts, list) or not all(isinstance(x, str) and re.fullmatch(r"[A-Za-z0-9_.+-]+", x)
                                                     for x in scripts):
            raise ValueError("restartable_scripts must be a list of script file names, such as "
                             "[\"run-api-tests.sh\"]")
        tools = [x for x in scripts if x in NOT_SCRIPTS or NOT_SCRIPT_PATTERN.fullmatch(x)]
        if tools:
            raise ValueError(f"restartable_scripts names scripts, not tools: {', '.join(sorted(tools))} "
                             "would make anything run with them restartable")
        self.restartable_scripts = frozenset(scripts)
        self.unwatched_seconds = number(d["unwatched_seconds"], "unwatched_seconds", 1, 86400)
        self.history_runs = number(d["history_runs"], "history_runs", 1, 1000, integer=True)
        self.history_days = number(d["history_days"], "history_days", 1, 3650)
        self.history_keys = number(d["history_keys"], "history_keys", 10, 1_000_000, integer=True)
        self.mem_margin = number(d["mem_margin"], "mem_margin", 1, 10)
        self.max_log = parse_size(d["max_log"])
        self.slice = str(d["slice"])
        if not re.fullmatch(r"[A-Za-z0-9_.\-]+\.slice", self.slice):
            raise ValueError(f"slice must be a systemd slice name ending in .slice: {self.slice!r}")
        self.slice_guard = boolean(d["slice_guard"], "slice_guard")
        self.runner = str(d["runner"])
        if self.runner not in ("auto", "systemd", "direct"):
            raise ValueError("runner must be auto, systemd or direct")
        self.keep_finished = parse_duration(d["keep_finished"])
        self.max_finished = number(d["max_finished"], "max_finished", 0, 1_000_000, integer=True)
        self.on_finish = str(d["on_finish"] or "")
        self.shed_memory = boolean(d["shed_memory"], "shed_memory")
        self.reuse_window = parse_duration(d["reuse_window"]) if d["reuse_window"] not in (0, "0", "", None) else 0.0
        self.github_status = boolean(d["github_status"], "github_status")
        # Only its form is checked here: a gh removed later (a version manager's upgrade) must not
        # make the whole configuration, lanes and all, fail to load. Whether it runs is found out
        # when a status is sent, and logged once.
        gh = os.path.expanduser(str(d["gh"] or ""))
        if gh and not os.path.isabs(gh):
            raise ValueError(f"gh must be a full path (~ is expanded): {gh!r}")
        self.gh = gh
        self.metrics = boolean(d["metrics"], "metrics")
        rap = d["release_after_peak"]
        self.release_after_peak = "shadow" if rap == "shadow" else boolean(rap, "release_after_peak")
        if not isinstance(d["lanes"], dict) or not d["lanes"]:
            raise ValueError("lanes must define at least one lane")
        self.lanes = {str(n): Lane(str(n), lane, mem_total, ncpu) for n, lane in d["lanes"].items()}
        for lane in self.lanes.values():  # a group that names a lane must be that lane's group
            named = self.lanes.get(lane.workspace_group)
            if lane.group_given and named is not None and named is not lane and named.workspace_group != lane.workspace_group:
                raise ValueError(f"lanes.{lane.name}.workspace_group {lane.workspace_group!r}: lane {named.name}'s "
                                 f"group is {named.workspace_group!r}: use that")
        for lane in self.lanes.values():
            if not lane.group_given:
                continue
            others = [o for o in self.lanes.values() if o is not lane and o.workspace_group == lane.workspace_group]
            if not others:
                raise ValueError(f"lanes.{lane.name}.workspace_group {lane.workspace_group!r} is shared with no other "
                                 "lane (to join a lane's group, name that lane or its group)")
            if any(not o.exclusive for o in [lane, *others]):
                raise ValueError(f"lanes.{lane.name}.workspace_group {lane.workspace_group!r}: every lane in a group "
                                 "must be exclusive")
        self.default_lane = str(d["default_lane"])
        if self.default_lane not in self.lanes:
            raise ValueError(f"default_lane {self.default_lane!r} is not in lanes {sorted(self.lanes)}")
        if not isinstance(d["env"], dict):
            raise ValueError("env must be a table")
        self.env = {}
        for key, value in d["env"].items():
            if not ENV_NAME.match(str(key)) or isinstance(value, (dict, list)):
                raise ValueError(f"env: bad variable {key!r}")
            if key in DEFAULTS:
                raise ValueError(f"env.{key} is a top-level setting written after [env]; move it above the "
                                 "first [table] of the file")
            self.env[str(key)] = str(value)
        if not isinstance(d["lane_rules"], list):
            raise ValueError("lane_rules must be a list of tables")
        self.lane_rules = []
        for entry in d["lane_rules"]:
            if not isinstance(entry, dict) or "match" not in entry or "lane" not in entry:
                raise ValueError("each lane_rules entry needs a match and a lane")
            if set(entry) - {"match", "lane"}:
                raise ValueError(f"lane_rules: unknown keys {sorted(set(entry) - {'match', 'lane'})} "
                                 "(a top-level key written after a [[lane_rules]] entry lands in it)")
            if str(entry["lane"]) not in self.lanes:
                raise ValueError(f"lane_rules: lane {entry['lane']!r} is not in lanes")
            try:
                self.lane_rules.append((re.compile(str(entry["match"])), str(entry["lane"])))
            except re.error as e:
                raise ValueError(f"lane_rules: bad pattern {entry['match']!r}: {e}") from e
        if not isinstance(d["flock_slots"], list):
            raise ValueError("flock_slots must be a list of tables")
        self.flock_slots = []
        for entry in d["flock_slots"]:
            if not isinstance(entry, dict) or "glob" not in entry:
                raise ValueError("each flock_slots entry needs a glob")
            if set(entry) - {"glob", "lane"}:
                raise ValueError(f"flock_slots: unknown keys {sorted(set(entry) - {'glob', 'lane'})}")
            lane = str(entry.get("lane", self.default_lane))
            if lane not in self.lanes:
                raise ValueError(f"flock_slots: lane {lane!r} is not in lanes")
            self.flock_slots.append((os.path.expanduser(str(entry["glob"])), lane))

    def summary(self) -> dict:
        return {
            "max_jobs": self.max_jobs, "cpu_target": self.cpu_target, "mem_floor": self.mem_floor,
            "disk_floor": f"{self.disk_floor_share * 100:g}%" if self.disk_floor_share else self.disk_floor,
            "cpu_psi_block": self.cpu_psi_block, "mem_psi_block": self.mem_psi_block,
            "ramp_seconds": self.ramp_seconds, "starve_seconds": self.starve_seconds, "ci_first": self.ci_first,
            "make_room_for_ci": self.make_room_for_ci, "make_room_behind_agents": self.make_room_behind_agents,
            "make_room_spare_after": self.make_room_spare_after, "script_labels": sorted(self.script_labels),
            "restartable_scripts": sorted(self.restartable_scripts),
            "slice": self.slice,
            "slice_guard": self.slice_guard,
            "runner": self.runner, "default_lane": self.default_lane, "keep_finished": self.keep_finished,
            "max_log": self.max_log, "shed_memory": self.shed_memory, "reuse_window": self.reuse_window,
            "github_status": self.github_status, "gh": self.gh, "metrics": self.metrics,
            "release_after_peak": self.release_after_peak,
            "lanes": {name: lane.summary() for name, lane in self.lanes.items()},
            "lane_rules": [[rule.pattern, lane] for rule, lane in self.lane_rules],
            "env": self.env,
        }

    def lane_for(self, argv: list[str]) -> str:
        """The lane a command goes to when its caller names none: the first rule that matches
        its key words (`cargo test -p api`, `pnpm --filter web build`, ...), else default_lane."""
        words = " ".join(command_words(argv, self.script_labels))
        for rule, lane in self.lane_rules:
            if rule.search(words):
                return lane
        return self.default_lane


def load_config_file(path: str, mem_total: int, ncpu: int) -> Config:
    raw = {}
    if os.path.exists(path):
        with open(path, "rb") as f:
            raw = tomllib.load(f)
    return Config(raw, mem_total, ncpu)


# --------------------------------------------------------------------------------------------
# What the machine is doing


def cpu_times() -> tuple[int, int]:
    """(all jiffies, idle + iowait jiffies) summed over every CPU, from /proc/stat."""
    with open("/proc/stat") as f:
        fields = [int(x) for x in f.readline().split()[1:9]]
    return sum(fields), fields[3] + fields[4]


def meminfo() -> dict[str, int]:
    out = {}
    with open("/proc/meminfo") as f:
        for line in f:
            name, _, rest = line.partition(":")
            parts = rest.split()
            if parts:
                out[name] = int(parts[0]) * (KIB if len(parts) > 1 else 1)
    return out


def pressure(resource: str, kind: str) -> float:
    """avg10 of /proc/pressure/<resource> for "some" or "full"; 0 where PSI is unavailable."""
    try:
        with open(f"/proc/pressure/{resource}") as f:
            for line in f:
                parts = line.split()
                if parts and parts[0] == kind:
                    for field in parts[1:]:
                        name, _, value = field.partition("=")
                        if name == "avg10":
                            return float(value)
    except (OSError, ValueError):
        pass
    return 0.0


def disk_space(path: str) -> tuple[int, int] | None:
    """(bytes free to an unprivileged user, the filesystem's size) where a path lives, or None."""
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize, st.f_blocks * st.f_frsize
    except OSError:
        return None


class Machine:
    """Machine-wide CPU and memory, sampled once a second by the daemon."""

    TAU = 10.0  # seconds; time constant of the busy-cores average

    def __init__(self):
        self.ncpu = os.cpu_count() or 1
        self.busy = 0.0
        self.busy_now = 0.0
        self.mem_total = self.mem_available = self.swap_used = 0
        self.psi_cpu = self.psi_mem = self.psi_mem_some = 0.0
        self._prev = None
        self._primed = False
        self.sample(time.monotonic())

    def sample(self, now: float) -> None:
        total, idle = cpu_times()
        if self._prev is not None:
            t0, total0, idle0 = self._prev
            if total > total0:
                self.busy_now = max(0.0, 1 - (idle - idle0) / (total - total0)) * self.ncpu
                if self._primed:
                    self.busy += (1 - math.exp(-max(now - t0, 0.0) / self.TAU)) * (self.busy_now - self.busy)
                else:
                    self.busy = self.busy_now
                    self._primed = True
        self._prev = (now, total, idle)
        info = meminfo()
        self.mem_total = info.get("MemTotal", 0)
        self.mem_available = info.get("MemAvailable", info.get("MemFree", 0))
        self.swap_used = info.get("SwapTotal", 0) - info.get("SwapFree", 0)
        self.psi_cpu = pressure("cpu", "some")
        self.psi_mem = pressure("memory", "full")
        self.psi_mem_some = pressure("memory", "some")

    def read_available(self) -> int:
        """MemAvailable now, read again: a build that ended since this tick's sample has given its
        memory back by now (see make_room_for_ci)."""
        info = meminfo()
        self.mem_available = info.get("MemAvailable", info.get("MemFree", self.mem_available))
        return self.mem_available

    def summary(self) -> dict:
        return {
            "cores": self.ncpu, "busy": round(self.busy, 2), "busy_now": round(self.busy_now, 2),
            "mem_total": self.mem_total, "mem_available": self.mem_available, "swap_used": self.swap_used,
            "psi_cpu_some_avg10": self.psi_cpu, "psi_mem_full_avg10": self.psi_mem,
            "psi_mem_some_avg10": self.psi_mem_some,
        }


def user_manager_cgroup() -> str:
    """The cgroup directory of this user's systemd manager (user@UID.service)."""
    try:
        with open("/proc/self/cgroup") as f:
            for line in f:
                if line.startswith("0::"):
                    match = re.match(r"(.*/user@\d+\.service)(?:/|$)", line[3:].strip())
                    if match:
                        return "/sys/fs/cgroup" + match.group(1)
    except OSError:
        pass
    return f"/sys/fs/cgroup/user.slice/user-{UID}.slice/user@{UID}.service"


def slice_path(name: str) -> str:
    """systemd nests a-b.slice inside a.slice: 'a-b.slice' -> 'a.slice/a-b.slice'."""
    parts = name[: -len(".slice")].split("-")
    return "/".join("-".join(parts[: i + 1]) + ".slice" for i in range(len(parts)))


def sane_count(value, limit: float = 1e12) -> float | None:
    """A non-negative, finite number no larger than `limit` from a file another process wrote, or
    None. (float() of a huge integer raises OverflowError; NaN fails every comparison.)"""
    if isinstance(value, bool):
        return None
    try:
        value = float(value)
    except (TypeError, ValueError, OverflowError):
        return None
    return value if 0 <= value <= limit else None


def unreclaimable(stat: dict[str, int]) -> int:
    return stat.get("anon", 0) + stat.get("shmem", 0) + max(0, stat.get("kernel", 0) - stat.get("slab_reclaimable", 0))


def cgroup_stats(path: str):
    """(cpu usage in usec, unreclaimable memory in bytes, oom kills) of a cgroup, or None if gone.

    The memory is anon + shmem + kernel - slab_reclaimable from memory.stat. memory.current and
    memory.peak also count page cache, which a build fills with its own output and the kernel takes
    back when it needs to, so they say little about what a build needs.
    """
    try:
        usage = 0
        with open(os.path.join(path, "cpu.stat")) as f:
            for line in f:
                name, _, value = line.partition(" ")
                if name == "usage_usec":
                    usage = int(value)
                    break
        stat = {}
        with open(os.path.join(path, "memory.stat")) as f:
            for line in f:
                name, _, value = line.partition(" ")
                if name in ("anon", "kernel", "shmem", "slab_reclaimable"):
                    stat[name] = int(value)
        return usage, unreclaimable(stat), cgroup_oom_kills(path)
    except (OSError, ValueError):
        return None


def cgroup_events(path: str) -> dict[str, int]:
    out = {}
    try:
        with open(os.path.join(path, "memory.events.local")) as f:
            for line in f:
                name, _, value = line.partition(" ")
                out[name] = int(value)
    except (OSError, ValueError):
        pass
    return out


def cgroup_memory_waits(path: str) -> tuple[float, float, int] | None:
    """(seconds in which some of the cgroup's tasks waited on memory, seconds in which all of them
    did, times it went over its own MemoryHigh), or None if its memory.pressure can't be read.

    The waits are reclaim and swap-in, whatever caused them: the cgroup's own MemoryHigh, or a
    machine short of memory. Going over MemoryHigh says its own limit was one of the causes."""
    some = full = 0.0
    try:
        with open(os.path.join(path, "memory.pressure")) as f:
            for line in f:
                parts = line.split()
                total = next((int(p[6:]) for p in parts[1:] if p.startswith("total=")), 0) / 1e6
                if parts and parts[0] == "some":
                    some = total
                elif parts and parts[0] == "full":
                    full = total
    except (OSError, ValueError):
        return None
    return some, full, cgroup_events(path).get("high", 0)


def cgroup_held(path: str) -> tuple[int, int] | None:
    """(unreclaimable memory, swap) a cgroup and its descendants hold, in bytes, or None if its
    memory.stat can't be read (it has gone, say). Swap counts because with zram it is still RAM."""
    stat = {}
    try:
        with open(os.path.join(path, "memory.stat")) as f:
            for line in f:
                name, _, value = line.partition(" ")
                if name in ("anon", "kernel", "shmem", "slab_reclaimable"):
                    stat[name] = int(value)
    except (OSError, ValueError):
        return None
    swap = 0
    try:
        with open(os.path.join(path, "memory.swap.current")) as f:
            swap = int(f.read())
    except (OSError, ValueError):
        pass
    return unreclaimable(stat), swap


def cgroup_swap(path: str) -> int:
    """Bytes of a cgroup's memory in swap now (0 if unknown)."""
    try:
        with open(os.path.join(path, "memory.swap.current")) as f:
            return int(f.read())
    except (OSError, ValueError):
        return 0


class WalkBudget:
    """How many more cgroup directories a walk may read, and until when."""

    def __init__(self, dirs: int, deadline: float | None):
        self.dirs, self.deadline, self.complete = dirs, deadline, True

    def out(self) -> bool:
        if self.dirs <= 0 or (self.deadline is not None and time.monotonic() > self.deadline):
            self.complete = False
            return True
        return False


def biggest_process(path: str, skip=(), budget: WalkBudget | None = None, limit: int = 500) -> str:
    """The name of the largest process (by resident memory) in a cgroup or below it, leaving out the
    subtrees in `skip`: best effort, looking at no more than `limit` processes and within `budget`."""
    best, name, seen = -1, "", 0
    for directory, children, _ in os.walk(path):
        if budget is not None:
            if budget.out():
                return name
            budget.dirs -= 1
        children[:] = [c for c in children if os.path.join(directory, c) not in skip]
        try:
            with open(os.path.join(directory, "cgroup.procs")) as f:
                pids = f.read().split()
        except OSError:
            continue
        for pid in pids:
            if seen >= limit:
                if budget is not None:
                    budget.complete = False  # the largest may be among those not looked at
                return name
            if budget is not None and budget.out():
                return name
            seen += 1
            try:
                with open(f"/proc/{pid}/statm") as f:
                    rss = int(f.read().split()[1])
                if rss > best:
                    with open(f"/proc/{pid}/comm", errors="replace") as f:
                        best, name = rss, f.read().strip()
            except (OSError, ValueError, IndexError):
                continue
    return name


def biggest_cgroups(root: str = "/sys/fs/cgroup", count: int = 6, at_least: int = 256 * MIB,
                    max_dirs: int = 5000, deadline: float | None = None):
    """Where the machine's memory is: the cgroups holding the most that the kernel can't simply drop
    (as cgroup_stats counts it, plus swap), largest first, as a list of (memory, swap, path below
    root, its largest process), and whether the walk finished.

    It looks into a cgroup only if its memory.current plus its swap is at least `at_least`. A cgroup
    none of whose children is that big is listed as a whole; one with big children is listed by
    those, plus "(the rest)" for what its small children hold together, when that is big enough, so
    many small services don't vanish. It reads at most `max_dirs` directories while walking, and
    as many again looking for process names, and stops at `deadline`, listing what it has not looked
    into yet as a whole."""
    found = []
    budget = WalkBudget(max_dirs, deadline)

    def big_children(path: str) -> tuple[list[tuple[str, tuple[int, int]]], bool]:
        """Its children big enough to look into, and whether the listing was cut off."""
        big = []
        try:
            with os.scandir(path) as entries:
                for entry in entries:
                    if budget.out():
                        return big, True
                    if not entry.is_dir(follow_symlinks=False):
                        continue
                    budget.dirs -= 1
                    try:
                        with open(os.path.join(entry.path, "memory.current")) as f:
                            size = int(f.read())
                    except (OSError, ValueError):
                        continue
                    if size < at_least:
                        try:  # swapped out, it holds little RAM but may hold a lot of swap
                            with open(os.path.join(entry.path, "memory.swap.current")) as f:
                                size += int(f.read())
                        except (OSError, ValueError):
                            pass
                        if size < at_least:
                            continue
                    held = cgroup_held(entry.path)
                    if held is not None:  # one that has gone counts in its parent's rest
                        big.append((entry.path, held))
        except OSError:
            pass
        return big, False

    def visit(path: str, depth: int, held: tuple[int, int] | None) -> None:
        big, cut = big_children(path) if depth < 8 and not budget.out() else ([], False)
        if cut and held is not None:  # its unread children would pass for "the rest": list it whole
            found.append((held[0], held[1], path, ()))
            return
        if held is not None:  # not the root, which has no memory of its own to list
            if not big:
                found.append((held[0], held[1], path, ()))
                return
            rest = (max(0, held[0] - sum(h[0] for _, h in big)), max(0, held[1] - sum(h[1] for _, h in big)))
            if sum(rest) >= at_least:
                found.append((rest[0], rest[1], path + " (the rest)", tuple(c for c, _ in big)))
        for child, child_held in big:
            if budget.out():
                found.append((child_held[0], child_held[1], child, ()))  # listed whole, not looked into
            else:
                visit(child, depth + 1, child_held)

    visit(root, 0, None)
    found.sort(key=lambda e: e[0] + e[1], reverse=True)
    names = WalkBudget(max_dirs, None if deadline is None else max(deadline, time.monotonic()) + 5)
    top = []
    for memory, swap, path, skip in found[:count]:
        directory = path[: -len(" (the rest)")] if path.endswith(" (the rest)") else path
        top.append((memory, swap, os.path.relpath(path, root), biggest_process(directory, skip, names)))
    return top, budget.complete and names.complete


def short_cgroup(rel: str) -> str:
    """The last part of a cgroup's path, with a container's 64-digit ID cut to Docker's 12."""
    return re.sub(r"^docker-([0-9a-f]{12})[0-9a-f]{52}\.scope", r"docker-\1.scope", rel.rsplit("/", 1)[-1])


def cgroup_oom_kills(path: str) -> int:
    try:
        with open(os.path.join(path, "memory.events")) as f:
            for line in f:
                name, _, value = line.partition(" ")
                if name == "oom_kill":
                    return int(value)
    except (OSError, ValueError):
        pass
    return 0


def cgroup_populated(path: str) -> bool:
    try:
        with open(os.path.join(path, "cgroup.events")) as f:
            return "populated 1" in f.read()
    except FileNotFoundError:
        return False
    except OSError:
        return True  # can't tell (out of descriptors, say): don't call a build gone on that


def proc_identity(pid):
    """(start time in clock ticks since boot, state letter) of a process, or None if it's gone."""
    try:
        with open(f"/proc/{int(pid)}/stat") as f:
            data = f.read()
        fields = data.rsplit(")", 1)[1].split()
        return int(fields[19]), fields[0]
    except (OSError, ValueError, IndexError, TypeError):
        return None


def proc_alive(pid, start) -> bool:
    ident = proc_identity(pid) if pid else None
    return bool(ident) and ident[0] == start and ident[1] not in ("Z", "X")


def proc_cmdline(pid: int) -> list[str]:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def proc_cgroup(pid: int) -> str | None:
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            for line in f:
                if line.startswith("0::"):
                    return "/sys/fs/cgroup" + line[3:].strip()
    except OSError:
        pass
    return None


def proc_children(pid: int) -> list[int]:
    try:
        with open(f"/proc/{pid}/task/{pid}/children") as f:
            return [int(x) for x in f.read().split()]
    except (OSError, ValueError):
        return []


def tagged_processes(job: str, exclude: int | None = None) -> list[int]:
    """This user's processes whose environment says they belong to build `job` (BUILDQ_JOB),
    including any that left the build's process group."""
    tag = f"BUILDQ_JOB={job}".encode()
    found = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == exclude or int(entry) == os.getpid():
            continue
        try:
            if os.stat(f"/proc/{entry}").st_uid != UID:
                continue
            with open(f"/proc/{entry}/environ", "rb") as f:
                if tag in f.read().split(b"\0"):
                    ident = proc_identity(int(entry))
                    if ident and ident[1] not in ("Z", "X"):
                        found.append(int(entry))
        except OSError:
            continue
    return found


# --------------------------------------------------------------------------------------------
# flock(2) slots of an older semaphore script


def locked_inodes() -> set[int]:
    """Inodes of every file with a flock(2) lock on it, from /proc/locks.

    The pid there is whoever took the lock, which for flock(1) on an inherited descriptor is a
    process that has already exited, and on btrfs the device differs from stat()'s. So this gives
    only candidates; holds_flock() confirms one.
    """
    inodes = set()
    try:
        with open("/proc/locks") as f:
            for line in f:
                parts = line.split()
                # "3: FLOCK  ADVISORY  WRITE 2234 00:56:67 0 EOF"; waiters read "3: -> FLOCK ...".
                if len(parts) >= 6 and parts[1] == "FLOCK":
                    try:
                        inodes.add(int(parts[5].rsplit(":", 1)[1]))
                    except (ValueError, IndexError):
                        continue
    except OSError:
        pass
    return inodes


def holds_flock(pid: int, path: str, inode: int) -> bool:
    """Whether `pid` holds the flock on `path`.

    A waiter has the file open too, so this looks for a descriptor of that file whose open file
    description carries the lock: the kernel lists the lock in that descriptor's fdinfo. It uses
    readlink, not stat, so a descriptor on a hung filesystem can't block it.
    """
    try:
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return False
    for fd in fds:
        try:
            if os.readlink(f"/proc/{pid}/fd/{fd}") != path:
                continue
            with open(f"/proc/{pid}/fdinfo/{fd}") as f:
                for line in f:
                    if line.startswith("lock:") and "FLOCK" in line and "->" not in line \
                            and line.split()[-3].endswith(f":{inode}"):
                        return True
        except (OSError, IndexError):
            continue
    return False


def fifo_in_use(cgroup: str, path: str | None) -> bool:
    """Whether a process of the build (other than its supervisor's own copy) has its jobserver
    FIFO open: a tool that opened it speaks the protocol, even before it takes a token."""
    if not path:
        return False
    try:
        with open(os.path.join(cgroup, "cgroup.procs")) as f:
            pids = [int(x) for x in f.read().split()]
    except (OSError, ValueError):
        return False
    users = 0
    for pid in pids:
        try:
            for fd in os.listdir(f"/proc/{pid}/fd"):
                try:
                    if os.readlink(f"/proc/{pid}/fd/{fd}") == path:
                        users += 1
                        break
                except OSError:
                    continue
        except OSError:
            continue
    return users > 1  # the supervisor holds it open for the whole build


PENDING = object()  # a query run off the event loop whose answer isn't in yet


class InlineExecutor:
    """Runs each query at once, on the caller's thread (tests)."""

    def submit(self, fn, *args) -> Future:
        future: Future = Future()
        try:
            future.set_result(fn(*args))
        except BaseException as e:  # (as a pool's future would hold it)
            future.set_exception(e)
        return future

    def shutdown(self, wait: bool = True, cancel_futures: bool = False) -> None:
        pass


MAKE_FLAG_VARS = ("MAKEFLAGS", "CARGO_MAKEFLAGS", "MFLAGS")
FD_JOBSERVER = re.compile(r"--jobserver-(?:auth|fds)=-?\d+,-?\d+")
# A word of make flags as make splits them: whitespace ends a word unless a backslash escapes it (a
# directory with a space in it is written `-Ia\ b`), and a backslash escapes the character after it.
MAKE_WORD = re.compile(r"(?:\\[\s\S]?|[^ \t\\])+")  # (only spaces and tabs split: a newline is in a word)
# Options whose argument may be the next word: that word is an argument, not an option.
MAKE_ARG_OPTIONS = frozenset({"-C", "-f", "-I", "-o", "-W", "-l", "--directory", "--file", "--makefile",
                              "--include-dir", "--old-file", "--assume-old", "--what-if", "--new-file",
                              "--assume-new", "--load-average", "--max-load"})


def make_words(flags: str) -> list[str]:
    """Make flags split into words as make splits them (MAKE_WORD), each kept exactly as written: a
    backslash keeps the next character (or, last, itself) in the word."""
    return MAKE_WORD.findall(flags)


def make_options(words: list[str]) -> list[str]:
    """The words that are options (not an option's separate argument, `-I DIR`), with make's
    backslash escapes taken out, as make reads them."""
    out, argument = [], False
    for w in words:
        plain = re.sub(r"\\(.)", r"\1", w, flags=re.S)
        if not argument:
            out.append(plain)
        argument = plain in MAKE_ARG_OPTIONS
    return out


def callers_jobs(options: str) -> bool:
    """Make options that set the job count or a jobserver of the caller's own (#37: whole options,
    not a word inside an option's argument)."""
    return any(w.startswith("-j") or w.startswith(("--jobs", "--jobserver"))
               for w in make_options(make_words(options)))


def split_make_flags(flags: str) -> tuple[str, str | None]:
    """Make flags split at their first `--`: the options before it, and the variable assignments
    after it, kept exactly as written (escaped spaces and all), or None if there is no `--`. A `--`
    after an escaped space (an odd number of backslashes before it) is part of a value, not the split."""
    for m in re.finditer(r"(?:^|[ \t])--(?=[ \t]|$)", flags):
        before = flags[:m.start()]
        if (len(before) - len(before.rstrip("\\"))) % 2 == 0:
            return before, flags[m.end() + 1:]
    return flags, None


def without_fd_jobserver(flags: str) -> str | None:
    """The make flags without an inherited jobserver passed by file descriptor
    (--jobserver-auth=R,W, or the older --jobserver-fds=R,W) and the -j that came with it, or None
    if they have none (#4). Those descriptors belong to the make that ran the caller and don't reach
    the build's service: make would warn and run serially, so the build gets buildq's jobserver
    instead. A fifo jobserver (fifo:PATH) can still be opened there, so it is left alone. Only the
    options before a `--` are looked at; the assignments after it are kept as they are."""
    options, assignments = split_make_flags(flags)
    words = make_words(options)  # (an escaped space or tab stays in its word, as written: #37)
    if not any(FD_JOBSERVER.fullmatch(w) for w in words):
        return None
    kept, drop_number = [], False
    for w in words:
        if FD_JOBSERVER.fullmatch(w) or re.fullmatch(r"-j\d*", w):
            drop_number = w == "-j"  # `-j 8`: its count goes with it
            continue
        if drop_number and w.isdigit():
            drop_number = False
            continue
        drop_number = False
        kept.append(w)
    kept = " ".join(kept)
    return kept if assignments is None else f"{kept} -- {assignments}".lstrip()


def with_make_flags(flags: str, more: str) -> str:
    """Make flags with more options added: before a `--` and the variable assignments after it
    (kept exactly as written), or make would take the options for targets."""
    options, assignments = split_make_flags(flags)
    words = make_words(options)
    if words and (len(words[-1]) - len(words[-1].rstrip("\\"))) % 2:
        words[-1] += "\\"  # a lone backslash at the end (`-Ia\` is the folder `a\`) mustn't escape what comes next
    head = " ".join(words + make_words(more))  # (an escaped trailing space stays: #37)
    return head if assignments is None else f"{head} -- {assignments}".lstrip()


def fs_device(path: str) -> int | None:
    """The device of the filesystem path is on, or None if it can't be read."""
    try:
        return os.stat(path).st_dev
    except OSError:
        return None


def reset_failed_unit(unit: str | None) -> bool:
    """Unload a failed service of that name, so a launch can use the name again."""
    try:
        subprocess.run(["systemctl", "--user", "reset-failed", unit or "-"], stdin=DEVNULL,
                       stdout=DEVNULL, stderr=DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass
    return True


def configured_memory_max(slice_name: str) -> str | None:
    """The MemoryMax systemd has for the slice, in bytes ("max" for none), or None if it can't say."""
    try:
        out = subprocess.run(["systemctl", "--user", "show", "-p", "MemoryMax", "--value", slice_name],
                             stdin=DEVNULL, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    if out == "infinity":
        return "max"
    return out if out.isdigit() else None


def find_gh() -> str:
    """gh, from PATH or from where a user install puts it: a systemd user service's PATH is often
    just /usr/local/bin:/usr/bin, without ~/.local/bin."""
    found = shutil.which("gh")
    if found:
        return found
    for where in ("~/.local/bin/gh", "~/bin/gh"):
        path = os.path.expanduser(where)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return "gh"


def find_flock_holder(path: str, inode: int) -> int | None:
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            if os.stat(f"/proc/{entry}").st_uid != UID:
                continue
        except OSError:
            continue
        if holds_flock(int(entry), path, inode):
            return int(entry)
    return None


# --------------------------------------------------------------------------------------------
# Which command is this? The key that history is kept under, and the build's workspace.

WRAPPERS = {"nice", "ionice", "nohup", "setsid", "stdbuf", "time", "command", "exec", "chrt",
            "taskset", "sudo", "doas"}
VALUE_OPTIONS = {"-n", "-c", "-o", "-e", "-i", "-p", "-u", "-g", "-C"}
SHELLS = {"bash", "sh", "zsh", "dash", "ksh", "fish"}
INTERPRETERS = {"python", "python3", "node", "deno", "ruby", "perl", "bun"}
# Names restartable_scripts refuses: tools and wrappers, not scripts (listing `git` would make `git
# push` restartable).
NOT_SCRIPTS = (SHELLS | INTERPRETERS | WRAPPERS | {"env", "timeout", "git", "cargo", "rustc", "dotnet", "make",
                                                    "gmake", "ninja", "cmake", "docker", "podman", "buildah",
                                                    "npm", "pnpm", "yarn", "npx", "pnpx", "bunx", "kubectl", "aws",
                                                    "gh", "ssh", "scp", "rsync", "curl", "wget", "xargs",
                                                    "parallel", "busybox", "uv", "uvx", "just", "mvn", "gradle",
                                                    "gradlew", "go", "terraform", "pytest", "jest", "sbt",
                                                    "heavy-run", "buildq", "flock", "systemd-run", "run0", "pkexec",
                                                    "nix-shell", "firejail", "xvfb-run", "strace", "valgrind", "tsx",
                                                    "ts-node", "zx", "pwsh", "nodejs"})
# (and any versioned interpreter or shell: python2, python3.12, pypy3, node22, bash5 …; the list can't
# be complete)
NOT_SCRIPT_PATTERN = re.compile(r"(python|pypy|node|ruby|perl|php|lua|bash|zsh|ksh|dash|sh|fish)[0-9.]*")
JS_TOOLS = {"npm", "pnpm", "yarn", "npx", "pnpx", "bunx"}
CARGO_VALUE_OPTIONS = {"--manifest-path", "--target-dir", "-j", "--jobs", "--color", "--config",
                       "-Z", "--profile", "--target", "-F", "--features", "--bin", "--test",
                       "--example", "--bench", "-p", "--package", "--exclude", "--message-format"}
JS_VALUE_OPTIONS = {"-C", "--dir", "--prefix", "--filter", "-F", "--workspace", "--cwd"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
JOBSERVER_TOOLS = {"cargo", "make", "gmake", "ninja"}
SAFE_WORD = re.compile(r"^@?[A-Za-z0-9_.,+:%/-]{1,64}$")  # "@scope/pkg" is an npm package, not an address


def env_command(args: list[str]) -> list[str] | None:
    """What `env ARGS` runs, read as GNU env reads it: its options first (up to `--` or the first
    word that isn't one), then assignments (any word with "="), then the command. Only options whose
    reading is exact are read: -i, -0, -v (grouped too), --ignore-environment, --null, --debug, a lone
    `-`, and -u/-C with their value apart or attached (-uX, --unset=, --chdir=). None for any other
    (grouped with a value, abbreviated, -a, -S/--split-string, even with "=" in it): the command can't
    be told for certain."""
    rest = list(args)
    while rest and rest[0].startswith("-") and rest[0] != "-":
        option = rest.pop(0)
        if option == "--":
            break
        if option in ("--ignore-environment", "--null", "--debug") or re.fullmatch(r"-[i0v]+", option):
            continue
        if option in ("-u", "--unset", "-C", "--chdir") and rest:
            rest.pop(0)  # its value, written apart
            continue
        if re.fullmatch(r"(-u|-C).+|(--unset|--chdir)=.*", option):
            continue  # its value, written with it (an empty one fails, or a later -C wins: the command is the same)
        return None
    if rest[:1] == ["-"]:  # (env - …: the same as -i)
        rest = rest[1:]
    while rest and "=" in rest[0]:  # GNU env takes any word with "=" for an assignment
        rest = rest[1:]
    return rest


def strip_wrappers(argv: list[str]) -> list[str]:
    t = list(argv)
    while t:
        head = os.path.basename(t[0])
        if ASSIGNMENT.match(t[0]):
            t = t[1:]
        elif head == "env":
            rest = env_command(t[1:])
            if rest is None:
                return t  # env's command can't be told for certain: leave env as the command, unread
            t = rest
        elif head == "timeout":
            t = t[1:]
            while t and t[0].startswith("-"):
                option = t.pop(0)
                if option in ("-s", "-k", "--signal", "--kill-after") and t:
                    t.pop(0)
            t = t[1:]  # the duration
        elif head in WRAPPERS:
            t = t[1:]
            while t and t[0].startswith("-"):
                option = t.pop(0)
                if option in VALUE_OPTIONS and t:
                    t.pop(0)
            if head in ("taskset", "chrt"):
                while t and re.fullmatch(r"[0-9a-fA-Fx,\-]+", t[0]):
                    t.pop(0)
        else:
            break
    return t


def positionals(args: list[str], value_options: set[str] = frozenset()) -> list[str]:
    out, skip = [], False
    for arg in args:
        if skip:
            skip = False
        elif arg.startswith("-"):
            skip = arg in value_options
        else:
            out.append(arg)
    return out


def option_values(args: list[str], names: set[str]) -> list[str]:
    values = []
    for i, arg in enumerate(args):
        if arg in names:
            if i + 1 < len(args):
                values.append(args[i + 1])
            continue
        for name in names:
            if name.startswith("--") and arg.startswith(name + "="):
                values.append(arg[len(name) + 1:])
            elif len(name) == 2 and not arg.startswith("--") and arg.startswith(name) and len(arg) > 2:
                values.append(arg[2:])
    return values


def git_toplevel(cwd: str) -> str | None:
    d = os.path.abspath(cwd)
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def repo_name(cwd: str) -> str:
    """The name of the git repository that holds cwd, the same for every worktree of it."""
    top = git_toplevel(cwd)
    if top is None:
        return os.path.basename(os.path.abspath(cwd).rstrip("/")) or "/"
    dot_git = os.path.join(top, ".git")
    if os.path.isdir(dot_git):
        return os.path.basename(top) or "/"
    try:
        with open(dot_git) as f:
            gitdir = os.path.normpath(os.path.join(top, f.read().split("gitdir:", 1)[1].strip()))
        common = gitdir
        commondir = os.path.join(gitdir, "commondir")
        if os.path.isfile(commondir):
            with open(commondir) as f:
                common = os.path.normpath(os.path.join(gitdir, f.read().strip()))
        if os.path.basename(common) == ".git":
            return os.path.basename(os.path.dirname(common))
        return re.sub(r"\.git$", "", os.path.basename(common)) or os.path.basename(top)
    except (OSError, IndexError):
        return os.path.basename(top)


SCRIPT_WORD = re.compile(r"[a-z][a-z_-]{0,23}")


def command_words(argv: list[str], labels: "frozenset[str] | tuple" = ()) -> list[str]:
    t = strip_wrappers(argv)
    if "--" in t:
        t = t[: t.index("--")]
    if not t:
        return ["?"]
    # Nothing that could hold a credential reaches a key, not even through basename().
    t = [t[0]] + ["…" if re.search(r"://|^[^@\s/]+:[^@\s]*@|^[^-][^=]*=", a) else a for a in t[1:]]
    tool = os.path.basename(t[0])
    rest = t[1:]
    words = [tool]
    if tool == "cargo":
        if rest and rest[0].startswith("+"):
            rest = rest[1:]
        words += positionals(rest, CARGO_VALUE_OPTIONS)[:1]
        words += [f"-p {p}" for p in sorted(set(option_values(rest, {"-p", "--package"})))]
        words += [f"--profile {p}" for p in option_values(rest, {"--profile"})]
        words += [f for f in ("--release", "--workspace", "--all-targets", "--no-run", "--lib", "--doc")
                  if f in rest]
    elif tool in JS_TOOLS:
        words += [f"--filter {f}" for f in sorted(set(option_values(rest, {"--filter", "-F"})))]
        pos = positionals(rest, JS_VALUE_OPTIONS)
        if pos[:1] and pos[0] in ("run", "run-script", "exec", "x", "dlx"):
            pos = pos[1:]
        words += pos[:1]
    elif tool == "git":
        words += positionals(rest, {"-C", "-c", "--git-dir", "--work-tree"})[:1]
    elif tool in SHELLS or re.fullmatch(r"python3(\.\d+)?", tool) or tool in INTERPRETERS:
        if rest[:1] and not rest[0].startswith("-") and os.path.basename(rest[0]) in labels:
            # A script named in script_labels takes a label as the argument right after it, naming
            # what it runs (`persistent-cargo-target.sh architecture …` and `… rust-tests …` are
            # different builds of different sizes). Only when the script comes straight after the
            # interpreter (`bash wrap.sh label`: not a command string, `-lc wrap.sh`, or an option's
            # value, `--require wrap.js`), whatever its own arguments are, and only a plain
            # lowercase word.
            words.append(os.path.basename(rest[0]))
            if rest[1:] and SCRIPT_WORD.fullmatch(rest[1]):
                words.append(rest[1])
        elif "-c" in rest:
            words.append("-c")
            i = rest.index("-c")
            if i + 1 < len(rest):
                script = [w for w in rest[i + 1].split() if not ASSIGNMENT.match(w)]
                words += [os.path.basename(w) for w in script[:2]]
        else:
            pos = positionals(rest, {"-m"} if "python" in tool else set())
            module = option_values(rest, {"-m"})[:1] if "python" in tool else []  # (only python has -m modules)
            words += [os.path.basename(p) for p in pos[:1]] + module
    elif tool in ("make", "gmake", "ninja"):
        words += [a for a in positionals(rest, {"-C", "-f", "-j", "-l", "-o", "-W"}) if "=" not in a][:2]
    else:
        words += [os.path.basename(p) for p in positionals(rest)[:2]]
    # Keys are logged and kept; nothing that could be a secret goes into one.
    return [w if all(SAFE_WORD.match(part) and not TOKEN_LIKE.match(part) for part in w.split(" ")) else "…"
            for w in words]


WRITING_FLAG = re.compile(r"--(fix|fix-type|write|bless|update|update-snapshots|updateSnapshot|watch|watchAll|"
                          r"allow-dirty|no-run)(=.*)?|-[uw]")
# Options that write a file the caller may read next (a report, coverage, test results): a reused
# pass wouldn't write it.
REPORT_OPTIONS = {"-o", "--output-file", "--outputFile", "--coverage", "--logger", "--results-directory",
                  "--collect", "--diag", "--junit", "--reporter-file"}
VERIFY_CARGO = {"check", "c", "clippy", "test", "t", "nextest"}
RESTART_CARGO = {"build", "b", "check", "c", "clippy", "test", "t", "doc", "d", "nextest", "bench"}


def _tool_and_args(argv: list[str]) -> tuple[str, list[str]]:
    args = strip_wrappers(argv)
    if args and os.path.basename(args[0]) in ("npx", "pnpx", "bunx"):
        args = [a for a in args[1:] if a not in ("-y", "--yes", "--no-install")]
    return (os.path.basename(args[0]) if args else ""), args[1:]


def reusable_check(argv: list[str]) -> bool:
    """A command whose only result is a verdict on the source: cargo check, clippy, test or nextest
    run, dotnet test, `tsc --noEmit`, eslint, `vitest run`, with nothing that writes (--fix, -u,
    --update-snapshots, watch modes, --no-run, which keeps the test binaries for later). A second
    pass on the same source tells nothing the first didn't, so the first answers it. Commands that
    produce files (builds, docs, bundles) and package scripts, which might do anything, never do."""
    tool, args = sure_tool_and_args(argv)  # (a wrapper with options: no tool, so no reuse)
    if any(WRITING_FLAG.fullmatch(a) or writes_report(a) for a in args):
        return False
    if any(a in ("--reporter", "--reporters") and writes_report(f"{a}={b}") for a, b in zip(args, args[1:])):
        return False  # `--reporter html`
    if tool == "dotnet" and any(re.match(r"-[ld](:|$)", a) or re.search(r"CollectCoverage", a) for a in args):
        return False  # dotnet test's short --logger and --diag, and coverage through MSBuild
    if tool == "cargo":
        words = command_words(["cargo", *args])
        sub = words[1] if len(words) > 1 else ""
        return sub in VERIFY_CARGO and (sub != "nextest" or "run" in args)
    if tool == "dotnet":
        return positionals(args)[:1] == ["test"]
    if tool in ("tsc", "vue-tsc"):
        return no_emit(args)
    if tool == "eslint":
        return True
    if tool == "vitest":
        return positionals(args)[:1] == ["run"]
    return False


def writes_report(arg: str) -> bool:
    """An option that writes a file a reused pass wouldn't: a report, coverage, test results,
    in any of its spellings (--logger:trx, --outputFile.junit=x, --coverage.enabled, --reporter=html)."""
    name = re.split(r"[=:.]", arg, maxsplit=1)[0]
    if name in REPORT_OPTIONS:
        return True
    return bool(re.fullmatch(r"--reporter(s)?[=:]?(html|junit|json|lcov|teamcity|blob).*", arg))


def no_emit(args: list[str]) -> bool:
    """Whether tsc's --noEmit is in effect at the end of its arguments (`--noEmit false` turns it off)."""
    on, i = False, 0
    while i < len(args):
        arg = args[i]
        if arg == "--noEmit":
            on = True
            if i + 1 < len(args) and args[i + 1] in ("true", "false"):
                on, i = args[i + 1] == "true", i + 1
        elif arg.startswith("--noEmit="):
            on = arg.split("=", 1)[1] == "true"
        i += 1
    return on


SURE_WRAPPERS = {"nice", "ionice", "nohup", "setsid", "stdbuf", "time", "command", "exec", "sudo", "doas"}


def sure_tool_and_args(argv: list[str]) -> tuple[str, list[str]]:
    """The tool and its arguments for a decision that must not be fooled (restart_safe,
    reusable_check): read with plainly, so a wrapper with options yields no tool at all ("", [])
    rather than a guess (`time -f eslint bash deploy.sh` runs deploy.sh, not eslint)."""
    t = plainly(argv)
    if not t:
        return "", []
    if os.path.basename(t[0]) in ("npx", "pnpx", "bunx"):
        t = [t[0]] + [a for a in t[1:] if a not in ("-y", "--yes", "--no-install")]
        return (os.path.basename(t[1]) if len(t) > 1 else ""), t[2:]
    return os.path.basename(t[0]), t[1:]


def plainly(argv: list[str]) -> list[str] | None:
    """The command, if it can be read for certain: past `env` (as env_command reads it),
    `timeout DURATION`, and the wrappers in SURE_WRAPPERS given no option, with the assignments
    `sudo` takes before its command. None for anything else: a wrapper's options might take a value
    that could be read as the command (`env -iu wrap.sh bash deploy.sh` runs deploy.sh), and a
    command is run, not read by a shell, so a word with "=" anywhere else is a program's path
    (`X=./deploy.sh cargo test` runs ./deploy.sh in the folder "X=.")."""
    t = list(argv)
    while t:
        head = os.path.basename(t[0])
        if "=" in t[0]:
            return None  # not an assignment here: a path, or sudo 'X-Y=./wrap.sh' (not one sudo takes)
        elif head == "env":
            t = env_command(t[1:])  # (options first, as env reads them: `--split-string=…` is one)
            if t is None:
                return None
        elif head == "timeout":
            if len(t) < 3 or t[1].startswith("-"):
                return None
            t = t[2:]
        elif head in SURE_WRAPPERS or head in WRAPPERS:
            if head not in SURE_WRAPPERS or (t[1:2] and t[1].startswith("-")):
                return None
            t = t[1:]
            if head == "sudo":
                while t and ASSIGNMENT.match(t[0]):  # sudo VAR=value … sets them for the command
                    t = t[1:]
        else:
            return t
    return None


def listed_script(argv: list[str], scripts) -> list[str] | bool | None:
    """For a script named in restartable_scripts, read for certain (plainly) and run directly or
    straight after its interpreter: True, or, if it runs the command after its `--` (a wrapper that
    sets up a target folder, say), that command, which decides. None if it isn't one. A `--`
    followed by an option (`run-tests.sh -- --nocapture`) passes arguments, not a command."""
    t = plainly(argv)
    if not t:
        return None
    tool, args = os.path.basename(t[0]), t[1:]
    if tool in scripts:
        script_args = args
    elif (tool in SHELLS or re.fullmatch(r"python3(\.\d+)?", tool) or tool in INTERPRETERS) and args[:1] \
            and not args[0].startswith("-") and os.path.basename(args[0]) in scripts:
        script_args = args[1:]
    else:
        return None
    if "--" in script_args:
        command = script_args[script_args.index("--") + 1:]
        if command and command[0].startswith("--") and command[0] != "--":
            return True  # its own long options (`run-tests.sh -- --nocapture`), not a command
        return command  # the command it runs (a short option or another `--` fails safe); empty: no
    return True


def restart_safe(argv: list[str], scripts: "frozenset[str] | tuple" = ()) -> bool:
    """A command that can be stopped and started again from the beginning without doing anything
    twice: a compile or a test run of cargo, dotnet, tsc, eslint or vitest, or a script named in
    restartable_scripts (see listed_script; a wrapper is only as safe as the command it runs). Any
    other script might upload or push before it compiles, so it is stopped and failed instead
    (unless --restartable)."""
    for _ in range(8):  # (a wrapper running a wrapper: at most this deep)
        inner = listed_script(argv, scripts) if scripts else None
        if inner is None:
            break
        if inner is True:
            return True
        if not inner:
            return False
        argv = inner
    else:
        return False
    tool, args = sure_tool_and_args(argv)
    if tool == "cargo":
        words = command_words(["cargo", *args])
        return (words[1] if len(words) > 1 else "") in RESTART_CARGO
    if tool == "dotnet":
        return positionals(args)[:1] in (["build"], ["test"])
    if tool == "ninja":  # a custom target (install, deploy) might do anything
        return set(positionals(args, {"-C", "-f", "-j", "-k", "-l", "-d", "-t", "-w"})) <= {"all", "test", "check"}
    return tool in ("tsc", "vue-tsc", "eslint", "vitest")


def paths_inside(argv: list[str], cwd: str, top: str) -> bool:
    """Every path the command names is inside the tree whose source was recorded: an argument (or
    an option's value) with a slash or starting with . or ~, and any that names something that
    exists (`-p external`, a symlink), resolved through links, from wrappers' options too. A value
    run on to a short option counts (`env -C../other`, `make -C../other`). A command pointed
    elsewhere (`--manifest-path ../other/Cargo.toml`) builds source the record doesn't cover."""
    root = os.path.realpath(top)
    for arg in argv[1:]:
        if arg.startswith("-") and "=" in arg:
            value = arg.split("=", 1)[1]
        elif re.match(r"-[A-Za-z0-9].", arg):
            value = arg[2:]  # -C../other: what it runs on to (-j8 and -Dwarnings are no paths)
        else:
            value = arg
        if not value or value.startswith("-") or re.match(r"[a-z][a-z0-9+.-]*://", value):
            continue  # an option, or a URL
        candidate = os.path.join(cwd, os.path.expanduser(value))
        looks = "/" in value or value.startswith((".", "~"))
        if not looks and not os.path.lexists(candidate):
            continue  # a word (a subcommand, a test name), not a path
        path = os.path.realpath(candidate)
        if path != root and not path.startswith(root + os.sep):
            return False
    return True


# Variables that differ between sessions, terminals or runs but not in what a build does. Anything
# else counts, secrets included (only a hash of the whole environment is kept).
# What git reads to see a tree as its user does: where its configuration and ignore files are.
GIT_ENV = re.compile(r"HOME|PATH|XDG_CONFIG_HOME|GIT_CONFIG(_GLOBAL|_SYSTEM|_NOSYSTEM|_COUNT|_KEY_\d+|_VALUE_\d+)?|"
                     r"GIT_DIR|GIT_WORK_TREE|GIT_COMMON_DIR|GIT_INDEX_FILE|GIT_CEILING_DIRECTORIES|"
                     r"GIT_DISCOVERY_ACROSS_FILESYSTEM|GIT_ATTR_NOSYSTEM|GIT_OBJECT_DIRECTORY|"
                     r"GIT_ALTERNATE_OBJECT_DIRECTORIES")

VOLATILE_ENV = re.compile(
    r"PWD|OLDPWD|SHLVL|_|COLUMNS|LINES|WINDOWID|STY|TMUX|TMUX_PANE|TERM_SESSION_ID|SSH_AUTH_SOCK|SSH_AGENT_PID|"
    r"SSH_CLIENT|SSH_CONNECTION|SSH_TTY|GPG_TTY|DBUS_SESSION_BUS_ADDRESS|XDG_SESSION_ID|XDG_ACTIVATION_TOKEN|"
    r"INVOCATION_ID|JOURNAL_STREAM|MANAGERPID|MANAGERPIDFDID|SYSTEMD_EXEC_PID|NOTIFY_SOCKET|LISTEN_(PID|FDS|FDNAMES)|"
    r"CLAUDE_PID|CLAUDE_CODE_(SESSION_ID|CHILD_SESSION|SESSION_ATTENDED|MESSAGING_SOCKET|MESSAGING_TOKEN)|"
    r"T3CODE_THREAD_ID|CODEX_(THREAD|SESSION)_ID|KITTY_WINDOW_ID|WEZTERM_PANE|VSCODE_GIT_IPC_HANDLE|"
    r"VSCODE_IPC_HOOK_CLI|BUILDQ_(AS|FALLBACK|SOURCE|CALLER|SOCKET|BIN)")


def env_digest(env: dict[str, str]) -> str:
    kept = sorted((k, v) for k, v in env.items() if not VOLATILE_ENV.fullmatch(k))
    return hashlib.sha256(json.dumps(kept).encode()).hexdigest()


def dedupe_key(source: dict, argv: list[str], cwd: str, lane: str, env: dict[str, str], settings: list) -> str:
    """The same command, on the same source, in the same directory, lane, environment and settings
    (its timeout, umask, limits, given cores and memory, and the daemon's own [env])."""
    parts = [source.get("commit"), source.get("fingerprint"), argv, os.path.realpath(cwd), lane, env_digest(env),
             settings]
    return hashlib.sha256(json.dumps(parts, sort_keys=True, default=str).encode()).hexdigest()


def sane_source(raw) -> dict | None:
    """The client's record of the source a build is of, if it is well formed."""
    if not isinstance(raw, dict):
        return None
    commit, fingerprint, repo = raw.get("commit"), raw.get("fingerprint"), raw.get("repo")
    if not (isinstance(commit, str) and re.fullmatch(r"[0-9a-f]{40}([0-9a-f]{24})?", commit)):
        return None
    if not (isinstance(fingerprint, str) and re.fullmatch(r"[0-9a-f]{16,64}", fingerprint)):
        return None
    remote = raw.get("remote")
    if not (isinstance(remote, str) and re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", remote)):
        remote = None
    return {"repo": repo if isinstance(repo, str) and os.path.isabs(repo) else None, "commit": commit,
            "dirty": bool(raw.get("dirty")), "fingerprint": fingerprint, "remote": remote}


def valid_post(post) -> bool:
    return (isinstance(post, dict) and all(isinstance(post.get(k), str) for k in ("repo", "sha", "state", "context",
                                                                             "description"))
            and all(isinstance(post.get(k), (int, float)) for k in ("first", "next")))


def sane_caller(raw) -> str | None:
    """Who submitted a build: the unit (a session's scope, a CI runner's service) its client ran in."""
    if isinstance(raw, str) and 0 < len(raw) <= 200 and raw.isprintable():
        return raw
    return None


def cgroup_freeze_set(path: str) -> bool | None:
    """Whether this cgroup itself is set frozen (its own cgroup.freeze), whatever its parents are.
    cgroup.events says whether it is frozen in effect, which a frozen parent also makes it."""
    try:
        with open(os.path.join(path, "cgroup.freeze")) as f:
            return f.read().strip() == "1"
    except (OSError, ValueError):
        return None


def parent_freeze_set(path: str) -> bool:
    """Whether the cgroup's parent (its slice) is set frozen: someone froze buildq.slice, say."""
    return bool(cgroup_freeze_set(os.path.dirname(path.rstrip("/"))))


def cgroup_frozen(path: str) -> bool | None:
    try:
        with open(os.path.join(path, "cgroup.events")) as f:
            for line in f:
                name, _, value = line.partition(" ")
                if name == "frozen":
                    return value.strip() == "1"
    except OSError:
        pass
    return None


def command_key(argv: list[str], cwd: str, lane: str, labels: "frozenset[str] | tuple" = ()) -> str:
    return f"{repo_name(cwd)}|{lane}|{' '.join(command_words(argv, labels))}"


def workspace_of(cwd: str, env: dict) -> str:
    """What a build writes to, so two builds that would fight over it run one at a time: its
    CARGO_TARGET_DIR if it has one, else its git worktree, else its directory."""
    target = env.get("CARGO_TARGET_DIR")
    if target:
        return "target:" + os.path.realpath(os.path.join(cwd, target))
    top = git_toplevel(cwd)
    if top in (None, "/", os.path.expanduser("~")):  # a dotfiles repo isn't a workspace
        top = cwd
    return "tree:" + os.path.realpath(top)


def within_home(path: str) -> str | None:
    """`path` resolved, if it lies inside the user's home (not home itself); else None. The
    folders `buildq top` measures are kept to these."""
    home = os.path.realpath(os.path.expanduser("~"))
    real = os.path.realpath(path)
    return real if real.startswith(home + os.sep) else None


def write_dirs_of(cwd: str, env: dict, argv: list[str]) -> list[str]:
    """Where a build fills the disk, for `buildq top`: its CARGO_TARGET_DIR (for cargo with none,
    the target/ beside the nearest Cargo.lock) and its TMPDIR, in the environment it runs with.
    Only folders inside the user's home count, and none inside another."""
    found = []
    target = env.get("CARGO_TARGET_DIR")
    if target:
        found.append(os.path.join(cwd, target))
    elif command_words(argv)[:1] == ["cargo"]:
        here = os.path.abspath(cwd)
        for _ in range(12):
            if os.path.exists(os.path.join(here, "Cargo.lock")):
                found.append(os.path.join(here, "target"))
                break
            if os.path.dirname(here) == here:
                break
            here = os.path.dirname(here)
    if env.get("TMPDIR"):
        found.append(os.path.join(cwd, env["TMPDIR"]))
    kept: list[str] = []
    for real in sorted({r for r in map(within_home, found) if r}, key=len):
        if not any(real == k or real.startswith(k + os.sep) for k in kept):
            kept.append(real)
    return kept


def disk_paths_of(cwd: str, env: dict) -> list[str]:
    """Where a build writes: its directory, its CARGO_TARGET_DIR and its TMPDIR, as far as they
    exist (or their nearest existing parent), each filesystem once."""
    paths, devices = [], set()
    for raw in (cwd, env.get("CARGO_TARGET_DIR"), env.get("TMPDIR")):
        if not raw:
            continue
        path = os.path.abspath(os.path.join(cwd, raw))
        while not os.path.exists(path) and os.path.dirname(path) != path:
            path = os.path.dirname(path)
        try:
            dev = os.stat(path).st_dev
        except OSError:
            continue
        if dev not in devices:
            devices.add(dev)
            paths.append(path)
    return paths


def asks_for_jobs(args: list[str]) -> bool:
    return any(a == "-j" or re.fullmatch(r"-j\d+", a) or a == "--jobs" or a.startswith("--jobs=") for a in args)


def without_jobs(argv: list[str]) -> list[str]:
    """argv with make's or ninja's -j/--jobs options removed, so the build's jobserver decides."""
    out, skip = [], False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a in ("-j", "--jobs"):
            skip = i + 1 < len(argv) and argv[i + 1].isdigit()
            continue
        if re.fullmatch(r"-j\d+", a) or a.startswith("--jobs="):
            continue
        out.append(a)
    return out


def cargo_cold(argv: list[str], cwd: str, env: dict) -> bool:
    """Whether a cargo command will build from scratch: its target directory has no build of that
    profile yet. History of warm builds says little about a cold one."""
    t = strip_wrappers(argv)
    if not t or os.path.basename(t[0]) != "cargo":
        return False
    target = env.get("CARGO_TARGET_DIR")
    if target:
        target = os.path.join(cwd, target)
    else:
        d = os.path.abspath(cwd)
        root = None
        while True:
            if os.path.exists(os.path.join(d, "Cargo.lock")):
                root = d
                break
            if os.path.exists(os.path.join(d, "Cargo.toml")):
                root = root or d
            parent = os.path.dirname(d)
            if parent == d:
                break
            d = parent
        if root is None:
            return False
        target = os.path.join(root, "target")
    profile = "release" if "--release" in t else "debug"
    profiles = option_values(t, {"--profile"})
    if profiles:
        profile = {"dev": "debug", "test": "debug", "bench": "release"}.get(profiles[0], profiles[0])
    return not os.path.isdir(os.path.join(target, profile))


SECRET_IN_URL = re.compile(r"(://[^/\s:@]+:)[^@\s/]+@")


SECRET_OPTION = re.compile(r"^(--?[A-Za-z0-9_-]*(?:key|token|secret|passw|pass|auth|cred)[A-Za-z0-9_-]*=).+$", re.I)
TOKEN_LIKE = re.compile(r"^(?:gh[pousr]_|github_pat_|sk-|xox[abpr]-|AKIA|glpat-)\S+$|^(?=.*[A-Za-z])(?=.*\d)[A-Za-z0-9+_=-]{32,}$")


def redacted_label(argv: list[str], limit: int = 300) -> str:
    """The command for display, with NAME=value assignments, secret-looking options and words, and
    passwords in URLs hidden."""
    shown = []
    for arg in argv:
        arg = re.sub(r"(^|\s)([A-Za-z_][A-Za-z0-9_]*)=\S*", r"\1\2=…", arg)
        arg = SECRET_OPTION.sub(r"\1…", arg)
        if TOKEN_LIKE.match(arg):
            arg = "…"
        shown.append(SECRET_IN_URL.sub(r"\1…@", arg))
    text = shlex.join(shown)
    return text if len(text) <= limit else text[: limit - 1] + "…"


# --------------------------------------------------------------------------------------------
# History of what each command used


class Estimate:
    def __init__(self, want: int, need: int, mem: int, source: str, rigid: bool, wall: float | None = None,
                 mem_cores: int = 1):
        self.want, self.need, self.mem, self.source, self.rigid, self.wall = want, need, mem, source, rigid, wall
        self.mem_cores = mem_cores  # the cores the build had when it needed `mem`


class History:
    KEEP = 100  # recent records per command
    PEAK_DAYS = 400  # each day's biggest run is kept this long, so a full rebuild isn't forgotten

    def __init__(self, path: str, max_keys: int = 2000):
        self.path = path
        self.max_keys = max_keys
        self.by_key: collections.OrderedDict[str, collections.deque] = collections.OrderedDict()
        self.peaks: dict[str, dict[int, dict]] = {}  # key -> day -> that day's biggest run
        self.lines = 0
        try:
            with open(path) as f:
                for line in f:
                    record = self.valid(line)
                    if record:
                        self._remember(record)
                    self.lines += 1
        except FileNotFoundError:
            pass
        if self.lines > self._bound():
            self.compact()

    @staticmethod
    def valid(line: str) -> dict | None:
        try:
            r = json.loads(line)
            if not isinstance(r, dict) or not isinstance(r.get("key"), str):
                return None
            r["peak_mem"] = int(r["peak_mem"])
            r["peak_cores"] = float(r["peak_cores"])
            r["t"] = float(r.get("t", 0))
            for name in ("wall", "granted", "avg_cores", "mem_cores", "peak_at", "tail", "peak_cpu"):
                if r.get(name) is not None:
                    r[name] = float(r[name])
                    if not math.isfinite(r[name]) or r[name] < 0:
                        return None
            if r["peak_mem"] < 0 or not math.isfinite(r["peak_cores"]):
                return None
            return r
        except (ValueError, KeyError, TypeError, OverflowError):
            return None

    def _remember(self, record: dict) -> None:
        key = record["key"]
        records = self.by_key.pop(key, None) or collections.deque(maxlen=self.KEEP)
        records.append(record)
        self.by_key[key] = records  # most recently used last
        day = int(record["t"] // 86400)
        peaks = self.peaks.setdefault(key, {})
        if day not in peaks or record["peak_mem"] > peaks[day]["peak_mem"]:
            peaks[day] = record
        for old in [d for d in peaks if d < day - self.PEAK_DAYS]:
            del peaks[old]
        while len(self.by_key) > self.max_keys:
            gone, _ = self.by_key.popitem(last=False)
            self.peaks.pop(gone, None)

    def _retained(self, key: str) -> list[dict]:
        recent = list(self.by_key.get(key, ()))
        seen = {id(r) for r in recent}
        return [r for r in self.peaks.get(key, {}).values() if id(r) not in seen] + recent

    def _bound(self) -> int:
        return 1000 + 2 * sum(len(self._retained(k)) for k in self.by_key)

    def add(self, record: dict) -> None:
        self._remember(record)
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(self.path, "a") as f:
            f.write(json.dumps(record, separators=(",", ":")) + "\n")
        self.lines += 1
        if self.lines > self._bound():
            self.compact()

    def compact(self) -> None:
        tmp = f"{self.path}.tmp"
        with open(tmp, "w") as f:
            for key in self.by_key:
                for record in sorted(self._retained(key), key=lambda r: r["t"]):
                    f.write(json.dumps(record, separators=(",", ":")) + "\n")
        os.replace(tmp, self.path)
        self.lines = sum(len(self._retained(k)) for k in self.by_key)

    @staticmethod
    def shaped(r: dict) -> bool:
        """A run that says when it peaked and what it used after: it succeeded, wasn't killed for
        memory, ran a minute or more, and its peak came before its last minute and last tenth."""
        return (r.get("exit") == 0 and not r.get("oom") and not r.get("mem_high") and r.get("peak_at") is not None
                and r.get("tail") is not None and r.get("peak_cpu") is not None and (r.get("wall") or 0) >= 60
                and r["wall"] - r["peak_at"] >= max(60.0, 0.1 * r["wall"]))

    def after_peak(self, key: str, cfg: Config, now: float, need: int = 3) -> tuple[float, float, int, int, float] | None:
        """For "past the peak": from the same runs the estimate reads (the last history_runs, and
        the biggest within history_days), the latest any of them peaked (seconds in), the most any
        used after its peak, the peak behind the estimate, and the cores that peak was measured
        with, and the most CPU-seconds any had used by its peak. None unless the run behind the
        estimate and `need` recent runs are `shaped`, no recent successful run peaked at its end
        (such a command's runs say nothing about after a peak), and no run in the window was killed
        for memory (the clearest sign that a later phase can be bigger). Failed runs teach nothing
        here either: a failure may have skipped a later, bigger phase."""
        cutoff = now - cfg.history_days * 86400
        recent = [r for r in self.by_key.get(key, ()) if r["t"] >= cutoff][-cfg.history_runs:]
        window = [r for r in self._retained(key) if r["t"] >= cutoff] or recent
        if not window:
            return None
        top = max(window, key=lambda r: r["peak_mem"])
        known = [r for r in recent if self.shaped(r)]
        ended_at_peak = [r for r in recent if r.get("exit") == 0 and not r.get("oom") and not self.shaped(r)
                         and r.get("peak_at") is not None and (r.get("wall") or 0) >= 60]
        if len(known) < need or not self.shaped(top) or ended_at_peak or any(r.get("oom") for r in window):
            return None
        runs = known + ([top] if all(r is not top for r in known) else [])
        cores = int(top.get("mem_cores") or top.get("granted") or 0)
        return (max(r["peak_at"] for r in runs), max(r["tail"] for r in runs), int(top["peak_mem"]), cores,
                max(r["peak_cpu"] for r in runs))

    def estimate(self, key: str, lane: Lane, cfg: Config, ncpu: int, cap_enforced: bool, cold: bool,
                 now: float) -> Estimate:
        """What the next run of a command needs.

        Memory: the largest peak of its recent runs (the last history_runs within history_days),
        with a margin. It is never lowered below a seen peak, except down to an enforced MemoryMax,
        which the build can't exceed anyway. A cold build counts at least as the lane default.

        Cores: a run that used nearly all the cores it was given ("saturated") could have used
        more, so the build wants half as many again; a run that left cores idle wants a little
        more than it used. A run that used far more cores than it was given doesn't follow the job
        count, so the build is "rigid": it needs what it uses, however many cores it is given.
        """
        cutoff = now - cfg.history_days * 86400
        recent = [r for r in self.by_key.get(key, ()) if r["t"] >= cutoff][-cfg.history_runs:]
        cap = lane.mem_cap if cap_enforced else None
        rigid = False
        walls = sorted(float(r["wall"]) for r in recent if r.get("wall") and r.get("exit") == 0) or \
            sorted(float(r["wall"]) for r in recent if r.get("wall"))
        wall = walls[len(walls) // 2] if walls else None  # the median time of its successful runs
        if not recent:
            want, mem, source = lane.cores, lane.mem, f"{lane.name} lane default"
            mem_cores = lane.cores
        else:
            # Memory: the biggest run within history_days, however many smaller ones came since.
            window = [r for r in self._retained(key) if r["t"] >= cutoff] or recent
            top = max(window, key=lambda r: r["peak_mem"])
            mem_cores = int(top.get("mem_cores") or top.get("granted") or lane.cores) or lane.cores
            peak = top["peak_mem"]
            if any(r.get("oom") for r in window):
                peak = max(peak, cap or int(peak * 1.5), lane.mem)
            mem = int(peak * cfg.mem_margin) + 256 * MIB
            wants = []
            for r in recent:
                used, given = r["peak_cores"], float(r.get("granted") or 0)
                sustained = float(r.get("avg_cores") or 0)
                if given and sustained > given * 1.2 + 0.5:  # not a burst: it ran wider than told
                    rigid = True
                    wants.append(used * 1.1)
                elif given and used >= given * 0.85:
                    wants.append(given * 1.5)
                else:
                    wants.append(used * 1.2)
            want = max(wants)
            source = f"largest of the last {len(recent)} run{'s' if len(recent) > 1 else ''}"
        if cold:
            if lane.mem > mem:
                mem, mem_cores = lane.mem, lane.cores
            want = max(want, lane.max_cores)
            source += ", cold build"
        mem = max(mem, lane.min_mem)
        if cap:
            mem = min(mem, cap)
        if rigid:
            # It uses what it uses; plan for that, but never for more than the lane allows or the
            # CPU target could ever cover, or it could never start.
            ceiling = max(1, math.floor(cfg.cpu_target * ncpu)) if lane.waits_for_cpu else ncpu
            want = min(max(1, math.ceil(want)), lane.max_cores, ceiling)
            need = want
            source += ", ignores the job count"
        else:
            want = min(max(lane.min_cores, math.ceil(want)), lane.max_cores)
            need = lane.min_cores
        return Estimate(want, need, mem, source, rigid, wall, max(1, mem_cores))


# --------------------------------------------------------------------------------------------
# Analytics: a small SQLite file of how the machine and the queue were doing, kept bounded


# The `minute` and `hour` tables share these columns: (name, SQL type, how a period rolls up).
# AVG is weighted by `sampled` (the seconds the daemon saw); WAVG:<column> is weighted by that
# column instead; SUM, MAX and MIN are what they say. wait_* are the builds waiting, by reason, on
# average, so wait_memory × sampled / 60 is build-minutes.
METRIC_COLUMNS = [
    ("sampled", "REAL", "SUM"),
    ("cores", "INTEGER", "MAX"), ("cpu_target", "REAL", "AVG"),
    ("cpu_busy", "REAL", "AVG"), ("cpu_busy_max", "REAL", "MAX"),
    ("mem_total", "INTEGER", "MAX"), ("mem_floor", "INTEGER", "AVG"),
    ("mem_available", "INTEGER", "AVG"), ("mem_available_min", "INTEGER", "MIN"),
    ("swap_used", "INTEGER", "AVG"), ("psi_cpu", "REAL", "AVG"), ("psi_mem", "REAL", "AVG"),
    ("running", "REAL", "AVG"), ("running_max", "INTEGER", "MAX"),
    ("queued", "REAL", "AVG"), ("queued_max", "INTEGER", "MAX"),
    ("reserved", "INTEGER", "AVG"),  # the running builds' expected peaks, together
    ("growth", "INTEGER", "AVG"),  # what is held for them to grow into
    ("free_mem", "INTEGER", "AVG"), ("free_mem_min", "INTEGER", "MIN"),  # room for new builds
    ("free_cpu", "REAL", "AVG"),
    ("wait_memory", "REAL", "AVG"), ("wait_cpu", "REAL", "AVG"), ("wait_held", "REAL", "AVG"),
    ("wait_turn", "REAL", "AVG"), ("wait_workspace", "REAL", "AVG"), ("wait_other", "REAL", "AVG"),
    # While at least one build waited on memory: for how long, and what sat idle or held meanwhile.
    ("mem_wait_seconds", "REAL", "SUM"),
    ("idle_cores_mem_wait", "REAL", "WAVG:mem_wait_seconds"),  # cores under the CPU target
    ("free_mem_mem_wait", "INTEGER", "WAVG:mem_wait_seconds"),  # memory above the floor
    ("growth_mem_wait", "INTEGER", "WAVG:mem_wait_seconds"),  # held for running builds to grow into
    # Who used the machine: buildq's builds, CI runners, containers, the user's apps (sessions,
    # editors; CI runners in app.slice not counted twice), and the rest. Cores are averages.
    ("builds_cores", "REAL", "AVG"), ("builds_mem", "INTEGER", "AVG"),
    ("ci_cores", "REAL", "AVG"), ("ci_mem", "INTEGER", "AVG"),
    ("containers_cores", "REAL", "AVG"), ("containers_mem", "INTEGER", "AVG"),
    ("apps_cores", "REAL", "AVG"), ("apps_mem", "INTEGER", "AVG"),
    ("other_cores", "REAL", "AVG"),
]
WAIT_COLUMN = {"memory": "wait_memory", "memory-pressure": "wait_memory",
               "cpu": "wait_cpu", "cpu-pressure": "wait_cpu", "held": "wait_held", "max-jobs": "wait_turn",
               "workspace": "wait_workspace"}  # anything else (too big, disk, paused, new): wait_other
WAIT_COLUMNS = ("wait_memory", "wait_cpu", "wait_held", "wait_turn", "wait_workspace", "wait_other")
EXTREMES = {"cpu_busy": ("cpu_busy_max", max), "mem_available": ("mem_available_min", min),
            "running": ("running_max", max), "queued": ("queued_max", max), "free_mem": ("free_mem_min", min)}
BUILD_COLUMNS = [
    ("id", "TEXT PRIMARY KEY"), ("ended", "INTEGER"), ("submitted", "INTEGER"), ("key", "TEXT"),
    ("label", "TEXT"), ("name", "TEXT"), ("lane", "TEXT"), ("caller", "TEXT"), ("repo", "TEXT"),
    ("state", "TEXT"), ("exit", "INTEGER"), ("from_ci", "INTEGER"),
    ("wall", "REAL"), ("waited", "REAL"),
    ("waited_by", "TEXT"),  # JSON: seconds waited by reason (memory, cpu, held, max-jobs, ...)
    ("est_mem", "INTEGER"), ("est_src", "TEXT"),  # what was planned for it, and why
    ("mem_peak", "INTEGER"), ("peak_at", "REAL"),  # its peak, and how far into its run
    ("tail", "INTEGER"),  # the most it used from half a minute after its peak to its end
    ("profile", "TEXT"),  # JSON: its most memory in each tenth of its run, in MiB
    ("released", "INTEGER"),  # 1 if its reservation was let go after its peak
    ("release_at", "REAL"), ("release_hold", "INTEGER"),  # past the peak (also in shadow mode): when, what kept
    ("after_release_peak", "INTEGER"), ("release_revoked", "INTEGER"),  # the most it used after; taken back
    ("release_end", "REAL"),  # when that was (seconds in), if it was
    # Past the peak over all its attempts: how many were, how many then used more than would be kept
    # and by how much at most, the held room that would be freed (GB-hours), and how many can't say
    # (a daemon restart left them unwatched for a while).
    ("past_peak_attempts", "INTEGER"), ("past_peak_over", "INTEGER"), ("past_peak_most_over", "INTEGER"),
    ("past_peak_freed", "REAL"), ("past_peak_unknown", "INTEGER"), ("past_peak_released", "INTEGER"),
    ("observed_gap", "INTEGER"),  # picked up after a daemon restart
    ("cores_granted", "REAL"), ("avg_cores", "REAL"), ("peak_cores", "REAL"), ("cpu_seconds", "REAL"),
    ("requeues", "INTEGER"), ("paused", "REAL"), ("oom", "INTEGER"), ("mem_high", "INTEGER"),
    ("mem_wait", "REAL"),
    ("ci_stops", "INTEGER"),  # of its requeues, the times it was stopped to make room for a CI job's build
    ("attempt_wall", "REAL"),  # its last attempt's wall time, which its profile and avg_cores describe
    ("workspace", "TEXT"),  # what it wrote to (target folder or worktree): builds sharing one take turns
]
CI_UNITS = ("actions.runner.*", "gha-*", "*-runner-*", "gitlab-runner*")  # CI runner services, by unit name


def memory_profile(trace: list, wall: float, buckets: int = 10) -> list[int] | None:
    """The most memory a build used in each tenth of its run, in MiB, from (seconds in, bytes)."""
    if not trace or wall <= 0:
        return None
    out = [0] * buckets
    for at, mem in trace:
        i = min(buckets - 1, max(0, int(at / wall * buckets)))
        out[i] = max(out[i], int(mem) >> 20)
    return out


def rollup_sql(column: str, how: str) -> str:
    """How a period's value of a column comes from its minutes (see METRIC_COLUMNS)."""
    if how in ("SUM", "MAX", "MIN"):
        return f"{how}({column})"
    weight = how.partition(":")[2] or "sampled"
    return f"SUM({column} * {weight}) / NULLIF(SUM(CASE WHEN {column} IS NOT NULL THEN {weight} END), 0)"


class Consumers:
    """Who uses the machine, read from the cgroups once a minute: CPU since the last reading, and
    the memory each group needs now (as cgroup_stats counts it: not page cache)."""

    def __init__(self):
        self.manager = user_manager_cgroup()
        self.last: tuple[float, dict[str, int]] | None = None

    @staticmethod
    def children(path: str) -> list[str]:
        try:
            return sorted(os.listdir(path))
        except OSError:
            return []

    def groups(self, builds: str) -> dict[str, list[str]]:
        apps = os.path.join(self.manager, "app.slice")
        found = {"builds": [builds], "apps": [apps], "ci": [], "containers": []}
        for parent in (self.manager, apps):  # newer systemd puts user services in app.slice
            for name in self.children(parent):
                if name.endswith(".service") and any(fnmatch.fnmatch(name, p) for p in CI_UNITS):
                    found["ci"].append(os.path.join(parent, name))
        for name in self.children(os.path.join(self.manager, "user.slice")):
            if name.startswith("libpod-") and name.endswith(".scope"):
                found["containers"].append(os.path.join(self.manager, "user.slice", name))
        system = "/sys/fs/cgroup/system.slice"
        for name in self.children(system):
            if any(fnmatch.fnmatch(name, p) for p in CI_UNITS) and name.endswith(".service"):
                found["ci"].append(os.path.join(system, name))
            elif (name.startswith("docker-") and name.endswith(".scope")) or name in ("docker.service",
                                                                                      "containerd.service"):
                found["containers"].append(os.path.join(system, name))
        return found

    def read(self, builds: str, busy: float) -> dict:
        now = time.monotonic()
        usages: dict[str, int] = {}
        found = self.groups(builds)
        apps = found["apps"][0]
        totals: dict[str, list] = {}
        inside_apps = [0, 0.0]  # CI runners within app.slice: taken off the apps' figures
        for group, paths in found.items():
            mem, cores = 0, 0.0
            for path in paths:
                stats = cgroup_stats(path)
                if stats is None:
                    if self.last is not None and path in self.last[1]:
                        usages[path] = self.last[1][path]  # unreadable this once: keep its baseline
                    continue
                usage, need, _ = stats
                usages[path] = usage
                share = 0.0
                if self.last is not None and now > self.last[0]:
                    # A cgroup not seen last time is new since, and one whose count went down was
                    # started again: either way, all its time is in this minute.
                    before = self.last[1].get(path, 0)
                    delta = usage - before if usage >= before else usage
                    share = min(delta / 1e6 / (now - self.last[0]), float(os.cpu_count() or 1))
                mem += need
                cores += share
                if group == "ci" and path.startswith(apps + os.sep):
                    inside_apps[0] += need
                    inside_apps[1] += share
            totals[group] = [mem, cores]
        totals["apps"][0] = max(0, totals["apps"][0] - inside_apps[0])
        totals["apps"][1] = max(0.0, totals["apps"][1] - inside_apps[1])
        out: dict = {}
        for group, (mem, cores) in totals.items():
            out[f"{group}_mem"] = mem
            if self.last is not None:
                out[f"{group}_cores"] = round(cores, 3)
        if self.last is not None:
            out["other_cores"] = round(max(0.0, busy - sum(c for _, c in totals.values())), 3)
        self.last = (now, usages)
        return out


class Metrics:
    """The analytics file, metrics.db: one row a minute (kept MINUTE_DAYS), one an hour rolled up
    from them (HOUR_DAYS), and one per finished build (BUILD_DAYS, at most BUILD_ROWS). Rows past
    their age are deleted once an hour and SQLite reuses the space, so the file levels off. The
    daemon only adds up numbers it already has; a thread of its own writes the file and reads the
    cgroups, so the loop never waits on the disk. If the file can't be used, that is logged (at
    most once an hour) and the queue carries on without it."""

    MINUTE_DAYS, HOUR_DAYS, BUILD_DAYS, BUILD_ROWS = 14, 365, 180, 100_000
    WAL_LIMIT = 64 << 20  # the write-ahead log is cut back to this after a checkpoint
    WAL_MAX = 256 << 20  # past this (a reader holding it open), rows are dropped until it shrinks

    def __init__(self, path: str):
        self.path = path
        self.items: queue.Queue = queue.Queue(maxsize=10000)
        self.thread: threading.Thread | None = None
        self.lock = threading.Lock()
        self.stopping = False
        self.failed = False
        self.dropped = False
        self.complained_at = -1e18
        self.minute: int | None = None
        self.last: float | None = None
        self.seconds = 0.0
        self.sums: dict[str, float] = collections.defaultdict(float)
        self.extremes: dict[str, float] = {}
        self.builds_cgroup = ""

    def trouble(self, message: str) -> None:
        """Log a problem with the analytics, at most once an hour."""
        now = time.monotonic()
        if now - self.complained_at >= 3600:
            self.complained_at = now
            log(message, level=4)

    # ---- on the daemon's loop

    def observe(self, now: float, values: dict, builds_cgroup: str) -> None:
        """Add one tick's numbers to the minute; a new minute sends the last one to be written."""
        minute = int(now // 60) * 60
        self.builds_cgroup = builds_cgroup
        if self.minute is not None and minute != self.minute:
            self.emit(builds_cgroup)
        if minute != self.minute:
            self.minute, self.last, self.seconds = minute, None, 0.0
            self.sums.clear()
            self.extremes.clear()
        weight = 1.0 if self.last is None else min(max(now - self.last, 0.0), 5.0)
        self.last = now
        if weight <= 0:
            return
        self.seconds += weight
        for name, value in values.items():
            self.sums[name] += float(value) * weight
            if name in EXTREMES:
                column, pick = EXTREMES[name]
                self.extremes[column] = pick(self.extremes.get(column, value), value)
        if values.get("wait_memory", 0) > 0:
            self.sums["mem_wait_seconds"] += weight
            self.sums["@idle_cores_mem_wait"] += max(values["cpu_target"] - values["cpu_busy"], 0.0) * weight
            self.sums["@free_mem_mem_wait"] += max(values["mem_available"] - values["mem_floor"], 0) * weight
            self.sums["@growth_mem_wait"] += values["growth"] * weight

    def emit(self, builds_cgroup: str) -> None:
        if self.seconds <= 0 or self.minute is None:
            return
        types = {name: kind for name, kind, _ in METRIC_COLUMNS}
        row: dict = {"_kind": "minute", "t": self.minute, "sampled": round(self.seconds, 1),
                     "_builds": builds_cgroup}
        waited = self.sums.get("mem_wait_seconds", 0.0)
        for name, total in self.sums.items():
            if name.startswith("@"):
                column = name[1:]
                value = total / waited if waited else None
            elif name == "mem_wait_seconds":
                column, value = name, total
            else:
                column, value = name, total / self.seconds
            if value is not None:
                row[column] = int(value) if types.get(column) == "INTEGER" else round(value, 3)
        for column, value in self.extremes.items():
            row[column] = int(value) if types.get(column) == "INTEGER" else round(float(value), 3)
        self.put(row)

    def build(self, row: dict) -> None:
        self.put({"_kind": "build", **row})

    def put(self, item) -> None:
        if self.failed or self.stopping:
            return
        with self.lock:
            if self.thread is not None and not self.thread.is_alive():
                self.trouble("the analytics writer had stopped; starting it again")
                self.thread = None
            if self.thread is None:
                self.thread = threading.Thread(target=self.run, name="metrics", daemon=True)
                self.thread.start()
        try:
            self.items.put_nowait(item)
        except queue.Full:
            if not self.dropped:
                self.dropped = True
                self.trouble("the analytics writer is behind; dropping rows until it catches up")

    def flush(self, timeout: float = 5.0) -> bool:
        deadline = time.monotonic() + timeout
        while self.items.unfinished_tasks and time.monotonic() < deadline:
            time.sleep(0.01)
        return not self.items.unfinished_tasks

    def stop(self, timeout: float = 2.0) -> None:
        if not self.stopping and self.minute is not None and self.seconds > 0:
            self.emit(self.builds_cgroup)  # the minute so far
            self.minute = None
        with self.lock:
            self.stopping = True
            thread = self.thread
        if thread is not None and thread.is_alive():
            try:
                self.items.put(None, timeout=timeout)
            except queue.Full:
                pass
            thread.join(timeout)

    # ---- on its own thread

    def open(self):
        import sqlite3
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        new = not os.path.exists(self.path)
        db = sqlite3.connect(self.path, timeout=10, isolation_level=None)
        if new:
            db.execute("PRAGMA auto_vacuum = INCREMENTAL")  # freed pages go back to the disk
        db.execute("PRAGMA journal_mode = WAL")
        db.execute("PRAGMA synchronous = NORMAL")
        db.execute(f"PRAGMA journal_size_limit = {self.WAL_LIMIT}")
        for table in ("minute", "hour"):
            db.execute(f"CREATE TABLE IF NOT EXISTS {table} (t INTEGER PRIMARY KEY)")
            have = {row[1] for row in db.execute(f"PRAGMA table_info({table})")}
            for name, kind, _ in METRIC_COLUMNS:
                if name not in have:
                    db.execute(f"ALTER TABLE {table} ADD COLUMN {name} {kind}")
        db.execute("CREATE TABLE IF NOT EXISTS build (id TEXT PRIMARY KEY)")
        have = {row[1] for row in db.execute("PRAGMA table_info(build)")}
        for name, kind in BUILD_COLUMNS:
            if name not in have:
                db.execute(f"ALTER TABLE build ADD COLUMN {name} {kind.replace(' PRIMARY KEY', '')}")
        db.execute("CREATE INDEX IF NOT EXISTS build_ended ON build (ended)")
        db.execute("CREATE INDEX IF NOT EXISTS build_key ON build (key)")
        try:
            os.chmod(self.path, 0o600)
        except OSError:
            pass
        return db

    def wal_too_big(self, db) -> bool:
        """Checkpoint a write-ahead log that has grown, and say if it is still too big (a reader
        holds it open): rows are dropped until it shrinks, rather than the disk filling."""
        try:
            size = os.path.getsize(self.path + "-wal")
        except OSError:
            return False
        if size <= self.WAL_LIMIT:
            return False
        db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        try:
            size = os.path.getsize(self.path + "-wal")
        except OSError:
            return False
        if size > self.WAL_MAX:
            self.trouble(f"the analytics file's write-ahead log is {fmt_size(size)} and can't be cut back "
                         "(a reader holds it open); dropping rows until it shrinks")
            return True
        return False

    def run(self) -> None:
        import sqlite3
        try:
            db = self.open()
        except (sqlite3.Error, OSError) as e:
            self.trouble(f"can't open the analytics file {self.path}: {e}; the queue carries on without it")
            self.failed = True
            while True:  # let flush() and stop() see an empty queue
                item = self.items.get()
                self.items.task_done()
                if item is None:
                    return
        consumers = Consumers()
        cleaned = -1e18  # monotonic: when the rows were last rolled up and trimmed
        since: float | None = None  # the earliest minute written since then
        written = 0
        full = False
        while True:
            item = self.items.get()
            try:
                if item is None:
                    db.close()
                    return
                kind = item.pop("_kind")
                if written % 100 == 0:
                    full = self.wal_too_big(db)
                written += 1
                if kind == "minute":
                    builds = item.pop("_builds")
                    item.update(consumers.read(builds, float(item.get("cpu_busy") or 0.0)))
                    if not full:
                        names = [n for n in item if n == "t" or n in {c for c, _, _ in METRIC_COLUMNS}]
                        db.execute(f"INSERT OR REPLACE INTO minute ({', '.join(names)}) VALUES "
                                   f"({', '.join('?' * len(names))})", [item[n] for n in names])
                        since = min(since, float(item["t"])) if since is not None else float(item["t"])
                elif kind == "build" and not full:
                    names = [n for n, _ in BUILD_COLUMNS if n in item]
                    db.execute(f"INSERT OR REPLACE INTO build ({', '.join(names)}) VALUES "
                               f"({', '.join('?' * len(names))})", [item[n] for n in names])
                if time.monotonic() - cleaned >= 3600:
                    cleaned = time.monotonic()  # (a failure is tried again in an hour)
                    self.clean(db, time.time(), since)
                    since = None
                    full = self.wal_too_big(db)
                self.dropped = False
            except Exception as e:  # never let the writer die on a row
                self.trouble(f"can't write to the analytics file {self.path}: {e!r}")
            finally:
                self.items.task_done()

    def clean(self, db, now: float, since: float | None = None) -> None:
        """Roll the minutes up into hours (from the newest hour on, or the earliest minute written
        since the last time, so the hour still going and late minutes are rolled again), and delete
        rows past their age, keeping at most BUILD_ROWS builds. On an error, nothing is kept."""
        names = [n for n, _, _ in METRIC_COLUMNS]
        rolled = ", ".join(rollup_sql(n, how) for n, _, how in METRIC_COLUMNS)
        newest = db.execute("SELECT MAX(t) FROM hour").fetchone()[0]
        start = int(newest) if newest is not None else 0
        if since is not None:
            start = min(start, int(since // 3600) * 3600)
        db.execute("BEGIN")
        try:
            db.execute(f"INSERT OR REPLACE INTO hour (t, {', '.join(names)}) SELECT (t / 3600) * 3600, {rolled} "
                       "FROM minute WHERE t >= ? GROUP BY t / 3600", (start,))
            db.execute("DELETE FROM minute WHERE t < ?", (now - self.MINUTE_DAYS * 86400,))
            db.execute("DELETE FROM hour WHERE t < ?", (now - self.HOUR_DAYS * 86400,))
            db.execute("DELETE FROM build WHERE ended < ?", (now - self.BUILD_DAYS * 86400,))
            db.execute("DELETE FROM build WHERE id IN (SELECT id FROM build ORDER BY ended DESC "
                       "LIMIT -1 OFFSET ?)", (self.BUILD_ROWS,))
            db.execute("COMMIT")
        except BaseException:
            if db.in_transaction:
                db.execute("ROLLBACK")
            raise
        db.execute("PRAGMA incremental_vacuum").fetchall()  # (it frees a page per row it returns)


# --------------------------------------------------------------------------------------------
# A jobserver of its own for each build: a FIFO of tokens, one per core beyond the first


class Jobserver:
    """GNU make's jobserver protocol over a named pipe (`--jobserver-auth=fifo:PATH`), which make
    4.4, cargo and ninja 1.13 understand. Each byte in the pipe is a token: a client reads one
    before starting another process and writes it back when that process ends. The daemon puts
    tokens in to grow a build and takes free ones out to shrink it."""

    def __init__(self, path: str, create: bool, out: int = 0):
        self.path = path
        if create:
            os.mkfifo(path, 0o600)
        self.fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
        self.out = out  # tokens the daemon has put into circulation
        self.used = False

    def free(self) -> int:
        try:
            return struct.unpack("i", fcntl.ioctl(self.fd, termios.FIONREAD, b"\0\0\0\0"))[0]
        except OSError:
            return 0

    def resize(self, tokens: int) -> None:
        tokens = max(0, tokens)
        if tokens > self.out:
            try:
                self.out += os.write(self.fd, b"+" * (tokens - self.out))
            except BlockingIOError:
                pass
        elif tokens < self.out:
            try:
                taken = len(os.read(self.fd, self.out - tokens))
            except BlockingIOError:
                taken = 0
            self.out -= taken  # tokens in use come back later; the next resize takes them then

    def observe(self) -> None:
        if not self.used and self.free() < self.out:
            self.used = True  # something took a token: this build speaks the protocol

    def close(self) -> None:
        try:
            os.close(self.fd)
        except OSError:
            pass


# --------------------------------------------------------------------------------------------
# Running builds: as transient systemd services, or as plain processes


class SystemdRunner:
    """Each build is buildq-<ticket>.service in the configured slice, with its lane's properties."""

    name = "systemd"

    def __init__(self, cg_base: str):
        self.cg_base = cg_base

    def prepare(self, ticket, slice_name: str) -> None:
        """Name the build's service before it is started, so a daemon that stops in between can
        still find it."""
        # Each attempt of a build stopped to free memory gets a name of its own: the last one's
        # service may still be loaded while systemd lets it go.
        ticket.unit = f"buildq-{ticket.id}.service" if not ticket.requeues else f"buildq-{ticket.id}-r{ticket.requeues}.service"
        ticket.cg = os.path.join(self.cg_base, slice_path(slice_name), ticket.unit)

    def unit_state(self, ticket) -> str:
        """'pending' if systemd has the service or a job to start it, 'gone' if it has neither,
        'unknown' if systemd can't be asked."""
        try:
            out = subprocess.run(["systemctl", "--user", "show", "-p", "LoadState,ActiveState,Job", ticket.unit],
                                 stdin=DEVNULL, capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return "unknown"
        props = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
        if not props:
            return "unknown"
        if props.get("LoadState") == "loaded" and (props.get("Job") or props.get("ActiveState") in
                                                   ("active", "activating", "reloading", "deactivating")):
            return "pending"
        return "gone"

    def launch(self, ticket, lane: Lane, slice_name: str):
        self.prepare(ticket, slice_name)
        unit = ticket.unit
        properties = [f"--property={k}={v}" for k, v in lane.properties.items()]
        with open(os.path.join(ticket.dir, "launch.err"), "wb") as err:
            proc = subprocess.Popen(
                ["systemd-run", "--user", "--quiet", f"--unit={unit}", f"--slice={slice_name}",
                 "--property=KillMode=mixed", "--property=OOMPolicy=continue", "--property=TimeoutStopSec=60",
                 *properties, "--", sys.executable, SELF, "--supervise", ticket.dir],
                stdin=DEVNULL, stdout=DEVNULL, stderr=err)
        return proc, False  # running once systemd-run exits 0

    def alive(self, ticket) -> bool:
        return bool(ticket.cg) and cgroup_populated(ticket.cg)

    def result(self, ticket) -> str:
        """systemd's Result for the build's service: "success", "exit-code", "signal", "oom-kill" (the
        kernel or systemd-oomd stopped it for memory), ... or "" if systemd can't say."""
        try:
            out = subprocess.run(["systemctl", "--user", "show", "-p", "Result", "--value", ticket.unit],
                                 stdin=DEVNULL, capture_output=True, text=True, timeout=5).stdout
            return out.strip()
        except (OSError, subprocess.SubprocessError):
            return ""

    def cleanup(self, ticket):
        """Unload the build's service once its outcome is read (a failed one stays loaded until then)."""
        if not ticket.unit:
            return None
        return subprocess.Popen(["systemctl", "--user", "reset-failed", ticket.unit], stdin=DEVNULL,
                                stdout=DEVNULL, stderr=DEVNULL)

    can_freeze = True

    def freeze(self, ticket, frozen: bool):
        """Pause or resume the build's processes with the cgroup freezer: they stop where they are,
        keeping their memory but asking for no more, until thawed. Written to its cgroup.freeze at
        once (as cgroup.kill is), with `systemctl freeze`/`thaw` where that can't be written."""
        if ticket.cg:
            try:
                with open(os.path.join(ticket.cg, "cgroup.freeze"), "w") as f:
                    f.write("1" if frozen else "0")
                return None
            except OSError:
                pass
        if not ticket.unit:
            return None
        return subprocess.Popen(["systemctl", "--user", "freeze" if frozen else "thaw", ticket.unit], stdin=DEVNULL,
                                stdout=DEVNULL, stderr=DEVNULL)

    def stop(self, ticket, force: bool = False):
        if not ticket.unit:
            return None
        if force and ticket.cg:
            try:  # every process of the build, frozen ones too, at once (Linux 5.14+)
                with open(os.path.join(ticket.cg, "cgroup.kill"), "w") as f:
                    f.write("1")
                return None
            except OSError:
                pass
        command = ["systemctl", "--user", "kill", "--signal=SIGKILL", ticket.unit] if force else \
                  ["systemctl", "--user", "stop", "--no-block", ticket.unit]
        return subprocess.Popen(command, stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL)

    @staticmethod
    def check_lane(lane: Lane) -> str | None:
        """Whether systemd accepts the lane's properties; the error if it doesn't."""
        if not lane.properties:
            return None
        try:
            # A transient service, as builds run, so service-only properties are checked too.
            probe = subprocess.run(["systemd-run", "--user", "--wait", "--quiet", "--collect",
                                    *[f"--property={k}={v}" for k, v in lane.properties.items()], "true"],
                                   stdin=DEVNULL, stdout=DEVNULL, stderr=subprocess.PIPE, timeout=30)
        except (OSError, subprocess.SubprocessError) as e:
            return str(e)
        return None if probe.returncode == 0 else probe.stderr.decode(errors="replace").strip()[-300:]

    @staticmethod
    def available() -> bool:
        if not shutil.which("systemd-run") or not shutil.which("systemctl"):
            return False
        try:
            return subprocess.run(["systemctl", "--user", "show-environment"], stdin=DEVNULL, stdout=DEVNULL,
                                  stderr=DEVNULL, timeout=10).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False


class DirectRunner:
    """Each build's supervisor is a plain process in a session of its own: no limits, no measurement.
    What a build leaves behind is found by the BUILDQ_JOB in its environment and stopped."""

    name = "direct"

    def prepare(self, ticket, slice_name: str) -> None:
        pass

    def result(self, ticket) -> str:
        return ""

    def cleanup(self, ticket):
        return None

    def unit_state(self, ticket) -> str:
        sup = read_json(os.path.join(ticket.dir, "supervisor.json")) or {}
        if proc_alive(sup.get("pid"), sup.get("start")):
            ticket.pid, ticket.pid_start = sup["pid"], sup["start"]
            return "pending"
        return "gone"

    def launch(self, ticket, lane: Lane, slice_name: str):
        proc = subprocess.Popen([sys.executable, SELF, "--supervise", ticket.dir], stdin=DEVNULL, stdout=DEVNULL,
                                stderr=DEVNULL, start_new_session=True)
        ticket.pid = proc.pid
        ident = proc_identity(proc.pid)
        ticket.pid_start = ident[0] if ident else None
        return proc, True

    def alive(self, ticket) -> bool:
        if proc_alive(ticket.pid, ticket.pid_start):
            return True
        return bool(tagged_processes(ticket.id))  # the supervisor is gone; is anything of the build left?

    can_freeze = False  # no cgroup of its own to freeze

    def freeze(self, ticket, frozen: bool):
        return None

    def stop(self, ticket, force: bool = False):
        if proc_alive(ticket.pid, ticket.pid_start):
            try:
                os.kill(ticket.pid, signal.SIGKILL if force else signal.SIGTERM)
            except OSError:
                pass
        if force or not proc_alive(ticket.pid, ticket.pid_start):
            for pid in tagged_processes(ticket.id):
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
        return None

    @staticmethod
    def check_lane(lane: Lane) -> str | None:
        return None


# --------------------------------------------------------------------------------------------
# Tickets

_seq = itertools.count()


class Conn:
    """One client connection; sends newline-delimited JSON."""

    def __init__(self, writer):
        self.writer = writer
        self.closed = False
        self.submission = None  # the submission a `buildq run` on this connection made or joined

    def send(self, message: dict) -> bool:
        if self.closed or self.writer is None or self.writer.is_closing():
            self.closed = True
            return False
        try:
            self.writer.write((json.dumps(message) + "\n").encode())
            return True
        except Exception:
            self.closed = True
            return False


class Ticket:
    PERSIST = ("id", "name", "argv", "cwd", "lane", "key", "label", "notify", "submitted", "priority", "timeout",
               "workspace", "disk_paths", "submission", "attached", "grant_area", "rlimits", "umask", "exec_argv", "cold", "cores_given", "mem_given", "state", "started", "ended", "exit", "oom",
               "timed_out", "error", "unit", "cg", "runner", "pid", "pid_start", "cancel_requested", "want",
               "need", "rigid", "est_mem", "mem_base", "mem_cores", "est_src", "peak_mem_cores", "granted", "max_granted", "jobserver", "tokens_out",
               "elastic", "max_log", "mem_peak", "peak_cores", "avg_cores", "measured", "mem_wait_some",
               "mem_wait_full", "mem_high", "source", "dedupe", "caller", "frozen", "frozen_at", "requeues",
               "requeue_pending", "shed_error", "restartable", "joiners", "answered", "interests", "followed",
               "extra_notify",
               "frozen_total", "frozen_attempt", "attempts_wall", "attempts_mem_wait", "attempts_peak", "attempts_cpu",
               "attempts_mem_high", "git_env", "freeze_failed", "freeze_asked", "thaw_failed",
               "source_verified", "source_changed", "attempt_offsets", "queued_at", "wait_total", "source_checks", "from_ci", "workspace_group", "group_lane",
               "waited_by", "wait_mark", "peak_at", "tail", "released", "release_at", "release_hold",
               "after_release_peak", "release_revoked", "observed_gap", "release_end", "peak_cpu",
               "past_peak_attempts", "past_peak_over", "past_peak_most_over", "past_peak_freed",
               "past_peak_unknown", "past_peak_released", "release_est", "release_oom_base", "release_breach",
               "release_open_at_gap", "write_dirs", "ci_stops", "yields_to", "yield_until")

    def __init__(self, tid: str, argv: list[str], cwd: str, lane: str, key: str, submitted: float,
                 directory: str | None):
        self.id = tid
        self.name = None
        self.argv = argv
        self.cwd = cwd
        self.lane = lane
        self.key = key
        self.label = redacted_label(argv)
        self.notify = None
        self.submitted = submitted
        self.priority = 0
        self.timeout = None
        self.workspace = None
        self.disk_paths: list[str] = []
        self.submission = None
        self.attached = False  # submitted by `buildq run`: cancelled once nobody follows it
        self.rlimits: dict = {}  # the submitter's soft limits, applied to the build
        self.umask = 0o022  # the submitter's, so its build writes files as the command run directly would
        self.exec_argv = None  # what actually runs, when it differs from argv
        self.grant_area = 0.0  # core-seconds given, for the time-weighted grant
        self.cold = False
        self.seq = next(_seq)
        self.dir = directory
        self.cores_given = None
        self.mem_given = None
        self.state = "queued"
        self.started = None
        self.ended = None
        self.exit = None
        self.oom = False
        self.timed_out = False
        self.error = None
        self.unit = None
        self.cg = None
        self.runner = None
        self.pid = None
        self.pid_start = None
        self.cancel_requested = False
        self.want = 1
        self.need = 1
        self.rigid = False
        self.expected = None  # seconds it usually takes, from history
        self.est_mem = 0
        self.mem_base = 0   # the memory estimate at mem_cores cores
        self.mem_cores = 1
        self.est_src = ""
        self.granted = 0
        self.max_granted = 0
        self.jobserver = None  # its FIFO's path
        self.tokens_out = 0
        self.elastic = False
        self.max_log = 0
        self.mem_peak = 0
        self.peak_mem_cores = 0
        self.peak_cores = 0.0
        self.avg_cores = 0.0
        self.measured = False
        self.mem_wait_some = 0.0  # seconds some of its tasks waited on memory (memory.pressure)
        self.mem_wait_full = 0.0  # seconds all of them did
        self.mem_high = 0  # times it went over its own MemoryHigh, where the kernel slows it
        self.source = None  # the commit it is of, and whether its tree had changes ({repo, commit, dirty, ...})
        self.dedupe = None  # same source, command, directory, lane and environment: the same build
        self.caller = None  # the unit its client ran in: a session, a CI runner
        self.from_ci = False  # submitted from a GitHub Actions job, which reports its own result
        # Its lane's workspace_group when it started, kept across reloads: "" for a non-exclusive
        # lane (no group); None when unknown (saved before groups were recorded).
        self.workspace_group: str | None = None
        self.group_lane: str | None = None  # the lane it started in: it also holds that lane's group as it is now
        self.waited_by: dict[str, float] = {}  # seconds queued, by the reason it waited
        self.wait_mark: float | None = None  # when that was last added up
        self.peak_at = 0.0  # seconds into this attempt when it reached mem_peak (time paused not counted)
        self.tail = 0  # the most it has used from half a minute after that peak on
        self.trace: list[list[float]] = []  # [seconds in, most memory] every TRACE_SECONDS, for its profile
        self.trace_merges = 1  # each point now covers this many TRACE_SECONDS
        self.released = False  # its reservation was let go after its peak (release_after_peak = true)
        # Past the peak, worked out in "shadow" mode too: when (seconds in) and what it would hold,
        # the most it used from then on, and whether it went past that and was taken back.
        self.release_at: float | None = None
        self.release_hold = 0
        self.after_release_peak = 0
        self.release_revoked = False
        self.release_end: float | None = None  # when it went past that (seconds in)
        self.peak_cpu = 0.0  # CPU-seconds this attempt had used when it reached mem_peak
        # The same over all attempts, kept across requeues: see close_release_audit.
        self.past_peak_attempts = self.past_peak_over = self.past_peak_most_over = self.past_peak_unknown = 0
        self.past_peak_freed = 0.0  # byte-seconds of held room it would have freed
        self.past_peak_released = 0  # attempts really released (mode true)
        self.release_est = 0  # its expected peak when the release was decided
        self.release_oom_base = 0  # its OOM kills then
        self.release_breach = False  # taken back because it went over its hold or was killed for memory
        self.kills_seen = 0  # OOM kills in its supervisor's result, wherever the limit was (not saved)
        self.kills_own_cap = False  # and whether one was at its own MemoryMax (not saved)
        self.release_open_at_gap = False  # its decision still stood when a daemon restart left it unwatched
        self.release_stood_at_load = False  # ... when this daemon loaded it (not saved)
        self.release_dirty = False  # measure() took its decision back: the daemon saves the ticket
        self.write_dirs: list[str] = []  # its CARGO_TARGET_DIR and TMPDIR, absolute: what it fills on disk
        self.settled_since: float | None = None  # it has looked past its peak since then
        self.swap_now = 0  # bytes of it in swap
        self.observed_gap = False  # picked up after a daemon restart: its peak may have been missed
        self.frozen = False  # paused to give the machine its memory back
        self.frozen_at = None
        self.requeues = 0  # times it was stopped to free memory and queued again
        self.ci_stops = 0  # of those, the times it was stopped to make room for a CI job's build
        self.yields_to: str | None = None  # the CI job's build it was last stopped for: it doesn't go before it
        self.yield_until: float | None = None  # ...for at most this long
        self.short_hm = 0.0  # (not kept) the room held ahead of it then, which it couldn't use
        self.short_agents = 0.0  # (not kept) of that, the room held for agents' builds (not CI jobs')
        self.short_by = 0.0  # (not kept) the memory it lacked when the queue was last looked at
        self.requeue_pending = False  # being stopped, to be queued again
        self.shed_error = None  # why it can't be queued again once stopped
        self.restartable = False  # its caller says it can start over from the beginning safely
        self.joiners = 0  # other submissions that joined it
        self.answered: dict[str, str] = {}  # other submissions it answered: id -> "joined" or "reused"
        self.interests: dict[str, str] = {}  # submissions waiting for it: id -> "run" (followed) or "submit"
        self.followed: dict[str, float] = {}  # a run submission -> when a client of it last followed
        self.frozen_total = 0.0  # seconds spent paused, over all its attempts
        self.frozen_attempt = 0.0  # seconds this attempt spent paused, the current pause not included
        self.attempts_cpu = 0.0  # CPU seconds of attempts stopped for memory
        self.attempts_mem_high = 0
        self.attempts_wall = 0.0  # run time, memory waits and peak of attempts stopped for memory
        self.attempts_mem_wait = 0.0
        self.attempts_peak = 0
        self.git_env: dict[str, str] = {}  # what git needs to see the tree as its submitter did
        self.extra_notify: list[str] = []  # joiners' --notify commands
        self.source_verified = None  # its source was the same at its start and end (None: not known yet)
        self.source_checks: dict = {}  # "start"/"end" -> whether the tree matched the record then
        self.source_changed = False  # it wasn't: it built something else than its record says
        self.attempt_offsets: dict = {}  # where the last attempt's output begins in stdout/stderr.log
        self.queued_at = None  # when it last joined the queue
        self.wait_total = 0.0  # time spent queued, over all its attempts
        self.freeze_asked = None  # (frozen?, when) of the last freezer request not yet seen to take
        self.force_sent = False  # SIGKILL sent: its memory is on its way back
        self.freeze_failed = False  # this attempt's freeze never took: don't try again (kept on disk)
        self.thaw_failed = False  # its thaw never took and it couldn't be stopped: don't ask again
        # Not kept on disk:
        self.env: dict | None = None  # its environment, to queue it again (gone after a restart)
        self.js: Jobserver | None = None
        self.launcher = None
        self.running_since = None
        self.result_seen = None
        self.last_watched = time.time()
        self.last_grant_t = None
        self.recheck_at = None
        self.stop_sent = None
        self.samples: collections.deque = collections.deque()
        self.cores_now = 0.0
        self.mem_now = 0
        self.cpu_usec = 0
        self.cpu_usec_base = None
        self.oom_base = 0
        self.oom_kills = 0
        self.flock = None  # (lock path, holder pid) for a build found holding a flock slot
        self.reason = ""
        self.reason_cat = ""
        self.held = False
        self.sent_cat = None
        self.sent_at = 0.0

    @property
    def log(self) -> str | None:
        return os.path.join(self.dir, "output.log") if self.dir else None

    @property
    def est_cores(self) -> float:
        return self.granted if self.state in ("starting", "running") and self.granted else self.need

    def record(self) -> dict:
        return {k: getattr(self, k) for k in self.PERSIST}

    @classmethod
    def from_record(cls, rec: dict, directory: str) -> "Ticket":
        t = cls(rec["id"], list(rec["argv"]), rec["cwd"], rec["lane"], rec["key"], float(rec["submitted"]), directory)
        for k in cls.PERSIST:
            if k in rec:
                setattr(t, k, rec[k])
        t.take_waits(0, 0, 0)  # numbers only, whatever the file said
        waited = t.waited_by if isinstance(t.waited_by, dict) else {}
        t.waited_by = {str(k): v for k, v in ((k, sane_count(v)) for k, v in waited.items()) if v is not None}
        t.peak_at = sane_count(t.peak_at) or 0.0
        t.tail = int(sane_count(t.tail) or 0)
        t.ci_stops = int(sane_count(t.ci_stops) or 0)
        t.yields_to = t.yields_to if isinstance(t.yields_to, str) else None
        t.yield_until = sane_count(t.yield_until)
        t.released = t.released is True
        t.release_at = sane_count(t.release_at)
        t.release_hold = int(sane_count(t.release_hold) or 0)
        t.after_release_peak = int(sane_count(t.after_release_peak) or 0)
        t.release_revoked = t.release_revoked is True
        t.release_breach = t.release_breach is True
        t.release_open_at_gap = t.release_open_at_gap is True
        t.group_lane = t.group_lane if isinstance(t.group_lane, str) else None
        t.workspace_group = t.workspace_group if isinstance(t.workspace_group, str) else None
        t.observed_gap = t.observed_gap is True
        t.write_dirs = [r for r in (within_home(d) for d in t.write_dirs if isinstance(d, str))
                        if r][:4] if isinstance(t.write_dirs, list) else []
        t.release_end = sane_count(t.release_end)
        t.peak_cpu = sane_count(t.peak_cpu) or 0.0
        for name in ("past_peak_attempts", "past_peak_over", "past_peak_most_over", "past_peak_unknown",
                     "past_peak_released", "release_est", "release_oom_base"):
            setattr(t, name, int(sane_count(getattr(t, name)) or 0))
        t.past_peak_freed = sane_count(t.past_peak_freed, 1e18) or 0.0
        t.wait_mark = sane_count(t.wait_mark)
        return t

    def measure(self, now: float) -> None:
        if self.js is not None:
            self.js.observe()
            if self.js.used and not self.elastic:
                self.elastic = True
        if not self.cg:
            return
        stats = cgroup_stats(self.cg)
        if stats is None:
            return
        usage, need, oom = stats
        if self.cpu_usec_base is None:
            self.cpu_usec_base = usage if self.measured else 0  # picked up after a restart: count from here
        self.measured = True
        self.samples.append((now, usage))
        # Keep about five seconds of samples, so cores_now is a five-second average.
        while len(self.samples) > 2 and now - self.samples[1][0] >= 5.0:
            self.samples.popleft()
        t0, u0 = self.samples[0]
        if now - t0 >= 1.0:
            self.cores_now = max(0.0, (usage - u0) / 1e6 / (now - t0))
            if now - t0 >= 3.0:
                self.peak_cores = max(self.peak_cores, self.cores_now)
        self.cpu_usec = usage
        self.mem_now = need
        self.swap_now = cgroup_swap(self.cg)
        pausing = max(0.0, now - self.frozen_at) if self.frozen and self.frozen_at else 0.0
        elapsed = max(0.0, now - (self.started or now) - self.frozen_attempt - pausing)
        if need > self.mem_peak:
            self.mem_peak = need
            self.peak_mem_cores = self.granted
            self.peak_at, self.tail = elapsed, 0
            self.peak_cpu = max(0, usage - (self.cpu_usec_base or 0)) / 1e6
        elif elapsed - self.peak_at >= 30 and not self.frozen:
            self.tail = max(self.tail, need)
        if not self.frozen:
            self.note_trace(elapsed, need)
        if self.release_at is not None and (not self.release_revoked or self.release_breach):
            # Past its peak: did it need more, and how much more? After a breach it is still
            # followed: the room let go may already be another build's, so all of it counts.
            used = need + self.swap_now
            self.after_release_peak = max(self.after_release_peak, used)
            if used > self.release_hold and not self.release_revoked:
                self.release_revoked = self.release_breach = self.release_dirty = True
                self.release_end = round(elapsed, 1)
                if self.released:
                    log(f"{self.id} grew past what was kept for it after its peak ({fmt_size(used)} > "
                        f"{fmt_size(self.release_hold)}); holding its full {fmt_size(self.est_mem)} again", level=4)
        self.oom_kills = max(0, oom - (self.oom_base or 0))
        if self.release_at is not None and not self.release_revoked and self.oom_kills > self.release_oom_base:
            self.release_revoked = self.release_breach = self.release_dirty = True  # something in it was killed for memory
            self.release_end = round(elapsed, 1)
            if self.released:
                log(f"{self.id} had a process killed for memory after its peak; holding its full "
                    f"{fmt_size(self.est_mem)} again", level=4)
        waits = cgroup_memory_waits(self.cg)
        if waits is not None:
            self.take_waits(*waits)

    TRACE_SECONDS = 10.0
    TRACE_POINTS = 720

    def note_trace(self, elapsed: float, need: int) -> None:
        """The most memory in each TRACE_SECONDS of the run; past TRACE_POINTS, neighbours are
        merged, so a long run keeps its shape in a bounded list."""
        step = self.TRACE_SECONDS * self.trace_merges
        if self.trace and elapsed - self.trace[-1][0] < step:
            self.trace[-1][1] = max(self.trace[-1][1], need)
            return
        self.trace.append([elapsed, need])
        if len(self.trace) > self.TRACE_POINTS:
            pairs = [[a[0], max(a[1], b[1])] for a, b in zip(self.trace[::2], self.trace[1::2])]
            self.trace = pairs + ([self.trace[-1]] if len(self.trace) % 2 else [])
            self.trace_merges *= 2

    def take_waits(self, some, full, high) -> None:
        """Keep the largest memory waits seen: the cgroup's counters only grow while it lives. A
        value that isn't a sensible number (a damaged result.json or ticket.json) is ignored."""
        for name, value in (("mem_wait_some", some), ("mem_wait_full", full), ("mem_high", high)):
            value = sane_count(value)
            best = max(sane_count(getattr(self, name)) or 0.0, value or 0.0)
            setattr(self, name, int(best) if name == "mem_high" else best)

    def row(self, now: float, ahead: int | None = None) -> dict:
        elapsed = round((self.ended or now) - self.started, 1) if self.started else None
        return {
            "id": self.id, "short": self.id if self.flock else self.id[:8], "name": self.name,
            "lane": self.lane, "label": self.label, "key": self.key, "cwd": self.cwd, "state": self.state,
            "priority": self.priority, "submitted": self.submitted, "started": self.started, "ended": self.ended,
            "waited": round((self.started or now) - self.submitted, 1), "elapsed": elapsed,
            "est_cores": self.est_cores, "est_mem": self.est_mem, "est_src": self.est_src,
            "want": self.want, "need": self.need, "granted": self.granted, "elastic": self.elastic,
            "rigid": self.rigid, "cold": self.cold, "expected": self.expected,
            "cores_now": round(self.cores_now, 2), "mem_now": self.mem_now, "mem_peak": self.mem_peak,
            "peak_cores": round(self.peak_cores, 2), "avg_cores": round(self.avg_cores, 2),
            "measured": self.measured, "exit": self.exit, "oom": self.oom, "timed_out": self.timed_out,
            "mem_wait_some": round(self.mem_wait_some, 1), "mem_wait_full": round(self.mem_wait_full, 1),
            "mem_high": self.mem_high, "source": self.source, "caller": self.caller, "frozen": self.frozen,
            "requeues": self.requeues, "ci_stops": self.ci_stops, "yields_to": self.yields_to,
            "source_changed": self.source_changed, "attempt_offsets": self.attempt_offsets,
            "source_verified": self.source_verified,
            "joiners": self.joiners,
            "error": self.error, "reason": self.reason if self.state == "queued" else None,
            "waiting_for": self.reason_cat if self.state == "queued" else None,
            "held": self.held if self.state == "queued" else False, "ahead": ahead,
            "log": self.log, "dir": self.dir, "outside": self.flock[0] if self.flock else None,
            "cancel_requested": self.cancel_requested, "runner": self.runner, "timeout": self.timeout,
            # for `buildq top`: where to read it, and what it fills
            "cg": self.cg, "write_dirs": self.write_dirs, "disk_paths": self.disk_paths, "swap_now": self.swap_now, "waited_by": self.waited_by,
            "peak_at": round(self.peak_at, 1), "release_at": self.release_at, "release_hold": self.release_hold,
        }


# --------------------------------------------------------------------------------------------
# The daemon


class Daemon:
    REBALANCE_SECONDS = 5.0
    VACATED_SECONDS = 600.0  # how long a cancelled `run` build's place is kept for its retry

    def __init__(self, config_path: str, state_dir: str, machine: Machine | None = None, runner=None,
                 queries=None):
        self.config_path = config_path
        # systemctl queries, which take seconds when the user manager is slow, run here, off the
        # event loop: a stalled systemd mustn't stall every client (#2). See query().
        self.queries = queries or ThreadPoolExecutor(max_workers=4, thread_name_prefix="buildq-query")
        self.pending_queries: dict[tuple, Future] = {}
        self.storage_unreadable: set[str] = set()  # container storage said to be unreadable, once each
        self.state_dir = state_dir
        os.makedirs(state_dir, exist_ok=True)
        self.last_good = os.path.join(state_dir, "config.last-good.toml")
        self.machine = machine or Machine()
        self.tickets_dir = os.path.join(state_dir, "tickets")
        os.makedirs(self.tickets_dir, exist_ok=True)
        self.cg_base = user_manager_cgroup()
        self.override = runner  # tests pass a runner of their own
        self.runners = {"systemd": SystemdRunner(self.cg_base), "direct": DirectRunner()}
        if runner is not None:
            self.runners[runner.name] = runner
        self._systemd_ok = None
        self.cfg = None
        self.cfg = self.load_config()
        self.runner = self.runner_for_config(self.cfg)
        self.history = History(os.path.join(state_dir, "history.jsonl"), self.cfg.history_keys)
        self.metrics = Metrics(os.path.join(state_dir, "metrics.db"))
        self.tickets: dict[str, Ticket] = {}
        self.watchers: dict[str, set[Conn]] = collections.defaultdict(set)
        self.helpers: list[tuple[subprocess.Popen, float]] = []
        self.budget: dict = {}
        self.stopping = False
        self.last_prune = -1e9
        self.last_rebalance = -1e9
        # The place in the queue of a `buildq run` build cancelled because its client went (a tool
        # timeout), by (directory, command, lane, caller): (seconds it waited, kept until). The retry
        # takes it (#7). Kept in memory only: a daemon restart forgets them (the retry goes to the back).
        self.vacated: dict[tuple, tuple[float, float]] = {}
        self.guard_available: int | None = None  # MemAvailable when the slice was last guarded
        self.submissions: dict[str, str] = {}  # the client's submission id -> its ticket
        self.slice_limit = None  # the slice's configured MemoryMax, read once systemd has the slice
        self.guard_failed = False
        self.cg_root = "/sys/fs/cgroup"
        self.memory_tight = False
        self.memory_calm_since = None
        self.last_memory_log = 0.0
        self.memory_lines: queue.Queue = queue.Queue()
        self.walk_wanted = threading.Event()
        self.walking = False
        self.memory_stopping = False
        self.memory_threads: dict[str, threading.Thread] = {}
        self.memory_thread_lock = threading.Lock()
        self.memory_thread_failed = False
        self.last_freeze = self.last_kill = -1e9
        self.room_made: dict[str, float] = {}  # a CI job's build -> when builds were last stopped for it
        self.started_at = time.time()
        self.avail_seen: collections.deque = collections.deque()  # (time, memory available) of the last 10 s
        self.submit_outcome: dict = {}  # how the last submission was answered: joined, reused, passed before
        self.paused = read_json(os.path.join(state_dir, "paused.json"))  # {"reason", "since"} or None
        if not isinstance(self.paused, dict):
            self.paused = None
        self.status_posts: list = read_json(os.path.join(state_dir, "github-statuses.json")) or []
        if not isinstance(self.status_posts, list):
            self.status_posts = []
        self.status_procs: list[tuple[subprocess.Popen, dict, float]] = []
        self.gh: list | None = None  # None: found as each status is sent (tests put a stand-in here)
        self.gh_unrunnable = False  # said so in the log already, until gh runs again
        self.source_command = [sys.executable, os.path.join(os.path.dirname(SELF), "buildq"), "source"]
        self.source_checks: list[tuple[subprocess.Popen, str, str, float, int]] = []
        self.source_wanted: collections.deque = collections.deque()  # (ticket, phase, attempt) waiting a turn
        self.status_posted: dict[str, dict] = {}  # "repo@sha@context" -> {state, order} last posted
        self.status_seen: dict[str, list] = {}  # "repo@sha@context" -> order of the newest verdict seen
        statuses = read_json(os.path.join(state_dir, "github-statuses.json"))
        if isinstance(statuses, dict):
            self.status_posts = statuses.get("queue") or []
            seen = statuses.get("seen")
            self.status_seen = {str(k): list(v) for k, v in seen.items() if isinstance(v, list)} \
                if isinstance(seen, dict) else {}
            posted = statuses.get("posted")
            self.status_posted = {}
            for where, value in (posted.items() if isinstance(posted, dict) else ()):
                if isinstance(value, str):
                    value = {"state": value, "order": [0, ""]}
                if isinstance(value, dict) and isinstance(value.get("state"), str):
                    self.status_posted[str(where)] = {"state": value["state"], "order": list(value.get("order") or [0, ""])}
        newest: dict[str, dict] = {}
        for post in (p for p in self.status_posts if valid_post(p)):  # what was in flight is just queued now
            where = post.get("where") or f"{post['repo']}@{post['sha']}@{post['context']}"
            post["where"] = where
            post["order"] = list(post.get("order") or [post["first"], ""])
            if where not in newest or post["order"] > newest[where]["order"]:
                newest[where] = post
        self.status_posts = list(newest.values())

    # ---- configuration

    def attempt(self, t: Ticket) -> tuple:
        """A ticket's attempt: queries are keyed by it, so an answer never outlives its attempt."""
        return (t.id, t.requeues, t.unit)

    @staticmethod
    def snapshot(t: Ticket):
        """What a runner's query reads from a ticket, copied: the loop goes on changing the ticket
        while the query runs on another thread."""
        return types.SimpleNamespace(id=t.id, unit=t.unit, cg=t.cg, dir=t.dir)

    def drop_queries(self, t: Ticket) -> None:
        """Forget a ticket's queries (its attempt has ended): their answers belong to it alone."""
        for key in [k for k in self.pending_queries if len(k) > 1 and isinstance(k[1], tuple) and k[1][0] == t.id]:
            self.pending_queries.pop(key).cancel()

    def unit_state_of(self, t: Ticket):
        """The runner's view of a ticket's service: through query() for systemd (a systemctl call that
        can be slow); the direct runner's is a file read, done here on the ticket itself."""
        runner = self.runner_of(t)
        if runner.name != "systemd":
            return runner.unit_state(t)
        return self.query(("unit-state", self.attempt(t)), runner.unit_state, self.snapshot(t))

    def result_of(self, t: Ticket):
        """systemd's verdict on a build's service (through query()), or the runner's own."""
        runner = self.runner_of(t)
        if runner.name != "systemd":
            return runner.result(t)
        return self.query(("result", self.attempt(t)), runner.result, self.snapshot(t))

    def query(self, key: tuple, fn, *args):
        """fn(*args), run off the event loop: its answer, or PENDING while it isn't in yet, so the
        caller asks again on a later tick. A quick answer (a healthy systemctl takes milliseconds)
        is waited for, up to 50 ms, so it is used at once."""
        future = self.pending_queries.get(key)
        if future is None:
            future = self.pending_queries[key] = self.queries.submit(fn, *args)
            wait = 0.05  # a quick answer is used at once
        else:
            wait = 0.0  # asked before: look, don't wait again (a stalled systemd mustn't cost every tick)
        try:
            answer = future.result(timeout=wait)
        except FutureTimeout:
            return PENDING
        finally:
            if future.done():
                self.pending_queries.pop(key, None)
        return answer

    def runner_for_config(self, cfg: Config):
        """The runner new builds use. A build already running keeps the runner it started under."""
        if self.override is not None:
            return self.override
        wanted = os.environ.get("BUILDQ_RUNNER") or cfg.runner
        if wanted not in ("auto", "systemd", "direct"):
            log(f"BUILDQ_RUNNER={wanted!r} isn't auto, systemd or direct; using {cfg.runner}")
            wanted = cfg.runner
        if os.environ.get("INVOCATION_ID") and wanted != "systemd":
            # Running as a systemd service: the direct runner would put every build inside the
            # daemon's own small cgroup. A slow probe under load mustn't pick it.
            if wanted == "direct":
                log("runner = \"direct\" can't be used while buildqd runs as a systemd service; using systemd")
            wanted = "systemd"
        if wanted == "auto":
            if self._systemd_ok is None:
                self._systemd_ok = SystemdRunner.available()
            wanted = "systemd" if self._systemd_ok else "direct"
        return self.runners[wanted]

    def runner_of(self, t: "Ticket"):
        return self.runners.get(t.runner) or self.runner

    def load_config(self) -> Config:
        """The configuration file if it loads and systemd accepts its lanes; else the last one that
        did; else the defaults. A typo never leaves the queue without its limits."""
        m = self.machine
        try:
            cfg = load_config_file(self.config_path, m.mem_total, m.ncpu)
            runner = self.runner_for_config(cfg)
            for lane in cfg.lanes.values():
                problem = runner.check_lane(lane)
                if problem:
                    raise ValueError(f"systemd refuses lanes.{lane.name}.properties: {problem}")
            if os.path.exists(self.config_path):
                shutil.copyfile(self.config_path, self.last_good)
            return cfg
        except Exception as e:
            problem = f"config {self.config_path}: {e}"
        if self.cfg is not None:
            log(f"{problem}; keeping the configuration in force")
            return self.cfg
        try:
            cfg = load_config_file(self.last_good, m.mem_total, m.ncpu)
            log(f"{problem}; using the last configuration that loaded ({self.last_good})")
            return cfg
        except Exception:
            log(f"{problem}; no earlier configuration loaded, so using the defaults")
            return Config({}, m.mem_total, m.ncpu)

    async def reload_async(self) -> None:
        """Reload without blocking the loop: checking lane properties starts processes."""
        cfg = await asyncio.get_running_loop().run_in_executor(None, self.load_config)
        self.apply(cfg)

    def reload(self) -> None:
        self.apply(self.load_config())

    def apply(self, cfg: "Config") -> None:
        self.cfg = cfg
        self.slice_limit = None  # read it again: the slice may have changed
        for key in [k for k in self.pending_queries if k[0] == "slice-max"]:
            self.pending_queries.pop(key).cancel()  # (and not from an answer asked for before)
        self.runner = self.runner_for_config(self.cfg)
        self.history.max_keys = self.cfg.history_keys
        log(f"configuration in force: {json.dumps(self.cfg.summary())}")
        self.schedule(time.time())

    def lane(self, name: str) -> Lane:
        return self.cfg.lanes.get(name) or self.cfg.lanes[self.cfg.default_lane]

    # ---- the ticket index

    def queue(self, now: float | None = None) -> list[Ticket]:
        """Queued tickets in the order they get a turn: any that has waited starve_seconds (or, with
        ci_first, comes from a CI job) first, then the higher priority (the lane's plus the ticket's
        own), CI jobs first at the same priority with ci_first (one that has waited starve_seconds
        before newer ones), then the one expected to finish soonest, then the oldest.

        With ci_first, any build that has waited three times starve_seconds, or was stopped to free
        memory, goes before all of those, so CI jobs (in a higher lane, for a CI job's build) can't
        keep it waiting for ever."""
        now = time.time() if now is None else now

        # Fair shares: at the same priority, a caller (a session, a CI runner) with fewer builds
        # running goes first, so one agent's burst of builds doesn't keep everyone else waiting.
        running = collections.Counter(t.caller for t in self.active())

        def tier(t: Ticket):
            lane = self.cfg.lanes.get(t.lane)
            passes = bool(lane and lane.may_pass_held)
            # A build that has waited starve_seconds goes ahead of everything else, or a stream of
            # quicker or higher builds could keep it waiting for ever. With ci_first a CI job's build
            # counts so at once, and any build that has waited much longer goes before it: a
            # session's, or a CI job's that higher-lane CI builds keep passing.
            starving = self.starving(t, now) and not passes
            overdue = (self.cfg.ci_first and not passes and not self.yielding(t, now)
                       and (now - t.submitted >= 3 * self.cfg.starve_seconds or t.requeues > 0))
            # A CI job's build goes before the others at its priority, and one that has waited out its
            # turn before newer ones, or a stream of quicker CI builds could keep it waiting past its
            # job's time limit. Not among overdue builds (they go in the plain order, or a backlog of
            # CI builds could keep an overdue session's build waiting), nor in a lane that passes held
            # room (it gets no head start there).
            first = self.cfg.ci_first and t.from_ci and not passes and not overdue
            return (not overdue, not starving, -self.weight(t), not first, not (first and self.waited_out(t, now)))

        def own_order(t: Ticket):
            return (*tier(t), t.expected if t.expected is not None else math.inf, t.submitted, t.seq)

        queued = sorted((t for t in self.tickets.values() if t.state == "queued"), key=own_order)
        # Within a tier, a caller's k-th waiting build counts as if k more of its builds ran, so
        # callers take turns: one session's burst of builds is interleaved with everyone else's.
        share, seen = {}, collections.Counter()
        for t in queued:
            share[t.id] = running[t.caller] + seen[(tier(t), t.caller)]
            seen[(tier(t), t.caller)] += 1
        return sorted(queued, key=lambda t: (*tier(t), share[t.id], *own_order(t)[2:]))

    def weight(self, t: Ticket) -> int:
        """Its priority: its lane's plus its own."""
        lane = self.cfg.lanes.get(t.lane)
        return t.priority + (lane.priority if lane else 0)

    def waited_out(self, t: Ticket, now: float) -> bool:
        """It has waited starve_seconds, or it was stopped to free memory once already (and doesn't
        yield to the CI job's build it was stopped for)."""
        if self.yielding(t, now):
            return False
        return now - t.submitted >= self.cfg.starve_seconds or t.requeues > 0

    YIELD_MAX = 1800.0  # seconds a build stopped for a CI job's build waits for it at most

    def yielding(self, t: Ticket, now: float) -> bool:
        """It was stopped to make room for a CI job's build that is still waiting, less than
        YIELD_MAX ago: it doesn't start, go before that build, hold room or count as waited out, or
        it would take back the room it gave. (A CI build that can't start for long doesn't keep it
        waiting for ever: after YIELD_MAX it goes first, as any stopped build does.)"""
        if not t.yields_to or now >= (t.yield_until or 0.0):
            return False
        ci = self.tickets.get(t.yields_to)
        return ci is not None and ci.state == "queued"

    def starving(self, t: Ticket, now: float) -> bool:
        """It has waited out its turn, or (with ci_first) it comes from a CI job, which has a time
        limit of its own and holds up a merge or a release: it goes first, and the room it needs is
        held for it. (A CI job's room binds only builds of its priority or lower until it has
        waited out its turn too; see schedule.)"""
        return self.waited_out(t, now) or (self.cfg.ci_first and t.from_ci)

    def active(self) -> list[Ticket]:
        """Tickets that hold a turn: starting or running, including builds found in flock slots."""
        return [t for t in self.tickets.values() if t.state in ("starting", "running")]

    def resolve(self, ref) -> tuple[Ticket | None, str | None]:
        ref = str(ref or "").strip().lower()
        if ref in self.tickets:
            return self.tickets[ref], None
        if len(ref) < 4:
            return None, "give at least the first 4 characters of the ticket"
        matches = [t for tid, t in self.tickets.items() if tid.startswith(ref)]
        if len(matches) == 1:
            return matches[0], None
        if matches:
            return None, f"{ref} matches {len(matches)} tickets; give more of it"
        return None, f"no ticket {ref}"

    def position(self, t: Ticket) -> int | None:
        return self.queue().index(t) if t.state == "queued" else None

    def save(self, t: Ticket) -> None:
        if not t.dir:
            return
        try:
            write_json(os.path.join(t.dir, "ticket.json"), t.record())
        except OSError as e:
            log(f"can't save ticket {t.id}: {e}")

    def broadcast(self, t: Ticket, now: float) -> None:
        conns = self.watchers.get(t.id)
        if not conns:
            return
        message = {"type": "ticket", **t.row(now, self.position(t))}
        for conn in list(conns):
            if not conn.send(message):
                conns.discard(conn)
        if t.state in FINISHED:
            self.watchers.pop(t.id, None)

    def estimate(self, t: Ticket, now: float) -> None:
        e = self.history.estimate(t.key, self.lane(t.lane), self.cfg, self.machine.ncpu,
                                  self.runner.name == "systemd", t.cold, now)
        t.want, t.need, t.est_src, t.rigid, t.expected = e.want, e.need, e.source, e.rigid, e.wall
        t.mem_base, t.mem_cores = e.mem, e.mem_cores
        if t.cores_given is not None:
            if t.rigid:  # it was seen to use more than it is told; telling it less changes nothing
                t.est_src = f"{t.est_src}; cores given, but it doesn't follow them"
            else:  # the caller knows how many cores the build should use
                t.want = t.need = int(t.cores_given)
                t.est_src = f"{t.est_src}; cores given"
        if t.mem_given is not None and t.mem_given > t.mem_base:  # a given size may raise, never lower
            t.mem_base, t.mem_cores = t.mem_given, max(t.mem_cores, t.want)
            t.est_src = f"{t.est_src}; memory given"
        t.est_mem = self.mem_for(t, t.granted if t.state in ("starting", "running") and t.granted else t.need)

    def mem_for(self, t: Ticket, cores: int) -> int:
        """The memory a build needs with `cores` cores. Builds that run more compilers at once need
        more memory, so past the cores its history was measured at, the estimate grows in
        proportion, up to the lane's MemoryMax where that is enforced."""
        base = t.mem_base
        if t.rigid or cores <= t.mem_cores:
            return base
        scaled = int(base * cores / t.mem_cores)
        lane = self.lane(t.lane)
        if lane.mem_cap and self.runner_of(t).name == "systemd":
            scaled = min(scaled, max(lane.mem_cap, base))
        return scaled

    # ---- submitting, cancelling

    def submit(self, msg: dict, now: float) -> tuple[Ticket | None, str | None]:
        if self.stopping:
            return None, "the daemon is stopping; try again in a moment"
        argv = msg.get("argv")
        if not isinstance(argv, list) or not argv or not all(isinstance(a, str) and a for a in argv):
            return None, "no command given"
        lane_name = str(msg.get("lane") or self.cfg.lane_for(argv))
        if lane_name not in self.cfg.lanes:
            return None, f"unknown lane {lane_name!r}; the lanes are {', '.join(sorted(self.cfg.lanes))}"
        lane = self.cfg.lanes[lane_name]
        cwd = msg.get("cwd")
        if not isinstance(cwd, str) or not os.path.isabs(cwd):
            return None, "the working directory must be an absolute path"
        env = msg.get("env")
        if not isinstance(env, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items()):
            return None, "the environment must be a map of strings"
        self.submit_outcome = {}
        submission = msg.get("submission")
        if isinstance(submission, str) and submission in self.submissions:
            earlier = self.tickets.get(self.submissions[submission])
            if earlier is not None:  # the client didn't get our answer and asked again: the same answer
                how = earlier.answered.get(submission)
                self.submit_outcome = {how: True} if how in ("joined", "reused") else {}
                return earlier, None
        tid = str(uuid.uuid4())
        t = Ticket(tid, argv, cwd, lane_name, command_key(argv, cwd, lane_name, self.cfg.script_labels), now,
                   os.path.join(self.tickets_dir, tid))
        try:
            t.priority = number(msg.get("priority") or 0, "priority", -1000, 1000, integer=True)
            if msg.get("timeout") is not None:
                t.timeout = number(float(msg["timeout"]), "timeout", 1, 30 * 86400)
            else:
                t.timeout = lane.timeout
            if msg.get("cores") is not None:
                t.cores_given = number(float(msg["cores"]), "cores", 1, self.machine.ncpu)
            if msg.get("mem") is not None:
                t.mem_given = parse_size(msg["mem"], self.machine.mem_total)
        except (TypeError, ValueError, OverflowError) as e:
            return None, f"bad option: {e}"
        t.attached = bool(msg.get("attach"))
        t.restartable = msg.get("restartable") is True
        umask = msg.get("umask")
        if isinstance(umask, int) and not isinstance(umask, bool) and 0 <= umask <= 0o777:
            t.umask = umask
        limits = msg.get("rlimits")
        if isinstance(limits, dict):
            t.rlimits = {str(k): v for k, v in limits.items() if k in ("NOFILE", "STACK", "CORE") and isinstance(v, int)}
        name, notify = msg.get("name"), msg.get("notify")
        t.name = str(name)[:200] if name else None
        t.notify = str(notify) if notify else None
        t.caller = sane_caller(msg.get("caller"))
        t.from_ci = bool(env.get("GITHUB_ACTIONS") and env.get("RUNNER_NAME"))  # (the shim's test, too)
        # A place left by the same build of this caller's, cancelled when its `buildq run` went: taken
        # here, so a retry that joins another build uses it up too.
        place = self.vacated.pop((cwd, tuple(argv), lane_name, t.caller), None) if t.caller else None
        source = sane_source(msg.get("source"))
        if source and source.get("repo") and paths_inside(argv, cwd, source["repo"]):
            settings = [t.timeout, t.umask, t.rlimits, t.cores_given, t.mem_given, self.cfg.env]
            t.source, t.dedupe = source, dedupe_key(source, argv, cwd, lane_name, env, settings)
        elif source:
            t.source = source  # shown, but a command that reaches outside the tree matches nothing
        if t.dedupe and msg.get("again") is not True:
            earlier = self.same_build(t, msg, now)
            if earlier is not None:
                who = submission if isinstance(submission, str) and len(submission) <= 100 else f"anon-{tid}"
                how = "joined" if self.submit_outcome.get("joined") else "reused"
                earlier.answered[who] = how
                self.submissions[who] = earlier.id  # a resend gets the same answer
                if how == "joined":
                    earlier.interests[who] = "run" if t.attached else "submit"
                    if t.attached:
                        earlier.followed[who] = now
                self.save(earlier)
                return earlier, None
        t.workspace = workspace_of(cwd, env)
        if isinstance(submission, str) and len(submission) <= 100:
            t.submission = submission
            self.submissions[submission] = tid
        t.interests = {t.submission or f"anon-{tid}": "run" if t.attached else "submit"}
        if t.attached:
            t.followed = {t.submission or f"anon-{tid}": now}
        t.git_env = {k: v for k, v in env.items() if GIT_ENV.fullmatch(k)}
        t.cold = cargo_cold(argv, cwd, env)
        t.max_log = self.cfg.max_log
        job_env = dict(env)
        for key, value in self.cfg.env.items():
            job_env.setdefault(key, value.replace("{id}", tid))
        job_env["BUILDQ_JOB"] = tid
        job_env["BUILDQ_TICKET"] = tid
        t.disk_paths = disk_paths_of(cwd, job_env)  # (configured defaults included: a TMPDIR elsewhere counts)
        t.write_dirs = write_dirs_of(cwd, job_env, argv)
        try:
            os.makedirs(t.dir)
            write_json(os.path.join(t.dir, "env.json"), job_env)
            open(os.path.join(t.dir, "output.log"), "ab").close()
        except OSError as e:
            shutil.rmtree(t.dir, ignore_errors=True)
            return None, f"can't create the ticket: {e}"
        t.env = job_env
        t.queued_at = t.wait_mark = now
        if place and place[1] >= now and place[0] > 0:
            t.submitted = now - place[0]  # the retry of a run whose client went: as long a wait behind it
            log(f"{tid} takes the place of the same build, cancelled when its `buildq run` went "
                f"(it had waited {place[0]:.0f}s)")
        self.estimate(t, now)
        self.tickets[tid] = t
        self.save(t)
        log(f"queued {tid} [{lane_name}]: want {t.want} cores (at least {t.need}), {fmt_size(t.est_mem)} "
            f"({t.est_src}); {t.label!r} in {cwd}")
        self.schedule(now)
        return t, None

    def waiting(self, t: Ticket, now: float) -> list[str]:
        """The submissions still waiting for a build: dropped-off ones, and those of `buildq run`s
        following it, or whose client followed it within unwatched_seconds (it may be reconnecting,
        after a daemon restart say: the time counts from the daemon's start at the earliest). A run
        killed outright waits no more after that."""
        following = {getattr(c, "submission", None) for c in self.watchers.get(t.id, ())}

        def recent(who):
            return now - max(t.followed.get(who, 0.0), self.started_at) <= self.cfg.unwatched_seconds
        return [who for who, kind in t.interests.items() if kind == "submit" or who in following or recent(who)]

    def same_build(self, t: Ticket, msg: dict, now: float) -> Ticket | None:
        """An earlier ticket that answers this submission: the same build queued or running (it
        joins it), or, for a plain check or with --reuse, one that passed on the same source within
        reuse_window, with its source checked unchanged at its start and end."""
        same = [x for x in self.tickets.values() if x.dedupe == t.dedupe and not x.source_changed]
        live = [x for x in same if x.state not in FINISHED and not x.cancel_requested and not x.shed_error]
        if live:
            x = live[0]
            if not t.attached:
                x.attached = False  # a dropped-off submission depends on it now: no client owns it
            x.joiners += 1
            x.priority = max(x.priority, t.priority)
            if t.notify:
                x.extra_notify.append(t.notify)
            self.save(x)
            self.submit_outcome = {"joined": True}
            log(f"{x.id} is already {x.state} for the same command on the same source; a new submission joins it")
            return x
        passed = [x for x in same if x.state == "succeeded" and x.source_verified and x.ended
                  and now - x.ended <= self.cfg.reuse_window]
        if not passed:
            return None
        last = max(passed, key=lambda x: x.ended)
        reuse = msg.get("reuse")
        if reuse is True or (reuse is None and reusable_check(t.argv)):
            self.submit_outcome = {"reused": True}
            log(f"{last.id} passed the same command on the same source {now - last.ended:.0f}s ago; "
                "its result answers a new submission")
            return last
        self.submit_outcome = {"passed_before": {"id": last.id, "short": last.id[:8], "ended": last.ended}}
        return None

    def cancel(self, t: Ticket, now: float) -> None:
        if t.state in FINISHED or t.flock:
            return
        t.cancel_requested = True
        if t.state == "queued":
            self.finalize(t, now, None)
            return
        self.stop(t, now, force=t.frozen)  # a frozen build can't act on SIGTERM; thawing it would let it grow
        self.save(t)
        self.broadcast(t, now)
        log(f"cancelling {t.id}")

    def stop(self, t: Ticket, now: float, force: bool = False) -> None:
        t.stop_sent = now
        t.force_sent = t.force_sent or force
        try:
            proc = self.runner_of(t).stop(t, force)
            if proc is not None:
                self.helpers.append((proc, now + 60))
        except OSError as e:
            log(f"can't stop {t.id}: {e}")

    # ---- pausing the queue

    def pause(self, reason: str | None, now: float) -> None:
        """Start nothing new until resumed (before a reboot, say); running builds carry on."""
        self.paused = {"reason": reason, "since": now}
        write_json(os.path.join(self.state_dir, "paused.json"), self.paused)
        log(f"paused the queue{f' ({reason})' if reason else ''}: running builds carry on, nothing new starts",
            level=4)
        self.schedule(now)

    def resume(self, now: float) -> None:
        if self.paused is None:
            return
        self.paused = None
        try:
            os.remove(os.path.join(self.state_dir, "paused.json"))
        except OSError:
            pass
        log("resumed the queue")
        self.schedule(now)

    # ---- giving memory back when the machine runs short

    FREEZE_SECONDS = 10  # between pauses, so the machine's memory can settle
    KILL_SECONDS = 2  # between stops: a stop frees memory at once, and a pause must never hold one up
    SHED_MIN = 512 * MIB  # a build holding less frees too little to be worth stopping

    FREEZE_MAX = 300  # a pause lasts this long at most: then the build goes on, or is stopped

    def shed_memory(self, now: float) -> None:
        """When the machine runs short of memory although no build may grow past its estimate (other
        work grew: CI, containers, sessions), give memory back before the machine stalls, as GNU
        parallel's --memsuspend and --memfree do, and as Slurm requeues the jobs it preempts.

        Memory still held by builds being stopped counts as free already, so one shortfall stops
        one build. Below a quarter of mem_floor available, stop a build at once: the newest of those
        whose memory covers the shortfall (back to half the floor), else the largest; never one
        holding less than 512 MiB. A build that can start over safely (a compile or test run, or
        --restartable) is queued again at the front; anything else fails, saying why, as running it
        again might repeat what it did. Below half of mem_floor, while memory is still falling, pause
        (freeze) the newest build holding at least 1 GiB: it stops growing and using CPU. A paused
        build goes on once the machine has mem_floor free plus the room it may still grow into, at
        once if shed_memory is off, and after FREEZE_MAX in any case: if memory is still below half
        the floor then, it is stopped instead."""
        cfg, m = self.cfg, self.machine
        builds = [t for t in self.active() if not t.flock and t.state == "running" and not t.cancel_requested
                  and not t.requeue_pending]
        self.reconcile_freezes(builds, now)
        builds = [t for t in builds if not t.requeue_pending]  # (reconciling may have stopped one)
        frozen = [t for t in builds if t.frozen]
        floor = cfg.mem_floor
        if m.mem_available < floor / 4 and cfg.shed_memory:
            for t in self.active():  # a cancelled build in its grace period is going anyway: now, then
                if t.cancel_requested and not t.flock and not t.force_sent:
                    self.stop(t, now, force=True)
                    t.force_sent = True
        stopping = sum(t.mem_now for t in self.active() if t.requeue_pending or t.force_sent)
        avail = m.mem_available + stopping
        self.avail_seen.append((now, avail))
        while self.avail_seen and now - self.avail_seen[0][0] > 10:
            self.avail_seen.popleft()
        if not cfg.shed_memory or not floor:
            for t in frozen:
                if not (t.freeze_asked and not t.freeze_asked[0]) and not t.thaw_failed:
                    self.freeze(t, False, now, "shed_memory is off")
            return
        thawing = {t.id for t in frozen if t.freeze_asked and not t.freeze_asked[0]}
        for t in frozen:
            if t.id in thawing:
                continue  # asked to go on already
            if self.paused_for(t, now) >= self.FREEZE_MAX:
                if avail >= floor / 2:
                    self.freeze(t, False, now, f"paused for {self.FREEZE_MAX // 60} minutes in all, the longest it "
                                               "may be (it won't be paused again)")
                    self.last_freeze = now
                elif now - self.last_kill >= self.KILL_SECONDS:
                    self.shed(t, now)  # memory stays short: its memory is what frees it
                    self.last_kill = now
                return
        if avail < floor / 4:
            if now - self.last_kill < self.KILL_SECONDS:
                return
            pool = sorted((t for t in builds if t.mem_now >= self.SHED_MIN), key=lambda t: t.started or 0,
                          reverse=True)
            if not pool:
                return  # what holds the memory isn't ours to stop
            shortfall = floor / 2 - avail
            enough = [t for t in pool if t.mem_now >= shortfall]
            self.shed(enough[0] if enough else max(pool, key=lambda t: t.mem_now), now)
            self.last_kill = now
        elif avail < floor / 2:
            falling = self.avail_seen[0][1] - avail >= 256 * MIB  # pausing only helps while memory still goes
            if now - self.last_freeze < self.FREEZE_SECONDS or not falling:
                return
            pool = [t for t in sorted(builds, key=lambda t: t.started or 0, reverse=True)
                    if not t.frozen and not t.freeze_failed and t.mem_now >= GIB and self.runner_of(t).can_freeze
                    and self.paused_for(t, now) < self.FREEZE_MAX]  # each attempt is paused for so long at most
            if pool:
                self.freeze(pool[0], True, now, f"only {fmt_size(m.mem_available)} of memory is free (half the floor "
                                                f"is {fmt_size(floor / 2)}) and falling")
                self.last_freeze = now
        elif [t for t in frozen if t.id not in thawing] and now - self.last_freeze >= self.FREEZE_SECONDS:
            t = min((t for t in frozen if t.id not in thawing), key=lambda t: t.frozen_at or 0)
            if avail > floor + max(0, t.est_mem - t.mem_now):
                self.freeze(t, False, now, f"{fmt_size(m.mem_available)} of memory is free again")
                self.last_freeze = now

    def paused_for(self, t: Ticket, now: float) -> float:
        """How long this attempt has been paused, in all."""
        return t.frozen_attempt + (max(0.0, now - t.frozen_at) if t.frozen and t.frozen_at else 0.0)

    def freeze(self, t: Ticket, frozen: bool, now: float, why: str) -> None:
        try:
            proc = self.runner_of(t).freeze(t, frozen)
            if proc is not None:
                self.helpers.append((proc, now + 30))
        except OSError as e:
            log(f"can't {'pause' if frozen else 'resume'} {t.id}: {e}", level=4)
            if frozen:
                return
            # A thaw that couldn't even be sent still has its minute: then the build is stopped.
        observable = bool(t.cg) and cgroup_frozen(t.cg) is not None
        # A pause begins, and ends, when the cgroup says so (reconcile_freezes); where that can't be
        # seen, at once.
        if frozen:
            t.frozen, t.frozen_at, t.thaw_failed = True, (None if observable else now), False
        elif not observable:
            if t.frozen_at:
                t.frozen_attempt += max(0.0, now - t.frozen_at)
            t.frozen, t.frozen_at = False, None
        t.freeze_asked = (frozen, now)
        self.save(t)
        self.broadcast(t, now)
        log(f"asked {t.id} to {'pause' if frozen else 'go on'}: {why}", level=4)

    def reconcile_freezes(self, builds: list[Ticket], now: float) -> None:
        """The build's own cgroup.freeze says whether buildq's pause is set; cgroup.events whether
        it took (a frozen parent, buildq.slice say, freezes a build too, but that isn't buildq's
        pause, and isn't taken for one). A pause counts from when it is seen to take. A request that
        hasn't taken after 15 s is sent once more; after a minute the daemon gives up: a freeze that
        never took is undone (so it can't land later), and this attempt isn't paused again; a thaw
        that never took (its own setting still frozen) means the build can't go on, so it is
        stopped, if shed_memory is on. With no request pending, the ticket follows the build's own
        setting (a freeze that landed late; a thaw from before a restart)."""
        for t in builds:
            own = cgroup_freeze_set(t.cg) if t.cg else None
            took = cgroup_frozen(t.cg) if t.cg else None
            if t.freeze_asked is None:
                if own is None:
                    if t.frozen and t.frozen_at is None:
                        t.frozen_at = now  # can't be seen: paused, as far as is known, from now
                elif own and not t.frozen and parent_freeze_set(t.cg):
                    pass  # its slice is frozen (older systemd sets each member's own setting too): not buildq's
                elif own and not t.frozen:
                    t.frozen, t.frozen_at = True, (now if took else None)
                    if not t.freeze_failed:  # (else it is buildq's own freeze, whose undo didn't take)
                        log(f"{t.id} is set paused, though buildq didn't mean it to be; taking it so", level=4)
                    self.save(t)
                    self.broadcast(t, now)
                elif not own and t.frozen:
                    if t.frozen_at:
                        t.frozen_attempt += max(0.0, now - t.frozen_at)
                    t.frozen, t.frozen_at, t.thaw_failed = False, None, False  # (thawed by someone: it may be again)
                    self.save(t)
                    self.broadcast(t, now)
                elif own and took and t.frozen_at is None:
                    t.frozen_at = now
                    self.save(t)
                continue
            wanted, asked, retried = (list(t.freeze_asked) + [False, False])[:3]
            if own is None:
                continue
            done = (own and took) if wanted else not own  # a thaw is done once its own setting is clear
            if done:
                if wanted and t.frozen_at is None:
                    t.frozen_at = now  # it took: the pause counts from here
                elif not wanted:  # thawed (a parent may still hold it, but that isn't buildq's pause)
                    if t.frozen_at:
                        t.frozen_attempt += max(0.0, now - t.frozen_at)
                    t.frozen, t.frozen_at, t.thaw_failed = False, None, False
                    self.broadcast(t, now)
                t.freeze_asked = None
                self.save(t)
                continue
            if now - asked >= 60:
                if wanted:  # a freeze that never took: undo it, so it can't land later; and no more tries
                    log(f"{t.id} hadn't paused a minute after it was asked to; undoing it, and not pausing it "
                        "again", level=4)
                    t.frozen, t.frozen_at, t.freeze_failed = False, None, True
                    try:
                        proc = self.runner_of(t).freeze(t, False)
                        if proc is not None:
                            self.helpers.append((proc, now + 30))
                    except OSError:
                        pass
                    t.freeze_asked = (False, now)  # tracked: if even the undo doesn't take, the build is stopped
                elif self.cfg.shed_memory:  # a thaw that never took: it can't go on, so it is stopped
                    undo = t.freeze_failed  # (the undo of a freeze that never took, rather than a pause)
                    log(f"{t.id} hadn't {'had its pause undone' if undo else 'resumed'} a minute after it was asked "
                        "to; stopping it", level=4)
                    t.freeze_asked = None
                    self.shed(t, now, why="its pause couldn't be undone" if undo
                              else "it couldn't be resumed after a pause")
                    continue
                else:
                    log(f"{t.id} hadn't resumed a minute after it was asked to, and shed_memory is off: "
                        "leaving it paused", level=4)
                    t.freeze_asked, t.thaw_failed = None, True  # not asked again: it would only fail again
                self.save(t)
                self.broadcast(t, now)
            elif now - asked >= 15 and not retried:
                t.freeze_asked = (wanted, asked, True)  # once more, not on every tick
                try:
                    proc = self.runner_of(t).freeze(t, wanted)
                    if proc is not None:
                        self.helpers.append((proc, now + 30))
                except OSError:
                    pass

    def thaw_all(self, now: float) -> None:
        """Before the daemon stops: nothing would resume a paused build while it is gone. Nothing
        will see these thaws take either, so the pauses end, for the record, as they are sent."""
        for t in self.active():
            if t.frozen and not t.flock:
                if not (t.freeze_asked and not t.freeze_asked[0]):
                    self.freeze(t, False, now, "the daemon is stopping")
                else:  # a thaw pending: send it once more, the last chance before the daemon goes; its minute stays
                    try:
                        proc = self.runner_of(t).freeze(t, False)
                        if proc is not None:
                            self.helpers.append((proc, now + 30))
                    except OSError:
                        pass
                if t.frozen_at:
                    t.frozen_attempt += max(0.0, now - t.frozen_at)
                t.frozen_at = None  # the pause ends here for the record; the thaw stays asked for until seen
                self.save(t)

    def shed(self, t: Ticket, now: float, why: str | None = None) -> None:
        """Stop a build (to free its memory, or `why`); check() queues it again once it is gone, if it may be."""
        avail = fmt_size(self.machine.mem_available)
        stopped = f"stopped ({why})" if why else f"stopped to free memory (only {avail} was free)"
        if not (t.restartable or restart_safe(t.argv, self.cfg.restartable_scripts)):
            t.shed_error = (f"{stopped}. It isn't started again by itself, as it might repeat what it had done (a "
                            "script, a push): run it again once the machine has room, or submit it with "
                            "--restartable if starting over is safe (or list the script in the machine's "
                            "restartable_scripts)")
        elif t.env is None:
            t.shed_error = (f"{stopped}. Its environment is gone since the daemon restarted, so it isn't queued "
                            "again: run it again")
        elif t.requeues - t.ci_stops >= 3:  # (stops for a CI job's build don't count: those are limited apart)
            t.shed_error = f"{stopped} for the fourth time; run it again later"
        if t.frozen and t.frozen_at:  # its pause ends here: it is being killed
            t.frozen_attempt += max(0.0, now - t.frozen_at)
        t.frozen, t.frozen_at, t.freeze_asked = False, None, None
        t.requeue_pending = True
        self.stop(t, now, force=True)  # SIGKILL reaches frozen processes too
        self.save(t)
        self.broadcast(t, now)
        cause = why or (f"to free memory: only {avail} is free (a quarter of the floor is "
                        f"{fmt_size(self.cfg.mem_floor / 4)})")
        log(f"stopping {t.id} ({fmt_size(t.mem_now)}) {cause}{'' if t.shed_error else '; it will be queued again'}",
            level=4)

    CI_STOPS_MAX = 2  # times one build may be stopped to make room for CI jobs' builds
    ROOM_PAUSE = 120.0  # seconds after making room for a CI job's build, while it is queued, before more is made

    def was_overdue(self, t: Ticket) -> bool:
        """It went before CI jobs' builds when it started: it had waited three times starve_seconds,
        or it had been stopped once, and its lane doesn't pass held room (see queue)."""
        if self.lane(t.lane).may_pass_held:
            return False  # never overdue there: it gets no head start, and none to protect
        return t.requeues > 0 or (t.started is not None and t.started - t.submitted >= 3 * self.cfg.starve_seconds)

    def make_room_for_ci(self, now: float) -> None:
        """A CI job's build that has waited make_room_for_ci for memory that builds of ours hold: stop
        the newest of the builds that can start over safely (a compile or test run, or --restartable),
        of its priority or lower and not a CI job's, whose memory covers what it lacks, else the newest
        few that do together, and queue them again (see requeue). Each yields to it (doesn't start,
        whatever its lane) until it has started, or for YIELD_MAX, then goes first, as a build stopped
        to free memory does. What it lacks is worked out again after the pass, with the builds the pass
        started. None is stopped if all of them together wouldn't make it fit, nor one stopped
        CI_STOPS_MAX times already, nor any for a CI job's build in a lane that passes held room (it
        holds none, so what is freed could go elsewhere). One CI job's build at a time: not while
        builds stopped for the last are still going, nor within ROOM_PAUSE of making room for one
        that is still queued."""
        wait = self.cfg.make_room_for_ci
        self.room_made = {k: v for k, v in self.room_made.items()
                          if k in self.tickets and self.tickets[k].state == "queued"}
        if not wait or self.stopping or self.paused is not None:
            return
        if any(t.requeue_pending and t.yields_to for t in self.active()):
            return  # builds stopped for a CI job's build are still going: their memory isn't free yet
        if any(now - made < self.ROOM_PAUSE for made in self.room_made.values()):
            return  # room was just made for one that is still queued: it starts first (what it frees may lag)
        if any(t.cancel_requested and not t.flock for t in self.active()):
            return  # a cancelled build (a CI job past its time limit, say) is giving its memory back: wait for it
        running = self.active()
        free_now = None
        for ci in self.queue(now):
            if not (ci.from_ci and ci.short_by > 0 and now - ci.submitted >= wait
                    and not self.lane(ci.lane).may_pass_held  # it holds no room: what is freed could go elsewhere
                    ):
                continue
            if ci.short_agents > 0 and not self.cfg.make_room_behind_agents:
                continue  # it waits partly behind agents' builds that have waited longer: they go first (#38)
            # What it lacks now, after the builds this pass started (one in a lane that passes held
            # room may have taken what was free), with the room still held ahead of it.
            if free_now is None:
                # Read again rather than this tick's sample (only once a CI build is due): a build that
                # ended in check() since has given its memory back, and stopping one for it would be
                # for nothing.
                read = getattr(self.machine, "read_available", None)
                available = read() if read is not None else self.machine.mem_available
                free_now = available - sum(self.still_to_grow(t, now) for t in running) - self.cfg.mem_floor
            short = ci.est_mem - (free_now - ci.short_hm)
            if short <= 0:
                continue  # it fits: it starts on the next pass
            weight = self.weight(ci)
            spare = self.cfg.make_room_spare_after
            protect = not self.cfg.make_room_behind_agents
            builds = [t for t in running if not t.flock and t.state == "running" and not t.from_ci
                      and not t.cancel_requested and not t.requeue_pending and t.started is not None
                      and self.weight(t) <= weight and t.ci_stops < self.CI_STOPS_MAX
                      and (t.restartable or restart_safe(t.argv, self.cfg.restartable_scripts)) and t.env is not None
                      and t.requeues - t.ci_stops < 3
                      and not (spare and now - t.started - self.paused_for(t, now) >= spare)  # far along: spared
                      and not (protect and self.was_overdue(t))]  # its turn came first (#38)
            gives = {t.id: t.mem_now + self.still_to_grow(t, now) for t in builds}  # what admission sets aside
            newest = sorted(builds, key=lambda t: t.started, reverse=True)
            chosen = next(([t] for t in newest if gives[t.id] >= short), None)
            if chosen is None:
                chosen, total = [], 0.0
                for t in newest:
                    chosen.append(t)
                    total += gives[t.id]
                    if total >= short:
                        break
                else:
                    continue  # stopping every one of them wouldn't make it fit
            self.room_made[ci.id] = now
            waited = f"{(now - ci.submitted) / 60:.0f} min"
            for t in chosen:  # (counted in ci_stops once it is gone: it may yet finish by itself)
                t.yields_to, t.yield_until = ci.id, now + self.YIELD_MAX
                self.shed(t, now, why=f"to make room for a CI job's build that has waited {waited} for "
                                      f"{fmt_size(short)} more memory: {ci.label[:60]} ({ci.id[:8]})")
            return

    def requeue(self, t: Ticket, now: float) -> None:
        """A build stopped to free memory is gone: queue it again, at the front, or fail it."""
        self.drop_queries(t)  # its attempt's answers are no use to the next one, or to no one
        result = read_json(os.path.join(t.dir, "result.json"))  # its kills, before the file goes
        if isinstance(result, dict):
            t.kills_seen = max(t.kills_seen, int(sane_count(result.get("oom_kills")) or 0))
            t.kills_own_cap = t.kills_own_cap or oom_of(result)
        if t.cancel_requested:
            self.finalize(t, now, None)  # cancelled while it was being stopped: it stays cancelled
            return
        if t.shed_error or t.env is None:
            self.finalize(t, now, None, error=t.shed_error or "stopped to free memory; its environment is gone "
                                                              "since the daemon restarted: run it again")
            return
        try:  # unload the old service; the next attempt has a name of its own
            proc = self.runner_of(t).cleanup(t)
            if proc is not None:
                self.helpers.append((proc, now + 60))
        except OSError:
            pass
        self.close_jobserver(t, remove=True)
        try:
            for name in ("result.json", "supervisor.json", "child.json"):
                try:
                    os.remove(os.path.join(t.dir, name))
                except FileNotFoundError:
                    pass
            write_json(os.path.join(t.dir, "env.json"), t.env)
            ci = self.tickets.get(t.yields_to) if t.yields_to else None
            cause = ("because the machine ran short of memory" if not t.yields_to else
                     f"to make room for a CI job's build ({ci.label[:60]}, {ci.id[:8]})" if ci is not None
                     else "to make room for a CI job's build")
            marker = (f"\nbuildq: stopped at {time.strftime('%H:%M:%S')} {cause}; "
                      "it starts again from the beginning when there is room.\n").encode()
            offsets = {}
            for name in ("output.log", "stderr.log", "stdout.log"):
                with open(os.path.join(t.dir, name), "a+b") as f:
                    if name != "stdout.log":  # stdout may be parsed: keep the note out of it
                        f.write(marker)
                    elif f.tell():
                        f.seek(-1, os.SEEK_END)
                        if f.read(1) != b"\n":
                            f.write(b"\n")  # end a line the stop cut, so the next attempt's first line is whole
                    offsets[name] = f.tell()
        except OSError as e:
            self.finalize(t, now, None, error=f"stopped to free memory, and couldn't be queued again: {e}")
            return
        t.attempt_offsets = offsets
        if t.frozen and t.frozen_at:
            t.frozen_attempt += max(0.0, now - t.frozen_at)
        attempt = max(0.0, now - (t.started or now) - t.frozen_attempt)
        self.close_release_audit(t, attempt)
        t.attempts_wall += attempt
        t.frozen_total += t.frozen_attempt
        t.frozen_attempt = 0.0
        t.attempts_cpu += max(0, t.cpu_usec - (t.cpu_usec_base or 0)) / 1e6
        t.attempts_mem_wait += t.mem_wait_some
        t.attempts_mem_high += t.mem_high
        t.attempts_peak = max(t.attempts_peak, t.mem_peak)
        t.force_sent = t.freeze_failed = t.thaw_failed = False
        t.state, t.started, t.running_since, t.result_seen, t.stop_sent = "queued", None, None, None, None
        t.unit = t.cg = t.launcher = t.last_grant_t = t.cpu_usec_base = t.freeze_asked = None
        t.granted = t.max_granted = t.tokens_out = 0
        t.measured = t.elastic = t.frozen = t.requeue_pending = False
        t.frozen_at = None
        t.samples.clear()
        t.cores_now, t.mem_now, t.cpu_usec, t.grant_area = 0.0, 0, 0, 0.0
        t.mem_peak, t.peak_cores, t.peak_mem_cores = 0, 0.0, 0
        t.peak_at, t.tail, t.trace, t.trace_merges, t.released = 0.0, 0, [], 1, False
        t.release_at, t.release_hold, t.after_release_peak, t.release_revoked = None, 0, 0, False
        t.settled_since, t.swap_now, t.observed_gap, t.release_end, t.peak_cpu = None, 0, False, None, 0.0
        t.release_est = t.release_oom_base = t.kills_seen = 0
        t.release_breach = t.kills_own_cap = t.release_open_at_gap = False
        t.mem_wait_some = t.mem_wait_full = 0.0
        t.mem_high = 0
        t.source_verified = None  # the next attempt is checked afresh
        t.source_checks = {}
        t.requeues += 1
        for_ci = bool(t.yields_to)  # stopped for a CI job's build (make_room_for_ci)
        if for_ci:
            t.ci_stops += 1
            if not self.yielding(t, now):  # it has started, left the queue or waited YIELD_MAX: nothing to yield to
                t.yields_to = t.yield_until = None
        t.queued_at = t.wait_mark = now
        if self.yielding(t, now):
            t.reason_cat, t.reason = "held", ("stopped to make room for a CI job's build; it goes first once "
                                              "that has started")
        elif for_ci:
            t.reason_cat, t.reason = "memory", ("stopped to make room for a CI job's build, which no longer needs "
                                                "it; it goes first once there is room")
        else:
            t.reason_cat, t.reason = "memory", "stopped to free memory; it goes first once there is room"
        self.save(t)
        self.broadcast(t, now)
        what = "make room for a CI job's build" if for_ci else "free memory"
        log(f"queued {t.id} again: stopped to {what} ({t.requeues} time{'s' if t.requeues != 1 else ''})", level=4)

    # ---- checking that a build built the source its record says

    SOURCE_CHECKS_AT_ONCE = 3

    def check_source(self, t: Ticket, phase: str, now: float) -> None:
        """Fingerprint the build's tree again, in a process of its own (`buildq source DIR`, with the
        submitter's git settings), as it starts and as it ends: the build uses what is on disk then,
        which may no longer be what was recorded when it was submitted. Only a build whose tree
        matched both times can answer a later submission, or tell GitHub it passed. At most three
        checks run at once; the rest wait their turn."""
        self.source_wanted.append((t.id, phase, t.requeues))
        self.start_source_checks(now)

    def start_source_checks(self, now: float) -> None:
        while self.source_wanted and len(self.source_checks) < self.SOURCE_CHECKS_AT_ONCE:
            tid, phase, attempt = self.source_wanted.popleft()
            t = self.tickets.get(tid)
            if t is None or t.requeues != attempt:
                continue
            env = {"LC_ALL": "C", **t.git_env} if t.git_env else None
            try:
                proc = subprocess.Popen([*self.source_command, t.cwd], stdin=DEVNULL, stdout=subprocess.PIPE,
                                        stderr=DEVNULL, start_new_session=True, env=env)
            except OSError as e:
                log(f"can't check {t.id}'s source: {e}")
                t.source_checks[phase] = False
                continue
            self.source_checks.append((proc, tid, phase, now + 30, attempt))

    def collect_source_checks(self, now: float) -> None:
        for entry in list(self.source_checks):
            proc, tid, phase, deadline, attempt = entry
            if proc.poll() is None:
                if now < deadline:
                    continue
                try:  # the helper and the git under it
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass
                proc.wait()
            self.source_checks.remove(entry)
            try:
                seen = json.loads(proc.stdout.read() or b"null") if proc.returncode == 0 else None
            except ValueError:
                seen = None
            proc.stdout.close()
            t = self.tickets.get(tid)
            if t is None or not t.source or t.requeues != attempt:
                continue  # gone, or a check of an attempt since stopped: it says nothing of this one
            same = isinstance(seen, dict) and seen.get("commit") == t.source["commit"] \
                and seen.get("fingerprint") == t.source["fingerprint"]
            t.source_checks[phase] = same
            if isinstance(seen, dict) and not same:
                t.source_changed = True
                log(f"{t.id}'s source changed {'before it started' if phase == 'start' else 'while it ran'}: "
                    "it answers no later submission")
            if "start" in t.source_checks and "end" in t.source_checks and t.state in FINISHED:
                t.source_verified = bool(t.source_checks["start"] and t.source_checks["end"]) and not t.source_changed
                if t.source_verified:
                    self.note_status(t, now)
            self.save(t)
        self.start_source_checks(now)

    # ---- telling GitHub what passed

    def note_status(self, t: Ticket, now: float) -> None:
        """With github_status on, a check (see reusable_check) or a named build that passed on a
        commit with no changes on top, its source the same at its start and end, says so on GitHub,
        as a status of that commit, so its pull request shows it was verified here. A later failure of
        the same check on the same commit, the check's own verdict (an exit of 1 to 127; not a kill,
        a timeout or a stop to free memory), turns that status red; other failures aren't posted (a
        local failure on the way to a fix is noise on a pull request). Results are ordered by when
        their builds ended, not when their checks did: an older result never replaces a newer one.
        A commit that isn't on GitHub yet is tried again after the next `git push` run through buildq
        from that repository, and every ten minutes, for a day. A build from a GitHub Actions job never
        posts success: the job reports its own result, and on a pull request its commit is usually a
        merge commit the pull request doesn't show. Its failure can still turn a green buildq posted
        on the same commit red."""
        src = t.source or {}
        if t.from_ci and t.state == "succeeded":
            return
        if not self.cfg.github_status or src.get("dirty") or not src.get("remote") or not src.get("commit") \
                or t.source_changed or not t.source_verified or not (t.name or reusable_check(t.argv)) \
                or t.state not in ("succeeded", "failed"):
            return
        if t.state == "failed" and not (isinstance(t.exit, int) and 1 <= t.exit <= 127 and not t.oom
                                        and not t.timed_out and not t.shed_error):
            return
        context = ("buildq/" + (t.name or " ".join(command_words(t.argv))))[:100]
        where = f"{src['remote']}@{src['commit']}@{context}"
        order = [t.ended or now, t.submitted, t.id]  # ties go to the one submitted later
        pending = [p for p in self.status_posts if p.get("where") == where]
        latest = max([p.get("order") or [0, ""] for p in pending] + [self.status_posted.get(where, {}).get("order")
                                                                      or [0, ""]])
        latest = max(latest, self.status_seen.get(where) or [0, ""])
        if order <= latest:
            return  # a result of a build that ended later is already there
        self.status_seen.pop(where, None)
        self.status_seen[where] = order  # newer than anything seen: what came before can't win now
        shown = (max(pending, key=lambda p: p.get("order") or [0, ""])["state"] if pending
                 else self.status_posted.get(where, {}).get("state"))
        if t.state == "failed" and shown != "success":
            self.save_status_posts()
            return  # nothing green to correct, but nothing older may turn it green now either
        in_flight = {id(p) for _, p, _ in self.status_procs}
        for p in pending:  # the newest result replaces older ones not yet sent
            if id(p) not in in_flight:
                self.status_posts.remove(p)
        took = fmt_duration((t.ended or now) - (t.started or now))
        self.status_posts.append({
            "repo": src["remote"], "sha": src["commit"], "state": "success" if t.state == "succeeded" else "failure",
            "context": context, "where": where, "order": order,
            "description": (f"passed on the shared build machine in {took}" if t.state == "succeeded" else
                            f"failed (exit {t.exit}) on the shared build machine")[:140],
            "first": now, "next": now, "ticket": t.id})
        self.save_status_posts()

    def save_status_posts(self) -> None:
        if len(self.status_posted) > 2000:  # (insertion order: the oldest go)
            self.status_posted = dict(list(self.status_posted.items())[-1000:])
        try:
            if len(self.status_seen) > 2000:
                self.status_seen = dict(list(self.status_seen.items())[-1000:])
            write_json(os.path.join(self.state_dir, "github-statuses.json"),
                       {"queue": self.status_posts, "posted": self.status_posted, "seen": self.status_seen})
        except OSError as e:
            log(f"can't save the GitHub statuses to send: {e}")

    def send_status_posts(self, now: float) -> None:
        changed = False
        for entry in list(self.status_procs):
            proc, post, deadline = entry
            code = proc.poll()
            if code is None and now < deadline:
                continue
            if code is None:
                proc.kill()
                proc.wait()
            self.status_procs.remove(entry)
            error = (proc.stderr.read() or b"").decode(errors="replace").strip() if proc.stderr else ""
            if proc.stderr:
                proc.stderr.close()
            newer = any(p is not post and p.get("where") == post.get("where")
                        and (p.get("order") or [0, ""]) > (post.get("order") or [0, ""]) for p in self.status_posts)
            if proc.returncode == 0 or newer:
                if post in self.status_posts:
                    self.status_posts.remove(post)  # sent, or replaced by a newer result for the same check
            if proc.returncode == 0:
                where = post.get("where") or f"{post['repo']}@{post['sha']}@{post['context']}"
                if (post.get("order") or [0, ""]) >= (self.status_posted.get(where, {}).get("order") or [0, ""]):
                    self.status_posted.pop(where, None)
                    self.status_posted[where] = {"state": post["state"], "order": post.get("order") or [0, ""]}
            else:
                post["next"] = now + 600
                if not post.get("logged"):
                    post["logged"] = True
                    log(f"GitHub didn't take the status for {post['repo']}@{post['sha'][:8]} (trying again in ten "
                        f"minutes, for a day): {error[:300] or f'gh exited {proc.returncode}'}", level=4)
            changed = True
        for post in list(self.status_posts):
            if now - post["first"] > 86400:
                why = "it didn't take it" if post.get("logged") else "gh couldn't be run"  # (logged: GitHub said no)
                log(f"gave up telling GitHub about {post['repo']}@{post['sha'][:8]}: {why} for a day")
                self.status_posts.remove(post)
                changed = True
        busy = {id(p) for _, p, _ in self.status_procs}
        sending = {p.get("where") for _, p, _ in self.status_procs}
        for post in self.status_posts if self.cfg.github_status else ():
            if len(self.status_procs) >= 2:
                break
            if id(post) in busy or post["next"] > now or post.get("where") in sending:
                continue  # one at a time per commit and check, so they land in order
            if any(p.get("where") == post.get("where") and (p.get("order") or [0, ""]) > (post.get("order") or [0, ""])
                   for p in self.status_posts):
                continue  # a newer result for it is queued
            command = [*(self.gh or [self.cfg.gh or find_gh()]), "api", "--method", "POST", f"repos/{post['repo']}/statuses/{post['sha']}",
                       "-f", f"state={post['state']}", "-f", f"context={post['context']}",
                       "-f", f"description={post['description']}"]
            try:
                proc = subprocess.Popen(command, stdin=DEVNULL, stdout=DEVNULL, stderr=subprocess.PIPE,
                                        start_new_session=True)
            except OSError as e:
                if not self.gh_unrunnable:  # once, not once per result every ten minutes
                    where = (" (it isn't on PATH, in ~/.local/bin or in ~/bin; the gh setting names it)"
                             if command[0] == "gh" else "")
                    log(f"can't run gh to tell GitHub a build's result{where}: {e}")
                    self.gh_unrunnable = True
                post["next"] = now + 600
                changed = True
                continue
            self.gh_unrunnable = False
            self.status_procs.append((proc, post, now + 60))
        if changed:
            self.save_status_posts()

    # ---- admission

    def disk_short(self, t: Ticket) -> tuple[int, int, int, str] | None:
        """(free, floor, size, path) of the filesystem where a build would write that is furthest
        under its floor, or None if every one has its floor free. Those are its own (directory,
        CARGO_TARGET_DIR, TMPDIR), buildq's state directory (its log and ticket go there), and, for
        an image build (docker, podman, buildah), the container storage that exists. The floor is
        disk_floor (a size) or, given as a percentage, disk_floor_share of that filesystem's own
        size. A path whose filesystem can't be read is skipped. The floor gates starts only: builds
        already running can still write below it."""
        paths = [*(t.disk_paths or [t.cwd]), self.state_dir]
        remote = str((t.env or {}).get("DOCKER_HOST") or (t.env or {}).get("CONTAINER_HOST") or "")
        if _tool_and_args(t.argv)[0] in ("docker", "podman", "buildah") and not remote.startswith(("tcp:", "ssh:")):
            for path in self.cfg.container_storage:  # (a build on a remote engine writes there, not here)
                try:
                    os.stat(path)
                except FileNotFoundError:
                    continue  # (not on this machine)
                except OSError as e:
                    if path not in self.storage_unreadable:  # once
                        self.storage_unreadable.add(path)
                        log(f"can't read container storage at {path} ({e}); name a readable directory on "
                            "that filesystem in container_storage, or image builds aren't held to disk_floor there")
                    continue
                paths.append(path)
        worst, devices = None, set()
        for path in paths:
            device = fs_device(path)  # None: unreadable (disk_space says what it can)
            if device is not None:
                if device in devices:
                    continue  # that filesystem is counted already
                devices.add(device)
            space = disk_space(path)
            if space is None:
                continue
            free, size = space
            floor = max(self.cfg.disk_floor, int(self.cfg.disk_floor_share * size))
            if free < floor and (worst is None or free - floor < worst[0] - worst[1]):
                worst = (free, floor, size, path)
        return worst

    def add_wait(self, t: Ticket, now: float) -> None:
        """Count the time since the last pass as waited for the reason the ticket had then."""
        if t.wait_mark is not None and now > t.wait_mark:
            reason = t.reason_cat or "new"
            t.waited_by[reason] = round(t.waited_by.get(reason, 0.0) + (now - t.wait_mark), 1)
        t.wait_mark = now

    def save_queued(self, now: float) -> None:
        """At shutdown: queued tickets' waits so far, by reason, so the next daemon goes on from them,
        and every running build's latest state (its peak, its past-the-peak record)."""
        for t in list(self.tickets.values()):
            if t.state == "queued":
                self.add_wait(t, now)
            if t.state not in FINISHED and not t.flock:
                self.save(t)

    def still_to_grow(self, t: Ticket, now: float) -> int:
        """What a running build may still grow into: its expected peak less what it holds now. With
        release_after_peak = true, a build released past its peak (past_peak_hold) is held to what its
        command's runs used after their peaks instead. In "shadow" mode the same is worked out and
        recorded, but the full room stays held; a decision made in shadow mode never takes effect,
        even if the mode is switched on later."""
        full = max(0, t.est_mem - t.mem_now)
        if not self.cfg.release_after_peak and t.release_at is not None and not t.release_revoked:
            t.release_revoked, t.release_end = True, round(max(0.0, now - (t.started or now)), 1)  # switched off
            self.save(t)
        if not self.cfg.release_after_peak or t.flock or t.state != "running":
            return full
        hold = self.past_peak_hold(t, now)
        if hold is None or self.cfg.release_after_peak is not True or not t.released:  # ("shadow")
            return full
        return max(0, min(t.est_mem, hold) - t.mem_now)

    def past_peak_hold(self, t: Ticket, now: float) -> int | None:
        """The memory to keep held for a build that is past its peak, or None. It is past its peak
        once all of these have held for SETTLE_SECONDS:
        - its lane allows it; it isn't a cold build or one given a size (--mem); it hasn't been
          paused or asked to pause, or gone over its MemoryHigh, this attempt; and it wasn't picked
          up after a daemon restart (any of these later takes a release back);
        - History.after_peak has its command's runs (the runs behind the estimate, all successful);
        - it has run 1.25 times the latest of their peaks and a minute more, and used 1.25 times
          the most CPU-seconds any of them had used by its peak (so a build on fewer cores, slower
          to its peak, waits for it); and its own peak was a minute or more ago;
        - its peak reached 0.8 of the peak behind the estimate, on no more cores than that had;
        - what it uses now, swap included, is at most 0.7 of its peak and at most what those runs
          used after their peaks, times 1.1 (the hold).
        Once released, a build that uses more than its hold is taken back for the rest of the
        attempt (measure() notices on every sample)."""
        if t.observed_gap and t.cpu_usec_base is None and t.release_at is not None and not t.release_revoked:
            return None  # picked up after a restart: the first sample says first whether it went over meanwhile
        if (not self.could_release(t) or t.observed_gap or t.frozen or t.freeze_asked is not None
                or t.frozen_attempt > 0 or t.mem_high > 0 or t.mem_peak <= 0 or not t.started
                or t.oom_kills > t.release_oom_base or (t.release_at is None and t.oom_kills > 0)):
            t.settled_since = None
            if t.release_at is not None and not t.release_revoked:
                t.release_revoked, t.release_end = True, round(max(0.0, now - t.started), 1)
                t.release_breach = t.oom_kills > t.release_oom_base
                self.save(t)
                if t.released:
                    log(f"{t.id} was paused, restarted, slowed at its MemoryHigh or opted out after its peak; "
                        f"holding its full {fmt_size(t.est_mem)} again", level=4)
            return None
        if t.release_at is not None:
            return None if t.release_revoked else t.release_hold
        after = self.history.after_peak(t.key, self.cfg, now)
        if after is None:
            t.settled_since = None
            return None
        latest, tail, top_peak, top_cores, peak_cpu = after
        hold = int(tail * 1.1)
        used = t.mem_now + t.swap_now
        elapsed = now - t.started
        cpu = max(0, t.cpu_usec - (t.cpu_usec_base or 0)) / 1e6
        if not (elapsed >= latest * 1.25 + 60 and cpu >= peak_cpu * 1.25 and elapsed - t.peak_at >= 60
                and t.mem_peak >= 0.8 * top_peak
                and (not top_cores or (t.granted <= top_cores and (t.peak_mem_cores or t.granted) <= top_cores))
                and used <= 0.7 * t.mem_peak and used <= hold and hold < t.est_mem):
            t.settled_since = None
            return None
        if t.settled_since is None:
            t.settled_since = now
        if now - t.settled_since < self.SETTLE_SECONDS:
            return None
        t.release_at, t.release_hold, t.after_release_peak = round(elapsed, 1), hold, used
        t.release_est, t.release_oom_base = t.est_mem, t.oom_kills
        if self.cfg.release_after_peak is True:
            t.released = True
            log(f"{t.id} is past its peak ({fmt_size(t.mem_peak)}, {elapsed:.0f}s in); holding "
                f"{fmt_size(hold)} for it instead of {fmt_size(t.est_mem)}")
        self.save(t)  # so a restart knows a decision was made
        return hold

    def could_release(self, t: Ticket) -> bool:
        """What rules a build out of "past the peak" from the start: its lane opts out, it is a cold
        build, or its caller gave its size."""
        return self.lane(t.lane).release_after_peak and not t.cold and not t.mem_given

    def close_release_audit(self, t: Ticket, elapsed: float) -> None:
        """At the end of an attempt (it finished, or was stopped to be queued again), add up what
        "past the peak" said about it, so a requeue doesn't lose it:
        - picked up after a daemon restart: unknown, if it had a decision or its command could have
          had one (part of it ran unwatched);
        - past its peak: went over what would be kept (a sample over it, or killed for memory after
          the decision, which a sample may have missed), and by how much at most; and the held room
          it would have freed, from the decision until it went over or ended, against the
          reservation it had at the decision."""
        kills = max(t.oom_kills, t.kills_seen)
        if t.observed_gap:
            # A daemon restart left it unwatched for a while. A decision taken back before that is
            # counted as usual, and so is a breach seen after it; a decision that stood across the
            # gap, or none where its command could have had one, says nothing.
            if t.release_at is None:
                after = self.history.after_peak(t.key, self.cfg, time.time()) if self.cfg.release_after_peak else None
                if (after is not None and t.measured and self.could_release(t) and t.mem_high == 0
                        and t.frozen_attempt == 0 and int(after[1] * 1.1) < t.est_mem
                        and (not after[3] or t.granted <= after[3])
                        and elapsed >= after[0] * 1.25 + 60 + self.SETTLE_SECONDS):
                    t.past_peak_unknown += 1  # it could have had a decision while nobody watched
                return
            if t.release_open_at_gap and not t.release_breach:
                # Killed for memory, the decision standing when this daemon loaded it, and no sample
                # since (its cgroup was gone first: a kill in the result, or systemd's verdict): the
                # kill came while the decision stood. Anything else, nobody can say.
                killed = kills > t.release_oom_base or (t.oom and not t.timed_out and not t.cancel_requested)
                if killed and t.release_stood_at_load and t.cpu_usec_base is None:
                    t.release_revoked = t.release_breach = True
                else:
                    t.past_peak_unknown += 1
                    return
        if t.release_at is None:
            return
        t.past_peak_attempts += 1
        t.past_peak_released += int(t.released)
        over = t.after_release_peak - t.release_hold  # (followed while the decision stood, and after a breach)
        if not (t.release_revoked and not t.release_breach):  # taken back for another reason: what came after isn't the rule's
            killed = kills > t.release_oom_base or (t.oom and not t.timed_out and not t.cancel_requested)
            if killed:
                lane = self.lane(t.lane)
                own = t.kills_own_cap and lane.mem_cap and self.runner_of(t).name == "systemd"
                # At its own cap it used that much; killed from outside (the slice's limit, oomd), it
                # may not have grown at all, so count what was let go.
                size = (lane.mem_cap if own else (t.release_est or t.est_mem)) - t.release_hold
                over = max(over, size, 1)
                t.release_breach = True
                if t.release_end is None:
                    t.release_end = round(elapsed, 1)
        if over > 0:
            t.past_peak_over += 1
            t.past_peak_most_over = max(t.past_peak_most_over, over)
        until = t.release_end if t.release_end is not None else elapsed
        t.past_peak_freed += max(0, (t.release_est or t.est_mem) - t.release_hold) * max(0.0, until - t.release_at)

    SETTLE_SECONDS = 30

    def schedule(self, now: float) -> None:
        if self.stopping:
            return
        cfg, m = self.cfg, self.machine
        for t in self.tickets.values():
            if t.state == "queued":
                self.add_wait(t, now)
        running = self.active()
        growth = sum(self.still_to_grow(t, now) for t in running)
        ramping = sum(max(0.0, t.est_cores - t.cores_now) for t in running
                      if t.started and now - t.started < cfg.ramp_seconds)
        # Cores that resizable builds could hand back, down to their minimum.
        shrinkable = sum(max(0, t.granted - t.need) for t in running if t.elastic and not t.rigid)
        ours_now = sum(t.mem_now for t in running if not t.flock)
        free_mem = m.mem_available - growth - cfg.mem_floor
        cpu_cap = cfg.cpu_target * m.ncpu
        free_cpu = cpu_cap - m.busy - ramping
        self.budget = {
            "free_mem": free_mem, "free_cores": round(free_cpu, 2), "cpu_cap": round(cpu_cap, 2),
            "shrinkable_cores": shrinkable, "growth_reserved": growth, "ramp_reserved": round(ramping, 2),
            "running": len(running),
        }
        count = len(running)
        per_lane = collections.Counter(t.lane for t in running)
        held_mem = held_cpu = 0.0
        held_agents = 0.0  # of held_mem, the room held for builds that aren't CI jobs' (#38)
        # Room held for CI jobs' builds by ci_first, as (priority, memory, cores): it binds only
        # builds of the same priority or lower, so a higher lane can still start in room that is free.
        ci_holds: list[tuple[int, float, float]] = []
        busy_workspaces: dict[tuple[str, str], Ticket] = {}
        for t in running:
            if not t.workspace:
                continue
            # Under the group it started with, and the group the lane it started in has now (a reload
            # may have regrouped it); a lane removed since holds only the group it started with.
            groups = {t.workspace_group} if isinstance(t.workspace_group, str) and t.workspace_group else set()
            if t.group_lane in cfg.lanes and cfg.lanes[t.group_lane].exclusive:
                groups.add(cfg.lanes[t.group_lane].workspace_group)
            for group in groups:
                busy_workspaces[(group, t.workspace)] = t
        if self.paused is not None:
            why = self.paused.get("reason") or "no reason given"
            for t in self.queue(now):
                t.held = False
                t.reason_cat, t.reason = "paused", f"the queue is paused ({why}); `buildq resume` starts it again"
            self.budget.update(held_mem=0, held_cores=0)
            return
        for t in self.queue(now):
            self.estimate(t, now)  # history or the configuration may have changed since it was queued
            lane = self.lane(t.lane)
            passes = lane.may_pass_held
            weight = self.weight(t)
            hm = 0.0 if passes else held_mem + sum(mem for w, mem, _ in ci_holds if w >= weight)
            hc = 0.0 if passes else held_cpu + sum(cores for w, _, cores in ci_holds if w >= weight)
            t.held = False
            t.short_by = 0.0
            reason, holds = None, True
            if not os.path.isdir(t.cwd):
                self.finalize(t, now, None, error=f"its working directory {t.cwd} is gone")
                continue
            short = self.disk_short(t)
            if t.est_mem > m.mem_total - cfg.mem_floor:
                reason, holds = ("too-big", f"needs {fmt_size(t.est_mem)} of memory, more than this machine has "
                                            f"({fmt_size(m.mem_total - cfg.mem_floor)} above the floor); cancel it "
                                            "or give its lane a smaller MemoryMax"), False
            elif short is not None:
                free, floor, size, where = short
                said = (f"{cfg.disk_floor_share * 100:g}% of its {fmt_size(size)}, {fmt_size(floor)}"
                        if floor > cfg.disk_floor else fmt_size(floor))
                reason, holds = ("disk", f"only {fmt_size(free)} of disk is free at {where} "
                                         f"(disk_floor is {said})"), False
            elif self.yielding(t, now):  # whatever its lane: it would take back the room it gave
                reason, holds = ("held", f"it was stopped to make room for a CI job's build ({t.yields_to[:8]}); it "
                                         "starts once that has started"), False
            elif lane.exclusive and (lane.workspace_group, t.workspace) in busy_workspaces and not (
                    # a CI job's build held by ci_first binds only builds of its priority or lower
                    (holder := busy_workspaces[(lane.workspace_group, t.workspace)]).state == "queued"
                    and not self.waited_out(holder, now) and weight > self.weight(holder)):
                what = ("is running" if holder.state != "queued" else
                        "is a CI job's, which goes first, and is held" if not self.waited_out(holder, now)
                        else "has waited longest and is held")
                reason, holds = ("workspace", f"another build in the same workspace {what} ({holder.label[:60]}, "
                                              f"{(holder.group_lane or holder.lane) if holder.state != 'queued' else self.lane(holder.lane).name} "
                                              f"lane, {holder.id[:8]}); they would "
                                              "fight over its build directory"), False
                # Kept out only by a CI job's weak hold, a build that has waited out its turn still
                # holds its own room and workspace, so builds behind it can't pass it there.
                # (Not one that couldn't fit even with every build of ours gone: that would stop
                # everything else for nothing.)
                holds = (holder.state == "queued" and not self.waited_out(holder, now) and self.waited_out(t, now)
                         and t.est_mem <= m.mem_available + ours_now - cfg.mem_floor)
            elif m.psi_mem > cfg.mem_psi_block:
                reason = ("memory-pressure", f"memory pressure is {m.psi_mem:.0f}% (no new build above "
                                             f"{cfg.mem_psi_block:g}%)")
            elif per_lane[t.lane] >= lane.extra_jobs and count - sum(
                    min(n, self.lane(name).extra_jobs) for name, n in per_lane.items()) >= cfg.max_jobs:
                # Up to extra_jobs builds of a lane run on top of max_jobs, so a lane of quick builds
                # is never kept waiting for a turn by slow ones; past those it shares the rest.
                reason = ("max-jobs", f"{count} build{'s are' if count != 1 else ' is'} running, the most "
                                      f"allowed (max_jobs = {cfg.max_jobs})")
            elif t.est_mem > free_mem - hm:
                t.short_by = t.est_mem - (free_mem - hm)  # (unless no stopped build could free it, below)
                t.short_hm = hm
                t.short_agents = 0.0 if passes else held_agents
                if t.est_mem <= free_mem:
                    reason = ("held", "the room it needs is held for a build that has waited longer"
                              if passes or t.est_mem > free_mem - held_mem else
                              "the room it needs is held for a CI job's build, which goes first")
                elif t.est_mem > m.mem_available + ours_now - cfg.mem_floor:
                    # It wouldn't fit even with every build of ours gone: holding room for it would
                    # stop everything else for nothing.
                    t.short_by = 0.0
                    reason, holds = ("memory", f"needs {fmt_size(t.est_mem)} of memory; even with no builds "
                                               f"running only {fmt_size(m.mem_available + ours_now - cfg.mem_floor)} "
                                               "would be free: other work holds the rest, and it starts "
                                               "when that ends"), False
                else:
                    reason = ("memory", f"needs {fmt_size(t.est_mem)} of memory; {fmt_size(max(free_mem, 0))} is "
                                        f"free after the {fmt_size(cfg.mem_floor)} floor and what running builds may "
                                        "still grow into")
            elif count > 0 and lane.waits_for_cpu and m.psi_cpu > cfg.cpu_psi_block:
                reason = ("cpu-pressure", f"CPU pressure is {m.psi_cpu:.0f}% (no new build above "
                                          f"{cfg.cpu_psi_block:g}% while one runs)")
            elif count > 0 and lane.waits_for_cpu and t.need > free_cpu + shrinkable - hc:
                if t.need <= free_cpu + shrinkable:
                    reason = ("held", "the room it needs is held for a build that has waited longer"
                              if passes or t.need > free_cpu + shrinkable - held_cpu else
                              "the room it needs is held for a CI job's build, which goes first")
                else:
                    reason = ("cpu", f"needs {t.need} core{'s' if t.need != 1 else ''}; "
                                     f"{max(free_cpu + shrinkable, 0):.1f} of {cpu_cap:.1f} are free "
                                     f"({m.busy:.1f} busy, {ramping:.1f} expected from builds just started)")
            if reason is None:
                room = math.floor(max(free_cpu if count else cpu_cap - m.busy, 0))
                granted = int(max(t.need, min(t.want, room)))
                while granted > t.need and self.mem_for(t, granted) > free_mem - hm:
                    granted -= 1  # more cores would need more memory than is free
                t.est_mem = self.mem_for(t, granted)
                self.start(t, now, granted)
                if t.state in FINISHED:
                    continue
                free_mem -= t.est_mem
                taken_from_others = max(0.0, granted - max(free_cpu, 0))
                free_cpu -= granted
                shrinkable = max(0, shrinkable - taken_from_others)
                count += 1
                per_lane[t.lane] += 1
                if lane.exclusive and t.workspace:
                    busy_workspaces[(lane.workspace_group, t.workspace)] = t
                continue
            t.reason_cat, t.reason = reason
            if holds and not passes and self.starving(t, now):
                t.held = True
                cores = t.need if lane.waits_for_cpu else 0  # it would start without that room
                if self.waited_out(t, now):
                    held_mem += t.est_mem
                    held_cpu += cores
                    if not t.from_ci:
                        held_agents += t.est_mem
                else:  # a CI job's build, first by ci_first: a higher lane may still use the room
                    ci_holds.append((weight, t.est_mem, cores))
                if lane.exclusive and t.workspace:  # and its workspace: a quicker lane mustn't keep taking it
                    key = (lane.workspace_group, t.workspace)
                    current = busy_workspaces.get(key)
                    if current is None or (current.state == "queued" and not self.waited_out(current, now)
                                           and self.waited_out(t, now)):  # a full hold over a CI job's weak one
                        busy_workspaces[key] = t
        self.budget.update(held_mem=held_mem + sum(mem for _, mem, _ in ci_holds),
                           held_cores=held_cpu + sum(cores for _, _, cores in ci_holds))

    def build_env(self, t: Ticket) -> dict:
        """Parallelism for the build's tools, unless the caller chose its own."""
        g, w = str(t.granted), str(t.want)
        values = {"BUILDQ_CORES": g, "CMAKE_BUILD_PARALLEL_LEVEL": g, "GOMAXPROCS": g,
                  # .NET: MSBuild sizes its worker nodes from the processor count, and node reuse
                  # leaves workers behind after the build, holding memory nobody accounts for.
                  "DOTNET_PROCESSOR_COUNT": g, "MSBUILDDISABLENODEREUSE": "1",
                  # ...and the shared compiler server would compile outside the build's cgroup.
                  "UseSharedCompilation": "false"}
        if self.lane(t.lane).test_threads:
            values.update({"RUST_TEST_THREADS": g, "NEXTEST_TEST_THREADS": g})
        args = strip_wrappers(t.argv)
        tool = os.path.basename(args[0]) if args else ""
        # make runs in parallel only when asked (-j): a Makefile not written for it can break. Its
        # -j is then replaced by the build's jobserver (see start()), since a -j on the command
        # line makes make ignore the jobserver. ninja is parallel by design. Other tools get the
        # jobserver through CARGO_MAKEFLAGS, which cargo reads first and hands to build scripts.
        parallel_make = tool == "ninja" or (tool in ("make", "gmake") and asks_for_jobs(args[1:]))
        if t.jobserver:
            flags = f"-j{w} --jobserver-auth=fifo:{t.jobserver}"
            values["CARGO_MAKEFLAGS"] = flags
            if parallel_make:
                values["MAKEFLAGS"] = flags
        else:
            values["CARGO_BUILD_JOBS"] = g  # no tokens to bound it, so cargo is told the number
            if parallel_make:
                values["MAKEFLAGS"] = f"-j{g}"
        return values

    def start(self, t: Ticket, now: float, granted: int) -> None:
        lane = self.lane(t.lane)
        self.add_wait(t, now)
        t.wait_mark = None
        t.state = "starting"
        t.started = now
        t.wait_total += max(0.0, now - (t.queued_at or t.submitted))
        t.runner = self.runner.name
        t.oom_base = 0
        t.reason = t.reason_cat = ""
        t.yields_to = t.yield_until = None  # running again: a later stop for memory isn't one for that CI job's build
        t.granted = t.max_granted = granted
        t.workspace_group = lane.workspace_group if lane.exclusive else ""
        t.group_lane = lane.name  # (the lane it really starts under: a reload may have removed t.lane)
        env_path = os.path.join(t.dir, "env.json")
        try:
            env = read_json(env_path)
            if not isinstance(env, dict):
                raise OSError("its environment file is missing")
            tool = os.path.basename((strip_wrappers(t.argv) or ["?"])[0])
            known = tool in JOBSERVER_TOOLS
            wanted = lane.jobserver == "all" or (lane.jobserver == "tools" and known)
            # An inherited jobserver passed by descriptor is dead in the build's service: drop it,
            # and give the build buildq's, unless the caller still brings make flags of its own.
            cleaned = {k: c for k in MAKE_FLAG_VARS if k in env
                       for c in [without_fd_jobserver(str(env[k]))] if c is not None}
            if cleaned:
                log(f"{t.id}: dropped the caller's jobserver ({', '.join(sorted(cleaned))}): its descriptors "
                    "don't reach the build")
            # The caller's own choice still wins: flags it set, or, where its dead jobserver was
            # dropped, a -j or jobserver of its own left in their options (an assignment after the
            # `--`, such as SUBMAKE=make\ -j4, is a variable's value, not make's own setting).
            callers_own = any(k in env and str(env[k]).strip()
                              and (k not in cleaned or callers_jobs(split_make_flags(cleaned[k])[0]))
                              for k in MAKE_FLAG_VARS)  # (an empty one is no choice at all)
            if wanted and not t.rigid and not callers_own:
                t.elastic = known  # it speaks the protocol even before it takes a token
                t.jobserver = os.path.join(t.dir, "jobserver")
                t.js = Jobserver(t.jobserver, create=True)
                t.js.resize(granted - 1)  # every client of a jobserver has one implicit token
                t.tokens_out = t.js.out
            if t.jobserver and tool in ("make", "gmake", "ninja") and asks_for_jobs(t.argv[1:]):
                tool_at = len(t.argv) - len(strip_wrappers(t.argv))  # (a wrapper's own words stay: env -u -j make)
                t.exec_argv = t.argv[:tool_at] + without_jobs(t.argv[tool_at:])  # its -j would make it ignore the jobserver
            # buildq's settings go in a file of their own, so a build that is queued again after a
            # restart gets fresh ones.
            ours = self.build_env(t)
            # The caller's own settings win; an empty make variable is no setting (a make recipe
            # exports MAKEFLAGS= and MFLAGS=), so buildq's flags go in its place.
            given = {k for k in env if k not in MAKE_FLAG_VARS or str(env[k]).strip()}
            parallel = {k: v for k, v in ours.items() if k not in given}
            for k, rest in cleaned.items():
                # The caller's make ran in parallel (it had a jobserver): a make or ninja build does
                # too, on buildq's. (cargo hands its own to build scripts through CARGO_MAKEFLAGS.)
                mine = ours.get(k) or (f"-j{t.want} --jobserver-auth=fifo:{t.jobserver}"
                                       if t.jobserver and k != "CARGO_MAKEFLAGS"
                                       and tool in ("make", "gmake", "ninja") else "")
                parallel[k] = with_make_flags(rest, mine)
            write_json(os.path.join(t.dir, "parallel.json"), parallel)
            self.runner.prepare(t, self.cfg.slice)
            self.save(t)  # with its service's name, before it exists
            t.launcher, running = self.runner.launch(t, lane, self.cfg.slice)
        except OSError as e:
            self.finalize(t, now, None, error=f"couldn't start the build: {e}")
            return
        if running:
            t.state = "running"
            t.running_since = now
        self.save(t)
        self.broadcast(t, now)
        if t.dedupe:
            self.check_source(t, "start", now)
        log(f"started {t.id} [{t.lane}] with {granted} core{'s' if granted != 1 else ''} (wants {t.want}"
            f"{', jobserver' if t.jobserver else ''}) after {now - t.submitted:.0f}s ({self.runner.name}): {t.label}")

    # ---- resizing builds that speak the jobserver protocol

    def rebalance(self, now: float) -> None:
        """Every few seconds, hand idle cores to builds that would use them, and take cores back
        when the machine is over its target or a queued build is waiting for cores."""
        m, cfg = self.machine, self.cfg
        for t in self.active():
            if t.js is not None and not t.elastic and t.cg and fifo_in_use(t.cg, t.jobserver):
                t.elastic = t.js.used = True
        elastic = [t for t in self.active() if t.js is not None and t.elastic and t.state == "running"
                   and not t.cancel_requested]
        if not elastic:
            return
        ramping = sum(max(0.0, t.est_cores - t.cores_now) for t in self.active()
                      if t.started and now - t.started < cfg.ramp_seconds and t not in elastic)
        cpu_cap = cfg.cpu_target * m.ncpu
        waiting = next((t for t in self.queue() if t.reason_cat in ("cpu", "held")), None)
        spare = cpu_cap - max(m.busy, m.busy_now) - ramping - (waiting.need if waiting else 0)
        free_mem = m.mem_available - sum(self.still_to_grow(t, now) for t in self.active()) - cfg.mem_floor
        changed = []
        waiting_for_memory = any(t.reason_cat == "memory" for t in self.queue(now))
        if spare >= 1 and free_mem > 0 and not waiting_for_memory:
            growers = sorted((t for t in elastic if t.granted < t.want and t.cores_now >= 0.75 * t.granted
                              and (t.release_at is None or t.release_revoked)),
                             key=lambda t: t.granted / max(t.want, 1))
            for t in growers:
                add = int(min(t.want - t.granted, math.floor(spare)))
                while add >= 1 and self.mem_for(t, t.granted + add) - t.est_mem > free_mem:
                    add -= 1  # the memory more cores would need isn't free
                if add >= 1:
                    new_mem = max(t.est_mem, self.mem_for(t, t.granted + add))
                    free_mem -= new_mem - t.est_mem
                    t.est_mem = new_mem
                    t.granted += add
                    t.max_granted = max(t.max_granted, t.granted)
                    spare -= add
                    changed.append(t)
        elif spare <= -1:
            deficit = math.ceil(-spare)
            for t in sorted(elastic, key=lambda t: t.granted - t.need, reverse=True):
                cut = min(t.granted - t.need, deficit)
                if cut >= 1:
                    t.granted -= cut
                    deficit -= cut
                    changed.append(t)
                if deficit <= 0:
                    break
        for t in elastic:
            before = t.js.out
            t.js.resize(t.granted - 1)
            if t.js.out != before or t in changed:
                t.tokens_out = t.js.out
                self.save(t)
        for t in changed:
            log(f"resized {t.id} to {t.granted} cores")

    # ---- keeping all builds together inside what the machine has free

    def memory_moving(self) -> bool:
        """Memory is short, under pressure ("full": a build held at its own MemoryHigh stalls only
        "some"), or has fallen a gigabyte since the slice was last
        guarded: other work can outgrow a guard every REBALANCE_SECONDS, so it is guarded every
        tick (a second) until things settle."""
        m = self.machine
        return (m.mem_available < 2 * self.cfg.mem_floor or m.psi_mem > 1.0
                or (self.guard_available is not None and self.guard_available - m.mem_available >= GIB))

    def guard_slice(self, stopping: bool = False) -> None:
        """Lower the slice's MemoryMax to what its builds hold plus what the machine has free above
        half of mem_floor, so all builds together can't take the machine below that: when other work
        grows, builds are stopped inside their slice, not elsewhere. It never goes above the limit
        the slice is configured with (the installer's 85% drop-in, or yours), and never below what
        the builds hold now (so the kernel needn't reclaim anything when it is written); when the
        daemon stops, the configured limit is put back."""
        if not self.cfg.slice_guard or self.runner.name != "systemd":
            return
        path = os.path.join(self.cg_base, slice_path(self.cfg.slice))
        if self.slice_limit is None:
            if stopping:  # (putting the limit back as the daemon stops: no later tick to wait for)
                self.slice_limit = configured_memory_max(self.cfg.slice) or "max"
            else:
                limit = self.query(("slice-max", self.cfg.slice), configured_memory_max, self.cfg.slice)
                if limit is PENDING:
                    return  # guarded from a later tick, once systemd has said
                self.slice_limit = limit or "max"
        m = self.machine
        if stopping:
            value = self.slice_limit
        else:
            try:
                with open(os.path.join(path, "memory.current")) as f:
                    held = int(f.read())
            except (OSError, ValueError):
                return
            value = held + max(2 * GIB, m.mem_available - self.cfg.mem_floor // 2)
            self.guard_available = m.mem_available
            if self.slice_limit != "max":
                value = min(value, int(self.slice_limit))
        try:
            with open(os.path.join(path, "memory.max"), "w") as f:
                f.write(str(value))
            self.guard_failed = False
        except OSError as e:
            if not self.guard_failed:
                log(f"can't set {self.cfg.slice}'s memory limit ({e}); builds are held only by their own caps")
            self.guard_failed = True

    # ---- watching builds

    def check(self, now: float) -> None:
        for t in self.active():
            if t.flock:
                t.measure(now)
                self.outgrown(t)
                continue
            if t.state == "starting" and not self.check_starting(t, now):
                continue
            t.measure(now)
            if t.release_dirty:  # a take-back is saved at once, so a crash can't bring the decision back
                t.release_dirty = False
                self.save(t)
            if t.requeue_pending:
                if self.runner_of(t).alive(t):
                    if t.stop_sent is None or now - t.stop_sent >= 30:
                        self.stop(t, now, force=True)
                    continue
                result = read_json(os.path.join(t.dir, "result.json"))
                if isinstance(result, dict) and isinstance(result.get("exit"), int) and result["exit"] < 128:
                    t.requeue_pending, t.shed_error = False, None  # it finished on its own first
                    self.finalize(t, now, result.get("exit"), oom=oom_of(result),
                                  timed_out=bool(result.get("timed_out")), result=result)
                else:
                    self.requeue(t, now)
                continue
            self.outgrown(t)
            if t.last_grant_t is not None and not t.frozen:
                t.grant_area += t.granted * max(0.0, now - t.last_grant_t)
            t.last_grant_t = now
            result = read_json(os.path.join(t.dir, "result.json"))
            if isinstance(result, dict):
                # Give systemd a moment to stop anything the build left behind, so the turn ends
                # with the build's last process.
                t.result_seen = t.result_seen or now
                if self.runner_of(t).alive(t):
                    # Processes the build left behind still hold memory and its workspace: the
                    # turn lasts until they are gone. Past 15 s, they are killed.
                    if now - t.result_seen >= 15 and (t.stop_sent is None or now - t.stop_sent >= 30):
                        log(f"{t.id} ended, but processes it left are still running; killing them")
                        self.stop(t, now, force=True)
                    continue
                self.finalize(t, now, result.get("exit"), oom=oom_of(result),
                              timed_out=bool(result.get("timed_out")), result=result)
                continue
            if t.cancel_requested and t.stop_sent and now - t.stop_sent > 75:
                self.stop(t, now, force=True)
            if not self.runner_of(t).alive(t) and now - (t.running_since or now) > 3:
                result = read_json(os.path.join(t.dir, "result.json"))
                if isinstance(result, dict):
                    self.finalize(t, now, result.get("exit"), oom=oom_of(result),
                                  timed_out=bool(result.get("timed_out")), result=result)
                else:
                    # Killed as a whole, supervisor and all: systemd-oomd, or SIGKILL from outside.
                    verdict = self.result_of(t)
                    if verdict is PENDING:
                        continue  # finalized on a later tick, with systemd's verdict
                    oom = verdict == "oom-kill"
                    error = None if t.cancel_requested else (
                        "it was stopped for memory (systemd-oomd or the kernel)" if oom else
                        f"the build ended without reporting an exit status ({verdict or 'killed?'})")
                    self.finalize(t, now, None, lost=True, oom=oom, error=error)

    def outgrown(self, t: Ticket) -> None:
        """A build that passes its estimate was underestimated (a full rebuild where history saw
        incremental ones, say). From then on, plan it at its lane's enforced MemoryMax, or at half as
        much again as it holds, so the room it may still grow into stays held."""
        if not t.measured or t.mem_now <= t.est_mem:
            return
        lane = self.lane(t.lane)
        cap = lane.mem_cap if self.runner_of(t).name == "systemd" else None
        raised = cap if cap and cap > t.mem_now else int(t.mem_now * 1.5)
        if raised > t.est_mem:
            log(f"{t.id} passed its estimate ({fmt_size(t.est_mem)}); planning it at {fmt_size(raised)}")
            t.est_mem = raised

    def check_starting(self, t: Ticket, now: float) -> bool:
        """Move a starting build on; True once it runs."""
        if t.launcher is None:  # found starting after a restart
            runner = self.runner_of(t)
            if runner.alive(t) or os.path.exists(os.path.join(t.dir, "result.json")):
                t.state, t.running_since = "running", now
                self.save(t)
                return True
            if now < (t.recheck_at or 0):
                return False
            state = self.unit_state_of(t)
            if state is PENDING:
                return False  # asked; the answer comes on a later tick
            if state in ("pending", "unknown"):
                # systemd has it again (or can't say): a reset-failed asked for meanwhile is stale
                stale = self.pending_queries.pop(("reset-failed", self.attempt(t)), None)
                if stale is not None:
                    stale.cancel()
                t.recheck_at = now + 10  # systemd has it, or can't say yet: look again
                return False
            if os.path.exists(os.path.join(t.dir, "env.json")) and t.cancel_requested:
                self.finalize(t, now, None)  # it never started, and it was cancelled
            elif os.path.exists(os.path.join(t.dir, "env.json")):
                # Systemd has neither the service nor a job to start it, and no supervisor read
                # its environment: it never started. Queue it again, clearing any failed unit of
                # that name first, so the next launch can use it.
                if self.query(("reset-failed", self.attempt(t)), reset_failed_unit, t.unit) is PENDING:
                    return False  # the build stays starting until the name is free
                self.close_jobserver(t, remove=True)
                self.drop_queries(t)  # (this attempt is over)
                t.state, t.started, t.unit, t.cg, t.granted = "queued", None, None, None, 0
                self.save(t)
                log(f"requeued {t.id}: it hadn't started when the daemon stopped")
            else:
                self.finalize(t, now, None, lost=True,
                              error="the daemon stopped while the build was starting, and it is gone")
            return False
        rc = t.launcher.poll()
        if rc is None:
            if now - (t.started or now) < 60:
                return False
            t.launcher.kill()  # systemd-run hung; find out what became of the service
            t.launcher.wait()
            t.launcher = None
            t.recheck_at = now
            return False
        if rc != 0:
            state = self.unit_state_of(t)
            if state is PENDING:
                return False  # the launcher's exit code keeps; look again on a later tick
            if state == "pending":
                rc = 0  # the service exists: a launch from before a daemon restart got there first
            elif state == "unknown":
                t.launcher, t.recheck_at = None, now + 10  # systemd isn't answering; ask again later
                return False
        if rc != 0:
            try:
                with open(os.path.join(t.dir, "launch.err"), errors="replace") as f:
                    detail = f.read().strip()[-500:]
            except OSError:
                detail = ""
            self.finalize(t, now, None, error=f"systemd-run couldn't start the build (exit {rc}): {detail}")
            return False
        t.launcher = None
        t.state, t.running_since = "running", now
        if t.cancel_requested:
            self.stop(t, now)
        self.save(t)
        self.broadcast(t, now)
        return True

    def close_jobserver(self, t: Ticket, remove: bool = False) -> None:
        if t.js is not None:
            t.js.close()
            t.js = None
        if remove and t.jobserver:
            try:
                os.remove(t.jobserver)
            except OSError:
                pass
            t.jobserver, t.tokens_out = None, 0

    def finalize(self, t: Ticket, now: float, exit_code, oom: bool = False, timed_out: bool = False,
                 error: str | None = None, lost: bool = False, result: dict | None = None) -> None:
        if t.state in FINISHED:
            return
        self.drop_queries(t)  # its attempt's answers are no use to anyone now
        t.env = None
        if isinstance(result, dict):  # the supervisor's reading, taken as the build ended
            t.take_waits(result.get("mem_wait_some"), result.get("mem_wait_full"), result.get("mem_high"))
            t.kills_seen = max(t.kills_seen, int(sane_count(result.get("oom_kills")) or 0))
            t.kills_own_cap = t.kills_own_cap or oom_of(result)
        exit_code = exit_code if isinstance(exit_code, int) and not isinstance(exit_code, bool) else None
        lane = self.lane(t.lane)
        t.exit = exit_code
        t.oom = bool(oom or t.oom_kills) or (exit_code == 137 and bool(lane.mem_cap) and t.mem_peak >= 0.9 * lane.mem_cap)
        t.timed_out = timed_out
        t.error = error or (f"timed out after {t.timeout or 0:.0f}s" if timed_out else None)
        t.ended = now
        if t.cancel_requested:
            t.state = "cancelled"
        elif exit_code is None:
            t.state = "lost" if lost or not error else "failed"
        else:
            t.state = "succeeded" if exit_code == 0 else "failed"
        if t.launcher is not None:
            t.launcher.poll()
            t.launcher = None
        self.close_jobserver(t)
        if t.frozen and t.frozen_at:  # ended while paused
            t.frozen_attempt += max(0.0, now - t.frozen_at)
            t.frozen, t.frozen_at = False, None
        if not t.started and t.queued_at:
            t.wait_total += max(0.0, now - t.queued_at)  # it ends without having run: all of it was waiting
        # Time spent paused is neither how long it takes nor time its cores were used.
        wall = max(now - (t.started or now) - (t.frozen_attempt if t.started else 0.0), 0.0)
        self.close_release_audit(t, wall)
        t.frozen_total += t.frozen_attempt
        t.frozen_attempt = 0.0
        used = t.cpu_usec - (t.cpu_usec_base or 0)
        t.avg_cores = used / 1e6 / wall if wall > 0 and t.measured else 0.0
        t.peak_cores = max(t.peak_cores, t.avg_cores)
        if t.flock:
            self.tickets.pop(t.id, None)
            log(f"no longer counting {t.id} ({error or 'lock released'})")
            return
        try:
            os.remove(os.path.join(t.dir, "env.json"))
        except OSError:
            pass
        # A run that a signal ended (a cancel, a timeout) shows how far it got, not what it needs,
        # so it teaches nothing; a run the kernel killed for memory teaches that it needs more.
        if t.oom and not t.measured:  # killed before it could be sampled: it needed at least its cap
            t.mem_peak = max(t.mem_peak, lane.mem_cap or t.est_mem)
            t.peak_cores = max(t.peak_cores, float(t.max_granted or 1))
        if exit_code is not None and exit_code < 128 and not t.measured and not t.oom:
            t.mem_peak = t.mem_peak or 0  # too quick to sample: it needed little, and that is worth knowing
        learn = t.oom or (exit_code is not None and exit_code < 128 and (t.measured or wall < 2))
        if learn and not t.cancel_requested and not timed_out:
            given = round(t.grant_area / wall, 1) if wall > 0 and t.grant_area else t.max_granted
            try:
                self.history.add({
                    "key": t.key, "lane": t.lane, "t": round(time.time()), "wall": round(wall, 1), "exit": exit_code,
                    "peak_mem": t.mem_peak, "peak_cores": round(t.peak_cores, 2), "avg_cores": round(t.avg_cores, 2),
                    "granted": given, "mem_cores": t.peak_mem_cores or t.max_granted, "elastic": t.elastic,
                    "cold": t.cold, "oom": t.oom, "mem_wait_some": round(t.mem_wait_some, 1),
                    "mem_wait_full": round(t.mem_wait_full, 1), "mem_high": t.mem_high,
                    "waited": round(t.wait_total, 1), "caller": t.caller,
                    "requeues": t.requeues,
                    "peak_at": round(t.peak_at, 1) if t.measured and not t.observed_gap else None,
                    "tail": t.tail if t.measured and not t.observed_gap else None,
                    "peak_cpu": round(t.peak_cpu, 1) if t.measured and not t.observed_gap else None,
                })
            except OSError as e:
                log(f"can't record {t.id} in history: {e}")
        try:
            proc = self.runner_of(t).cleanup(t)
            if proc is not None:
                self.helpers.append((proc, now + 60))
        except OSError:
            pass
        self.save(t)
        self.broadcast(t, now)
        self.run_hooks(t, now)
        if t.dedupe and t.state in ("succeeded", "failed") and not t.source_changed:
            self.check_source(t, "end", now)
        self.record_outcome(t, wall)
        try:
            self.record_build(t, wall)
        except Exception as e:  # the analytics must never cost a build its ending
            self.metrics.trouble(f"can't record {t.id} for the analytics: {e!r}")
        if t.state == "succeeded" and command_words(t.argv)[:2] == ["git", "push"] and t.source:
            for post in self.status_posts:  # a push may have brought commits that were waiting
                if post.get("repo") == t.source.get("remote"):
                    post["next"] = now
        waits = ""
        if t.mem_wait_some >= 1 or t.mem_high:
            waits = (f"; waited on memory {t.mem_wait_some:.0f}s ({t.mem_wait_full:.0f}s with all of it waiting)"
                     f"{', and went over its MemoryHigh' if t.mem_high else ''}")
        log(f"{t.state} {t.id} (exit {t.exit}{', killed for memory' if t.oom else ''}"
            f"{'; ' + t.error if t.error else ''}) after {wall:.0f}s: peak {fmt_size(t.mem_peak)}, "
            f"{t.peak_cores:.1f} cores at most, {t.avg_cores:.1f} on average, {t.max_granted} given{waits}")

    def record_outcome(self, t: Ticket, wall: float) -> None:
        """Every finished build, for `buildq report` (the history keeps only the runs that teach)."""
        if t.flock:
            return
        path = os.path.join(self.state_dir, "outcomes.jsonl")
        # What every attempt took, the ones stopped to free memory included.
        record = {"t": round(time.time()), "key": t.key, "lane": t.lane, "caller": t.caller, "state": t.state,
                  "exit": t.exit, "oom": t.oom, "timed_out": t.timed_out,
                  "stopped_for_memory": bool(t.shed_error) or t.requeues > t.ci_stops, "requeues": t.requeues,
                  "ci_stops": t.ci_stops,
                  "wall": round(wall + t.attempts_wall, 1), "waited": round(t.wait_total, 1),
                  "peak_mem": max(t.mem_peak, t.attempts_peak),
                  "mem_wait_some": round(t.mem_wait_some + t.attempts_mem_wait, 1), "mem_high": t.mem_high,
                  "avg_cores": round(t.avg_cores, 2), "paused": round(t.frozen_total, 1),
                  "cpu_seconds": round(t.attempts_cpu + max(0, t.cpu_usec - (t.cpu_usec_base or 0)) / 1e6, 1),
                  "mem_high_all": t.mem_high + t.attempts_mem_high}
        try:
            if os.path.getsize(path) > 8 << 20:
                os.replace(path, path + ".1")
        except OSError:
            pass
        try:
            with open(path, "a") as f:
                f.write(json.dumps(record, separators=(",", ":")) + "\n")
        except OSError as e:
            log(f"can't record {t.id}'s outcome: {e}")

    def record_build(self, t: Ticket, wall: float) -> None:
        """A finished build's row in the analytics file: what it waited for, what was planned for
        it, and what it used, with the shape of its memory over its last attempt."""
        if t.flock or not self.cfg.metrics:
            return
        whole = t.measured and not t.observed_gap  # watched from start to end
        profile = memory_profile(t.trace, wall) if whole else None
        self.metrics.build({
            "id": t.id, "ended": round(t.ended or time.time()), "submitted": round(t.submitted), "key": t.key,
            "label": t.label[:200], "name": t.name, "lane": t.lane, "caller": t.caller,
            "repo": (t.source or {}).get("repo") or t.workspace, "state": t.state, "exit": t.exit,
            "from_ci": int(bool(t.from_ci)), "wall": round(wall + t.attempts_wall, 1), "waited": round(t.wait_total, 1),
            "attempt_wall": round(wall, 1), "workspace": t.workspace,
            "waited_by": json.dumps(t.waited_by, separators=(",", ":"), sort_keys=True),
            "est_mem": t.est_mem, "est_src": t.est_src, "mem_peak": max(t.mem_peak, t.attempts_peak),
            "peak_at": round(t.peak_at, 1) if whole else None, "tail": t.tail if whole else None,
            "profile": json.dumps(profile) if profile else None, "released": int(t.released),
            "release_at": t.release_at, "release_hold": t.release_hold if t.release_at is not None else None,
            "after_release_peak": t.after_release_peak if t.release_at is not None else None,
            "release_revoked": int(t.release_revoked), "release_end": t.release_end,
            "past_peak_attempts": t.past_peak_attempts, "past_peak_over": t.past_peak_over,
            "past_peak_most_over": t.past_peak_most_over,
            "past_peak_freed": round(t.past_peak_freed / (1 << 30) / 3600, 3), "past_peak_unknown": t.past_peak_unknown,
            "past_peak_released": t.past_peak_released,
            "observed_gap": int(t.observed_gap),
            "cores_granted": round(t.grant_area / wall, 2) if wall > 0 and t.grant_area else t.max_granted,
            "avg_cores": round(t.avg_cores, 2), "peak_cores": round(t.peak_cores, 2),
            "cpu_seconds": round(t.attempts_cpu + max(0, t.cpu_usec - (t.cpu_usec_base or 0)) / 1e6, 1),
            "requeues": t.requeues, "ci_stops": t.ci_stops,
            "paused": round(t.frozen_total + t.frozen_attempt, 1), "oom": int(bool(t.oom)),
            "mem_high": t.mem_high + t.attempts_mem_high, "mem_wait": round(t.mem_wait_some + t.attempts_mem_wait, 1),
        })

    def observe_metrics(self, now: float) -> None:
        """This tick's numbers, added to the minute the analytics file will get."""
        if not self.cfg.metrics:
            return
        m, cfg, budget = self.machine, self.cfg, self.budget
        running = [t for t in self.active() if not t.flock]
        queued = [t for t in self.tickets.values() if t.state == "queued"]
        waits = collections.Counter(WAIT_COLUMN.get(t.reason_cat, "wait_other") for t in queued)
        values = {
            "cores": m.ncpu, "cpu_target": cfg.cpu_target * m.ncpu, "cpu_busy": m.busy_now,
            "mem_total": m.mem_total, "mem_floor": cfg.mem_floor, "mem_available": m.mem_available,
            "swap_used": m.swap_used, "psi_cpu": m.psi_cpu, "psi_mem": m.psi_mem,
            "running": len(self.active()), "queued": len(queued),
            "reserved": sum(t.est_mem for t in running), "growth": budget.get("growth_reserved", 0),
            "free_mem": budget.get("free_mem", 0), "free_cpu": budget.get("free_cores", 0),
        }
        values.update({name: waits.get(name, 0) for name in WAIT_COLUMNS})
        self.metrics.observe(now, values, os.path.join(self.cg_base, slice_path(cfg.slice)))

    def run_hooks(self, t: Ticket, now: float) -> None:
        for command in (t.notify, *t.extra_notify, self.cfg.on_finish):
            if not command:
                continue
            env = dict(os.environ, BUILDQ_TICKET=t.id, BUILDQ_STATE=t.state,
                       BUILDQ_EXIT="" if t.exit is None else str(t.exit), BUILDQ_OOM="1" if t.oom else "0",
                       BUILDQ_LABEL=t.label, BUILDQ_NAME=t.name or "", BUILDQ_CWD=t.cwd, BUILDQ_LOG=t.log or "")
            try:
                proc = subprocess.Popen(["/bin/sh", "-c", command], env=env, cwd=os.path.expanduser("~"),
                                        stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL, start_new_session=True)
                self.helpers.append((proc, now + 120))
            except OSError as e:
                log(f"can't run the finish hook for {t.id}: {e}")

    def reap_helpers(self, now: float) -> None:
        keep = []
        for proc, deadline in self.helpers:
            if proc.poll() is None:
                if now > deadline:
                    proc.kill()
                keep.append((proc, deadline))
        self.helpers = keep

    # ---- builds started outside the queue, holding flock slots of an older semaphore script

    def scan_flock_slots(self, now: float) -> None:
        seen = set()
        if self.cfg.flock_slots:
            locked = locked_inodes()
            for pattern, lane in self.cfg.flock_slots:
                for path in sorted(glob.glob(pattern)):
                    path = os.path.realpath(path)
                    try:
                        inode = os.stat(path).st_ino
                    except OSError:
                        continue
                    if inode not in locked:
                        continue
                    tid = "flock:" + path
                    t = self.tickets.get(tid)
                    if t and holds_flock(t.flock[1], path, inode):
                        seen.add(tid)
                        continue
                    if t:
                        self.finalize(t, now, None, error="the lock changed hands")
                    holder = find_flock_holder(path, inode)
                    if holder is not None:  # a lock that none of our processes holds isn't one of ours
                        seen.add(tid)
                        self.adopt_flock(tid, path, holder, lane, now)
        for t in [t for t in self.tickets.values() if t.flock and t.id not in seen]:
            self.finalize(t, now, None, error="lock released")

    def adopt_flock(self, tid: str, path: str, pid: int, lane: str, now: float) -> None:
        argv, cwd, cg = proc_cmdline(pid), "/", None
        own = proc_cgroup(pid)
        children = proc_children(pid)
        for child in children:
            child_cg = proc_cgroup(child)
            if child_cg and child_cg != own and child_cg.endswith(".scope"):
                argv, cg = proc_cmdline(child) or argv, child_cg
                break
        else:
            if children:
                argv = proc_cmdline(children[0]) or argv
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            pass
        argv = argv or [f"(holder of {os.path.basename(path)})"]
        t = Ticket(tid, argv, cwd, lane, command_key(argv, cwd, lane, self.cfg.script_labels), now, None)
        t.state, t.started, t.running_since, t.runner = "running", now, now, "outside"
        t.flock = (path, pid)
        t.cg = cg
        t.oom_base = None
        self.estimate(t, now)
        t.granted = t.want
        t.est_mem = self.mem_for(t, t.granted)
        self.tickets[tid] = t
        log(f"counting {tid} (held by pid {pid}, started outside the queue) as a running build: {t.label}")

    # ---- surviving a restart

    def load_tickets(self, now: float) -> None:
        for path in glob.glob(os.path.join(self.tickets_dir, "*", "ticket.json")):
            directory = os.path.dirname(path)
            try:
                t = Ticket.from_record(read_json(path), directory)
            except (TypeError, KeyError, ValueError):
                log(f"skipping unreadable ticket {directory}")
                continue
            if t.id != os.path.basename(directory):
                continue
            self.tickets[t.id] = t
            if t.submission:
                self.submissions[t.submission] = t.id
            if not isinstance(t.answered, dict):
                t.answered = {}
            if not isinstance(t.interests, dict):
                t.interests = {}
            if not isinstance(t.followed, dict):
                t.followed = {}
            if not t.interests and t.state not in FINISHED:  # saved before buildq kept interests
                t.interests = {t.submission or f"anon-{t.id}": "run" if t.attached else "submit"}
            for other in t.answered:
                self.submissions[str(other)] = t.id
            if t.state in FINISHED:
                continue
            if t.state in ("starting", "running") and t.group_lane is None:
                # Saved before groups were recorded: it started in this lane, under this lane's group
                # (or, the lane being gone, the lane's own name, which is what the old daemon held).
                t.group_lane = t.lane
                if t.workspace_group is None:
                    lane = self.cfg.lanes.get(t.lane)
                    t.workspace_group = (lane.workspace_group if lane.exclusive else "") if lane else t.lane
                self.save(t)  # at once: a crash before the next save mustn't lose it
            if t.lane not in self.cfg.lanes:
                t.lane = self.cfg.default_lane
            if t.state == "queued":
                if os.path.exists(os.path.join(directory, "env.json")):
                    env = read_json(os.path.join(directory, "env.json"))
                    t.env = env if isinstance(env, dict) else None
                    t.reason_cat = "restart"  # the time the daemon was away is waited for that
                    log(f"kept {t.id} in the queue across the restart")
                else:
                    self.finalize(t, now, None, error="its environment file is gone")
                continue
            if t.jobserver and os.path.exists(t.jobserver):
                try:
                    t.js = Jobserver(t.jobserver, create=False, out=t.tokens_out)
                    t.js.used = t.elastic
                except OSError:
                    t.js = None
            t.cpu_usec_base = None  # count CPU from here; the cgroup's counter started before
            t.observed_gap = True  # it ran unwatched for a while: its peak and after may have been missed
            t.release_stood_at_load = t.release_at is not None and not t.release_revoked
            t.release_open_at_gap = t.release_open_at_gap or t.release_stood_at_load
            if isinstance(t.freeze_asked, list) and len(t.freeze_asked) >= 2 and t.cg:
                wanted = bool(t.freeze_asked[0])
                t.freeze_asked = (wanted, now)  # sent again, with a full minute: its sender went with the old daemon
                try:
                    proc = self.runner_of(t).freeze(t, wanted)
                    if proc is not None:
                        self.helpers.append((proc, now + 30))
                except OSError:
                    pass
            else:
                t.freeze_asked = None
            if t.cg and t.freeze_asked is None:
                own = cgroup_freeze_set(t.cg)
                if own is not None:
                    if not own and t.frozen:  # resumed while the daemon was away: the pause ends now
                        if t.frozen_at:
                            t.frozen_attempt += max(0.0, now - t.frozen_at)
                        t.frozen, t.frozen_at, t.thaw_failed = False, None, False
                    elif own and not t.frozen and not parent_freeze_set(t.cg):
                        t.frozen, t.frozen_at = True, (now if cgroup_frozen(t.cg) else None)
                    elif own and t.frozen and not t.frozen_at and cgroup_frozen(t.cg):
                        t.frozen_at = now  # (a pause counts only once in effect)
            if t.state == "starting":
                t.recheck_at = now + 10
            else:
                t.running_since = now
            if t.cancel_requested:
                self.stop(t, now, force=t.frozen)  # a cancel in progress when the daemon stopped goes on
            log(f"picked up {t.id} [{t.lane}] ({t.state}) from before the restart: {t.label}")

    def prune(self, now: float) -> None:
        finished = sorted((t for t in self.tickets.values() if t.state in FINISHED and t.dir),
                          key=lambda t: t.ended or 0)
        excess = len(finished) - self.cfg.max_finished
        for i, t in enumerate(finished):
            if i < excess or (t.ended or 0) < now - self.cfg.keep_finished:
                shutil.rmtree(t.dir, ignore_errors=True)
                self.tickets.pop(t.id, None)
                if t.submission:
                    self.submissions.pop(t.submission, None)
                for other in t.answered:
                    self.submissions.pop(other, None)

    # ---- status

    def overview(self, now: float) -> dict:
        queue = self.queue()
        running = sorted(self.active(), key=lambda t: t.started or 0)
        recent = sorted((t for t in self.tickets.values() if t.state in FINISHED), key=lambda t: t.ended or 0)[-10:]
        return {
            "version": VERSION, "now": now, "runner": self.runner.name, "machine": self.machine.summary(),
            "budget": self.budget, "config": self.cfg.summary(), "paused": self.paused,
            "running": [t.row(now) for t in running],
            "queued": [t.row(now, i) for i, t in enumerate(queue)],
            "recent": [t.row(now) for t in reversed(recent)],
        }

    def listing(self, now: float, everything: bool) -> list[dict]:
        queue = self.queue()
        rows = []
        for t in sorted(self.tickets.values(), key=lambda t: t.submitted, reverse=True):
            if not everything and t.state in FINISHED and (t.ended or 0) < now - 86400:
                continue
            rows.append(t.row(now, queue.index(t) if t.state == "queued" else None))
        return rows

    # ---- the loop

    def tick(self, now: float) -> None:
        self.machine.sample(time.monotonic())
        self.check(now)
        self.shed_memory(now)
        self.drop_unwatched(now)
        self.scan_flock_slots(now)
        self.schedule(now)
        self.make_room_for_ci(now)
        try:
            self.observe_metrics(now)
        except Exception as e:  # nor the loop its tick
            self.metrics.trouble(f"can't add up this tick for the analytics: {e!r}")
        tick = time.monotonic()
        if tick - self.last_rebalance >= self.REBALANCE_SECONDS:
            self.last_rebalance = tick
            self.rebalance(now)
            self.guard_slice()
        elif self.memory_moving():
            self.guard_slice()  # every tick while memory is short or falling fast (#5)
        self.watch_memory(tick)
        if self.source_checks or self.source_wanted:
            self.collect_source_checks(now)
        if self.status_posts or self.status_procs:
            self.send_status_posts(now)
        self.send_waits(now)
        self.reap_helpers(now)
        if tick - self.last_prune >= 600:
            self.last_prune = tick
            self.prune(now)

    MEMORY_LOG_SECONDS = 30
    MEMORY_LOG_BYTES = 1 << 20

    def watch_memory(self, tick: float) -> None:
        """While memory is tight, say every half minute how much is free and which cgroups hold the
        most, builds or not, so that if the machine stalls and has to be reset, there is a record of
        what filled it. Tight is less than twice mem_floor available, or every task on the machine
        stalled on memory at once 5% of the time (memory "full"; "some" also counts one build slowed
        at its own MemoryHigh, which is normal). It is no longer tight once more than 2.5 times
        mem_floor is available and "full" is under 1% for half a minute.

        Nothing slow happens here, on the daemon's loop: memory.log is written and synced by a
        thread of its own, and the cgroups are walked by another."""
        m, floor = self.machine, self.cfg.mem_floor
        tight = m.mem_available < 2 * floor or m.psi_mem >= 5
        calm = m.mem_available > 2.5 * floor and m.psi_mem < 1
        if not tight and not self.memory_tight:
            return
        if calm:
            self.memory_calm_since = self.memory_calm_since or tick
            if tick - self.memory_calm_since >= self.MEMORY_LOG_SECONDS:
                self.memory_tight, self.memory_calm_since = False, None
                self.memory_note(f"memory is no longer tight: {fmt_size(m.mem_available)} available")
            return
        self.memory_calm_since = None
        if self.memory_tight and tick - self.last_memory_log < self.MEMORY_LOG_SECONDS:
            return
        self.memory_tight, self.last_memory_log = True, tick
        self.memory_note(f"memory is tight: {fmt_size(m.mem_available)} available (floor {fmt_size(floor)}), "
                         f"{fmt_size(m.swap_used)} of swap used, every task waiting on memory {m.psi_mem:.0f}% "
                         f"of the time (some task {m.psi_mem_some:.0f}%)")
        self.walk_wanted.set()  # one walk at a time: a request while one runs is the next one
        self.memory_thread("walker", self.memory_walker)

    def memory_note(self, text: str) -> None:
        """A memory-watch line: to the journal at warning priority, and queued for memory.log."""
        if self.memory_stopping:
            return
        log(text, level=4)
        self.memory_lines.put((time.strftime("%Y-%m-%dT%H:%M:%S%z"), text))
        self.memory_thread("writer", self.memory_writer)

    def memory_thread(self, name: str, target) -> None:
        with self.memory_thread_lock:  # the walker logs too: only one of each thread, ever at once
            thread = self.memory_threads.get(name)
            if self.memory_stopping or (thread is not None and thread.is_alive()):
                return
            try:
                thread = threading.Thread(target=target, name=f"memory-{name}", daemon=True)
                thread.start()
                self.memory_threads[name] = thread
            except RuntimeError as e:  # no threads to be had (a pids limit, say): the journal still has it
                if not self.memory_thread_failed:
                    log(f"can't start the memory watch's {name}: {e}")
                self.memory_thread_failed = True

    def memory_walker(self) -> None:
        while True:
            self.walk_wanted.wait()
            if self.memory_stopping:
                return
            self.walking = True  # before the request is cleared, so nobody sees it idle in between
            self.walk_wanted.clear()
            try:
                top, complete = biggest_cgroups(self.cg_root, deadline=time.monotonic() + 20)
                listed = ", ".join(f"{short_cgroup(rel)}{f' ({name})' if name else ''} {fmt_size(held)}"
                                   f"{f' + {fmt_size(swap)} swap' if swap >= 256 * MIB else ''}"
                                   for held, swap, rel, name in top)
                self.memory_note(f"holding the most memory: {listed or 'nothing measurable'}"
                                 f"{'' if complete else ' (the walk was cut short; partial)'}")
            except Exception:
                if not self.memory_stopping:
                    log("the memory watch failed:\n" + traceback.format_exc(), level=4)
            finally:
                self.walking = False

    def memory_writer(self) -> None:
        """Append queued lines to memory.log in the state directory, syncing each batch: the journal
        can lose its last minutes when a machine is reset, which is when this record matters."""
        path = os.path.join(self.state_dir, "memory.log")
        while True:
            batch = [self.memory_lines.get()]
            while True:
                try:
                    batch.append(self.memory_lines.get_nowait())
                except queue.Empty:
                    break
            lines = [item for item in batch if item is not None]
            try:
                if lines:
                    try:
                        if os.path.getsize(path) > self.MEMORY_LOG_BYTES:
                            os.replace(path, path + ".1")
                    except OSError:
                        pass
                    new = not os.path.exists(path)
                    data = "".join(f"{stamp} {text}\n" for stamp, text in lines).encode(errors="backslashreplace")
                    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
                    try:
                        while data:  # a short write (a full disk) is retried, or raises
                            data = data[os.write(fd, data):]
                        os.fsync(fd)
                    finally:
                        os.close(fd)
                    if new:  # a new file's name, after a rotation too, must survive a reset as well
                        dirfd = os.open(self.state_dir, os.O_RDONLY | os.O_DIRECTORY)
                        try:
                            os.fsync(dirfd)
                        finally:
                            os.close(dirfd)
            except Exception as e:  # never lose the writer to one bad batch
                if not self.memory_stopping:
                    log(f"can't write {path}: {e!r}")
            finally:
                for _ in batch:
                    self.memory_lines.task_done()
            if len(lines) < len(batch):  # told to stop
                return

    def memory_idle(self, timeout: float = 10.0) -> bool:
        """Wait until the memory watch has nothing left to do (for tests)."""
        until = time.monotonic() + timeout
        while time.monotonic() < until:
            if not self.walk_wanted.is_set() and not self.walking and not self.memory_lines.unfinished_tasks:
                return True
            time.sleep(0.01)
        return False

    def stop_memory_watch(self, timeout: float = 2.0) -> None:
        """Stop the watch's threads before the interpreter goes, so none is caught writing."""
        with self.memory_thread_lock:
            self.memory_stopping = True
            threads = list(self.memory_threads.values())
        self.walk_wanted.set()
        self.memory_lines.put(None)
        for thread in threads:
            thread.join(timeout)
        self.metrics.stop(timeout)

    def vacate(self, t: Ticket, now: float) -> None:
        """A queued `buildq run` build whose client went (a harness's tool timeout, by SIGKILL, or
        SIGTERM or SIGHUP) leaves its place for the retry, which a harness usually makes: the same
        command, in the same directory and lane, from the same caller, within VACATED_SECONDS. The
        place is the time it waited, so the retry doesn't go to the back of the queue, where under load
        it could cycle without ever running (#7). A build that was running leaves none: it had its
        turn, and one that can't finish within the tool's time limit mustn't come back first for ever."""
        if t.state != "queued" or not t.attached or not t.caller or t.requeues:
            # (with no caller to tell whose retry it is, anyone could take it; and a build queued again
            # after a memory stop had its turn: its "wait" would count the time it ran)
            return
        key = (t.cwd, tuple(t.argv), t.lane, t.caller)
        waited = max(0.0, now - t.submitted)
        earlier = self.vacated.get(key)
        if earlier and earlier[1] >= now:
            waited = max(waited, earlier[0])  # the longest wait of the two
        self.vacated[key] = (waited, now + self.VACATED_SECONDS)

    def drop_unwatched(self, now: float) -> None:
        """A build that `buildq run` submitted is meant to be followed. Once no one has followed it
        for unwatched_seconds (its client was killed, by an editor or a tool timeout), cancel it rather than let
        it hold a turn for output nobody reads. Builds dropped off with `buildq submit` stay."""
        for t in list(self.tickets.values()):
            if t.state not in FINISHED and t.interests:
                for conn in self.watchers.get(t.id, ()):
                    if getattr(conn, "submission", None) in t.interests:
                        t.followed[conn.submission] = now
                gone = [who for who, kind in t.interests.items() if kind == "run" and who not in self.waiting(t, now)]
                if gone and len(gone) < len(t.interests):  # (the last one's going is the unwatched rule below)
                    for who in gone:
                        del t.interests[who]
                        t.followed.pop(who, None)
                    self.save(t)
            if not t.attached or t.state in FINISHED or t.cancel_requested or t.flock:
                continue
            if self.watchers.get(t.id):
                t.last_watched = now
            elif now - max([t.last_watched, *t.followed.values()]) > self.cfg.unwatched_seconds:
                log(f"cancelling {t.id}: the `buildq run` that submitted it has gone")
                self.vacate(t, now)
                self.cancel(t, now)
        for place, (_, until) in list(self.vacated.items()):
            if until < now:
                del self.vacated[place]

    def send_waits(self, now: float) -> None:
        for position, t in enumerate(self.queue()):
            if t.reason_cat != t.sent_cat or now - t.sent_at >= 60:
                t.sent_cat, t.sent_at = t.reason_cat, now
                for conn in list(self.watchers.get(t.id, ())):
                    conn.send({"type": "wait", "id": t.id, "ahead": position, "reason": t.reason,
                               "category": t.reason_cat, "waited": round(now - t.submitted)})

    async def ticker(self) -> None:
        while not self.stopping:
            try:
                self.tick(time.time())
            except Exception:
                log("tick failed:\n" + traceback.format_exc())
            await asyncio.sleep(1.0)

    def handle_message(self, msg: dict, conn: Conn, now: float) -> None:
        op = msg.get("op")
        if op == "submit":
            t, error = self.submit(msg, now)
            if t is None:
                conn.send({"type": "error", "error": error})
                return
            if msg.get("watch") and t.state not in FINISHED:
                self.watchers[t.id].add(conn)
                conn.submission = msg.get("submission")
                t.sent_cat = None  # send the first reason on the next tick
            conn.send({"type": "ticket", **t.row(now, self.position(t)), **self.submit_outcome})
        elif op in ("watch", "cancel"):
            t, error = self.resolve(msg.get("ticket"))
            if t is None:
                conn.send({"type": "error", "error": error})
                return
            if op == "cancel":
                if t.flock:
                    conn.send({"type": "error", "error": f"{t.id} was started outside the queue; buildq can't cancel it"})
                    return
                who = msg.get("submission") or msg.get("owner")
                who = who if isinstance(who, str) and len(who) <= 100 else None
                if not msg.get("all") and t.state not in FINISHED:
                    if who is not None and t.interests and who not in t.interests:
                        conn.send({"type": "ticket", **t.row(now, self.position(t)), "kept": True})
                        return  # not one of its submissions (or one that went already): nothing to stop
                    if who is not None and who in t.interests:
                        # A `run` that made or joined it was interrupted: that submission stops
                        # waiting. The build stops only when it was the last one waiting.
                        del t.interests[who]
                        if self.waiting(t, now):
                            if "submit" in t.interests.values():
                                t.attached = False  # a dropped-off submission waits: no client's going cancels it
                            self.save(t)
                            log(f"{t.id}: a submission that waited for it went; {len(self.waiting(t, now))} still wait")
                            conn.send({"type": "ticket", **t.row(now, self.position(t)), "kept": True})
                            return
                    elif who is None and len(self.waiting(t, now)) > 1:
                        conn.send({"type": "error", "error": (
                            f"{t.id[:8]} is shared: {len(self.waiting(t, now))} submissions of the same build wait for it. "
                            "`buildq cancel --all` stops it for all of them")})
                        return
                if msg.get("vacate") is True:  # the client was stopped (SIGTERM, SIGHUP), not interrupted
                    self.vacate(t, now)
                self.cancel(t, now)
                self.schedule(now)
            elif t.state not in FINISHED:
                self.watchers[t.id].add(conn)
                if isinstance(msg.get("submission"), str):
                    conn.submission = msg["submission"]  # a `run` following again after a reconnect
                    if self.submissions.get(conn.submission) == t.id and conn.submission not in t.interests \
                            and (conn.submission == t.submission or t.answered.get(conn.submission) == "joined"):
                        t.interests[conn.submission] = "run"  # it had been given up for gone: it waits again
                    if conn.submission in t.interests:
                        t.followed[conn.submission] = now
                        self.save(t)
                t.sent_cat = None
            conn.send({"type": "ticket", **t.row(now, self.position(t))})
        elif op == "status":
            refs = msg.get("tickets")
            if refs:
                rows, errors = [], []
                for ref in refs if isinstance(refs, list) else [refs]:
                    t, error = self.resolve(ref)
                    if t is None:
                        errors.append(error)
                    else:
                        rows.append(t.row(now, self.position(t)))
                conn.send({"type": "tickets", "tickets": rows, "errors": errors})
            else:
                conn.send({"type": "status", **self.overview(now)})
        elif op == "list":
            conn.send({"type": "tickets", "tickets": self.listing(now, bool(msg.get("all"))), "errors": []})
        elif op == "pause":
            reason = msg.get("reason")
            self.pause(str(reason)[:300] if reason else None, now)
            conn.send({"type": "paused", "paused": self.paused})
        elif op == "resume":
            self.resume(now)
            conn.send({"type": "paused", "paused": None})
        elif op == "ping":
            conn.send({"type": "pong", "version": VERSION, "runner": self.runner.name})
        else:
            conn.send({"type": "error", "error": f"unexpected op {op!r}"})

    async def handle(self, reader, writer) -> None:
        conn = Conn(writer)
        sock = writer.get_extra_info("socket")
        if sock is not None and peer_uid(sock) not in (UID, None):
            writer.close()  # only this user's processes may use the queue
            return
        try:
            while not self.stopping:
                line = await reader.readline()
                if not line:
                    break
                try:
                    msg = json.loads(line)
                    if not isinstance(msg, dict):
                        raise ValueError("not an object")
                except ValueError:
                    conn.send({"type": "error", "error": "each message is one JSON object on one line"})
                    continue
                try:
                    self.handle_message(msg, conn, time.time())
                except Exception:
                    log("request failed:\n" + traceback.format_exc())
                    conn.send({"type": "error", "error": "the daemon failed to handle that request; see its log"})
                await writer.drain()
        except (ConnectionError, asyncio.IncompleteReadError, ValueError):
            pass
        except asyncio.CancelledError:
            raise
        except Exception:
            log("connection handler failed:\n" + traceback.format_exc())
        finally:
            conn.closed = True
            for conns in self.watchers.values():
                conns.discard(conn)
            try:
                writer.close()
            except Exception:
                pass


# --------------------------------------------------------------------------------------------
# The supervisor: runs one build inside its service


class CappedOutput:
    """Writes a build's output to its log, up to `limit` bytes; past that it keeps only the last
    quarter of `limit` and appends it, with a note, when the build ends."""

    def __init__(self, fd: int, limit: int, note: bool = True):
        self.fd = fd
        self.limit = limit
        self.note = note  # not in stdout.log, which a caller may be parsing
        self.written = 0
        self.tail: collections.deque = collections.deque()
        self.tail_bytes = 0
        self.tail_limit = max(limit // 4, 1)
        self.dropped = 0

    def _write_all(self, data: bytes) -> None:
        view = memoryview(data)
        while view:
            try:
                n = os.write(self.fd, view)
            except InterruptedError:
                continue
            except OSError:
                return  # a full disk mustn't stop the build
            view = view[n:]

    def write(self, data: bytes) -> None:
        if self.limit <= 0 or self.written < self.limit:
            room = len(data) if self.limit <= 0 else self.limit - self.written
            self._write_all(data[:room])
            self.written += min(room, len(data))
            data = data[room:]
        if data:
            self.tail.append(data)
            self.tail_bytes += len(data)
            self.dropped += len(data)
            while self.tail and self.tail_bytes - len(self.tail[0]) >= self.tail_limit:
                self.tail_bytes -= len(self.tail.popleft())

    def finish(self) -> None:
        if not self.dropped:
            return
        kept = b"".join(self.tail)[-self.tail_limit:]
        if self.note:
            self._write_all(f"\n[buildq: {self.dropped - len(kept)} bytes of output left out here; "
                            f"the last {len(kept)} follow]\n".encode())
        self._write_all(kept)


def oom_of(result: dict) -> bool:
    """Whether a build's result shows it was killed for memory at its own cap. A kill that came
    from outside (the slice's limit as other work grew, systemd-oomd) doesn't say the build needs
    more than it had."""
    return bool(result.get("oom_kills")) and bool(result.get("hit_own_cap", True))


def signal_group(pgid: int, sig: int) -> bool:
    """Signal a process group; False if it has no processes left."""
    try:
        os.killpg(pgid, sig)
        return True
    except ProcessLookupError:
        return False
    except OSError:
        return True


def apply_rlimits(limits) -> None:
    """The submitter's soft limits (open files, stack, core size), within this process's hard ones."""
    import resource
    names = {"NOFILE": resource.RLIMIT_NOFILE, "STACK": resource.RLIMIT_STACK, "CORE": resource.RLIMIT_CORE}
    for name, value in (limits or {}).items():
        which = names.get(name)
        if which is None or not isinstance(value, int):
            continue
        try:
            _, hard = resource.getrlimit(which)
            soft = value if hard == resource.RLIM_INFINITY or (0 <= value <= hard) else hard
            if value == resource.RLIM_INFINITY and hard != resource.RLIM_INFINITY:
                soft = hard
            resource.setrlimit(which, (soft, hard))
        except (ValueError, OSError):
            continue


def supervise(directory: str) -> int:
    """Run one build: its command, with its submitter's environment, directory and limits; its
    output into output.log (both streams) and stdout.log / stderr.log (each); and, whatever
    happens, its exit status into result.json."""
    os.umask(0o077)
    code, timed_out = 126, False
    outputs = []
    jobserver = None
    try:
        # Claim the environment atomically: if two supervisors ever start for one build (a launch
        # from before a daemon restart arriving late), only one gets it, and the other runs nothing.
        claimed = os.path.join(directory, f"env.{os.getpid()}.json")
        try:
            os.rename(os.path.join(directory, "env.json"), claimed)
        except FileNotFoundError:
            return 0  # another supervisor has this build; it writes the result
        me = proc_identity(os.getpid())
        write_json(os.path.join(directory, "supervisor.json"), {"pid": os.getpid(), "start": me[0] if me else None})
        spec = read_json(os.path.join(directory, "ticket.json")) or {}
        job = str(spec.get("id") or os.path.basename(directory))
        env = read_json(claimed)
        try:
            os.remove(claimed)  # the environment can hold secrets; it isn't kept once the build has it
        except OSError:
            pass
        parallel = read_json(os.path.join(directory, "parallel.json"))
        if isinstance(env, dict) and isinstance(parallel, dict):
            env.update({str(k): str(v) for k, v in parallel.items()})
        limit = int(spec.get("max_log") or 0)

        def log_file(name: str, size: int, note: bool = True) -> CappedOutput:
            fd = os.open(os.path.join(directory, name), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            output = CappedOutput(fd, size, note)
            outputs.append(output)
            return output

        combined = log_file("output.log", limit)
        streams = {1: log_file("stdout.log", limit // 2, note=False), 2: log_file("stderr.log", limit // 2)}

        def note(text: str) -> None:
            for output in (combined, streams[2]):
                output.write(text.encode())

        # Hold the build's jobserver open for as long as the build runs: a pipe's tokens last only
        # while someone has it open, and the daemon may restart in between.
        if spec.get("jobserver") and os.path.exists(spec["jobserver"]):
            try:
                jobserver = os.open(spec["jobserver"], os.O_RDWR | os.O_NONBLOCK)
            except OSError:
                jobserver = None
        apply_rlimits(spec.get("rlimits"))
        argv, cwd = spec.get("exec_argv") or spec.get("argv"), spec.get("cwd") or "/"
        timeout = spec.get("timeout")
        if not isinstance(env, dict) or not argv:
            note("buildq: this build's command or environment is missing; it can't run.\n")
            return code
        pipes = {1: os.pipe(), 2: os.pipe()}
        try:
            umask = spec.get("umask")
            child = subprocess.Popen(argv, cwd=cwd, env=env, stdin=DEVNULL, stdout=pipes[1][1], stderr=pipes[2][1],
                                     process_group=0, umask=umask if isinstance(umask, int) else 0o022)
        except (OSError, ValueError) as e:
            for r, w in pipes.values():
                os.close(r)
                os.close(w)
            note(f"buildq: can't run {argv[0]} in {cwd}: {getattr(e, 'strerror', None) or e}\n")
            code = 127 if isinstance(e, FileNotFoundError) else 126
            return code
        for _, w in pipes.values():
            os.close(w)
        write_json(os.path.join(directory, "child.json"), {"pid": child.pid, "pgid": child.pid})

        def forward(signum, _frame):
            signal_group(child.pid, signum)

        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT, signal.SIGUSR1, signal.SIGUSR2):
            signal.signal(sig, forward)
        selector = selectors.DefaultSelector()
        for number_, (r, _) in pipes.items():
            os.set_blocking(r, False)
            selector.register(r, selectors.EVENT_READ, number_)
        open_pipes = len(pipes)
        deadline = time.monotonic() + float(timeout) if timeout else None
        term_sent = None

        def pump(wait: float) -> None:
            nonlocal open_pipes
            if not open_pipes:
                time.sleep(wait)
                return
            for key, _ in selector.select(wait):
                for _batch in range(64):  # at most 4 MiB at a time, so deadlines are still checked
                    try:
                        data = os.read(key.fd, 1 << 16)
                    except BlockingIOError:
                        break
                    except InterruptedError:
                        continue
                    if not data:
                        selector.unregister(key.fd)
                        open_pipes -= 1
                        break
                    combined.write(data)
                    streams[key.data].write(data)

        last = time.monotonic()
        while child.poll() is None:
            pump(0.5)
            tick = time.monotonic()
            if deadline and tick - last > 5:
                # A turn of this loop that took far longer than its half second: the build was paused
                # (frozen to free memory) or the machine stalled. That time doesn't count.
                deadline += tick - last - 0.5
            last = tick
            if deadline and time.monotonic() > deadline and term_sent is None:
                timed_out, term_sent = True, time.monotonic()
                note(f"\nbuildq: timed out after {float(timeout):.0f}s; stopping it\n")
                signal_group(child.pid, signal.SIGTERM)
            if term_sent and time.monotonic() - term_sent > 30:
                signal_group(child.pid, signal.SIGKILL)
        # Whatever the build left running in its process group goes too, so its turn ends with it.
        if signal_group(child.pid, signal.SIGTERM):
            stop_by = time.monotonic() + 10
            while signal_group(child.pid, 0) and time.monotonic() < stop_by:
                pump(0.2)
            signal_group(child.pid, signal.SIGKILL)
        # And so does anything that left the group (setsid, a double fork): it still carries this
        # build's BUILDQ_JOB. Under the direct runner nothing else would find it.
        strays = tagged_processes(job, exclude=os.getpid())
        if strays:
            for pid in strays:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
            stop_by = time.monotonic() + 5
            while tagged_processes(job, exclude=os.getpid()) and time.monotonic() < stop_by:
                pump(0.2)
            for pid in tagged_processes(job, exclude=os.getpid()):
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
        drain_by = time.monotonic() + 2
        while open_pipes and time.monotonic() < drain_by:
            pump(0.1)
        for r, _ in pipes.values():
            try:
                os.close(r)
            except OSError:
                pass
        returncode = child.returncode
        code = 124 if timed_out else (returncode if returncode >= 0 else 128 - returncode)
        return code
    except Exception as e:  # the result must always be written
        try:
            for output in outputs[:1]:
                output.write(f"\nbuildq: the supervisor failed: {e!r}\n".encode())
        except Exception:
            pass
        return code
    finally:
        for output in outputs:
            try:
                output.finish()
                os.close(output.fd)
            except Exception:
                pass
        if jobserver is not None:
            os.close(jobserver)
        if os.path.exists(os.path.join(directory, "supervisor.json")) and \
                (read_json(os.path.join(directory, "supervisor.json")) or {}).get("pid") == os.getpid():
            own = proc_cgroup(os.getpid())
            # Only a cgroup of the build's own says anything about the build: under the direct
            # runner the supervisor shares the daemon's (or a terminal's), with its whole history.
            ticket_id = os.path.basename(os.path.normpath(directory))
            own = own if own and re.fullmatch(rf"buildq-{re.escape(ticket_id)}(-r\d+)?\.service",
                                              os.path.basename(own)) else None
            events = cgroup_events(own) if own else {}
            some, full, high = (cgroup_memory_waits(own) if own else None) or (None, None, None)
            try:
                write_json(os.path.join(directory, "result.json"),
                           {"exit": code, "ended": time.time(), "timed_out": timed_out,
                            "oom_kills": events.get("oom_kill", 0),
                            # "oom" counts the times an allocation was about to fail at the build's
                            # own MemoryMax ("max" only counts reclaim there); a kill without it came
                            # from outside (the slice's limit, systemd-oomd).
                            "hit_own_cap": events.get("oom", 0) > 0,
                            # None: not measured (no cgroup of its own)
                            "mem_wait_some": None if some is None else round(some, 1),
                            "mem_wait_full": None if full is None else round(full, 1), "mem_high": high})
            except OSError:
                pass


# --------------------------------------------------------------------------------------------
# Serving


def listening_socket(path: str):
    """The socket systemd passed us (socket activation), or one we bind at `path`."""
    if os.environ.get("LISTEN_PID") == str(os.getpid()) and int(os.environ.get("LISTEN_FDS") or 0) >= 1:
        for name in ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"):
            os.environ.pop(name, None)
        sock = socket.socket(fileno=3)
        sock.setblocking(False)
        return sock, False
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.connect(path)
        sys.exit(f"buildqd: something is already listening on {path}")
    except (FileNotFoundError, ConnectionRefusedError):
        pass
    finally:
        probe.close()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.bind(path)  # mode 0600: the daemon runs with umask 077
    sock.listen(128)
    sock.setblocking(False)
    return sock, True


async def serve(args) -> None:
    loop = asyncio.get_running_loop()
    stop = asyncio.Event()
    holder: dict = {}
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, stop.set)
    loop.add_signal_handler(signal.SIGHUP, lambda: asyncio.ensure_future(holder["daemon"].reload_async())
                            if "daemon" in holder else None)
    daemon = Daemon(args.config, args.state_dir)
    holder["daemon"] = daemon
    await asyncio.sleep(0.5)
    daemon.machine.sample(time.monotonic())  # a first CPU reading before the first decision
    now = time.time()
    daemon.load_tickets(now)
    daemon.prune(now)
    daemon.scan_flock_slots(now)
    sock, owned = listening_socket(args.socket)
    # Python 3.13+ removes a Unix server's socket file when the server closes. A socket systemd
    # passed us belongs to systemd and must outlive this process; ours we remove ourselves.
    keep = {"cleanup_socket": False} if sys.version_info >= (3, 13) else {}
    server = await asyncio.start_unix_server(daemon.handle, sock=sock, limit=16 << 20, **keep)
    ticker = asyncio.create_task(daemon.ticker())
    m = daemon.machine
    log(f"buildqd {VERSION} on {args.socket}: {m.ncpu} cores, {fmt_size(m.mem_total)} memory, "
        f"{daemon.runner.name} runner; configuration {json.dumps(daemon.cfg.summary())}")
    await stop.wait()
    daemon.stopping = True  # from here on nothing new starts
    daemon.thaw_all(time.time())
    daemon.save_queued(time.time())
    daemon.guard_slice(stopping=True)
    ticker.cancel()
    daemon.stop_memory_watch()
    daemon.queries.shutdown(wait=False, cancel_futures=True)
    server.close()
    if owned:
        try:
            os.unlink(args.socket)
        except OSError:
            pass
    log(f"stopping; {len(daemon.active())} running build(s) carry on, and the next daemon picks them up")


def main(argv=None) -> None:
    parser = argparse.ArgumentParser(prog="buildqd", description="The buildq daemon: a load-aware build queue.")
    parser.add_argument("--socket", default=default_socket(), help="Unix socket to listen on (default: %(default)s)")
    parser.add_argument("--state-dir", default=default_state_dir(), help="tickets and history (default: %(default)s)")
    parser.add_argument("--config", default=default_config(), help="TOML configuration file (default: %(default)s)")
    parser.add_argument("--check-config", action="store_true", help="load the configuration, print it, and exit")
    parser.add_argument("--supervise", metavar="TICKET_DIR", help=argparse.SUPPRESS)
    parser.add_argument("--version", action="version", version=f"buildqd {VERSION}")
    args = parser.parse_args(argv)
    os.umask(0o077)  # tickets, logs, history and the socket are private to this user
    if args.supervise:
        sys.exit(supervise(args.supervise))
    try:
        sys.stdout.reconfigure(errors="backslashreplace")
    except (AttributeError, ValueError):
        pass
    if args.check_config:
        m = Machine()
        cfg = load_config_file(args.config, m.mem_total, m.ncpu)
        if SystemdRunner.available():
            for lane in cfg.lanes.values():
                problem = SystemdRunner.check_lane(lane)
                if problem:
                    sys.exit(f"systemd refuses lanes.{lane.name}.properties: {problem}")
        if cfg.gh and not (os.path.isfile(cfg.gh) and os.access(cfg.gh, os.X_OK)):
            # (a warning, not a refusal: the configuration loads, and statuses are tried when sent)
            print(f"buildqd: warning: gh = {cfg.gh!r} isn't an executable file; commit statuses can't be "
                  "sent until it is", file=sys.stderr)
        print(json.dumps(cfg.summary(), indent=2))
        return
    asyncio.run(serve(args))


if __name__ == "__main__":
    main()
