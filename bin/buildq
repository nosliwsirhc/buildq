#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""buildq: drop off a build, get a ticket, and check on it later.

  buildq submit [OPTIONS] [--] COMMAND [ARGS...]   queue a build; prints its ticket and returns at once
  buildq run    [OPTIONS] [--] COMMAND [ARGS...]   queue it, stream its output, exit with its exit code
  buildq status [TICKET...] [--json]               a ticket in detail, or the whole queue and the machine
  buildq list   [--all] [--json]                   every ticket: queued, running and recently finished
  buildq wait   TICKET [--timeout DURATION]        block until it finishes; exit with its exit code
  buildq logs   TICKET [--follow] [--tail N]       its output
  buildq cancel TICKET...                          take it out of the queue, or stop it
  buildq pause [REASON] | resume                   start nothing new (running builds carry on), or go on
  buildq report [--since 7d] [--by command|lane|caller] [--json]
                                                   time, memory and kills per command, from history
  buildq help agents                               how a coding agent uses the queue
  buildq ping                                      check that the daemon answers

A ticket is a UUID; any unique prefix of four or more characters works in its place.

Options for submit and run:
  --lane NAME          the kind of build, from the daemon's configuration
  --cores N            use N cores, in place of the size learned from earlier runs
  --mem SIZE           expect at least this peak memory (for example 6G); it can raise the
                       learned size, never lower it
  --priority N         higher runs first (default 0)
  --timeout DURATION   stop the build after this long (for example 45m)
  --name TEXT          a name to show in place of the command
  --notify COMMAND     a shell command to run when it finishes (BUILDQ_TICKET, BUILDQ_STATE,
                       BUILDQ_EXIT, BUILDQ_LOG, ... are set)
  --again              run it even if the same command on the same source is queued, running, or
                       passed a moment ago
  --reuse              take an earlier pass of the same command on the same source as this one's
                       result, even for a command that isn't a plain check
  --restartable        it is safe to stop and start over from the beginning (it only builds and
                       tests): if the machine runs short of memory it is queued again, not failed

buildq records the source a build is of: the commit, and a fingerprint of the changes on top. The
same command on the same source, in the same directory, environment and settings, joins a build of
it that is queued or running. A plain check (cargo check, clippy or test, dotnet test, tsc --noEmit,
eslint, vitest run) that passed on the same source within the daemon's reuse_window, with the source
unchanged while it ran, isn't run again: its earlier result answers (--again runs it anyway).

The build runs in the background with the environment and working directory of the command that
submitted it, and no stdin. `buildq run` streams its output to stdout and exits with its exit
code (128 + N if signal N ended it). Interrupting `buildq run` (Ctrl-C, SIGTERM, SIGHUP) cancels
the build, and so does killing it outright, once no client has followed the build for the
daemon's unwatched_seconds. A build dropped off with `buildq submit` runs on alone.

Exit codes of the client itself: 2 for a refused request, 75 when the daemon can't be reached
(BUILDQ_FALLBACK=fail, or submit), 124 when `wait --timeout` runs out, 125 when a build ended
without an exit status (cancelled before it ran, or lost).

Environment:
  BUILDQ_SOCKET    the daemon's socket (default $XDG_RUNTIME_DIR/buildq.sock)
  BUILDQ_FALLBACK  what `buildq run` does when the daemon can't be reached. Unset: wait for it,
                   retrying every few seconds. "fail": exit 75. "run": run the command at once,
                   unqueued. Anything else: a command prefix to run the command through instead
                   (an older semaphore script, say).
  BUILDQ_JOB       set inside every build. A `buildq run` inside a build runs its command directly,
                   because the build already has a turn.
  BUILDQ_AS        the name of a wrapper in front of buildq that takes --submit, --wait, --status,
                   --logs and --cancel: buildq's hints then name the wrapper's commands.
"""

from __future__ import annotations

import argparse
import collections
import glob
import hashlib
import json
import math
import os
import re
import shutil
import select
import shlex
import signal
import socket
import stat
import struct
import subprocess
import sys
import time
import uuid

VERSION = "0.2.0"
GIB, MIB = 1 << 30, 1 << 20
FINISHED = ("succeeded", "failed", "cancelled", "lost")


def socket_path() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.expanduser(os.environ.get("BUILDQ_SOCKET") or os.path.join(runtime, "buildq.sock"))


def state_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.expanduser(os.environ.get("BUILDQ_STATE_DIR") or os.path.join(base, "buildq"))


def note(text: str) -> None:
    print(f"buildq: {text}", file=sys.stderr, flush=True)


def fmt_size(n) -> str:
    n = n or 0
    if abs(n) >= 10 * GIB:
        return f"{n / GIB:.0f}G"
    if abs(n) >= GIB:
        return f"{n / GIB:.1f}G"
    return f"{n / MIB:.0f}M"


def fmt_age(seconds) -> str:
    seconds = max(0, int(seconds or 0))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"
    return f"{seconds // 86400}d{(seconds % 86400) // 3600:02d}h"


def parse_duration(text: str) -> float:
    import re
    match = re.fullmatch(r"\s*([0-9]*\.?[0-9]+)\s*([smhd]?)\s*", str(text))
    if not match:
        raise argparse.ArgumentTypeError(f"not a duration: {text!r} (try 90s, 10m or 2h)")
    return float(match.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]


def short_path(path) -> str:
    if not path:
        return ""
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


# --------------------------------------------------------------------------------------------
# Talking to the daemon


class Lost(Exception):
    """The connection to the daemon failed or went quiet."""


class Channel:
    def __init__(self, sock: socket.socket):
        self.sock = sock
        self.buffer = b""

    def send(self, message: dict) -> None:
        try:
            self.sock.settimeout(10)
            self.sock.sendall((json.dumps(message) + "\n").encode())
        except OSError as e:
            raise Lost(str(e)) from e

    def poll(self, timeout: float) -> dict | None:
        """The next message, or None if none arrives within `timeout` seconds."""
        deadline = time.monotonic() + timeout
        while b"\n" not in self.buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            try:
                ready, _, _ = select.select([self.sock], [], [], remaining)
                if not ready:
                    return None
                self.sock.settimeout(5)
                chunk = self.sock.recv(65536)
            except OSError as e:
                raise Lost(str(e)) from e
            if not chunk:
                raise Lost("the daemon closed the connection")
            self.buffer += chunk
        line, _, self.buffer = self.buffer.partition(b"\n")
        try:
            return json.loads(line)
        except ValueError as e:
            raise Lost(f"a message from the daemon isn't JSON: {line[:200]!r}") from e

    def recv(self, timeout: float) -> dict:
        message = self.poll(timeout)
        if message is None:
            raise Lost(f"no answer from the daemon in {timeout:.0f}s")
        return message

    def close(self) -> None:
        try:
            self.sock.close()
        except OSError:
            pass


def connect(timeout: float, socket_timeout: float = 5) -> Channel | None:
    """Connect, retrying while the daemon restarts: up to `timeout` seconds while the socket
    refuses connections, and 2 seconds (or `timeout`, if less) while it doesn't exist (a daemon
    that isn't installed)."""
    start = time.monotonic()
    while True:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(socket_timeout)
        try:
            sock.connect(socket_path())
            uid = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                      struct.calcsize("3i")))[1]
            if uid != os.getuid():
                sock.close()
                note(f"refusing {socket_path()}: it belongs to uid {uid}, not to this user")
                return None
            return Channel(sock)
        except OSError as e:
            sock.close()
            limit = min(2.0, timeout) if isinstance(e, FileNotFoundError) else timeout
            if time.monotonic() - start >= limit:
                return None
            time.sleep(0.25)


def request(message: dict, timeout: float = 15, connect_timeout: float = 3) -> dict | None:
    channel = connect(connect_timeout, min(5.0, timeout))
    if channel is None:
        return None
    try:
        channel.send(message)
        return channel.recv(timeout)
    except Lost:
        return None
    finally:
        channel.close()


def command_for(verb: str, rest: str = "") -> str:
    """How to type `buildq VERB REST` here. A wrapper in front of buildq that takes --VERB (such as
    `wrapper --submit <command>`, `wrapper --wait <ticket>`) sets BUILDQ_AS to its name, so the
    hints name what its users type."""
    wrapper = os.environ.get("BUILDQ_AS", "").strip()
    if wrapper:
        return f"{wrapper} --{verb}{' ' + rest if rest else ''}"
    if verb in ("submit", "run") and rest:
        rest = "-- " + rest
    return f"buildq {verb}{' ' + rest if rest else ''}"


LONG_RUN = 8 * 60  # past this, a tool call that runs the command may well be cut off


def unreachable() -> int:
    note(f"the queue daemon isn't answering at {socket_path()} "
         "(systemctl --user status buildq; journalctl --user -u buildq)")
    return 75


# --------------------------------------------------------------------------------------------
# Describing tickets


def state_text(row: dict) -> str:
    state = row["state"]
    if state == "queued":
        ahead = row.get("ahead")
        place = f", {ahead} ahead" if ahead else ""
        return f"queued for {fmt_age(row['waited'])}{place}"
    if state == "starting":
        return "starting"
    if state == "running":
        return f"running for {fmt_age(row['elapsed'])}, after {fmt_age(row['waited'])} in the queue"
    after = f" after {fmt_age(row['elapsed'])}" if row.get("elapsed") is not None else ""
    if state == "succeeded":
        return f"succeeded{after}"
    if state == "failed":
        bits = [f"exit {row['exit']}"] if row.get("exit") is not None else []
        if row.get("oom"):
            bits.append("killed for memory")
        if row.get("timed_out"):
            bits.append("timed out")
        detail = f" ({', '.join(bits)})" if bits else ""
        return f"failed{detail}{after}"
    if state == "cancelled":
        return f"cancelled{after}"
    return f"lost{after}"


def title(row: dict) -> str:
    return row.get("name") or row["label"]


def summary_line(row: dict) -> str:
    text = f"{row['short']} {state_text(row)}"
    if row.get("measured") and row["state"] in FINISHED:
        text += f"; peak {fmt_size(row['mem_peak'])}, {row['peak_cores']:.1f} cores"
    if row.get("error"):
        text += f"; {row['error']}"
    return text


def print_ticket(row: dict) -> None:
    print(f"ticket {row['id']}  ({row['lane']} lane{', priority ' + str(row['priority']) if row.get('priority') else ''})")
    print(f"  state     {state_text(row)}")
    if row["state"] == "queued" and row.get("reason"):
        print(f"  waiting   {row['reason']}")
    if row.get("error"):
        print(f"  error     {row['error']}")
    if row.get("name"):
        print(f"  name      {row['name']}")
    print(f"  command   {row['label']}")
    print(f"  in        {short_path(row['cwd'])}")
    src = row.get("source")
    if src:
        if row.get("source_changed"):  # (found as it started or as it ended)
            checked = ("; it changed after it was recorded, so the result isn't of this source"
                       if row["state"] in FINISHED else
                       "; it changed after it was recorded, so the result won't count as this source's")
        elif row.get("source_verified"):
            checked = "; the same when the build started and ended"
        elif row.get("source_verified") is False:  # finished, but a check of it failed
            checked = "; it couldn't be checked, so no later run reuses it"
        else:
            checked = ""
        print(f"  source    commit {src['commit'][:10]}{' + uncommitted changes' if src.get('dirty') else ''}"
              f" (fingerprint {src['fingerprint'][:12]}){checked}")
    if row.get("caller"):
        print(f"  from      {row['caller']}")
    if row.get("frozen"):
        print("  paused    to give the machine its memory back; it goes on once there is room")
    if row.get("requeues"):
        n, for_ci = row["requeues"], row.get("ci_stops") or 0
        why = ("stopped to free memory" if not for_ci else "stopped to make room for CI jobs' builds" if for_ci == n
               else f"{n - for_ci} to free memory, {for_ci} to make room for CI jobs' builds")
        print(f"  requeued  {n} time{'s' if n != 1 else ''} ({why}), then started over")
    if row["state"] in ("starting", "running") and row.get("measured"):
        print(f"  using     {row['cores_now']:.1f} cores, {fmt_size(row['mem_now'])} now; "
              f"peak {fmt_size(row['mem_peak'])}, {row['peak_cores']:.1f} cores")
    elif row["state"] in FINISHED and row.get("measured"):
        print(f"  used      peak {fmt_size(row['mem_peak'])}, {row['peak_cores']:.1f} cores at most, "
              f"{row['avg_cores']:.1f} on average")
    some, full = row.get("mem_wait_some") or 0, row.get("mem_wait_full") or 0
    if some >= 1 or row.get("mem_high"):
        over = "; it went over its MemoryHigh, where the kernel slows it" if row.get("mem_high") else ""
        print(f"  memory    waited on memory {some:.0f}s ({full:.0f}s with all of it waiting){over}")
    if row.get("granted"):
        live = " (resized live through its jobserver)" if row.get("elastic") else ""
        print(f"  cores     {row['granted']} given{live}; it can use up to {row['want']}")
    print(f"  expected  {row['est_cores']:g} cores, {fmt_size(row['est_mem'])} ({row['est_src']})")
    if row.get("log"):
        print(f"  log       {short_path(row['log'])}")


def print_overview(s: dict) -> None:
    m, b, c = s["machine"], s.get("budget") or {}, s["config"]
    print(f"buildqd {s['version']} ({s['runner']} runner): {m['cores']} cores, {m['busy']:.1f} busy "
          f"(target {b.get('cpu_cap', 0):.1f}); memory {fmt_size(m['mem_available'])} available of "
          f"{fmt_size(m['mem_total'])} (floor {fmt_size(c['mem_floor'])}); pressure cpu "
          f"{m['psi_cpu_some_avg10']:.0f}%, memory {m['psi_mem_full_avg10']:.0f}%")
    if b:
        print(f"room for new builds: {max(b['free_cores'], 0):.1f} cores, {fmt_size(max(b['free_mem'], 0))} "
              f"(after {fmt_size(b['growth_reserved'])} held for running builds to grow into)")
    if s.get("paused"):
        p = s["paused"]
        print(f"PAUSED for {fmt_age(s['now'] - (p.get('since') or s['now']))}"
              f"{': ' + p['reason'] if p.get('reason') else ''}. Nothing new starts until `buildq resume`.")
    print()
    running, queued, recent = s["running"], s["queued"], s.get("recent") or []
    print(f"running {len(running)} of at most {c['max_jobs']}")
    for r in running:
        if r.get("outside"):
            use = f"~{r['est_cores']:g} cores ~{fmt_size(r['est_mem'])}"
            tag = f"  [outside the queue: holds {os.path.basename(r['outside'])}]"
        else:
            cores = f"{r['cores_now']:.1f}/{r['granted'] or r['est_cores']:g} cores" if r["measured"] else f"~{r['est_cores']:g} cores"
            memory = f"{fmt_size(r['mem_now'])}/{fmt_size(r['est_mem'])}" if r["measured"] else f"~{fmt_size(r['est_mem'])}"
            use, tag = f"{cores} {memory}", "  [paused: memory is short]" if r.get("frozen") else ""
        print(f"  {r['short']:<9} {r['lane']:<6} {fmt_age(r['elapsed']):>6}  {use:<22} {title(r)}{tag}")
    print(f"queued {len(queued)}")
    for r in queued:
        print(f"  {r['short']:<9} {r['lane']:<6} {fmt_age(r['waited']):>6}  "
              f"{'needs ' + fmt_size(r['est_mem']):<22} {title(r)}")
        print(f"  {'':<9} {'':<6} {'':>6}  waiting: {r['reason'] or 'deciding'}")
    if recent:
        print("finished recently")
        for r in recent[:5]:
            print(f"  {r['short']:<9} {r['lane']:<6} {fmt_age(s['now'] - (r['ended'] or s['now'])):>6}  "
                  f"{state_text(r):<22} {title(r)}")


def print_list(rows: list[dict], now: float) -> None:
    if not rows:
        print("no tickets")
        return
    print(f"{'TICKET':<9} {'LANE':<6} {'SUBMITTED':>9}  {'STATE':<40} COMMAND")
    for r in rows:
        print(f"{r['short']:<9} {r['lane']:<6} {fmt_age(now - r['submitted']) + ' ago':>9}  "
              f"{state_text(r)[:40]:<40} {title(r)}")


# --------------------------------------------------------------------------------------------
# Following a ticket to its end


def local_ticket_dir(ref: str) -> str | None:
    """The ticket's directory, found on disk without the daemon."""
    matches = glob.glob(os.path.join(state_dir(), "tickets", glob.escape(ref) + "*"))
    return matches[0] if len(matches) == 1 else None


def files_final(directory: str | None) -> dict | None:
    """The ticket's final state from its files, for when the daemon can't be asked."""
    if not directory:
        return None
    try:
        with open(os.path.join(directory, "ticket.json")) as f:
            record = json.load(f)
    except (OSError, ValueError):
        record = {}
    try:
        with open(os.path.join(directory, "result.json")) as f:
            result = json.load(f)
    except (OSError, ValueError):
        result = None
    state = record.get("state")
    if state in FINISHED:
        exit_code = record.get("exit")
    elif result is not None:
        exit_code = result.get("exit")
        state = "succeeded" if exit_code == 0 else "failed"
    else:
        return None
    tid = record.get("id") or os.path.basename(directory)
    return {"id": tid, "short": tid[:8], "state": state, "exit": exit_code, "elapsed": None,
            "oom": record.get("oom"), "error": record.get("error"), "measured": False,
            "timed_out": (result or {}).get("timed_out")}


def reraise(signum: int) -> int:
    """End this process by the signal that interrupted it, so a calling shell sees an interrupted
    command (and a script stops) rather than an ordinary exit status."""
    if signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        sys.stdout.flush()
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)
    return 128 + signum


class Follower:
    """Follows one ticket until it finishes: queue updates, its output, signals."""

    def __init__(self, row: dict, channel: Channel | None, stream: bool, cancel_on_signal: bool,
                 quiet: bool = False):
        self.row = row
        self.channel = channel
        self.stream = stream
        self.cancel_on_signal = cancel_on_signal
        self.quiet = quiet
        self.offset = 0
        self.offsets = {1: 0, 2: 0}
        self.split = False  # stream stdout.log and stderr.log to stdout and stderr
        self.last_file_check = time.monotonic()
        self.signals: list[int] = []
        self.last_category = None
        self.hinted = False  # said once that a long wait is better dropped off
        self.owner = None  # the submission that made the build, when this client made it
        self.last_note = 0.0
        self.daemon_lost_at = None

    def on_signal(self, signum, _frame) -> None:
        self.signals.append(signum)

    def copy_file(self, path: str, offset: int, out) -> int:
        try:
            with open(path, "rb") as f:
                f.seek(offset)
                while True:
                    chunk = f.read(1 << 20)
                    if not chunk:
                        break
                    offset += len(chunk)
                    out.write(chunk)
            out.flush()
        except FileNotFoundError:
            pass
        return offset

    def copy_output(self) -> None:
        path = self.row.get("log")
        if not self.stream or not path:
            return
        try:
            if self.split and self.row.get("dir"):
                d = self.row["dir"]
                self.offsets[1] = self.copy_file(os.path.join(d, "stdout.log"), self.offsets[1], sys.stdout.buffer)
                self.offsets[2] = self.copy_file(os.path.join(d, "stderr.log"), self.offsets[2], sys.stderr.buffer)
            else:
                self.offset = self.copy_file(path, self.offset, sys.stdout.buffer)
        except BrokenPipeError:
            # The reader went away (`| head`): stop like a build killed by SIGPIPE would.
            self.stream = False
            try:
                sys.stdout = open(os.devnull, "w")
            except OSError:
                pass
            self.signals.append(signal.SIGPIPE)

    def handle(self, message: dict) -> None:
        kind = message.get("type")
        if kind == "wait" and not self.quiet:
            now = time.monotonic()
            if message.get("category") != self.last_category or now - self.last_note >= 55:
                ahead = message.get("ahead") or 0
                place = f"{ahead} ahead, " if ahead else ""
                note(f"waiting ({place}{fmt_age(message.get('waited'))} so far): {message.get('reason')}")
                self.last_category, self.last_note = message.get("category"), now
                if self.cancel_on_signal and not self.hinted and (message.get("waited") or 0) >= 120:
                    self.hinted = True
                    note("if what runs this has a time limit (a tool call), waiting counts against it, and "
                         "a cut-off cancels the build; drop a long wait off instead: "
                         f"`{command_for('submit', '<command>')}` prints a ticket to wait on.")
        elif kind == "ticket":
            previous, was_frozen = self.row["state"], self.row.get("frozen")
            for_ci = (message.get("ci_stops") or 0) > (self.row.get("ci_stops") or 0)
            self.row = message
            if not self.quiet and message.get("frozen") != was_frozen and message["state"] == "running":
                note("paused: the machine is short of memory; it goes on where it was once there is room."
                     if message.get("frozen") else "going on: there is memory again.")
            if not self.quiet and previous in ("starting", "running") and message["state"] == "queued":
                note("stopped to make room for a CI job's build, and queued again: it starts from the beginning "
                     "once that build has started, and goes first then. Keep waiting." if for_ci and message.get("yields_to")
                     else "stopped to make room for a CI job's build, and queued again at the front: it starts from "
                     "the beginning once there is room. Keep waiting." if for_ci
                     else "stopped to free memory, and queued again at the front: it starts from the beginning "
                     "once there is room. Keep waiting.")
            if previous == "queued" and message["state"] in ("starting", "running") and not self.quiet \
                    and (message.get("waited") or 0) >= 2:
                note(f"starting after {fmt_age(message['waited'])} in the queue.")

    def reconnect(self) -> None:
        self.channel = connect(2)
        if self.channel is None:
            return
        try:
            self.channel.send({"op": "watch", "ticket": self.row["id"], "submission": self.owner})
        except Lost:
            self.channel.close()
            self.channel = None

    def run(self, timeout: float | None = None) -> int:
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, self.on_signal)
        deadline = time.monotonic() + timeout if timeout is not None else None
        cancel_sent = None
        directory = self.row.get("dir")
        while self.row["state"] not in FINISHED:
            if self.signals:
                if not self.cancel_on_signal:
                    return reraise(self.signals[0])
                if cancel_sent is None:
                    cancel_sent = time.monotonic()
                    # Ctrl-C means it; a SIGTERM or SIGHUP (a harness timing the call out) leaves its
                    # place in the queue for the retry.
                    reply = request({"op": "cancel", "ticket": self.row["id"], "submission": self.owner,
                                     "vacate": self.signals[0] in (signal.SIGTERM, signal.SIGHUP)})
                    if reply is None:
                        note(f"couldn't reach the daemon to cancel {self.row['short']}; it may still run")
                        return reraise(self.signals[0])
                    if reply.get("kept"):
                        note(f"{self.row['short']} carries on: other submissions of the same build wait for it")
                        return reraise(self.signals[0])
                    if not self.quiet:
                        note(f"cancelling {self.row['short']}")
                elif len(self.signals) > 1 or time.monotonic() - cancel_sent > 60:
                    return reraise(self.signals[0])
            message = None
            if self.channel is not None:
                try:
                    message = self.channel.poll(0.2)
                except Lost:
                    self.channel.close()
                    self.channel = None
            if self.channel is None:
                if self.daemon_lost_at is None:
                    self.daemon_lost_at = time.monotonic()
                elif time.monotonic() - self.daemon_lost_at >= 5:
                    self.daemon_lost_at = time.monotonic()
                    self.reconnect()
                final = files_final(directory)
                if final is not None:
                    self.row = {**self.row, **final}
                    break
                time.sleep(0.2)
            elif message is not None:
                if message.get("type") == "error":
                    note(message.get("error", "the daemon refused"))
                    return 2
                self.handle(message)
            elif time.monotonic() - self.last_file_check >= 5:
                # A final message can be lost (a full disk on the daemon's side, say); the ticket's
                # own files say when it is over.
                self.last_file_check = time.monotonic()
                final = files_final(directory)
                if final is not None:
                    self.row = {**self.row, **final}
                    break
            self.copy_output()
            if deadline is not None and time.monotonic() > deadline and self.row["state"] not in FINISHED:
                note(f"{self.row['short']} is still {self.row['state']}; "
                     f"`{command_for('wait', self.row['short'] + ' --timeout 9m')}` to keep waiting")
                return 124
        self.copy_output()
        if self.channel is not None:
            self.channel.close()
        if self.signals:
            return reraise(self.signals[0])
        if not self.quiet:
            note(summary_line(self.row))
        exit_code = self.row.get("exit")
        return exit_code if isinstance(exit_code, int) else 125


# --------------------------------------------------------------------------------------------
# Commands


def rlimits() -> dict:
    import resource
    out = {}
    for name in ("NOFILE", "STACK", "CORE"):
        try:
            out[name] = resource.getrlimit(getattr(resource, f"RLIMIT_{name}"))[0]
        except (ValueError, OSError, AttributeError):
            pass
    return out


def current_umask() -> int:
    mask = os.umask(0o022)
    os.umask(mask)
    return mask


GITHUB_REMOTE = re.compile(r"(?:git@github\.com:|https://(?:[^@/]+@)?github\.com/|ssh://git@github\.com/)"
                           r"([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?)(?:\.git)?/?$")


SOURCE_BYTES = 64 << 20  # tracked changes plus untracked contents hashed at most; past it, no record
SOURCE_FILES = 20000  # untracked or ignored files looked at, at most


def _find_prctl():
    try:
        import ctypes
        return ctypes.CDLL(None, use_errno=True).prctl
    except (ImportError, OSError, AttributeError):  # a Python without ctypes, a libc without prctl
        return None


PRCTL = _find_prctl()  # looked up once, here, not in each child


def die_with(parent: int):
    """For a child about to exec: be killed if `parent` dies (PR_SET_PDEATHSIG), so a git started for
    a fingerprint never outlives a helper killed for taking too long; and if it died already, between
    the fork and here, go at once."""
    def setup() -> None:
        if PRCTL is not None:
            try:
                PRCTL(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
            except Exception:
                pass
        if os.getppid() != parent:
            os._exit(1)
    return setup


class GitReader:
    """Runs git under one deadline: output is read as it comes (select, then os.read), and a git
    that overruns, or that the reader stops, is killed with its whole process group."""

    BASE = ["git", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false"]

    def __init__(self, limit: float):
        self.deadline = time.monotonic() + limit
        self.env = {**os.environ, "GIT_OPTIONAL_LOCKS": "0", "LC_ALL": "C"}

    def left(self) -> float:
        return self.deadline - time.monotonic()

    def stream(self, where: str, args: list[str], on_chunk) -> bool:
        """Feed git's output to on_chunk as it arrives; False on an error, at the deadline, or when
        on_chunk returns False."""
        if self.left() <= 0:
            return False
        try:
            proc = subprocess.Popen([*self.BASE, "-C", where, *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, env=self.env, start_new_session=True,
                                    preexec_fn=die_with(os.getpid()))
        except (OSError, subprocess.SubprocessError):
            return False
        fd, ok = proc.stdout.fileno(), True
        try:
            while True:
                left = self.left()
                if left <= 0 or not select.select([fd], [], [], left)[0]:
                    ok = False
                    break
                chunk = os.read(fd, 1 << 16)
                if not chunk:
                    break
                if on_chunk(chunk) is False:
                    ok = False
                    break
        except OSError:
            ok = False
        finally:
            proc.stdout.close()
            if not ok:
                self.kill(proc)
            try:
                proc.wait(max(0.1, self.left()))
            except subprocess.TimeoutExpired:
                self.kill(proc)
                proc.wait()
                ok = False
        return ok and proc.returncode == 0

    @staticmethod
    def kill(proc) -> None:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass

    def output(self, where: str, args: list[str], limit: int = 1 << 20) -> bytes | None:
        parts, size = [], [0]

        def take(chunk):
            size[0] += len(chunk)
            parts.append(chunk)
            return size[0] <= limit
        return b"".join(parts) if self.stream(where, args, take) else None

    def names(self, where: str, args: list[str], cap: int = SOURCE_FILES) -> list[bytes] | None:
        """NUL-separated names from `git ls-files -z ...`, giving up past `cap` of them."""
        names, rest = [], [b""]

        def take(chunk):
            items = (rest[0] + chunk).split(b"\0")
            rest[0] = items.pop()
            names.extend(i for i in items if i)
            return len(names) <= cap
        if not self.stream(where, ["ls-files", "-z", *args], take):
            return None
        if rest[0]:
            names.append(rest[0])
        return names if len(names) <= cap else None


def source_of(cwd: str, limit: float = 5.0) -> dict | None:
    """The source a build is of, as far as git can see it: the commit checked out, and a fingerprint
    of that commit plus everything on top of it: the diff of tracked files, the contents, modes and
    link targets of untracked files, and the names, sizes, modes and times of ignored `.env*` files
    (other ignored files are build output and caches, which a build rewrites). It writes nothing
    into the repository and runs no content filter.

    None (so nothing is matched against it) outside a git worktree; in a repository at / or the home
    directory; where an attributes file sets a content filter (LFS, git-crypt, nbstripout, which
    `git diff` would run); with files marked skip-worktree or assume-unchanged (whose changes git
    doesn't show); with a submodule, or a repository or worktree inside that isn't ignored;
    past SOURCE_BYTES or SOURCE_FILES; or past `limit` seconds. BUILDQ_SOURCE=off skips it."""
    if os.environ.get("BUILDQ_SOURCE", "").lower() in ("0", "off", "no", "false"):
        return None
    git = GitReader(limit)
    top = git.output(cwd, ["rev-parse", "--show-toplevel"])
    if not top:
        return None
    top = top.decode(errors="surrogateescape").strip()
    if top in ("/", os.path.expanduser("~")):  # a dotfiles repository isn't a project's source
        return None
    head = git.output(top, ["rev-parse", "--verify", "-q", "HEAD"])
    if not head:
        return None
    commit = head.decode().strip()
    root = top.encode(errors="surrogateescape")
    untracked = git.names(top, ["--others", "--exclude-standard"])
    ignored = git.names(top, ["--others", "--ignored", "--exclude-standard", "--directory"])
    if untracked is None or ignored is None:
        return None
    # Every tracked file, as it streams ("H 100644 sha 0<TAB>path"), keeping only the directories they
    # are in. No record with a file git hides the changes of (a lowercase tag is assume-unchanged, S
    # is skip-worktree), with a submodule (mode 160000: git would run a status, and its filters,
    # inside it), or with a tracked .gitattributes missing from the tree (git then reads the index's).
    folders, attributes, rest, refused = {b""}, [], [b""], [False]

    def take_tags(chunk):
        records = (rest[0] + chunk).split(b"\0")
        rest[0] = records.pop()
        for record in records:
            head, _, path = record.partition(b"\t")
            if re.match(rb"([a-z]|S) ", head) or head[2:8] == b"160000":
                refused[0] = True
                return False
            folders.add(os.path.dirname(path))
            if os.path.basename(path) == b".gitattributes":
                attributes.append(path)
        return True
    if not git.stream(top, ["ls-files", "-z", "-v", "-s"], take_tags) or refused[0]:
        return None
    if any(not os.path.lexists(os.path.join(root, a)) for a in attributes):
        return None
    if filters_in_use(git, top, root, folders):
        return None
    digest = hashlib.sha256(commit.encode() + b"\0")
    budget, changed = [SOURCE_BYTES], [False]

    def take_diff(chunk):
        budget[0] -= len(chunk)
        if budget[0] < 0:
            return False  # too big
        changed[0] = True
        digest.update(chunk)
        return True
    if not git.stream(top, ["diff", "HEAD", "--binary", "--no-ext-diff", "--no-textconv", "--no-color"], take_diff):
        return None
    loose = False  # untracked files of this tree's own (nested repositories aren't)
    for name in untracked:
        if git.left() <= 0:
            return None
        path = os.path.join(root, name)
        if name.endswith(b"/"):
            # A repository or worktree inside this one, which git lists as one entry: a check run
            # here may read it (eslint ., vitest), and its changes wouldn't be in this record.
            # (Checking each one's status costs seconds; ignore it in .git/info/exclude instead.)
            return None
        loose = True
        try:
            st = os.lstat(path)
            if stat.S_ISLNK(st.st_mode):
                content = os.readlink(path)
            elif stat.S_ISREG(st.st_mode):
                h = hashlib.sha256()
                with open(path, "rb") as f:
                    while block := f.read(1 << 20):
                        budget[0] -= len(block)
                        if budget[0] < 0 or git.left() <= 0:
                            return None
                        h.update(block)
                content = h.digest()
            else:
                content = b""  # a pipe or a device: its mode is all there is to know
            digest.update(b"u\0" + name + b"\0" + oct(st.st_mode).encode() + b"\0" + content + b"\0")
        except OSError:
            digest.update(b"u\0" + name + b"\0gone\0")
    untracked_changes = loose
    for name in ignored:  # .env files, by name, size, mode and time; ignored directories are build output
        if name.endswith(b"/") or not os.path.basename(name).startswith(b".env"):
            continue
        try:
            st = os.lstat(os.path.join(root, name))
            digest.update(b"i\0" + name + b"\0" + f"{st.st_size}:{st.st_mode:o}:{st.st_mtime_ns}".encode() + b"\0")
        except OSError:
            digest.update(b"i\0" + name + b"\0gone\0")
    remote = None
    url = git.output(top, ["remote", "get-url", "origin"])
    if url:
        match = GITHUB_REMOTE.match(url.decode(errors="replace").strip())
        remote = match.group(1) if match else None
    return {"repo": top, "commit": commit, "dirty": bool(changed[0] or untracked_changes),
            "fingerprint": digest.hexdigest()[:32], "remote": remote}


def filters_in_use(git: GitReader, top: str, root: bytes, folders: set[bytes]) -> bool:
    """Whether an attributes file git reads for the tracked files sets a content filter (filter=...),
    which `git diff` would run on every changed file (and LFS's writes into .git): a .gitattributes in
    any directory holding tracked files or above it, tracked or not, ignored or not;
    .git/info/attributes; the global one; the system one. Not knowing counts as yes, and so does an
    attributes file that isn't a plain file (a pipe would block)."""
    if os.environ.get("GIT_ATTR_SOURCE") or git.output(top, ["config", "--get", "attr.tree"]):
        return True  # attributes read from a tree: more than the files here
    info = git.output(top, ["rev-parse", "--git-path", "info/attributes"])
    if info is None:
        return True
    dirs = set()
    for folder in folders:  # and every directory above each
        while True:
            dirs.add(folder)
            if not folder:
                break
            folder = os.path.dirname(folder)
    in_tree = {os.path.join(root, d, b".gitattributes") for d in dirs}
    paths = sorted(in_tree) + [os.path.join(root, info.strip())]
    configured = git.output(top, ["config", "--path", "--get", "core.attributesFile"])  # ~ expanded
    home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    if configured is None:  # not set: the default global file
        paths.append(os.path.join(home, "git", "attributes"))
    elif configured.strip():  # (set empty, there is none)
        paths.append(os.path.join(root, configured.strip()))  # relative to the top
    if os.environ.get("GIT_ATTR_NOSYSTEM", "").lower() not in ("1", "true", "yes", "on"):
        paths.append("/etc/gitattributes")
    for path in paths:
        if git.left() <= 0:
            return True
        try:  # in the tree, a symlink isn't followed (git doesn't, and reads the index's copy instead)
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | (os.O_NOFOLLOW if path in in_tree else 0))
        except FileNotFoundError:
            continue
        except OSError:
            return True
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                return True
            if re.search(rb"(^|\s)filter=", os.read(fd, 1 << 20), re.M):
                return True
        except OSError:
            return True
        finally:
            os.close(fd)
    return False


def caller() -> str | None:
    """Who is submitting, for fair shares: BUILDQ_CALLER if set, else the agent session (Claude
    Code's session, a Codex or T3 thread), else the unit this client runs in (a CI runner's
    service, a terminal's scope). Agents that share a terminal or tmux server and set none of these
    can set BUILDQ_CALLER apart."""
    for name in ("BUILDQ_CALLER", "CLAUDE_CODE_SESSION_ID", "CODEX_THREAD_ID", "T3CODE_THREAD_ID"):
        named = os.environ.get(name, "").strip()
        if named:
            return named[:200]
    try:
        with open("/proc/self/cgroup") as f:
            for line in f:
                if line.startswith("0::"):
                    leaf = line[3:].strip().rsplit("/", 1)[-1]
                    return leaf or None
    except OSError:
        pass
    return None


def submit_message(args, command: list[str], watch: bool, submission: str) -> dict:
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = os.environ.get("PWD") or "/"
    # The submission id lets the daemon recognise this build if it has to be sent again.
    return {"op": "submit", "submission": submission, "argv": command, "cwd": cwd, "env": dict(os.environ),
            "lane": args.lane, "attach": watch, "rlimits": rlimits(), "umask": current_umask(),
            "cores": args.cores, "mem": args.mem, "priority": args.priority, "timeout": args.timeout,
            "name": args.name, "notify": args.notify, "watch": watch, "caller": caller(),
            "source": source_of(cwd), "again": bool(args.again), "reuse": True if args.reuse else None,
            "restartable": bool(args.restartable)}


def again_hint() -> str:
    wrapper = os.environ.get("BUILDQ_AS", "").strip()
    return f"{wrapper} --again <command>" if wrapper else "buildq run --again -- <command>"


def reuse_hint() -> str:
    wrapper = os.environ.get("BUILDQ_AS", "").strip()
    return f"{wrapper} --reuse <command>" if wrapper else "buildq run --reuse -- <command>"


def explain_outcome(reply: dict) -> None:
    """Say how the daemon answered a submission that matched an earlier build of the same source."""
    if reply.get("joined"):
        note(f"the same command on the same source is already {reply['state']} as ticket {reply['short']}: "
             f"this is that build (`{again_hint()}` starts a separate one).")
    elif reply.get("reused"):
        ago = fmt_age(time.time() - (reply.get("ended") or time.time()))
        note(f"this exact source passed this command {ago} ago (ticket {reply['short']}); that result answers "
             f"this one, and nothing runs. `{again_hint()}` runs it anyway.")
    elif reply.get("passed_before"):
        before = reply["passed_before"]
        ago = fmt_age(time.time() - (before.get("ended") or time.time()))
        note(f"this exact source passed this command {ago} ago (ticket {before.get('short')}); it runs again "
             f"because it isn't a plain build or test. `{reuse_hint()}` would take that result instead.")


def the_command(args) -> list[str] | None:
    command = list(args.command)
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        note(f"no command given. Usage: buildq {args.cmd} [OPTIONS] [--] COMMAND [ARGS...]")
        return None
    return command


def fallback(command: list[str], lane: str | None, why: str) -> int | None:
    """What to do when the daemon can't be reached. None means: wait for it and try again."""
    choice = os.environ.get("BUILDQ_FALLBACK", "").strip()
    if not choice:
        return None
    if choice == "fail":
        note(f"{why}; not running the command (BUILDQ_FALLBACK=fail).")
        return 75
    os.environ["BUILDQ_LANE"] = lane or ""
    os.environ["BUILDQ_FALLBACK_ACTIVE"] = "1"  # a nested buildq run inside it runs directly
    argv = command if choice == "run" else shlex.split(choice) + command
    note(f"{why}; running the command " + ("now, unqueued." if choice == "run" else f"through `{choice}` instead."))
    try:
        os.execvp(argv[0], argv)
    except OSError as e:
        note(f"can't run {argv[0]}: {e}")
        return 127


def inside_a_build() -> bool:
    """Whether this process is inside a build that already holds a turn."""
    if os.environ.get("BUILDQ_FALLBACK_ACTIVE"):
        return True
    job = os.environ.get("BUILDQ_JOB", "")
    if not job or "/" in job or job.startswith("."):
        return False
    try:
        with open("/proc/self/cgroup") as f:
            if re.search(rf"/buildq-{re.escape(job)}(-r\d+)?\.service(/|$)", f.read(), re.M):
                return True
    except OSError:
        pass
    try:  # the direct runner has no cgroup to show it: its ticket says instead
        with open(os.path.join(state_dir(), "tickets", job, "ticket.json")) as f:
            record = json.load(f)
        return record.get("runner") == "direct" and record.get("state") in ("starting", "running")
    except (OSError, ValueError):
        return False


def cmd_submit(args) -> int:
    command = the_command(args)
    if command is None:
        return 2
    if inside_a_build():
        note("this is inside a build already, which holds a turn: run the command directly. "
             "(A build it waited for could wait for this one's workspace for ever.)")
        return 2
    channel = connect(10)
    if channel is None:
        note("nothing was queued.")
        return unreachable()
    try:
        channel.send(submit_message(args, command, watch=False, submission=str(uuid.uuid4())))
        reply = channel.recv(30)
    except Lost as e:
        note(f"lost the daemon while submitting ({e}): it may have queued the build. Check "
             f"`{command_for('status')}` before submitting again")
        return 75
    finally:
        channel.close()
    if reply.get("type") != "ticket":
        note(reply.get("error", "the daemon refused the build"))
        return 2
    print(reply["id"])
    detail = f": {reply['reason']}" if reply["state"] == "queued" and reply.get("reason") else ""
    note(f"ticket {reply['id']} [{reply['lane']}] {state_text(reply)}{detail}")
    explain_outcome(reply)
    if reply["state"] in FINISHED:
        return 0
    waiting_for = reply.get("waiting_for")
    if waiting_for == "too-big":
        note(f"it can't fit on this machine as it is: cancel it (`{command_for('cancel', reply['short'])}`) "
             "and run a smaller job.")
    elif waiting_for == "disk":
        note("it won't start until disk space is freed where it runs.")
    else:
        expected = f" (it usually takes {fmt_age(reply['expected'])})" if reply.get("expected") else ""
        note(f"wait for it with `{command_for('wait', reply['short'] + ' --timeout 9m')}`{expected}; "
             "exit 124 with \"still queued\" or \"still running\" means wait again (a build that ran out of "
             "its own time limit also ends 124, but says \"timed out\").")
    return 0


def cmd_run(args) -> int:
    command = the_command(args)
    if command is None:
        return 2
    if inside_a_build():
        try:
            os.execvp(command[0], command)  # already inside a build's turn
        except OSError as e:
            note(f"can't run {command[0]}: {e}")
            return 127
    # Interrupts are caught from here on, so one that comes while the build is being submitted
    # still cancels it once its ticket is known.
    pending: list[int] = []
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, _frame: pending.append(signum))
    submission = str(uuid.uuid4())
    sent = False  # once the daemon may have the build, it must not also run some other way
    waiting_since, last_note = None, 0.0
    while True:
        if pending:
            return reraise(pending[0])
        channel = connect(10)
        if channel is not None:
            try:
                sent = True
                channel.send(submit_message(args, command, watch=True, submission=submission))
                reply = channel.recv(30)
                break
            except Lost as e:
                channel.close()
                why = f"lost the queue daemon while submitting ({e}); sending it again"
        else:
            why = f"the queue daemon isn't answering at {socket_path()}"
        if not sent:
            code = fallback(command, args.lane, why)
            if code is not None:
                return code
        now = time.monotonic()
        waiting_since = waiting_since or now
        if now - last_note >= 60:
            note(f"{why}; waiting for it ({fmt_age(now - waiting_since)} so far; "
                 "systemctl --user status buildq)")
            last_note = now
        for _ in range(25):
            if pending:
                break
            time.sleep(0.2)
    if reply.get("type") != "ticket":
        channel.close()
        note(reply.get("error", "the daemon refused the build"))
        return 2
    explain_outcome(reply)
    if reply.get("reused"):
        channel.close()
        offsets = reply.get("attempt_offsets") or {}
        for name, out in (("stdout.log", sys.stdout.buffer), ("stderr.log", sys.stderr.buffer)):
            try:
                with open(os.path.join(reply["dir"], name), "rb") as f:
                    f.seek(int(offsets.get(name) or 0))  # the attempt that passed, not one stopped for memory
                    while chunk := f.read(1 << 20):
                        out.write(chunk)
                out.flush()
            except OSError:
                pass
        note(summary_line(reply))
        return reply["exit"] if isinstance(reply.get("exit"), int) else 0
    shared = reply.get("joined") or (reply.get("joiners") or 0) > 0
    note(f"ticket {reply['id']} [{reply['lane']}]; Ctrl-C "
         f"{'stops following it (others wait for it too)' if shared else 'cancels it'}, "
         f"`{command_for('status', reply['short'])}` shows it from anywhere.")
    if (reply.get("expected") or 0) >= LONG_RUN:
        note(f"this command usually takes {fmt_age(reply['expected'])}. If what runs it has a shorter time "
             "limit (a tool call), it is cut off and the build cancelled; drop a long build off instead: "
             f"`{command_for('submit', '<command>')}` prints a ticket, then "
             f"`{command_for('wait', '<ticket> --timeout 9m')}`.")
    # Ctrl-C tells the daemon this submission has gone; it stops the build only if nobody else waits.
    follower = Follower(reply, channel, stream=True, cancel_on_signal=True)
    follower.owner = submission
    follower.split = True  # the build's stdout to stdout, its stderr to stderr
    follower.signals = pending  # an interrupt that already came cancels it straight away
    return follower.run()


def open_watch(ref: str) -> tuple[Channel | None, dict | None, int | None]:
    channel = connect(10)
    if channel is None:
        directory = local_ticket_dir(ref)
        final = files_final(directory)
        if final is None:
            return None, None, unreachable()
        return None, {**final, "dir": directory, "log": os.path.join(directory, "output.log"),
                      "label": "", "lane": "", "name": None}, None
    try:
        channel.send({"op": "watch", "ticket": ref})
        reply = channel.recv(15)
    except Lost as e:
        channel.close()
        note(f"lost the daemon ({e})")
        return None, None, 75
    if reply.get("type") != "ticket":
        channel.close()
        note(reply.get("error", "unknown ticket"))
        return None, None, 1
    return channel, reply, None


def cmd_wait(args) -> int:
    channel, row, failed = open_watch(args.ticket)
    if failed is not None:
        return failed
    follower = Follower(row, channel, stream=False, cancel_on_signal=False, quiet=args.quiet)
    code = follower.run(args.timeout)
    final = follower.row
    if not args.quiet and final.get("state") in ("failed", "lost") and final.get("log"):
        show_tail(final["log"], 20, final["short"])
    return code


def show_tail(path: str, lines: int, short: str) -> None:
    """The end of a failed build's output, so the error is here without asking for the log."""
    try:
        with open(path, "rb") as f:
            f.seek(tail_offset(path, lines))
            data = f.read()
    except OSError:
        return
    if not data.strip():
        return
    note(f"the last {lines} lines of its output (`{command_for('logs', short)}` has all of it):")
    sys.stderr.buffer.write(data if data.endswith(b"\n") else data + b"\n")
    sys.stderr.flush()


def cmd_logs(args) -> int:
    if args.follow:
        channel, row, failed = open_watch(args.ticket)
        if failed is not None:
            return failed
        follower = Follower(row, channel, stream=True, cancel_on_signal=False, quiet=True)
        if args.tail is not None:
            follower.offset = tail_offset(row["log"], args.tail)
        code = follower.run()
        return 0 if code < 124 or code > 125 else code
    reply = request({"op": "status", "tickets": [args.ticket]})
    if reply is None:
        directory = local_ticket_dir(args.ticket)
        path = os.path.join(directory, "output.log") if directory else None
    elif reply.get("errors"):
        note(reply["errors"][0])
        return 1
    else:
        path = reply["tickets"][0]["log"]
    if not path or not os.path.exists(path):
        note("no output yet" if path else "no such ticket")
        return 0 if path else 1
    start = tail_offset(path, args.tail) if args.tail is not None else 0
    with open(path, "rb") as f:
        f.seek(start)
        while chunk := f.read(1 << 20):
            sys.stdout.buffer.write(chunk)
    return 0


def tail_offset(path: str, lines: int) -> int:
    """The offset where the last `lines` lines of the file begin."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            block, data, offset = 1 << 16, b"", size
            while offset > 0 and data.count(b"\n") <= lines:
                offset = max(0, offset - block)
                f.seek(offset)
                data = f.read(size - offset)
            if data.count(b"\n") <= lines:
                return offset
            cut = len(data)
            for _ in range(lines + 1):
                cut = data.rfind(b"\n", 0, cut)
            return offset + cut + 1
    except OSError:
        return 0


def cmd_cancel(args) -> int:
    status = 0
    for ref in args.tickets:
        reply = request({"op": "cancel", "ticket": ref, "all": bool(args.all)})
        if reply is None:
            return unreachable()
        if reply.get("type") != "ticket":
            note(reply.get("error", f"couldn't cancel {ref}"))
            status = 1
            continue
        verb = "cancelled" if reply["state"] in FINISHED else "stopping"
        print(f"{verb} {reply['id']}: {title(reply)}")
    return status


def cmd_status(args) -> int:
    if args.tickets:
        reply = request({"op": "status", "tickets": args.tickets})
        if reply is None:
            return unreachable()
        for error in reply.get("errors") or []:
            note(error)
        if args.json:
            print(json.dumps(reply["tickets"], indent=2))
        else:
            for i, row in enumerate(reply["tickets"]):
                if i:
                    print()
                print_ticket(row)
        return 1 if reply.get("errors") else 0
    reply = request({"op": "status"})
    if reply is None or reply.get("type") != "status":
        return unreachable()
    reply.pop("type", None)
    if args.json:
        print(json.dumps(reply, indent=2))
    else:
        print_overview(reply)
    return 0


def cmd_list(args) -> int:
    reply = request({"op": "list", "all": args.all})
    if reply is None:
        return unreachable()
    if args.json:
        print(json.dumps(reply["tickets"], indent=2))
    else:
        print_list(reply["tickets"], time.time())
    return 0


def cmd_pause(args) -> int:
    reply = request({"op": "pause", "reason": " ".join(args.reason) or None})
    if reply is None:
        return unreachable()
    print("paused: running builds carry on, nothing new starts until `buildq resume`")
    return 0


def cmd_resume(_args) -> int:
    reply = request({"op": "resume"})
    if reply is None:
        return unreachable()
    print("resumed: queued builds start as there is room")
    return 0


def median(values: list[float]) -> float | None:
    values = sorted(v for v in values if v is not None)
    if not values:
        return None
    mid = len(values) // 2
    return values[mid] if len(values) % 2 else (values[mid - 1] + values[mid]) / 2


def cmd_report(args) -> int:
    """What the queue's record of finished builds says, per command (or lane, or caller): how often
    it ran and failed, how long it took and waited, its peak memory, how often it went over its
    MemoryHigh, how long it waited on memory, and how often it was killed or stopped for memory.
    With --capacity, how busy the machine and the queue were instead (capacity_report)."""
    if args.capacity:
        return capacity_report(args)
    since = time.time() - args.since
    groups: dict[str, list[dict]] = collections.defaultdict(list)
    base = os.path.join(state_dir(), "outcomes.jsonl")
    for path in (base + ".1", base):
        try:
            with open(path) as f:
                lines = f.readlines()
        except OSError:
            continue
        for line in lines:
            try:
                r = json.loads(line)
                if not isinstance(r, dict) or float(r.get("t") or 0) < since:
                    continue
            except (ValueError, TypeError):
                continue
            key = str(r.get("key") or "?")
            if args.by == "command":
                repo, _, rest = key.partition("|")
                name = f"{rest.partition('|')[2] or key}  ({repo})" if repo else key
            else:
                name = r.get(args.by)
            groups[str(name or "(unknown)")].append(r)

    def num(runs, field):
        out = []
        for r in runs:
            try:
                if r.get(field) is not None and not isinstance(r.get(field), bool):
                    out.append(float(r[field]))
            except (TypeError, ValueError):
                pass
        return out

    rows = []
    for name, runs in groups.items():
        walls = num(runs, "wall")
        rows.append({
            "name": name, "runs": len(runs), "failed": sum(1 for r in runs if r.get("state") != "succeeded"),
            "killed_for_memory": sum(1 for r in runs if r.get("oom") or r.get("stopped_for_memory")),
            "requeues": int(sum(num(runs, "requeues"))),
            "over_memory_high": sum(1 for r in runs if r.get("mem_high_all", r.get("mem_high"))),
            "median_seconds": median(walls), "total_seconds": sum(walls),
            "median_wait_seconds": median(num(runs, "waited")), "peak_memory": max(num(runs, "peak_mem"), default=0),
            "memory_wait_seconds": sum(num(runs, "mem_wait_some")),
            "core_hours": sum(num(runs, "cpu_seconds")) / 3600,
        })
    rows.sort(key=lambda r: r["total_seconds"], reverse=True)
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print(f"no finished builds recorded in the last {fmt_age(args.since)}")
        return 0
    print(f"the last {fmt_age(args.since)}, by {args.by}, most time first")
    print(f"{'RUNS':>5} {'FAILED':>6} {'MEDIAN':>7} {'WAITED':>7} {'PEAK':>6} {'HIGH':>5} {'MEMWAIT':>8} "
          f"{'KILLED':>6} {'AGAIN':>5}  {args.by.upper()}")
    for r in rows[: args.top]:
        waited = fmt_age(r["median_wait_seconds"]) if r["median_wait_seconds"] is not None else "-"
        print(f"{r['runs']:>5} {r['failed']:>6} {fmt_age(r['median_seconds']):>7} {waited:>7} "
              f"{fmt_size(r['peak_memory']):>6} {r['over_memory_high']:>5} {fmt_age(r['memory_wait_seconds']):>8} "
              f"{r['killed_for_memory']:>6} {r['requeues']:>5}  {r['name']}")
    print("FAILED: didn't succeed (failed, cancelled, timed out or lost). HIGH: went over its MemoryHigh, where the "
          "kernel slows it. MEMWAIT: time spent waiting on memory in all. KILLED: killed for memory, or stopped to "
          "free it. AGAIN: times stopped for memory and started over.")
    return 0


def metrics_db():
    """The analytics file the daemon keeps (metrics.db), read-only, or None if there is none yet."""
    import sqlite3
    import urllib.parse
    path = os.path.join(state_dir(), "metrics.db")
    if not os.path.exists(path):
        print(f"buildq: no analytics yet: the daemon writes {short_path(path)} once a minute "
              "(with metrics = true, the default)", file=sys.stderr)
        return None
    return sqlite3.connect(f"file:{urllib.parse.quote(path)}?mode=ro", uri=True, timeout=10)


def cmd_query(args) -> int:
    """Run one read-only SQL query on the analytics file; with no query, show its tables."""
    import sqlite3
    db = metrics_db()
    if db is None:
        return 1
    sql = " ".join(args.sql).strip()
    try:
        db.execute("PRAGMA query_only = ON")  # nothing written, an ATTACHed file included
        if not sql:
            for (table,) in db.execute("SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name"):
                columns = [f"{row[1]} {row[2]}".strip() for row in db.execute(f"PRAGMA table_info({table})")]
                print(f"{table}: {', '.join(columns)}")
            print("Tables and columns are described in docs/design.md, under Analytics.")
            return 0
        cursor = db.execute(sql)
        rows = cursor.fetchmany(args.limit + 1) if args.limit else cursor.fetchall()
        names = [d[0] for d in cursor.description or []]
    except sqlite3.Error as e:
        print(f"buildq: {e}", file=sys.stderr)
        return 2
    finally:
        db.close()  # before printing: a reader left open would keep the daemon's log of writes growing
    more = bool(args.limit) and len(rows) > args.limit
    rows = rows[: args.limit] if args.limit else rows
    if args.json:
        print(json.dumps([dict(zip(names, row)) for row in rows], indent=2))
    else:
        print("\t".join(names))
        for row in rows:
            print("\t".join("" if v is None else (f"{v:.3f}".rstrip("0").rstrip(".") if isinstance(v, float) else str(v))
                            for v in row))
    if more:
        print(f"(first {args.limit} rows; --limit 0 shows all)", file=sys.stderr)
    return 0


def capacity_report(args) -> int:
    """How busy the machine and the queue were, by day (or hour), from the analytics file: what
    builds waited for, what was idle or held while they waited on memory, and who used the
    machine. Days are local days."""
    import sqlite3
    db = metrics_db()
    if db is None:
        return 1
    since = time.time() - args.since
    table = "minute" if args.since <= 14 * 86400 else "hour"
    group = 3600 if args.hourly else 86400
    offset = time.localtime().tm_gmtoff  # local days (an hour off around a change of clocks)

    def weighted(column, weight="sampled"):
        return f"SUM({column} * {weight}) / NULLIF(SUM(CASE WHEN {column} IS NOT NULL THEN {weight} END), 0)"

    try:
        rows = db.execute(f"""
            SELECT ((t + ?) / {group}) * {group} - ? AS period,
                   SUM(wait_memory * sampled) / 60, SUM(wait_cpu * sampled) / 60,
                   SUM((wait_held + wait_turn + wait_workspace + wait_other) * sampled) / 60,
                   {weighted("idle_cores_mem_wait", "mem_wait_seconds")},
                   {weighted("free_mem_mem_wait", "mem_wait_seconds")},
                   {weighted("growth_mem_wait", "mem_wait_seconds")},
                   {weighted("cpu_busy")}, {weighted("builds_cores")}, {weighted("ci_cores")},
                   {weighted("containers_cores")}, {weighted("apps_cores")},
                   MIN(mem_available_min), MAX(cores)
            FROM {table} WHERE t >= ? GROUP BY period ORDER BY period""", (offset, offset, since)).fetchall()
        builds = db.execute("SELECT waited_by, est_mem, mem_peak, past_peak_released, past_peak_attempts, past_peak_over, "
                            "past_peak_most_over, past_peak_freed, past_peak_unknown FROM build WHERE ended >= ?",
                            (since,)).fetchall()
    except sqlite3.Error as e:
        print(f"buildq: {e}", file=sys.stderr)
        return 2
    finally:
        db.close()
    waited: dict[str, float] = collections.defaultdict(float)
    ratios, released = [], 0
    would, over, worst, freed, unknown = 0, 0, 0, 0.0, 0
    for waited_by, est_mem, mem_peak, was_released, attempts, overs, most_over, gb_hours, unsure in builds:
        try:
            for reason, seconds in (json.loads(waited_by or "{}") or {}).items():
                waited[reason] += float(seconds)
        except (ValueError, TypeError, AttributeError):
            pass
        if est_mem and mem_peak is not None:
            ratios.append(mem_peak / est_mem)
        released += was_released or 0
        would += attempts or 0
        over += overs or 0
        worst = max(worst, most_over or 0)
        freed += gb_hours or 0.0
        unknown += unsure or 0
    names = ("period", "waited_memory_minutes", "waited_cpu_minutes", "waited_other_minutes",
             "idle_cores_while_waiting_on_memory", "free_memory_while_waiting_on_memory",
             "held_for_growth_while_waiting_on_memory", "busy_cores", "build_cores", "ci_cores",
             "container_cores", "app_cores", "lowest_free_memory", "cores")
    past_peak = {"past_peak": would, "went_over_what_was_kept": over, "most_over": worst,
                 "held_gb_hours_freed": round(freed, 1), "past_peak_unknown": unknown, "released": released}
    if args.json:
        print(json.dumps({"periods": [dict(zip(names, row)) for row in rows], "builds": len(builds),
                          "waited_seconds_by_reason": waited, "median_peak_of_plan": median(ratios),
                          **past_peak}, indent=2))
        return 0
    if not rows:
        print(f"no analytics for the last {fmt_age(args.since)} yet")
        return 0

    def mins(value):
        return fmt_age(value * 60) if value else "-"

    def cores(value):
        return f"{value:.1f}" if value is not None else "-"

    def size(value):
        return fmt_size(value) if value is not None else "-"

    print(f"the last {fmt_age(args.since)}, by {'hour' if args.hourly else 'day'}")
    print(f"{'PERIOD':<11} {'MEMWAIT':>7} {'CPUWAIT':>7} {'OTHER':>6}  {'IDLE':>5} {'FREE':>6} {'HELD':>6}  "
          f"{'BUSY':>5} {'BUILDS':>6} {'CI':>5} {'CONT':>5} {'APPS':>5}  {'LOWEST':>6}")
    for row in rows:
        stamp = time.strftime("%m-%d %H:%M" if args.hourly else "%a %m-%d", time.localtime(row[0]))
        print(f"{stamp:<11} {mins(row[1]):>7} {mins(row[2]):>7} {mins(row[3]):>6}  {cores(row[4]):>5} "
              f"{size(row[5]):>6} {size(row[6]):>6}  {cores(row[7]):>5} {cores(row[8]):>6} {cores(row[9]):>5} "
              f"{cores(row[10]):>5} {cores(row[11]):>5}  {size(row[12]):>6}")
    print("MEMWAIT, CPUWAIT, OTHER: build-time spent waiting for memory, for cores, for anything else (a turn, "
          "held room, a busy workspace). While builds waited on memory: IDLE, cores under the CPU target; FREE, "
          "memory above the floor; HELD, what running builds might still grow into. BUSY: cores in use, of which "
          "BUILDS, CI runners, containers (CONT) and the user's apps (APPS). LOWEST: the least memory free.")
    if builds:
        reasons = ", ".join(f"{reason} {fmt_age(seconds)}" for reason, seconds in
                            sorted(waited.items(), key=lambda kv: -kv[1]) if seconds >= 1) or "nothing"
        ratio = median(ratios)
        print(f"{len(builds)} builds finished; they waited for: {reasons}.")
        if ratio is not None:
            print(f"Their memory peaked at a median {ratio:.0%} of what was planned for them.")
        if would or unknown:
            print(f"Past the peak: {would} attempts were past their peak{f' ({released} let go)' if released else ''}; "
                  f"{over} of them later used more than would have been kept"
                  f"{f' (by up to {fmt_size(worst)})' if over else ''}; about {freed:.0f} GB-hours of held "
                  "room would have been freed"
                  f"{f'; {unknown} more were picked up after a daemon restart and can say nothing' if unknown else ''}.")
    return 0


# --------------------------------------------------------------------------------------------
# buildq top: a live view of the machine and each build, like btop for the queue

CI_UNITS = ("actions.runner.*", "gha-*", "*-runner-*", "gitlab-runner*")  # as the daemon's analytics
ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b[@-Z\\-_]")


def clean(text: str) -> str:
    """Text safe to draw: no escape sequences; tabs as spaces; every control and format character
    (newlines, C1, bidi and zero-width marks, line separators) replaced, since a label can hold a
    script; in ASCII mode, ASCII only."""
    import unicodedata
    text = ANSI.sub("", str(text).expandtabs(4))
    text = "".join(GLYPHS["ctl"] if unicodedata.category(c) in ("Cc", "Cf", "Zl", "Zp") and c != "\u200c" else c
                   for c in text)  # (U+200C stays: Persian uses it inside words, and it moves nothing)
    return text.encode("ascii", "replace").decode() if GLYPHS["ctl"] == "?" else text


def char_width(c: str) -> int:
    """Columns a character takes on a terminal: wide (CJK, emoji) 2; marks and format characters
    (variation selectors, joiners) 0. (Drawn text has been through clean(), which replaces most
    format characters; this also serves text that hasn't.)"""
    import unicodedata
    if unicodedata.category(c) in ("Mn", "Me", "Cf") and c != "\u00ad":
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def text_width(text: str) -> int:
    return sum(char_width(c) for c in text)


def fit(text: str, width: int) -> str:
    """The longest start of `text` that takes at most `width` columns."""
    used, out = 0, []
    for c in text:
        w = char_width(c)
        if used + w > width:
            break
        used += w
        out.append(c)
    return "".join(out)


def read_text(path: str) -> str | None:
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def pressure_of(text: str | None) -> dict:
    """{"some": avg10, "full": avg10} from a *.pressure file; empty if it can't be read (PSI off)."""
    out = {}
    for line in (text or "").splitlines():
        parts = line.split()
        if parts and parts[0] in ("some", "full"):
            for part in parts[1:]:
                if part.startswith("avg10="):
                    try:
                        out[parts[0]] = float(part[6:])
                    except ValueError:
                        pass
    return out


_HOLDERS: dict[str, tuple[list[str], float]] = {}


def holders_of(device: str) -> list[str]:
    """MAJ:MIN of the devices stacked on a block device or on any of its partitions (dm-crypt,
    LVM, md). Known for a minute at a time: devices can be opened while top runs."""
    known = _HOLDERS.get(device)
    if known is None or time.monotonic() - known[1] > 60:
        base, found = f"/sys/dev/block/{device}", []  # (each once: an LV over two partitions shows twice)
        for holders in [os.path.join(base, "holders"), *glob.glob(os.path.join(base, "*", "holders"))]:
            try:
                names = os.listdir(holders)
            except OSError:
                continue
            for name in names:
                number = (read_text(f"/sys/class/block/{name}/dev") or "").strip()
                if number:
                    found.append(number)
        known = (list(dict.fromkeys(found)), time.monotonic())
        _HOLDERS[device] = known
    return known[0]


def io_counters(text: str | None) -> dict[str, tuple[int, int]]:
    """MAJ:MIN -> (bytes read, bytes written) from a cgroup's io.stat."""
    per = {}
    for line in (text or "").splitlines():
        fields = line.split()
        if not fields:
            continue
        rbytes = wbytes = 0
        for part in fields[1:]:
            name, _, value = part.partition("=")
            if name == "rbytes" and value.isdigit():
                rbytes = int(value)
            elif name == "wbytes" and value.isdigit():
                wbytes = int(value)
        per[fields[0]] = (rbytes, wbytes)
    return per


def io_rate(before: dict, after: dict, span: float) -> tuple[float, float]:
    """Bytes read and written per second between two io.stat readings, each byte once. I/O through
    dm-crypt, LVM or md is charged at the stacked device and again at the disks below (io.stat
    names whole disks). So devices are grouped with what is stacked on them, and each group counts
    the larger of what its bottom devices (nothing below them: the disks) and its top devices
    (nothing stacked on them) did in the interval:
    exact for dm-crypt, LVM, stripes however the bytes were split, and a plain partition beside a
    stacked one; a mirror's writes count each copy. Only devices in both readings count, so a
    stacked device that came or went shows no burst, and a new one makes what is stacked be looked
    at afresh. Loop devices aren't holders: a filesystem in a file counts twice."""
    if span <= 0:
        return 0.0, 0.0
    if any(d not in before for d in after):
        _HOLDERS.clear()  # something new: what is stacked may have changed
    deltas = {d: (max(0, after[d][0] - before[d][0]), max(0, after[d][1] - before[d][1])) for d in after if d in before}
    above = {d: [h for h in dict.fromkeys(holders_of(d)) if h in deltas and h != d] for d in deltas}
    group = {d: d for d in deltas}

    def root(x):
        while group[x] != x:
            group[x] = group[group[x]]
            x = group[x]
        return x

    for d, holders in above.items():
        for h in holders:
            group[root(d)] = root(h)
    stacked_on_something = {h for holders in above.values() for h in holders}
    members = collections.defaultdict(list)
    for d in deltas:
        members[root(d)].append(d)
    read = write = 0.0
    for devices in members.values():
        bottom = [d for d in devices if d not in stacked_on_something]  # nothing below it
        top = [d for d in devices if not above[d]]  # nothing above it
        read += max(sum(deltas[d][0] for d in bottom), sum(deltas[d][0] for d in top))
        write += max(sum(deltas[d][1] for d in bottom), sum(deltas[d][1] for d in top))
    return read / span, write / span


def cgroup_sample(path: str) -> dict | None:
    """What a cgroup is doing now: CPU time, the memory it needs (anon + shmem + kernel less
    reclaimable slab, as the daemon counts it), swap, bytes read and written, pressure, and memory
    events. None if it is gone or only partly readable (it is going)."""
    cpu, memory = read_text(os.path.join(path, "cpu.stat")), read_text(os.path.join(path, "memory.stat"))
    if cpu is None or memory is None:
        return None
    usage = 0
    for line in cpu.splitlines():
        if line.startswith("usage_usec "):
            usage = int(line.split()[1])
    stat = {}
    for line in memory.splitlines():
        name, _, value = line.partition(" ")
        if name in ("anon", "kernel", "shmem", "slab_reclaimable") and value.strip().isdigit():
            stat[name] = int(value)
    need = stat.get("anon", 0) + stat.get("shmem", 0) + max(0, stat.get("kernel", 0) - stat.get("slab_reclaimable", 0))
    swap = (read_text(os.path.join(path, "memory.swap.current")) or "").strip()
    io = io_counters(read_text(os.path.join(path, "io.stat")))
    events = {}
    for line in (read_text(os.path.join(path, "memory.events")) or "").splitlines():
        name, _, value = line.partition(" ")
        if value.strip().isdigit():
            events[name] = int(value)
    return {"usage": usage, "mem": need, "swap": int(swap) if swap.isdigit() else 0, "io": io,
            "psi_mem": pressure_of(read_text(os.path.join(path, "memory.pressure"))),
            "psi_cpu": pressure_of(read_text(os.path.join(path, "cpu.pressure"))),
            "psi_io": pressure_of(read_text(os.path.join(path, "io.pressure"))), "events": events}


def user_manager_dir() -> str:
    for line in (read_text("/proc/self/cgroup") or "").splitlines():
        if line.startswith("0::"):
            match = re.match(r"(.*/user@\d+\.service)(?:/|$)", line[3:].strip())
            if match:
                return "/sys/fs/cgroup" + match.group(1)
    uid = os.getuid()
    return f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service"


def slice_dir(name: str) -> str:
    parts = name[: -len(".slice")].split("-")
    return "/".join("-".join(parts[: i + 1]) + ".slice" for i in range(len(parts)))


def safe_dir(path) -> str | None:
    """A folder `top` may measure: it resolves to an existing directory inside the user's home
    (not home itself). Anything else (/, a symlink out of home, //) is left alone."""
    if not isinstance(path, str) or not path:
        return None
    home = os.path.realpath(os.path.expanduser("~"))
    real = os.path.realpath(path)
    return real if real.startswith(home + os.sep) and os.path.isdir(real) else None


def folders_of(row: dict) -> list[str]:
    """A build's folders, resolved, safe, each once, none inside another."""
    kept: list[str] = []
    for real in sorted({r for r in map(safe_dir, row.get("write_dirs") or []) if r}, key=len):
        if not any(real == k or real.startswith(k + os.sep) for k in kept):
            kept.append(real)
    return kept


class DirSizes:
    """The disk space build folders take, measured in the background by `du -sx` at idle I/O
    priority: it stays on one filesystem, counts a hard-linked file once, never follows a symlink,
    and can be killed. Each folder at most every RESCAN seconds; a `du` past LIMIT seconds is
    stopped and the folder shows as not measured."""

    RESCAN, LIMIT = 300.0, 60.0

    def __init__(self, background: bool = True):
        import atexit
        import threading
        self.proc: subprocess.Popen | None = None  # the du running now
        self.stopping = False
        atexit.register(self.stop)
        self.sizes: dict[str, tuple[int | None, bool, float]] = {}  # folder -> (bytes, complete, measured at)
        self.wanted: list[str] = []
        self.lock = threading.Lock()
        self.wake = threading.Event()
        if background:
            threading.Thread(target=self.run, name="dir-sizes", daemon=True).start()

    def want(self, folders) -> None:
        with self.lock:
            self.wanted = list(dict.fromkeys(folders))
        self.wake.set()

    def get(self, folder: str) -> tuple[int | None, bool, float] | None:
        """(bytes or None, complete, seconds ago) or None if not measured yet."""
        with self.lock:
            found = self.sizes.get(folder)
        return None if found is None else (found[0], found[1], time.monotonic() - found[2])

    def due(self) -> list[str]:
        with self.lock:
            return [f for f in self.wanted if f not in self.sizes or time.monotonic() - self.sizes[f][2] >= self.RESCAN]

    def run(self) -> None:
        while not self.stopping:
            self.wake.wait(5)
            self.wake.clear()
            for folder in self.due():
                if self.stopping:
                    return
                try:
                    self.measure_into(folder, self.LIMIT)
                except Exception:  # a thread that died would leave every folder "not yet" for good
                    pass

    def stop(self) -> None:
        """Kill the du running now: quitting top must not leave a walk going."""
        self.stopping = True
        proc = self.proc
        if proc is not None and proc.poll() is None:
            proc.kill()

    def measure_into(self, folder: str, limit: float, keep_cut: bool = True) -> None:
        if self.stopping:
            return
        size, complete, cut = self.measure(folder, limit, self)
        if cut and not keep_cut:
            return  # (--once: its deadline, not the folder's fault; it shows as not measured yet)
        with self.lock:
            self.sizes[folder] = (size, complete, time.monotonic())

    @staticmethod
    def measure(folder: str, limit: float, owner=None) -> tuple[int | None, bool, bool]:
        """(bytes or None, complete, cut off by the limit). du exits 1 when an entry vanished mid-walk,
        which a running build does all the time; only an entry it couldn't read makes it partial."""
        command = ["du", "-sx", "--block-size=1", folder]
        if shutil.which("ionice"):
            command = ["ionice", "-c3", *command]
        try:
            proc = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, preexec_fn=die_with(os.getpid()),
                                    env={**os.environ, "LC_ALL": "C"})  # (its messages are matched below)
        except OSError:
            return None, False, False
        if owner is not None:
            owner.proc = proc
        try:
            out, err = proc.communicate(timeout=limit)
        except subprocess.TimeoutExpired:
            proc.kill()
            try:
                proc.communicate(timeout=1)
            except subprocess.TimeoutExpired:
                pass  # stuck in the kernel (a hung mount): it goes when it can
            return None, False, True
        finally:
            if owner is not None:
                owner.proc = None
        match = re.match(rb"\s*(\d+)", out or b"")
        size = int(match.group(1)) if match else None
        unreadable = b"ermission denied" in (err or b"") or b"Input/output error" in (err or b"")
        return size, size is not None and not unreadable, False


class TopSampler:
    """One snapshot each refresh: the daemon's overview, the machine (from /proc), every
    filesystem builds write to, the groups that use the machine (buildq's builds, CI runners,
    containers, the user's apps), and every running build's own cgroup. Rates come from the
    change since the last snapshot."""

    def __init__(self, sizes: DirSizes | None = None):
        self.last: dict[str, tuple[float, dict]] = {}
        self.manager = user_manager_dir()
        self.sizes = sizes

    def rate(self, key: str, now: float, values: dict) -> dict:
        before = self.last.get(key)
        self.last[key] = (now, values)
        if before is None or now <= before[0]:
            return {}
        span = now - before[0]
        return {name: max(0.0, (values[name] - before[1].get(name, values[name])) / span)
                for name in values if isinstance(values[name], (int, float))}

    @staticmethod
    def mounts() -> list[tuple[str, str]]:
        """(mount point, source device name) from the mount table, in order (a later mount over the
        same point wins). btrfs gives each subvolume a device number of its own, so a path is matched
        to its mount by the longest mount point it lies under, not by its device number."""
        found = []
        for line in (read_text("/proc/self/mountinfo") or "").splitlines():
            fields = line.split()
            if len(fields) > 4 and " - " in line:
                source = line.split(" - ", 1)[1].split()[1:2]
                device = os.path.basename(os.path.realpath(source[0])) if source and source[0].startswith("/dev/") else ""
                found.append((re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), fields[4]), device))
        return found

    @staticmethod
    def mount_of(path: str, mounts: list[tuple[str, str]]) -> tuple[str, str]:
        real, best = os.path.realpath(path), ("/", "")
        for point, device in mounts:
            if (real == point or real.startswith(point.rstrip("/") + "/")) and len(point) >= len(best[0]):
                best = (point, device)
        return best

    def filesystems(self, now: float, paths, floor_setting) -> list[dict]:
        """`/` and every filesystem a build writes to, once each: free, size, floor, I/O rates."""
        mounts = self.mounts()
        stats = {}
        for line in (read_text("/proc/diskstats") or "").splitlines():
            parts = line.split()
            if len(parts) > 9:
                stats[parts[2]] = (int(parts[5]) * 512, int(parts[9]) * 512)
        out, seen = [], set()
        for path in ["/", *paths]:
            try:
                vfs = os.statvfs(path)
            except OSError:
                continue
            mount, device = self.mount_of(path, mounts)
            key = device or mount
            if key in seen:
                continue  # (btrfs subvolumes of one disk)
            seen.add(key)
            size, free = vfs.f_blocks * vfs.f_frsize, vfs.f_bavail * vfs.f_frsize
            if isinstance(floor_setting, str) and floor_setting.endswith("%"):
                floor = int(float(floor_setting[:-1]) / 100 * size)
            else:
                floor = int(floor_setting or 0)
            fs = {"mount": mount, "device": device, "free": free, "size": size, "floor": floor}
            if device in stats:
                rate = self.rate(f"disk:{device}", now, {"read": stats[device][0], "write": stats[device][1]})
                fs["read"], fs["write"] = rate.get("read"), rate.get("write")
            out.append(fs)
        return out

    def machine(self, now: float, overview: dict | None) -> dict:
        config = (overview or {}).get("config") or {}
        cores = ((overview or {}).get("machine") or {}).get("cores") or os.cpu_count() or 1
        out = {"cores": cores}
        fields = (read_text("/proc/stat") or "cpu 0 0 0 0").splitlines()[0].split()[1:]
        ticks = [int(x) for x in fields[:8]] + [0] * (8 - len(fields[:8]))
        rate = self.rate("machine:cpu", now, {"busy": sum(ticks) - ticks[3] - ticks[4], "total": sum(ticks)})
        if rate.get("total"):
            out["busy"] = rate["busy"] / rate["total"] * (os.cpu_count() or cores)
        info = {}
        for line in (read_text("/proc/meminfo") or "").splitlines():
            name, _, value = line.partition(":")
            if value.split():
                info[name] = int(value.split()[0]) * 1024
        out.update(mem_total=info.get("MemTotal", 0), mem_available=info.get("MemAvailable", 0),
                   swap_total=info.get("SwapTotal", 0), swap_used=info.get("SwapTotal", 0) - info.get("SwapFree", 0))
        for resource in ("cpu", "memory", "io"):
            out[f"psi_{resource}"] = pressure_of(read_text(f"/proc/pressure/{resource}"))
        rows = ((overview or {}).get("running") or []) + ((overview or {}).get("queued") or [])
        paths = list(dict.fromkeys(p for row in rows for p in (row.get("disk_paths") or []) if isinstance(p, str)))
        out["filesystems"] = self.filesystems(now, paths, config.get("disk_floor"))
        return out

    def group_paths(self, config: dict) -> dict[str, list[str]]:
        import fnmatch
        apps = os.path.join(self.manager, "app.slice")
        found = {"builds": [os.path.join(self.manager, slice_dir(config.get("slice") or "buildq.slice"))],
                 "ci": [], "containers": [], "apps": [apps]}

        def children(path):
            try:
                return sorted(os.listdir(path))
            except OSError:
                return []

        for parent in (self.manager, apps):
            for name in children(parent):
                if name.endswith(".service") and any(fnmatch.fnmatch(name, p) for p in CI_UNITS):
                    found["ci"].append(os.path.join(parent, name))
        system = "/sys/fs/cgroup/system.slice"
        for name in children(system):
            if any(fnmatch.fnmatch(name, p) for p in CI_UNITS) and name.endswith(".service"):
                found["ci"].append(os.path.join(system, name))
            elif (name.startswith("docker-") and name.endswith(".scope")) or name in ("docker.service", "containerd.service"):
                found["containers"].append(os.path.join(system, name))
        for name in children(os.path.join(self.manager, "user.slice")):
            if name.startswith("libpod-") and name.endswith(".scope"):
                found["containers"].append(os.path.join(self.manager, "user.slice", name))
        return found

    def cgroup(self, path: str, now: float) -> dict | None:
        sample = cgroup_sample(path)
        if sample is None:
            self.last.pop(path, None)
            return None
        before = self.last.get(path)
        rate = self.rate(path, now, {"usage": sample["usage"]})
        sample["cores"] = rate["usage"] / 1e6 if rate else None
        if before is not None and "io" in before[1]:
            sample["read_rate"], sample["write_rate"] = io_rate(before[1]["io"], sample["io"], now - before[0])
        else:
            sample["read_rate"] = sample["write_rate"] = None
        self.last[path] = (now, {"usage": sample["usage"], "io": sample["io"]})
        return sample

    def snapshot(self, overview: dict | None) -> dict:
        now = time.monotonic()
        config = (overview or {}).get("config") or {}
        snap = {"time": time.time(), "overview": overview, "machine": self.machine(now, overview), "groups": {},
                "builds": {}, "dir_sizes": {}}
        found = self.group_paths(config)
        samples = {path: self.cgroup(path, now) for paths in found.values() for path in paths}
        apps_dir = os.path.join(self.manager, "app.slice") + os.sep
        for group, paths in found.items():
            total = {"cores": 0.0, "mem": 0, "swap": 0, "read_rate": 0.0, "write_rate": 0.0, "known": True}
            for path in paths:
                sample = samples.get(path)
                if sample is None:
                    continue
                total["mem"] += sample["mem"]
                total["swap"] += sample["swap"]
                if sample["cores"] is None:
                    total["known"] = False  # seen for the first time: no rate yet
                else:
                    total["cores"] += sample["cores"]
                    total["read_rate"] += sample["read_rate"] or 0
                    total["write_rate"] += sample["write_rate"] or 0
                if group == "builds":
                    total["psi_mem"], total["psi_cpu"], total["psi_io"] = sample["psi_mem"], sample["psi_cpu"], sample["psi_io"]
            snap["groups"][group] = total
        apps = snap["groups"].get("apps")
        for path in found["ci"]:  # CI runners in app.slice aren't the user's apps
            sample = samples.get(path)
            if apps and sample and path.startswith(apps_dir):
                apps["mem"] = max(0, apps["mem"] - sample["mem"])
                apps["swap"] = max(0, apps["swap"] - sample["swap"])
                apps["cores"] = max(0.0, apps["cores"] - (sample["cores"] or 0.0))
        folders = []
        for row in (overview or {}).get("running") or []:
            if row.get("cg"):
                sample = self.cgroup(row["cg"], now)
                if sample is not None:
                    snap["builds"][row["id"]] = sample
            snap.setdefault("folders", {})[row["id"]] = folders_of(row)
            folders.extend(snap["folders"][row["id"]])
        if self.sizes is not None:
            self.sizes.want(folders)
            snap["dir_sizes"] = {f: self.sizes.get(f) for f in folders}
        return snap


# ---- drawing: lines of (text, colour) so the same code feeds curses and --once

GLYPHS = {"full": "█", "empty": "░", "mark": "▶", "atleast": "≥", "sep": "·", "more": "…", "ctl": "·"}


def use_ascii() -> None:
    """Without a UTF-8 locale, draw with ASCII."""
    GLYPHS.update(full="#", empty=".", mark=">", atleast=">=", sep="|", more="...", ctl="?")


def bar(fraction: float, width: int) -> str:
    fraction = min(max(fraction, 0.0), 1.0)
    full = int(round(fraction * width))
    return GLYPHS["full"] * full + GLYPHS["empty"] * (width - full)


def level(fraction: float) -> str:
    return "ok" if fraction < 0.6 else "warn" if fraction < 0.85 else "bad"


def rate_text(value) -> str:
    if value is None:
        return "-"
    if value < 1024:
        return "0"
    return f"{value / 1024:.0f}K/s" if value < MIB else fmt_size(value) + "/s"


def pct(values: dict, kind: str) -> str:
    """A pressure figure, or "-" when the kernel doesn't say (PSI off)."""
    return f"{values[kind]:.1f}%" if kind in values else "-"


def running_order(snap: dict, sort: str) -> list[dict]:
    """The running builds in the order the screen lists them."""
    builds = snap.get("builds", {})

    def use(row, name):
        return (builds.get(row["id"]) or {}).get(name) or 0

    keys = {"age": lambda r: -(r.get("elapsed") or 0), "cpu": lambda r: -use(r, "cores"),
            "mem": lambda r: -(use(r, "mem") or r.get("mem_now") or 0),
            "io": lambda r: -(use(r, "read_rate") + use(r, "write_rate")),
            "disk": lambda r: -(build_disk(snap, r)[0] or 0)}
    return sorted((snap.get("overview") or {}).get("running") or [], key=keys.get(sort, keys["age"]))


def folders_in(snap: dict, row: dict) -> list[str]:
    found = snap.get("folders", {}).get(row.get("id"))
    return found if found is not None else folders_of(row)


def build_disk(snap: dict, row: dict) -> tuple[int | None, str]:
    """What a build's folders take, and a mark: "" (measured), "≥" (only in part), "…" (not yet),
    "?" (couldn't be), "-" (no folders). The row adds "*" when another running build shares one."""
    folders = folders_in(snap, row)
    if not folders:
        return None, "-"
    measured = [snap.get("dir_sizes", {}).get(folder) for folder in folders]
    if all(found is None for found in measured):
        return None, GLYPHS["more"]  # not measured yet
    if all(found is None or found[0] is None for found in measured):
        return None, "?"  # couldn't be measured
    total = sum(found[0] for found in measured if found and found[0] is not None)
    partial = any(found is None or found[0] is None or not found[1] for found in measured)
    return total, GLYPHS["atleast"] if partial else ""


def shared_folders(snap: dict) -> set[str]:
    """Folders that another running build also writes to: the same folder, or one inside the other."""
    owned = [(row["id"], folder) for row in (snap.get("overview") or {}).get("running") or []
             for folder in folders_in(snap, row)]
    shared = set()
    for i, (a, fa) in enumerate(owned):
        for b, fb in owned[i + 1:]:
            if a != b and (fa == fb or fa.startswith(fb + os.sep) or fb.startswith(fa + os.sep)):
                shared.update((fa, fb))
    return shared


def render_top(snap: dict, width: int, height: int, selected: str | None = None, sort: str = "age",
               detail: bool = False, log_lines: list[str] | None = None) -> tuple[list[tuple[str, str]], list[str]]:
    """The screen as lines of (text, colour), and the running builds' ids in screen order. Colour is
    "", "head", "ok", "warn", "bad" or "dim". With a height, the build list scrolls to keep the
    selected build in view, and its detail and log get room of their own; height 0 draws it all."""
    m, groups, ov = snap["machine"], snap["groups"], snap.get("overview")
    sep = GLYPHS["sep"]
    barw = max(8, min(40, width - 80))
    head: list[tuple[str, str]] = []

    def put(lines, text, colour=""):
        lines.append((fit(clean(text), width).rstrip(), colour))

    stamp = time.strftime("%H:%M:%S", time.localtime(snap["time"]))
    state = ("daemon not answering" if ov is None else
             f"PAUSED: {(ov['paused'] or {}).get('reason') or ''}" if ov.get("paused") else f"buildqd {ov.get('version', '')}")
    put(head, f"buildq top  {stamp}  {state}   q quit {sep} s sort ({sort}) {sep} up/down select {sep} enter detail "
              f"{sep} l log", "head")
    cores = m.get("cores", 1)
    target = ((ov or {}).get("budget") or {}).get("cpu_cap") or cores
    busy = m.get("busy")
    if busy is not None:
        put(head, f"CPU   {bar(busy / cores, barw)} {busy:5.1f} of {cores} busy {sep} target {target:.1f} {sep} pressure "
                  f"{pct(m.get('psi_cpu', {}), 'some')}", level(busy / max(target, 1)))
    else:
        put(head, "CPU   (measuring)", "dim")
    total, avail = m.get("mem_total") or 1, m.get("mem_available") or 0
    budget = (ov or {}).get("budget") or {}
    floor = ((ov or {}).get("config") or {}).get("mem_floor") or 0
    pm = m.get("psi_memory", {})
    put(head, f"MEM   {bar(1 - avail / total, barw)} {fmt_size(total - avail)} used {sep} {fmt_size(avail)} free {sep} "
              f"floor {fmt_size(floor)} {sep} held for growth {fmt_size(budget.get('growth_reserved') or 0)} {sep} room "
              f"{fmt_size(max(budget.get('free_mem') or 0, 0))} {sep} pressure {pct(pm, 'some')} some, {pct(pm, 'full')} full",
        level(1 - avail / total))
    if m.get("swap_total"):
        put(head, f"SWAP  {bar(m['swap_used'] / m['swap_total'], barw)} {fmt_size(m['swap_used'])} of "
                  f"{fmt_size(m['swap_total'])}", level(m["swap_used"] / m["swap_total"]))
    for fs in m.get("filesystems") or []:
        used = fs["size"] - fs["free"]
        put(head, f"DISK  {bar(used / max(fs['size'], 1), barw)} {fs['mount']}: {fmt_size(fs['free'])} free of "
                  f"{fmt_size(fs['size'])}{f' {sep} floor ' + fmt_size(fs['floor']) if fs['floor'] else ''} {sep} read "
                  f"{rate_text(fs.get('read'))} {sep} write {rate_text(fs.get('write'))}",
            "bad" if fs["floor"] and fs["free"] < fs["floor"] else level(used / max(fs["size"], 1)))
    parts = []
    for name, label in (("builds", "builds"), ("ci", "CI"), ("containers", "containers"), ("apps", "apps")):
        g = groups.get(name)
        if g:
            cores_text = f"{g['cores']:.1f}c" if g.get("known") else "-"
            swap_text = f" +{fmt_size(g['swap'])} swap" if g["swap"] else ""
            parts.append(f"{label} {cores_text} {fmt_size(g['mem'])}{swap_text}")
    named = ("builds", "ci", "containers", "apps")
    if busy is not None and all(groups.get(n, {}).get("known") for n in named):
        parts.append(f"other {max(0.0, busy - sum(groups[n]['cores'] for n in named if n in groups)):.1f}c")
    put(head, "WHO   " + f" {sep} ".join(parts) + f" {sep} pressure: io {pct(m.get('psi_io', {}), 'some')}")
    b = groups.get("builds")
    if b and b.get("known"):
        bp = b.get("psi_mem") or {}
        put(head, f"QUEUE builds together: {b['cores']:.1f} cores {sep} {fmt_size(b['mem'])} memory {sep} "
                  f"{fmt_size(b['swap'])} swap {sep} read {rate_text(b['read_rate'])} {sep} write {rate_text(b['write_rate'])} "
                  f"{sep} memory pressure {pct(bp, 'some')} some, {pct(bp, 'full')} full")

    running = running_order(snap, sort)
    order = [row["id"] for row in running]
    queued = list((ov or {}).get("queued") or [])
    if selected not in order:
        selected = order[0] if order else None
    builds, shared = snap.get("builds", {}), shared_folders(snap)

    # Columns: the core ones always; then, as width allows, disk, memory pressure, I/O, swap.
    narrow = width < 80
    core = [("TICKET", 9)] + ([] if narrow else [("LANE", 6), ("AGE", 6)]) + [("CPU used/given", 14),
                                                                            ("MEMORY now/peak/plan", 24)]
    optional = [("DISK", 8), ("MEMP", 6), ("READ/s", 8), ("WRITE/s", 8), ("SWAP", 7)]
    used_width = 2 + sum(w + 1 for _, w in core)
    shown = []
    for name, w in optional:  # in order: the last ones go first
        if used_width + w + 1 + 12 > width:
            break
        shown.append((name, w))
        used_width += w + 1
    shown_names = {name for name, _ in shown}
    cmdw = max(0, width - used_width - 1)

    def cell(text, w, right=False):
        text = fit(clean(text), w)
        pad = " " * (w - text_width(text))
        return pad + text if right else text + pad

    table: list[tuple[str, str]] = []
    header = "  " + " ".join(cell(n, w, n == "AGE") for n, w in core)
    header += "".join(" " + cell(n, w, True) for n, w in optional if n in shown_names) + "  COMMAND"
    put(table, f"{len(running)} running {sep} {len(queued)} waiting", "head")
    put(table, header, "dim")
    rows: list[tuple[str, str]] = []
    for row in running:
        s = builds.get(row["id"]) or {}
        given = row.get("granted") or 0
        used = s.get("cores")
        cpu = (f"{bar(used / max(given, 1), 6)} {used:4.1f}/{given}" if used is not None else f"{'':6} {'-':>4}/{given}")
        mem_now = s.get("mem", row.get("mem_now") or 0)
        plan = row.get("est_mem") or 0
        mem = f"{bar(mem_now / plan, 6) if plan else ' ' * 6} {fmt_size(mem_now)}/{fmt_size(row.get('mem_peak') or 0)}/{fmt_size(plan)}"
        size, mark = build_disk(snap, row)
        disk = mark if size is None else (mark if mark == GLYPHS["atleast"] else "") + fmt_size(size) + (
            "*" if any(f in shared for f in folders_in(snap, row)) else "")
        psi = s.get("psi_mem") or {}
        values = {"DISK": disk, "MEMP": pct(psi, "some") if s else "-", "READ/s": rate_text(s.get("read_rate")),
                  "WRITE/s": rate_text(s.get("write_rate")),
                  "SWAP": fmt_size(s.get("swap", 0)) if s else "-"}
        marker = GLYPHS["mark"] if row["id"] == selected else " "
        some = psi.get("some", 0.0)
        colour = "bad" if some >= 10 or row.get("frozen") else "warn" if some >= 1 or (plan and mem_now > plan) else ""
        lane_age = "" if narrow else f"{cell(row['lane'], 6)} {cell(fmt_age(row.get('elapsed') or 0), 6, True)} "
        line = (f"{marker} {cell(row['short'], 9)} {lane_age}"
                f"{cell(cpu, 14)} {cell(mem, 24)}" + "".join(" " + cell(values[n], w, True) for n, w in optional if n in shown_names)
                + "  " + cell(row.get("label") or "", cmdw))
        put(rows, line, colour)

    pane: list[tuple[str, str]] = []
    if detail and selected:
        row = next(r for r in running if r["id"] == selected)
        s = builds.get(row["id"]) or {}
        put(pane, f"-- {row['id']}  {row.get('name') or ''}", "head")
        put(pane, f"  command   {row.get('label') or ''}")
        put(pane, f"  in        {row.get('cwd')}")
        put(pane, f"  plan      {fmt_size(row.get('est_mem') or 0)} ({row.get('est_src') or '?'}); peak "
                  f"{fmt_size(row.get('mem_peak') or 0)} at {fmt_age(row.get('peak_at') or 0)} in")
        put(pane, f"  cores     {row.get('granted')} given (wants {row.get('want')}, at least {row.get('need')}); "
                  f"{'-' if s.get('cores') is None else format(s['cores'], '.1f')} in use, {row.get('peak_cores') or 0:.1f} at most")
        if s:
            ev = s.get("events") or {}
            put(pane, f"  pressure  memory {pct(s.get('psi_mem') or {}, 'some')} some, {pct(s.get('psi_mem') or {}, 'full')} full "
                      f"{sep} cpu {pct(s.get('psi_cpu') or {}, 'some')} {sep} io {pct(s.get('psi_io') or {}, 'some')} {sep} "
                      f"over MemoryHigh {ev.get('high', 0)}x {sep} OOM kills {ev.get('oom_kill', 0)}")
        else:
            put(pane, "  pressure  - (no cgroup of its own to read, or not visible from here)")
        waits = ", ".join(f"{k} {fmt_age(v)}" for k, v in sorted((row.get("waited_by") or {}).items(), key=lambda kv: -kv[1]))
        put(pane, f"  waited    {fmt_age(row.get('waited') or 0)}{f' ({waits})' if waits else ''}")
        for folder in folders_in(snap, row):
            found = snap.get("dir_sizes", {}).get(folder)
            said = ("measuring" if found is None else "couldn't be measured" if found[0] is None else
                    ("at least " if not found[1] else "") + fmt_size(found[0]) + f", {fmt_age(found[2])} ago")
            put(pane, f"  writes    {folder}: {said}{' (shared with another build)' if folder in shared else ''}")
        if row.get("release_at") is not None:
            put(pane, f"  past its peak at {fmt_age(row['release_at'])} in: would keep {fmt_size(row.get('release_hold') or 0)}")
    log_pane: list[tuple[str, str]] = []
    if log_lines is not None and selected:
        put(log_pane, f"-- the end of {selected[:8]}'s output", "head")
        for text in log_lines:
            put(log_pane, "  " + text, "dim")

    waiting: list[tuple[str, str]] = []
    if queued:
        put(waiting, "WAITING", "head")
        for row in queued:
            put(waiting, f"  {cell(row['short'], 9)} {cell(row['lane'], 7)} {cell(fmt_age(row.get('waited') or 0), 6, True)}  "
                         f"needs {fmt_size(row.get('est_mem') or 0):>6}  {row.get('reason') or ''}",
                "warn" if row.get("held") else "")

    if not height:
        both = pane + log_pane
        return head + [("", "")] + table + rows + ([("", "")] + both if both else []) + (
            [("", "")] + waiting if waiting else []), order
    # Fit the screen: the machine; the table header; the detail and log (at most half the screen,
    # the newest log lines kept); as many build rows as fit, the selected one in view; then
    # waiting builds in what is left.
    pane_room = max(0, height // 2 - 1)
    pane = pane[:pane_room]
    log_pane = log_pane[:1] + log_pane[1:][-max(0, pane_room - len(pane) - 1):] if pane_room - len(pane) > 1 else []
    both = pane + log_pane
    head = head[:max(3, height - 6)]  # a short terminal keeps the title, CPU and memory, and the builds
    room = height - len(head) - 1 - len(table) - (len(both) + 1 if both else 0) - (min(len(waiting), 3) + 1 if waiting else 0)
    room = max(1, room)
    if len(rows) <= room:
        visible = rows
    else:
        slots = max(1, room - 1)  # one line says what is above and below
        index = order.index(selected) if selected in order else 0
        start = min(max(0, index - slots + 1), len(rows) - slots)
        visible = rows[start:start + slots]
        if room > 1:
            visible.append((f"  {GLYPHS['more']} {start} above, {len(rows) - start - slots} below (up/down)", "dim"))
    screen = head + [("", "")] + table + visible + ([("", "")] + both if both else [])
    left = height - len(screen) - 1
    if waiting and left > 1:
        screen += [("", "")] + waiting[:left]
        if len(waiting) > left:
            screen[-1] = (f"  {GLYPHS['more']} {len(waiting) - left + 1} more waiting", "dim")
    return screen[:height], order


def tail_lines(path, count: int = 12) -> list[str]:
    if not path:
        return []
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 16384))
            return [clean(line) for line in f.read().decode(errors="replace").splitlines()[-count:]]
    except OSError:
        return ["(its output can't be read)"]


def interval_arg(text: str) -> float:
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError("not a number") from None
    if not math.isfinite(value) or value < 0.5:
        raise argparse.ArgumentTypeError("at least 0.5 seconds")
    return value


def print_top_once(sampler: TopSampler) -> int:
    """One snapshot as text: two looks a second apart (rates need two), folder sizes measured
    first for up to 20 seconds in all (a folder not done by then shows as not measured yet)."""
    overview = request({"op": "status"}, 3)
    if sampler.sizes is not None and overview is not None:
        deadline = time.monotonic() + 20
        for row in overview.get("running") or []:
            for folder in folders_of(row):
                left = deadline - time.monotonic()
                if left > 1 and sampler.sizes.get(folder) is None:
                    sampler.sizes.measure_into(folder, left, keep_cut=False)
    sampler.snapshot(request({"op": "status"}, 3))
    time.sleep(1.0)
    snap = sampler.snapshot(request({"op": "status"}, 3))
    if snap["overview"] is None:
        unreachable()
    width = shutil.get_terminal_size((220, 24)).columns if sys.stdout.isatty() else 220
    encoding = sys.stdout.encoding or "utf-8"
    for text, _ in render_top(snap, width, 0)[0]:
        print(text.encode(encoding, "replace").decode(encoding, "replace"))
    return 0 if snap["overview"] is not None else 75


def cmd_top(args) -> int:
    """A live view of the machine and each build, refreshed every --interval seconds."""
    import locale
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:  # a locale named in the environment but not installed
        pass
    encoding = locale.getpreferredencoding(False) or "ascii"
    if "utf" not in encoding.lower().replace("-", ""):
        use_ascii()
    if args.once or not sys.stdout.isatty():
        sampler = TopSampler(DirSizes(background=False))
        try:
            return print_top_once(sampler)
        finally:
            sampler.sizes.stop()
    import curses
    sizes = DirSizes()

    def run(screen) -> int:
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        screen.timeout(100)
        colours = {"": 0}
        try:
            if curses.has_colors():
                curses.use_default_colors()
                for i, (name, fg) in enumerate((("head", curses.COLOR_CYAN), ("ok", curses.COLOR_GREEN),
                                                 ("warn", curses.COLOR_YELLOW), ("bad", curses.COLOR_RED),
                                                 ("dim", curses.COLOR_BLUE)), start=1):
                    curses.init_pair(i, fg, -1)
                    colours[name] = curses.color_pair(i) | (curses.A_BOLD if name == "head" else 0)
        except curses.error:
            colours = {"": 0}  # no default colours on this terminal: plain text
        sampler = TopSampler(sizes)
        sorts = ["age", "cpu", "mem", "io", "disk"]
        sort, selected, detail, logs = "age", None, False, False
        snap, next_at, order, dirty = None, 0.0, [], True
        while True:
            if time.monotonic() >= next_at:
                snap = sampler.snapshot(request({"op": "status"}, 1.5, connect_timeout=0.5))
                next_at = time.monotonic() + args.interval  # (after the request: a slow daemon isn't asked again at once)
                dirty = True
            if dirty:
                height, width = screen.getmaxyx()
                row = next((r for r in (snap["overview"] or {}).get("running") or [] if r["id"] == selected), None)
                log = tail_lines(row.get("log")) if logs and row else None
                lines, order = render_top(snap, max(width, 20), height, selected, sort, detail, log)
                if order and selected not in order:
                    selected = order[0]  # (kept while the daemon doesn't answer: it comes back to the same build)
                screen.erase()
                for y, (text, colour) in enumerate(lines):
                    if y == height - 1:
                        text = fit(text, width - 1)  # (curses can't write the bottom-right cell)
                    try:
                        screen.addstr(y, 0, text.encode(encoding, "replace").decode(encoding, "replace"),
                                      colours.get(colour, 0))
                    except (curses.error, UnicodeError):
                        pass
                screen.refresh()
                dirty = False
            key = screen.getch()
            if key == -1:
                continue
            dirty = True
            if key in (ord("q"), ord("Q")):
                return 0
            if key == ord("s"):
                sort = sorts[(sorts.index(sort) + 1) % len(sorts)]
            elif key in (curses.KEY_DOWN, ord("j")) and order:
                selected = order[min(order.index(selected) + 1 if selected in order else 0, len(order) - 1)]
            elif key in (curses.KEY_UP, ord("k")) and order:
                selected = order[max(order.index(selected) - 1 if selected in order else 0, 0)]
            elif key in (10, 13, curses.KEY_ENTER, ord("d")):
                detail = not detail
            elif key == ord("l"):
                logs = not logs
            # KEY_RESIZE: redrawn at the new size, without taking a new sample

    try:
        return curses.wrapper(run)
    except KeyboardInterrupt:
        return 0
    except curses.error:  # no usable terminal (TERM unset, dumb): one snapshot instead
        sizes.stop()
        once = TopSampler(DirSizes(background=False))
        try:
            return print_top_once(once)
        finally:
            once.sizes.stop()
    finally:
        sizes.stop()


def skill_file() -> str | None:
    """The agents' page: the installed skill (with this machine's notes), or the one beside this program."""
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(data, "buildq", "skill", "buildq", "SKILL.md"),
                 os.path.join(here, "..", "skills", "buildq", "SKILL.md")):
        if os.path.isfile(path):
            return path
    return None


def cmd_help(args) -> int:
    if args.topic != "agents":
        note("the help topic is `agents`; `buildq --help` has the rest")
        return 2
    path = skill_file()
    if path is None:
        note("the agents' page isn't installed; it is skills/buildq/SKILL.md in the buildq repository")
        return 1
    with open(path) as f:
        sys.stdout.write(f.read())
    return 0


def cmd_source(args) -> int:
    """For the daemon: the source record of a directory, as JSON (null if there is none)."""
    print(json.dumps(source_of(args.directory)))
    return 0


def cmd_ping(_args) -> int:
    reply = request({"op": "ping"})
    if reply is None or reply.get("type") != "pong":
        return unreachable()
    print(f"buildqd {reply.get('version')} ({reply.get('runner')} runner) is answering at {socket_path()}")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="buildq", description="Drop off builds, get tickets, check on them.")
    parser.add_argument("--version", action="version", version=f"buildq {VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    def build_options(p):
        p.add_argument("--lane", help="the kind of build, from the daemon's configuration")
        p.add_argument("--cores", type=float, help="use this many cores, in place of the learned size")
        p.add_argument("--mem", help="expect at least this peak memory (for example 6G); raises, never lowers")
        p.add_argument("--priority", type=int, default=0, help="higher runs first (default 0)")
        p.add_argument("--timeout", type=parse_duration, help="stop the build after this long (for example 45m)")
        p.add_argument("--name", help="a name to show in place of the command")
        p.add_argument("--notify", metavar="COMMAND", help="a shell command to run when the build finishes")
        again = p.add_mutually_exclusive_group()
        again.add_argument("--again", action="store_true",
                           help="run it even if the same command on the same source ran or is running")
        again.add_argument("--reuse", action="store_true",
                           help="take an earlier pass on the same source as the result, for any command")
        p.add_argument("--restartable", action="store_true",
                       help="safe to stop and start over from the beginning if the machine runs short of memory")
        p.add_argument("command", nargs=argparse.REMAINDER, help="the command and its arguments")

    build_options(sub.add_parser("submit", help="queue a build; prints its ticket"))
    build_options(sub.add_parser("run", help="queue a build, stream its output, exit with its exit code"))
    status = sub.add_parser("status", help="a ticket in detail, or the queue and the machine")
    status.add_argument("tickets", nargs="*")
    status.add_argument("--json", action="store_true")
    listing = sub.add_parser("list", help="every ticket")
    listing.add_argument("--all", action="store_true", help="include builds that finished more than a day ago")
    listing.add_argument("--json", action="store_true")
    wait = sub.add_parser("wait", help="block until a build finishes; exits with its exit code")
    wait.add_argument("ticket")
    wait.add_argument("--timeout", type=parse_duration, help="give up after this long (exit 124)")
    wait.add_argument("--quiet", action="store_true", help="print nothing; just exit with the code")
    logs = sub.add_parser("logs", help="a build's output")
    logs.add_argument("ticket")
    logs.add_argument("--follow", "-f", action="store_true", help="keep printing until the build finishes")
    logs.add_argument("--tail", "-n", type=int, help="start with the last N lines")
    cancel = sub.add_parser("cancel", help="take builds out of the queue, or stop them")
    cancel.add_argument("tickets", nargs="+")
    cancel.add_argument("--all", action="store_true",
                        help="stop a build even though other submissions of the same build wait for it")
    pause = sub.add_parser("pause", help="start nothing new until `buildq resume`; running builds carry on")
    pause.add_argument("reason", nargs="*", help="why, for everyone who sees the queue waiting")
    sub.add_parser("resume", help="start queued builds again")
    report = sub.add_parser("report", help="time, memory and kills per command, from the history")
    report.add_argument("--since", type=parse_duration, default=7 * 86400, help="how far back (default 7d)")
    report.add_argument("--by", choices=("command", "lane", "caller"), default="command")
    report.add_argument("--top", type=int, default=25, help="show this many (default 25)")
    report.add_argument("--json", action="store_true")
    report.add_argument("--capacity", action="store_true",
                        help="what builds waited for and what sat idle meanwhile, by day, from the analytics")
    report.add_argument("--hourly", action="store_true", help="with --capacity: by hour instead of by day")
    top = sub.add_parser("top", help="a live view of the machine and each build (q quits)")
    top.add_argument("--interval", type=interval_arg, default=2.0, help="seconds between refreshes (default 2, at least 0.5)")
    top.add_argument("--once", action="store_true", help="print one snapshot and exit (also when not a terminal)")
    query = sub.add_parser("query", help="a read-only SQL query on the analytics (no query: list its tables)")
    query.add_argument("sql", nargs="*", help="one SQL statement; quote it")
    query.add_argument("--json", action="store_true")
    query.add_argument("--limit", type=int, default=200, help="show at most this many rows (0: all; default 200)")
    helper = sub.add_parser("help", help="`buildq help agents`: how a coding agent uses the queue")
    helper.add_argument("topic", nargs="?", default="agents")
    sub.add_parser("ping", help="check that the daemon answers")
    source = sub.add_parser("source", help=argparse.SUPPRESS)
    source.add_argument("directory")
    args = parser.parse_args(argv)
    handlers = {"submit": cmd_submit, "run": cmd_run, "status": cmd_status, "list": cmd_list, "wait": cmd_wait,
                "logs": cmd_logs, "cancel": cmd_cancel, "pause": cmd_pause, "resume": cmd_resume,
                "report": cmd_report, "help": cmd_help, "ping": cmd_ping, "source": cmd_source,
                "query": cmd_query, "top": cmd_top}
    return handlers[args.cmd](args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
