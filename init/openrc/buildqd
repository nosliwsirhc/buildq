#!/sbin/openrc-run
# SPDX-License-Identifier: MIT
# OpenRC service for buildqd (Alpine, Gentoo, Artix, Devuan OpenRC).
#
# Copy to /etc/init.d/buildqd (chmod 755) and create /etc/conf.d/buildqd with:
#   BUILDQ_USER="youruser"
#   # Optional: delegate /sys/fs/cgroup/buildq-<user> for full cgroup v2 limits & freezing:
#   # BUILDQ_CGROUP_DELEGATE="yes"
# Then: rc-update add buildqd default && rc-service buildqd start

name="buildqd"
description="buildq load-aware build queue daemon"

: "${BUILDQ_USER:?Set BUILDQ_USER in /etc/conf.d/buildqd}"
case "$BUILDQ_USER" in
	''|*[!A-Za-z0-9_.-]*|-*) eerror "Invalid BUILDQ_USER: $BUILDQ_USER"; exit 1 ;;
esac
BUILDQ_HOME="${BUILDQ_HOME:-$(getent passwd "$BUILDQ_USER" | cut -d: -f6)}"
BUILDQ_BIN="${BUILDQ_BIN:-$BUILDQ_HOME/.local/bin/buildqd}"
BUILDQ_STATE_DIR="${BUILDQ_STATE_DIR:-$BUILDQ_HOME/.local/state/buildq}"
BUILDQ_CONFIG="${BUILDQ_CONFIG:-$BUILDQ_HOME/.config/buildq/config.toml}"
BUILDQ_LOG="${BUILDQ_LOG:-$BUILDQ_STATE_DIR/buildqd.log}"
BUILDQ_PID="${BUILDQ_PID:-$BUILDQ_STATE_DIR/buildqd.pid}"
BUILDQ_SOCKET="${BUILDQ_SOCKET:-$BUILDQ_STATE_DIR/run/buildq.sock}"

# OpenRC's supervise-daemon evaluates command_args via shell; reject whitespace/metacharacters.
for _p in "$BUILDQ_HOME" "$BUILDQ_BIN" "$BUILDQ_STATE_DIR" "$BUILDQ_CONFIG" "$BUILDQ_LOG" "$BUILDQ_PID" "$BUILDQ_SOCKET"; do
	case "$_p" in
		/*) ;;
		*) eerror "buildqd path must be absolute: $_p"; exit 1 ;;
	esac
	case "$_p" in
		*[[:space:]\;\|\&\$\`\'\"\\\(\)\<\>\*\?\[]*)
			eerror "buildqd path contains unsafe shell characters: $_p"; exit 1 ;;
	esac
done

supervisor="supervise-daemon"
command="$BUILDQ_BIN"
command_args="--socket $BUILDQ_SOCKET --state-dir $BUILDQ_STATE_DIR --config $BUILDQ_CONFIG --pid-file $BUILDQ_PID --log-file $BUILDQ_LOG"
command_user="$BUILDQ_USER"
supervise_daemon_args="--env HOME=$BUILDQ_HOME"
extra_started_commands="reload"

depend() {
	need localmount
	after bootmisc
}

start_pre() {
	local group cg_procs
	group=$(id -gn "$BUILDQ_USER")
	checkpath -d -m 0700 -o "$BUILDQ_USER:$group" "$BUILDQ_STATE_DIR"
	if [ "${BUILDQ_CGROUP_DELEGATE:-no}" = "yes" ] && [ -f /sys/fs/cgroup/cgroup.controllers ]; then
		if [ -x /usr/local/libexec/buildq-cgroup-setup.sh ]; then
			/usr/local/libexec/buildq-cgroup-setup.sh "$BUILDQ_USER" >/dev/null || true
		fi
		# Place supervise-daemon/buildqd inside the delegated subtree so unprivileged
		# migration into builds/buildq-<id> satisfies the cgroup v2 common-ancestor rule.
		for cg_procs in \
			"/sys/fs/cgroup/buildq-$BUILDQ_USER/user/daemon/cgroup.procs" \
			"/sys/fs/cgroup/buildq-$BUILDQ_USER/daemon/cgroup.procs"
		do
			if [ -w "$cg_procs" ]; then
				printf '%s\n' "$$" >"$cg_procs" 2>/dev/null || true
				break
			fi
		done
	fi
}

reload() {
	ebegin "Reloading buildqd configuration"
	supervise-daemon "$RC_SVCNAME" --signal HUP
	eend $?
}
