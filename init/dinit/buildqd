# dinit user service for buildqd (Chimera Linux, Artix dinit).
#
# Copy to ~/.config/dinit.d/buildqd (adjust paths if PREFIX differs), then:
#   dinitctl enable buildqd
#   dinitctl start buildqd
# For a system service in /etc/dinit.d/buildqd, add:
#   run-as = <username>
#   # Optional (after running init/cgroup-setup.sh <username>):
#   run-in-cgroup = /buildq-<username>/daemon

type = process
command = /home/USER/.local/bin/buildqd --state-dir /home/USER/.local/state/buildq --config /home/USER/.config/buildq/config.toml --pid-file /home/USER/.local/state/buildq/buildqd.pid --log-file /home/USER/.local/state/buildq/buildqd.log
smooth-recovery = true
restart = true
stop-timeout = 15
